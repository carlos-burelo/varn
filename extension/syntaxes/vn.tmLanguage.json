{
	"information_for_contributors": [
		"Lexer-safe grammar for Varn, tuned for two jobs:",
		"1. Editor fallback: in a live .vn buffer the varn-lsp semantic tokens provider is",
		"   authoritative and OVERRIDES this grammar for every identifier it classifies.",
		"   So the rules here only surface before the LSP responds or in error states.",
		"2. Hover / markdown rendering: VSCode renders hover signatures as ```Varn code",
		"   fences. Semantic tokens NEVER apply inside hover markdown, so this grammar is",
		"   the ONLY thing that colors them. The declaration/type rules below exist mainly",
		"   to make those hover signatures readable.",
		"Rules are deterministic and keyword/colon-anchored. Do NOT add speculative",
		"heuristics (arrow-fn detection, var-expr, destructuring, regex, decorator-as-",
		"expression, JSX): those produced the bad inferences this grammar replaced. The",
		"original TypeScript-derived grammar is preserved at vn.tmLanguage.full.backup.json.",
		"Keyword/type sets are derived from varn-core TokenKind, not TypeScript."
	],
	"name": "Varn",
	"scopeName": "source.vn",
	"patterns": [
		{ "include": "#comment" },
		{ "include": "#shebang" },
		{ "include": "#string" },
		{ "include": "#number" },
		{ "include": "#constant" },
		{ "include": "#declaration" },
		{ "include": "#type-annotation" },
		{ "include": "#primitive-type" },
		{ "include": "#keyword" },
		{ "include": "#operator" }
	],
	"repository": {
		"shebang": {
			"name": "comment.line.shebang.vn",
			"match": "\\A#!.*$"
		},
		"comment": {
			"patterns": [
				{
					"name": "comment.block.documentation.vn",
					"begin": "/\\*\\*",
					"end": "\\*/"
				},
				{
					"name": "comment.block.vn",
					"begin": "/\\*",
					"end": "\\*/"
				},
				{
					"name": "comment.line.double-slash.vn",
					"begin": "//",
					"end": "(?=$)"
				}
			]
		},
		"string": {
			"patterns": [
				{
					"name": "string.quoted.double.vn",
					"begin": "\"",
					"end": "\"|(?=$)",
					"patterns": [ { "include": "#string-escape" } ]
				},
				{
					"name": "string.quoted.single.vn",
					"begin": "'",
					"end": "'|(?=$)",
					"patterns": [ { "include": "#string-escape" } ]
				},
				{
					"name": "string.template.vn",
					"begin": "`",
					"end": "`",
					"patterns": [
						{ "include": "#string-escape" },
						{ "include": "#template-substitution" }
					]
				}
			]
		},
		"string-escape": {
			"name": "constant.character.escape.vn",
			"match": "\\\\(x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\}|u[0-9A-Fa-f]{4}|.)"
		},
		"template-substitution": {
			"name": "meta.template.expression.vn",
			"begin": "\\$\\{",
			"end": "\\}",
			"beginCaptures": {
				"0": { "name": "punctuation.definition.template-expression.begin.vn" }
			},
			"endCaptures": {
				"0": { "name": "punctuation.definition.template-expression.end.vn" }
			},
			"patterns": [
				{ "include": "#comment" },
				{ "include": "#string" },
				{ "include": "#number" },
				{ "include": "#constant" },
				{ "include": "#primitive-type" },
				{ "include": "#keyword" },
				{ "include": "#operator" }
			]
		},
		"number": {
			"patterns": [
				{
					"name": "constant.numeric.hex.vn",
					"match": "\\b0[xX][0-9a-fA-F_]+n?\\b"
				},
				{
					"name": "constant.numeric.octal.vn",
					"match": "\\b0[oO][0-7_]+n?\\b"
				},
				{
					"name": "constant.numeric.binary.vn",
					"match": "\\b0[bB][01_]+n?\\b"
				},
				{
					"name": "constant.numeric.decimal.vn",
					"match": "\\b[0-9][0-9_]*(\\.[0-9_]+)?([eE][+-]?[0-9_]+)?[nm]?\\b"
				}
			]
		},
		"constant": {
			"name": "constant.language.vn",
			"match": "(?<![._$[:alnum:]])(true|false|null)(?![_$[:alnum:]])"
		},
		"declaration": {
			"patterns": [
				{
					"match": "(?<![._$[:alnum:]])(function|method)(?![_$[:alnum:]])\\s+([_$[:alpha:]][_$[:alnum:]]*)",
					"captures": {
						"1": { "name": "storage.type.vn" },
						"2": { "name": "entity.name.function.vn" }
					}
				},
				{
					"match": "(?<![._$[:alnum:]])(class|struct|interface|enum|namespace|module|extension|type)(?![_$[:alnum:]])\\s+([_$[:alpha:]][_$[:alnum:]]*)",
					"captures": {
						"1": { "name": "storage.type.vn" },
						"2": { "name": "entity.name.type.vn" }
					}
				},
				{
					"match": "(?<![._$[:alnum:]])(const|let|var|prop)(?![_$[:alnum:]])\\s+([_$[:alpha:]][_$[:alnum:]]*)",
					"captures": {
						"1": { "name": "storage.type.vn" },
						"2": { "name": "variable.other.vn" }
					}
				},
				{
					"match": "(?<![._$[:alnum:]])(get|set)(?![_$[:alnum:]])\\s+([_$[:alpha:]][_$[:alnum:]]*)",
					"captures": {
						"1": { "name": "storage.type.vn" },
						"2": { "name": "entity.name.function.vn" }
					}
				}
			]
		},
		"type-annotation": {
			"patterns": [
				{
					"match": "(?<![._$[:alnum:]])(on|extends|implements)(?![_$[:alnum:]])\\s+([_$[:alpha:]][_$[:alnum:]]*)",
					"captures": {
						"1": { "name": "storage.modifier.vn" },
						"2": { "name": "entity.name.type.vn" }
					}
				},
				{
					"match": "(:)\\s*([_$[:alpha:]][_$[:alnum:]]*)",
					"captures": {
						"2": { "name": "entity.name.type.vn" }
					}
				}
			]
		},
		"primitive-type": {
			"name": "support.type.primitive.vn",
			"match": "(?<![._$[:alnum:]])(int|str|bool|float|decimal|bigint|char|void|dynamic|symbol|never|Object|Task|Result|Array)(?![_$[:alnum:]])"
		},
		"keyword": {
			"patterns": [
				{
					"name": "keyword.control.vn",
					"match": "(?<![._$[:alnum:]])(if|else|switch|case|default|while|for|do|break|continue|return|throw|try|catch|finally|with|match|yield|await)(?![_$[:alnum:]])"
				},
				{
					"name": "keyword.control.import.vn",
					"match": "(?<![._$[:alnum:]])(import|export|from|as)(?![_$[:alnum:]])"
				},
				{
					"name": "keyword.control.concurrency.vn",
					"match": "(?<![._$[:alnum:]])(spawn|parallel|start|using)(?![_$[:alnum:]])"
				},
				{
					"name": "storage.type.vn",
					"match": "(?<![._$[:alnum:]])(let|const|var|function|class|struct|interface|type|enum|namespace|module|extension|constructor|destructor|get|set)(?![_$[:alnum:]])"
				},
				{
					"name": "storage.modifier.vn",
					"match": "(?<![._$[:alnum:]])(public|private|protected|static|abstract|override|readonly|declare|native|async|extends|implements|on)(?![_$[:alnum:]])"
				},
				{
					"name": "keyword.operator.expression.vn",
					"match": "(?<![._$[:alnum:]])(typeof|instanceof|in|of|is|new|delete)(?![_$[:alnum:]])"
				},
				{
					"name": "variable.language.vn",
					"match": "(?<![._$[:alnum:]])(this|super)(?![_$[:alnum:]])"
				}
			]
		},
		"operator": {
			"comment": "Specific sub-scopes are required: themes (e.g. One Dark Pro) color keyword.operator.{arithmetic,comparison,relational,logical,bitwise,assignment} but leave the bare keyword.operator at foreground. Ordered longest-first; rules are tried top-down.",
			"patterns": [
				{
					"name": "keyword.operator.arrow.vn",
					"match": "=>|->|\\|>"
				},
				{
					"name": "keyword.operator.range.vn",
					"match": "\\.\\.\\.|\\.\\.=|\\.\\."
				},
				{
					"name": "keyword.operator.comparison.vn",
					"match": "===|!==|==|!=|<=|>="
				},
				{
					"name": "keyword.operator.assignment.vn",
					"match": ">>>=|<<=|>>=|\\*\\*=|&&=|\\|\\|=|\\?\\?=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|="
				},
				{
					"name": "keyword.operator.arithmetic.vn",
					"match": "\\+\\+|--|\\*\\*|\\+|-|\\*|/|%"
				},
				{
					"name": "keyword.operator.logical.vn",
					"match": "&&|\\|\\||!"
				},
				{
					"name": "keyword.operator.bitwise.vn",
					"match": "<<|>>>|>>|&|\\||\\^|~|<|>"
				},
				{
					"name": "keyword.operator.ternary.vn",
					"match": "\\?\\?|\\?\\.|\\?"
				}
			]
		}
	}
}
