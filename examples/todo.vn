import {
    Column, Row, Text, Title, Caption, Button, ButtonKind, Checkbox, Input, Each, Expanded, Spacer,
    signal, effect, component, run, Widget, Theme, UiFrame, Focus
} from "std:ui";
import { readText, writeText, exists } from "std:fs";
import { Json } from "std:encoding";

const FILE = "examples/todos.json";

type Todo = { text: str, done: bool };

function loadTodos(): Todo[] {
    if (!exists(FILE)) {
        return [];
    }
    try {
        return Json.parse<Todo[]>(readText(FILE)).map((t: Todo): Todo => ({ text: t.text, done: t.done == true }));
    } catch (e) {
        return [];
    }
}

const todos = signal<Todo[]>(loadTodos());
effect(() => writeText(FILE, Json.stringify(todos.value)));

@component
function App(): Widget {
    const draft = signal("");

    const add = (): void => {
        const clean = draft.value.trim();
        if (clean != "") {
            todos.update((all: Todo[]): Todo[] => [...all, { text: clean, done: false }]);
            draft.set("");
        }
    };
    const toggle = (at: int): void => todos.update((all: Todo[]): Todo[] =>
        all.map((t: Todo, i: int): Todo => i == at ? { text: t.text, done: !t.done } : t)
    );
    const remove = (at: int): void => todos.update((all: Todo[]): Todo[] =>
        all.filter((t: Todo, i: int): bool => i != at)
    );

    return Column([
        Title(`tareas (${todos.value.length})`),
        Row([Expanded(Input(draft, hint: "nueva tarea, Enter añade", onSubmit: (v: str) => add())), Button("Añadir", add)]),
        Each(todos.value, (t: Todo): str => t.text, (t: Todo, at: int) => Row([
            Checkbox(t.done, onChange: (next: bool) => toggle(at)),
            Expanded(Text(t.text, color: t.done ? Theme.colors.muted : Theme.colors.onSurface)),
            Button("-", () => remove(at), kind: ButtonKind.danger, w: 36.0, h: 30.0)
        ])),
        Spacer(),
        Caption(`click edita · Enter añade · Esc sale · guarda en ${FILE}`)
    ], pad: 20.0, gap: 12.0);
}

run("tareas", build: (fr: UiFrame, focus: Focus): Widget => App(), w: 800, h: 640);
print(`tareas: ${todos.value.length} en ${FILE}`);
