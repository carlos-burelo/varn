import {
    Column, Row, Text, Title, Headline, Caption, Card, Button, ButtonKind, Checkbox, Each, Progress, Divider, Spacer,
    signal, computed, effect, component, run, Widget, MainAxis, Theme, UiFrame, Focus
} from "std:ui";
import { Env } from "std:env";

type Todo = { id: int, title: str, done: bool };

@component
function Counter(start: int = 0): Widget {
    const count = signal(start);
    effect(() => print(`count is now ${count.value}`));

    return Card([
        Row([Text(`${count.value}`, size: 40.0), Caption(`x2 = ${count.value * 2}`)], mainAxis: MainAxis.spaceBetween),
        Row([
            Button("-1", () => count.update((n: int): int => n - 1)),
            Button("+1", () => count.update((n: int): int => n + 1)),
            Spacer(),
            Button("reset", () => count.set(start), kind: ButtonKind.subtle, enabled: count.value != start)
        ])
    ], title: "Counter");
}

@component
function TodoList(): Widget {
    const todos = signal<Todo[]>([
        { id: 1, title: "write a component", done: true },
        { id: 2, title: "keep its state between frames", done: false },
        { id: 3, title: "ship it", done: false }
    ]);
    const remaining = computed(() => todos.value.filter((t: Todo) => !t.done).length);

    const toggle = (id: int): void => todos.update((all: Todo[]): Todo[] =>
        all.map((t: Todo): Todo => t.id == id ? { id: t.id, title: t.title, done: !t.done } : t)
    );

    return Card([
        Row([Title("Todos"), Caption(`${remaining.value} left`)], mainAxis: MainAxis.spaceBetween),
        Divider(),
        Each(todos.value, (t: Todo, at: int) => Row([
            Checkbox(t.done, onChange: (next: bool) => toggle(t.id)),
            Text(t.title, color: t.done ? Theme.colors.muted : Theme.colors.onSurface)
        ]), gap: 10.0)
    ]);
}

@component
function Dashboard(): Widget {
    return Column([
        Row([Headline("Dashboard"), Caption("varn ui")], mainAxis: MainAxis.spaceBetween),
        Counter(start: 10),
        Progress(0.4),
        TodoList()
    ], pad: 24.0, gap: 16.0);
}

const real = Env.get("VARN_UI_REAL") == "1";
if (!real) {
    print("headless: 5 frames. Run with VARN_UI_REAL=1 to open a window (Esc closes).");
}
run("varn declarative ui", build: (fr: UiFrame, focus: Focus): Widget => Dashboard(), w: 560, h: 640, maxFrames: real ? 0 : 5);
print("declarative demo done");
