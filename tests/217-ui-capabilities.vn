import { describe, it, expect } from "std:test";
import { Process } from "std:process";
import { platform } from "std:sys";

const vnBin = platform() == "windows" ? "target/debug/vn.exe" : "target/debug/vn";

await describe("217 ui capabilities", async () => {
    await it("sandbox denies window open", async () => {
        const proc = Process.spawn(vnBin, ["run", "--sandbox", "tests/helpers/ui_open_probe.vn"]);
        const r = proc.wait();
        expect(r.success).toBe(false);
    });

    await it("restrictive flags without ui deny window open", async () => {
        const proc = Process.spawn(vnBin, [
            "run",
            "--allow-read=.",
            "tests/helpers/ui_open_probe.vn"
        ]);
        const r = proc.wait();
        expect(r.success).toBe(false);
    });

    await it("--allow-ui grants window open under restrictive flags", async () => {
        const proc = Process.spawn(vnBin, [
            "run",
            "--allow-read=.",
            "--allow-ui",
            "tests/helpers/ui_open_probe.vn"
        ]);
        const r = proc.wait();
        expect(r.success).toBe(true);
    });

    await it("default run allows window open", async () => {
        const proc = Process.spawn(vnBin, ["run", "tests/helpers/ui_open_probe.vn"]);
        const r = proc.wait();
        expect(r.success).toBe(true);
    });
});
