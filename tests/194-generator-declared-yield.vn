import { describe, it, expect } from "std:test";

function* short(): int { yield 1; yield 2 }
function* long(): Generator<int> { yield 3; yield 4 }
function* halves(): float { yield 1; yield 2.5 }
function* inner() { yield 41 }
function* outer() { yield inner() }

class Bag {
    *each(): str { yield "a"; yield "b" }
}

function sum(source: Generator<int>): int {
    let total = 0
    for (const value of source) { total = total + value }
    return total
}

await describe("194 generator declared yield", async () => {
    await it("the annotation names what is yielded, written short or long", () => {
        expect(sum(short())).toBe(3)
        expect(sum(long())).toBe(7)
        let text = ""
        for (const piece of new Bag().each()) { text = text + piece }
        expect(text).toBe("ab")
    })

    await it("an integer literal yielded as float arrives as a float", () => {
        let kinds = ""
        for (const value of halves()) { kinds = kinds + typeof value + " " }
        expect(kinds).toBe("float float ")
    })

    await it("a generator can still yield generators", () => {
        const nested = outer().next().unwrap()
        expect(nested.next().unwrap()).toBe(41)
    })
})
