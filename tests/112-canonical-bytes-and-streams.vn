import { Stream, AsyncReader, AsyncWriter } from "std:io";
import { TcpListener, TcpStream } from "std:net";
import { Process } from "std:process";
import { delay, Task } from "std:task";
import { describe, it, expect } from "std:test";


function testBytesBasics(): void {
    let b = Bytes.alloc(5);
        expect(b.length).toBe(5);;

    b[0] = 72; // 'H'
    b[1] = 101; // 'e'
    b[2] = 108; // 'l'
    b[3] = 108; // 'l'
    b[4] = 111; // 'o'

        expect(b[0]).toBe(72);;
        expect(b[4]).toBe(111);;
        expect(b.toString()).toBe("Hello");;

    let sub = b.slice(0, 4);
        expect(sub.length).toBe(4);;
        expect(sub.toString()).toBe("Hell");;

    let hex = b.toHex();
        expect(hex).toBe("48656c6c6f");;

    let b64 = b.toBase64();
        expect(b64).toBe("SGVsbG8=");;

    // Test binary transparency: arbitrary non-UTF8 bytes with null byte
    let rawArr = [0x00, 0xFF, 0xFE, 0x80, 0x7F];
    let bin = Bytes.fromBytes(rawArr);
        expect(bin.length).toBe(5);;
        expect(bin[0]).toBe(0x00);;
        expect(bin[1]).toBe(0xFF);;
        expect(bin[2]).toBe(0xFE);;
        expect(bin[3]).toBe(0x80);;
        expect(bin[4]).toBe(0x7F);;

}

class MockChunkReader implements AsyncReader {
    chunks: Bytes[];
    idx: int = 0;

    constructor(chunks: Bytes[]) {
        this.chunks = chunks;
    }

    async read(size: int = 4096): Task<Bytes?> {
        if (this.idx >= this.chunks.length) {
            return null;
        }
        let chunk = this.chunks[this.idx];
        this.idx = this.idx + 1;
        return chunk;
    }
}

class MockChunkWriter implements AsyncWriter {
    received: Bytes[] = [];
    flushed: bool = false;

    async write(chunk: Bytes): Task<int> {
        this.received.push(chunk);
        return chunk.length;
    }

    async flush(): Task<void> {
        this.flushed = true;
    }

    close(): void {}
}
async function testStreamPipe(): Task<void> {
let chunk1 = Bytes.fromString("Chunk1_");
let chunk2 = Bytes.fromString("Chunk2_");
let chunk3 = Bytes.fromString("Chunk3");
let reader = new MockChunkReader([chunk1, chunk2, chunk3]);
let writer = new MockChunkWriter();
await Stream.pipe(reader, writer);
expect(writer.flushed).toBeTruthy();
expect(writer.received.length).toBe(3);
expect(writer.received[0].toString()).toBe("Chunk1_");
expect(writer.received[1].toString()).toBe("Chunk2_");
expect(writer.received[2].toString()).toBe("Chunk3");
}

async function testTcpBinaryRoundtrip(): Task<void> {
    let port = 19877;
    let proc = Process.spawn("target/debug/vn.exe", ["run", "tests/helpers/tcp_binary_echo_server.vn"]);
    await delay(150);
    let client = await TcpStream.connect("127.0.0.1", port);
    let original = Bytes.fromBytes([0x00, 0x01, 0xFF, 0xFE, 0x80, 0x7F, 0xAB, 0xCD]);
    await client.writeAll(original);
    let received = await client.read(1024);
    expect(received !== null).toBeTruthy();
    let recBytes = received as Bytes;
    expect(recBytes.length).toBe(8);
    expect(recBytes[0]).toBe(0x00);
    expect(recBytes[1]).toBe(0x01);
    expect(recBytes[2]).toBe(0xFF);
    expect(recBytes[3]).toBe(0xFE);
    expect(recBytes[4]).toBe(0x80);
    expect(recBytes[5]).toBe(0x7F);
    expect(recBytes[6]).toBe(0xAB);
    expect(recBytes[7]).toBe(0xCD);
    client.close();
    let exitInfo = proc.wait();
    expect(exitInfo.exitCode).toBe(0);
}

await describe("112 canonical bytes and streams", async () => {
    await it("bytes basics", async () => {
        testBytesBasics();
    });

    await it("stream pipe", async () => {
        await testStreamPipe();
    });

    await it("tcp binary roundtrip", async () => {
        await testTcpBinaryRoundtrip();
    });


});
