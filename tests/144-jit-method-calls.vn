// Method calls from a compiled body go through the runtime's one method
// call — the same resolution, inline cache and fast paths as the
// interpreter's `CallMethod`, with the arguments handed over as values
// instead of registers. Each function runs past the tiering threshold and has
// two statements, so it executes compiled instead of being inlined.

class McShape {
    side: int
    constructor(side: int) {
        this.side = side
    }
    area(): int {
        return this.side * this.side
    }
    scaled(k: int, extra: int): int {
        return this.area() * k + extra
    }
}

class McSquare extends McShape {
    constructor(side: int) {
        super(side)
    }
    override area(): int {
        return this.side * this.side + 1
    }
}

class McMath {
    static twice(x: int): int {
        return x * 2
    }
}

enum McToken {
    Word(text: str),
    Number(value: int)
}

// A VM method, a virtual override and a method calling a method.
function mcArea(s: McShape, k: int): int {
    const a = s.scaled(k, 3)
    return a
}

// `toString` on an int receiver.
function mcIntText(i: int): str {
    const t = i.toString()
    return t
}

// A static method on a class.
function mcStatic(i: int): int {
    const r = McMath.twice(i)
    return r
}

// An enum variant built through a method-call shape.
function mcVariant(i: int): McToken {
    const t = i % 2 == 0 ? McToken.Number(i) : McToken.Word("w" + i)
    return t
}

// `push` / `pop` on an array whose type is not known statically.
function mcDynArray(xs: dynamic, v: int): dynamic {
    xs.push(v)
    return xs.pop()
}

// A function-valued property called as a method.
function mcCallback(o: dynamic, x: int): dynamic {
    const r = o.apply(x)
    return r
}

// An exception thrown inside the called method reaches the caller's catch.
class McFailing {
    fail(i: int): int {
        if (i % 7 == 0) {
            throw new Error("seven")
        }
        return i
    }
}
function mcGuarded(f: McFailing, i: int): int {
    let r = 0
    try {
        r = f.fail(i)
    } catch (e) {
        r = -1
    }
    return r
}

let mArea = 0
let mText = 0
let mStatic = 0
let mNumbers = 0
let mWords = 0
let mDyn = 0
let mCb = 0
let mGuard = 0
const mcShape = new McShape(3)
const mcSquare = new McSquare(3)
const mcFailing = new McFailing()
const mcObj: dynamic = { apply: (x: int) => x + 100 }
const mcArr: dynamic = [1, 2]
for (let i = 0; i < 3000; i = i + 1) {
    mArea = mArea + mcArea(i % 2 == 0 ? mcShape : mcSquare, 2)
    mText = mText + mcIntText(i).length
    mStatic = mStatic + mcStatic(i)
    const tok = mcVariant(i)
    const num: int = match (tok) {
        Number(v) => v,
        Word(_) => 0
    }
    const wordLen: int = match (tok) {
        Number(_) => 0,
        Word(w) => w.length
    }
    mNumbers = mNumbers + num
    mWords = mWords + wordLen
    mDyn = mDyn + (mcDynArray(mcArr, i) as int)
    mCb = mCb + (mcCallback(mcObj, i) as int)
    mGuard = mGuard + mcGuarded(mcFailing, i)
}

// 9 * 2 + 3 = 21 for the shape, 10 * 2 + 3 = 23 for the square.
assert("VM methods and overrides", mArea === 1500 * 21 + 1500 * 23)
// Digits of 0..2999: 10 + 90 * 2 + 900 * 3 + 2000 * 4.
assert("toString on an int", mText === 10 + 180 + 2700 + 8000)
assert("a static method", mStatic === 2 * 4498500)
assert("enum variants built as calls", mNumbers === 2248500 && mWords === 1500 + (5 + 45 * 2 + 450 * 3 + 1000 * 4))
assert("push / pop on a dynamic array", mDyn === 4498500 && (mcArr as int[]).length === 2)
assert("a function-valued property", mCb === 4498500 + 300000)
// 429 multiples of 7 below 3000 (0 included) turn into -1.
assert("a throwing method reaches the caller's catch", mGuard === 4498500 - (7 * 428 * 429 / 2) - 429)

print("[PASSED] 144. JIT method calls")
