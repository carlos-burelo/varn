import { describe, it, expect } from "std:test";

function f2i(x: float): int { return x as int }
function i2f(x: int): float { return x as float }

function faultOf(f: () => int): str {
    try { f(); return "none" } catch (e) {
        if (e instanceof IntegerOverflow) { return "ovf" }
        return "other"
    }
}

const big: bigint = 42n
const huge: bigint = 99999999999999999999999n

const dec: decimal = 7.9d

const fromDyn: dynamic = 5
const fromDynF: dynamic = 5.7

let i = 0
let acc = 0

const bigF: bigint = 12345678901234567890n
function bigKind(f: () => bigint): str {
    try { f(); return "none" } catch (e) {
        if (e instanceof IntegerOverflow) { return "ovf" }
        return "other"
    }
}
const dynBig: dynamic = 5n
await describe("122 numeric conversions", async () => {
        await it("group 1 part 1", async () => {
        expect(f2i(3.9)).toBe(3);
        expect(f2i(0.0 - 3.9)).toBe(0 - 3);
        expect(i2f(2)).toBe(2.0);
        expect(i2f(9007199254740993)).toBe(9007199254740992.0);
        expect(faultOf(() => f2i(0.0 / 0.0))).toBe("ovf");
        expect(faultOf(() => f2i(1.0 / 0.0))).toBe("ovf");
        expect(faultOf(() => f2i(1e19))).toBe("ovf");
    });

    await it("group 1 part 2", async () => {
        expect((big as int)).toBe(42);
        expect(faultOf(() => huge as int)).toBe("ovf");
        expect((dec as int)).toBe(7);
        expect(typeof (fromDyn as float)).toBe("float");
        expect((fromDynF as int)).toBe(5);
        while (i < 500) { acc = acc + f2i(2.5); i = i + 1 }
        expect(acc).toBe(1000);
        expect((bigF as float)).toBe(12345678901234567000.0);
    });

    await it("group 1 part 3", async () => {
        expect(((2.9e20) as bigint)).toBe(290000000000000000000n);
        expect((2.5d as float)).toBe(2.5);
        expect(((0.5) as decimal)).toBe(0.5d);
        expect(((10n) as decimal)).toBe(10.0d);
        expect(((7.9d) as bigint)).toBe(7n);
        expect(bigKind(() => (0.0 / 0.0) as bigint)).toBe("ovf");
        expect((dynBig as float)).toBe(5.0);
    });


});
