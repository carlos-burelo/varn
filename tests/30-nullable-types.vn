import { describe, it, expect } from "std:test";

function identity(x: int?): int? {
    return x;
}
function first(arr: int?[]?): int? {
    if (arr === null) return null;
    if (arr.length === 0) return null;
    return arr[0];
}
function wrap(x: int): int[]? {
    if (x < 0) return null;
    return [x];
}
function matrix(flag: bool): int?[][]? {
    if (!flag) return null;
    return [[1, null], [null, 2]];
}

await describe("30 Nullable Types", async () => {
    await it("shapes", () => {
        const a: str? = null;
        const b: str? = "hello";
        const c: bool? = true;
        const d: int[] = [1, 2, 3];
        const e: str[] = ["a", "b"];
        const f: int?[] = [1, null, 3];
        const g: str?[] = [null, "x", null];
        const h: int[]? = null;
        const i: str[]? = ["a", "b"];
        const j: int?[]? = null;
        const k: int?[]? = [1, null, 3];
        const l: int[][] = [[1, 2], [3, 4]];
        const m: (int | null)[][] = [[1, null], [null, 4]];
        const n: int[][] | null = null;
        const o: int[][] | null = [[1, 2]];
        const p: (int | null)[][] | null = null;
        const q: (int | null)[][] | null = [[null, 1]];
        const r: Array<int | null> = [1, null, 2];
        const s: Array<int> | null = null;
        const t: Array<int> | null = [1, 2];
        const u: Array<str | null> | null = null;
        const v: Array<str | null> | null = [null, "x"];
        expect(a).toBe(null);
        expect(b).toBe("hello");
        expect(c).toBe(true);
        expect(d.length).toBe(3);
        expect(f[0]).toBe(1);
        expect(f[1]).toBe(null);
        expect(h).toBe(null);
        expect(i !== null).toBeTruthy();
        expect(l[0][0]).toBe(1);
    });

    await it("function signatures", () => {
        expect(identity(null)).toBe(null);
        expect(identity(42)).toBe(42);
        expect(first([])).toBe(null);
        expect(first([1, null, 3])).toBe(1);
        expect(wrap(-1)).toBe(null);
        expect(wrap(5) !== null).toBeTruthy();
        expect(matrix(false)).toBe(null);
        expect(matrix(true) !== null).toBeTruthy();
    });
});
