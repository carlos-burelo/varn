import { describe, it, expect } from "std:test";

type Pt = { x: int; y: int }
type Line = { from: Pt; to: Pt; width: int }
struct Money { amount: int; currency: str }

class Canvas {
    cursor: Pt = { x: 0, y: 0 }
    marks: Pt[] = [{ x: 1, y: 1 }, { x: 2, y: 2 }]
    move(dx: int): void { this.cursor.x += dx }
}

function shifted(p: Pt): Pt {
    let local = p
    local.x = local.x + 10
    return local
}

await describe("346 fields of a value are updated through their place", async () => {
    await it("assigning a field of a let record replaces the value and leaves every alias alone", () => {
        let a: Pt = { x: 1, y: 2 }
        const alias = a
        a.x = 5
        expect(a.x).toBe(5)
        expect(a.y).toBe(2)
        expect(alias.x).toBe(1)
    })

    await it("compound assignment and increments update a field", () => {
        let p: Pt = { x: 1, y: 2 }
        p.x += 4
        p.y *= 3
        expect(p.x).toBe(5)
        expect(p.y).toBe(6)
        p.x++
        ++p.y
        p.y--
        expect(p.x).toBe(6)
        expect(p.y).toBe(6)
        const before = p.x++
        expect(before).toBe(6)
        expect(p.x).toBe(7)
    })

    await it("the assignment is an expression with the assigned value", () => {
        let p: Pt = { x: 1, y: 2 }
        const got = (p.x = 9)
        expect(got).toBe(9)
        expect(p.x).toBe(9)
    })

    await it("nested records are rebuilt from the root", () => {
        let line: Line = { from: { x: 0, y: 0 }, to: { x: 1, y: 1 }, width: 2 }
        const original = line
        line.to.x = 8
        line.from.y = 3
        expect(line.to.x).toBe(8)
        expect(line.to.y).toBe(1)
        expect(line.from.y).toBe(3)
        expect(line.width).toBe(2)
        expect(original.to.x).toBe(1)
        expect(original.from.y).toBe(0)
    })

    await it("a record held in a class field is updated through the instance", () => {
        const canvas = new Canvas()
        canvas.cursor.x = 4
        canvas.move(3)
        expect(canvas.cursor.x).toBe(7)
        expect(canvas.cursor.y).toBe(0)
    })

    await it("a record inside an array element is updated through the element", () => {
        const canvas = new Canvas()
        canvas.marks[1].y = 9
        expect(canvas.marks[1].y).toBe(9)
        expect(canvas.marks[1].x).toBe(2)
        expect(canvas.marks[0].y).toBe(1)
    })

    await it("a parameter is a variable and its record is a copy", () => {
        const base: Pt = { x: 1, y: 2 }
        const moved = shifted(base)
        expect(moved.x).toBe(11)
        expect(base.x).toBe(1)
    })

    await it("a struct held in a let is updated the same way", () => {
        let price = new Money(5, "EUR")
        const snapshot = price
        price.amount = 8
        expect(price.amount).toBe(8)
        expect(price.currency).toBe("EUR")
        expect(snapshot.amount).toBe(5)
    })

    await it("a map keeps the record it was given when the variable changes", () => {
        let key: Pt = { x: 1, y: 1 }
        const seen = new Map<str, Pt>()
        seen.set("k", key)
        key.x = 99
        expect(seen.get("k")?.x).toBe(1)
    })
})
