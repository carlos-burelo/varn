import { TcpListener, TcpStream, connect, listen, isIP, isIPv4, isIPv6 } from "std:net";
import { HttpServer, Request, Response, HttpStatus, json, get, post, put, patch, del, fetch } from "std:http";
import { WebSocket, WebSocketReadyState } from "std:ws";
import { Process } from "std:process";
import { platform } from "std:sys";
import { delay, Task } from "std:task";
import { describe, it, expect } from "std:test";



function testNetIpUtils(): void {
        expect(isIP("127.0.0.1")).toBeTruthy();;
        expect(isIP("::1")).toBeTruthy();;
        expect(isIP("invalid-ip")).toBeFalsy();;

        expect(isIPv4("192.168.1.1")).toBeTruthy();;
        expect(isIPv4("::1")).toBeFalsy();;

        expect(isIPv6("::1")).toBeTruthy();;
        expect(isIPv6("fe80::1")).toBeTruthy();;
        expect(isIPv6("192.168.1.1")).toBeFalsy();;

}

function testHttpServerAndClientApis(): void {
    // 1. Response and HttpStatus
    let res = json({ message: "Success", code: 200 });
        expect(res.status).toBe(200);;
        expect(res.ok).toBeTruthy();;
        expect(res.statusText).toBe("OK");;
    let parsedJson: dynamic = res.json();
        expect(parsedJson.message).toBe("Success");;

    let errRes = new Response("boom", 404);
        expect(errRes.status).toBe(404);;
        expect(errRes.ok).toBeFalsy();;
        expect(errRes.statusText).toBe("Not Found");;

    // 2. HttpServer Routing & CORS
    let app = new HttpServer();
    app.cors("*", "GET,POST,PUT,DELETE,PATCH,OPTIONS");

    app.get("/api/items", (req: Request) => {
        return json([{ id: 1, name: "Item1" }]);
    });

    app.post("/api/items", (req: Request) => {
        return json({ created: true });
    });

    app.patch("/api/items/:id", (req: Request) => {
        return json({ updated: req.params["id"] });
    });

    app.delete("/api/items/:id", (req: Request) => {
        return json({ deleted: req.params["id"] });
    });

        expect(app !== null).toBeTruthy();;
        expect(app.port).toBe(0);;
        expect(app.isListening).toBeFalsy();;

    // 3. http client free helpers
        expect(typeof get).toBe("function");;
        expect(typeof post).toBe("function");;
        expect(typeof put).toBe("function");;
        expect(typeof patch).toBe("function");;
        expect(typeof del).toBe("function");;

}

function testWebSocket(): void {
        expect(WebSocketReadyState.Connecting as int).toBe(0);;
        expect(WebSocketReadyState.Open as int).toBe(1);;
        expect(WebSocketReadyState.Closing as int).toBe(2);;
        expect(WebSocketReadyState.Closed as int).toBe(3);;

        expect(typeof WebSocket === "class").toBeTruthy();;

}
let testPort = 19876;
let vnBin = platform() == "windows" ? "target/debug/vn.exe" : "target/debug/vn";
let proc = Process.spawn(vnBin, ["run", "tests/helpers/tcp_echo_server.vn"]);

async function main(): Task<void> {
    testNetIpUtils();
    testHttpServerAndClientApis();
    testWebSocket();
}

await describe("111 network apis overhaul", async () => {

    await it("Give child process a small moment to start listening", async () => {
        let attempts = 0;
        let ok = false;
        while (!ok && attempts < 25) {
            attempts = attempts + 1;
            try {
                let clientSock = await TcpStream.connect("127.0.0.1", testPort);
                expect(clientSock.isOpen).toBeTruthy();
                expect(clientSock.remoteHost).toBe("127.0.0.1");
                expect(clientSock.remotePort).toBe(testPort);
                await clientSock.writeAll("varn_test\n");
                let echoMsg = await clientSock.readText();
                expect(echoMsg.trim()).toBe("ECHO:varn_test");
                clientSock.close();
                ok = true;
            } catch (e) {
                await delay(200);
            }
        }
        expect(ok).toBeTruthy();
        expect(proc.kill()).toBeTruthy();
    });

    await it("network apis main flow", async () => {
        await main();
    });
});