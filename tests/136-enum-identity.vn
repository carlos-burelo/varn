import { Shade as ShadeA } from "./helpers/shade-a.vn";
import { Shade as ShadeB } from "./helpers/shade-b.vn";
import { describe, it, expect } from "std:test";

// An enum value belongs to the enum that declared it, not to its name: two
// modules declaring `Shade`, and a local `Result`, never trade methods or
// compare equal.

enum Result<T, E> {
    Good(value: T),
    Bad(error: E)
}

const a = ShadeA.Light;
const b = ShadeB.Light;

// A local enum sharing the name, variants in the other order: a match on
// the imported value must use the imported enum's tags.
enum Shade { Dark, Light }

await describe("136 enum identity", async () => {
        await it("group 1 part 1", async () => {
        expect(a.label() == "a").toBeTruthy();
        expect(b.label() == "b").toBeTruthy();
        expect((a as dynamic) != (b as dynamic)).toBeTruthy();
        expect(a == ShadeA.Light).toBeTruthy();
    });

    await it("enum tag matching", async () => {
        const which = match (a) {
            Light => "light",
            Dark => "dark"
        };
        expect(which).toBe("light");
        expect(match (Shade.Light) { Dark => 0, Light => 1 }).toBe(1);
    });

    await it("local result and option", async () => {
        const local = Result.Good(1);
        const matched = match (local) {
            Good(v) => v,
            Bad(_) => 0
        };
        const core: Option<int> = Some(2);
        expect(matched).toBe(1);
        expect(core.unwrapOr(0)).toBe(2);
    });


});
