import { describe, it, expect } from "std:test";
import { fontCount, fonts, shape, measure, ascent, descent, wrap } from "std:ui/text";

await describe("216 text shaping", async () => {
    await it("system fonts discovered", () => {
        expect(fontCount() > 0).toBe(true);
        expect(fonts().length).toBe(fontCount());
    });

    await it("ascii shapes one glyph per char", () => {
        const r = shape("hola", 16.0);
        expect(r.count).toBe(4);
        expect(r.glyphs.length).toBe(4);
        expect(r.advances.length).toBe(4);
        expect(r.clusters).toEqual([0, 1, 2, 3]);
        expect(r.width > 0.0).toBe(true);
    });

    await it("shaping is deterministic", () => {
        const a = shape("hola mundo", 16.0);
        const b = shape("hola mundo", 16.0);
        expect(a.glyphs).toEqual(b.glyphs);
        expect(a.width).toBe(b.width);
        expect(measure("hola mundo", 16.0)).toBe(a.width);
    });

    await it("empty shapes empty", () => {
        const r = shape("", 16.0);
        expect(r.count).toBe(0);
        expect(r.width).toBe(0.0);
    });

    await it("bad size throws", () => {
        let failed = false;
        try {
            shape("hola", 0.0);
        } catch (e) {
            failed = true;
        }
        expect(failed).toBe(true);
    });

    await it("metrics are positive and deterministic", () => {
        const a = ascent(22.0);
        const d = descent(22.0);
        expect(a > 0.0).toBe(true);
        expect(d > 0.0).toBe(true);
        expect(ascent(22.0)).toBe(a);
        expect(descent(22.0)).toBe(d);
        expect(ascent(32.0) > a).toBe(true);
        let failed = false;
        try {
            ascent(0.0);
        } catch (e) {
            failed = true;
        }
        expect(failed).toBe(true);
        failed = false;
        try {
            descent(-1.0);
        } catch (e) {
            failed = true;
        }
        expect(failed).toBe(true);
    });

    await it("wrap respects max width", () => {        const ls = wrap("hola mundo desde varn", 16.0, 80.0);
        expect(ls.length > 1).toBe(true);
        for (let i = 0; i < ls.length; i = i + 1) {
            expect(measure(ls[i], 16.0) <= 80.0).toBe(true);
        }
        expect(wrap("", 16.0, 80.0)).toEqual([]);
        let failed = false;
        try {
            wrap("hola", 16.0, 0.0);
        } catch (e) {
            failed = true;
        }
        expect(failed).toBe(true);
    });
});
