// Operators whose operands no type proves native — `dynamic` values, `str`
// equality — run the runtime's generic operator in a compiled body, exactly
// as the interpreter runs them. Each function runs past the tiering
// threshold, so it executes compiled; each has two statements, so the
// compiler does not inline it into its caller instead.

function dynArith(a: dynamic, b: dynamic): dynamic {
    const r = a * 2 + b - 1
    return r
}

function dynCompare(a: dynamic, b: dynamic): int {
    let n = 0
    if (a == b) { n = n + 1 }
    if (a != b) { n = n + 10 }
    if (a < b) { n = n + 100 }
    if (a >= b) { n = n + 1000 }
    return n
}

function strEquals(a: str, b: str): bool {
    const r = a == b
    return r
}

function dynBits(a: dynamic, b: dynamic): dynamic {
    const r = (a & b) | (a ^ 1) | (b << 2)
    return r
}

// `!` of a value that is not a `bool` is truthiness, not a bit flip.
function dynNot(a: dynamic): bool {
    const r = !a
    return r
}

// Also on a typed `int`: `!2` is `false`, not `2 ^ 1`.
function intNot(a: int): bool {
    const r = !a
    return r
}

function dynNegate(a: dynamic): dynamic {
    const r = -a
    return r
}

function dynInvert(a: dynamic): dynamic {
    const r = ~a
    return r
}

// A dynamic sum returned through an `int` return type.
function dynAsInt(a: dynamic): int {
    const r = a + 1
    return r
}

class DynShape {
    size: int
    constructor(size: int) {
        this.size = size
    }
    grow(): int {
        return this.size + 1
    }
}

function dynIs(x: dynamic): bool {
    const r = x instanceof DynShape
    return r
}

// `in`, in a body that also calls a method (the lowering from bytecode).
function dynHasKey(o: dynamic, key: str, s: DynShape): int {
    let n = s.grow()
    if (key in o) { n = n + 100 }
    return n
}

let dArith = 0
let dCompare = 0
let dStr = 0
let dBits = 0
let dNot = 0
let dIntNot = 0
let dNeg = 0
let dInv = 0
let dInt = 0
let dIs = 0
let dIn = 0
const dShape = new DynShape(4)
const dObj: dynamic = { alpha: 1 }
for (let i = 0; i < 3000; i = i + 1) {
    dArith = dArith + (dynArith(i, 3) as int)
    dCompare = dCompare + dynCompare(i % 3, 1)
    if (strEquals("key-" + (i % 2), "key-0")) { dStr = dStr + 1 }
    dBits = dBits + (dynBits(i % 8, 3) as int)
    if (dynNot(i % 3)) { dNot = dNot + 1 }
    if (intNot(i % 3)) { dIntNot = dIntNot + 1 }
    dNeg = dNeg + (dynNegate(i) as int)
    dInv = dInv + (dynInvert(i) as int)
    dInt = dInt + dynAsInt(i)
    if (dynIs(i % 2 == 0 ? dShape : dObj)) { dIs = dIs + 1 }
    dIn = dIn + dynHasKey(dObj, i % 2 == 0 ? "alpha" : "beta", dShape)
}

// Sum over i of 2i + 3 - 1 = 2 * 4498500 + 2 * 3000.
assert("dynamic arithmetic", dArith === 2 * 4498500 + 6000)
// i % 3 = 0, 1, 2 against 1: (!=, <) = 110, (==, >=) = 1001, (!=, >=) = 1010.
assert("dynamic comparisons", dCompare === 1000 * (110 + 1001 + 1010))
assert("str equality", dStr === 1500)
assert("dynamic bitwise", dBits === 375 * ((0 & 3 | 0 ^ 1 | 12) + (1 & 3 | 1 ^ 1 | 12) + (2 & 3 | 2 ^ 1 | 12) + (3 & 3 | 3 ^ 1 | 12) + (4 & 3 | 4 ^ 1 | 12) + (5 & 3 | 5 ^ 1 | 12) + (6 & 3 | 6 ^ 1 | 12) + (7 & 3 | 7 ^ 1 | 12)))
assert("! of a non-bool is truthiness", dNot === 1000)
assert("! of an int is truthiness", dIntNot === 1000)
assert("dynamic negation", dNeg === -4498500)
assert("dynamic bitwise not", dInv === -4498500 - 3000)
assert("a dynamic sum returned as int", dInt === 4498500 + 3000)
assert("instanceof on a dynamic value", dIs === 1500)
assert("in, compiled from bytecode", dIn === 3000 * 5 + 1500 * 100)

print("[PASSED] 142. JIT dynamic operators")
