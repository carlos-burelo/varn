import { describe, it, expect } from "std:test";

function strEquals(a: str, b: str): bool {
    const r = sameValue(a, b)
    return r
}

function intNot(a: int?): bool {
    const r = !a
    return r
}

class DynShape {
    size: int
    constructor(size: int) {
        this.size = size
    }
}

function dynIs(x: dynamic): bool {
    const r = x is DynShape
    return r
}

let dStr = 0
let dIntNot = 0
let dIs = 0
const dShape = new DynShape(4)
const dObj: dynamic = { alpha: 1 }

await describe("142 jit operators beyond native types", async () => {
    await it("str equality, int? negation and is on a dynamic run compiled", async () => {
        for (let i = 0; i < 3000; i = i + 1) {
            if (strEquals(`key-${(i % 2)}`, "key-0")) { dStr = dStr + 1 }
            if (intNot(i % 3 == 0 ? null : i % 3)) { dIntNot = dIntNot + 1 }
            if (dynIs(i % 2 == 0 ? dShape : dObj)) { dIs = dIs + 1 }
        }
        expect(dStr).toBe(1500);
        expect(dIntNot).toBe(1000);
        expect(dIs).toBe(1500);
    });
});
