class Point { x: int; constructor(x: int) { this.x = x } }
const p1 = new Point(1)
const p2 = new Point(1)
assert("class == is identity", p1 == p1 && !(p1 == p2))

const o1 = { x: 1 }
const alias = o1
assert("object == is identity", o1 == alias && !(o1 == { x: 1 }))

const r1 = #{ p: #{ x: 1 }, t: #[1, #[2, 3]] }
const r2 = #{ p: #{ x: 1 }, t: #[1, #[2, 3]] }
assert("record == is deep structural", r1 == r2)
assert("record === has no identity either", r1 === r2)
assert("record differs by value", !(#{ x: 1 } == #{ x: 2 }))
assert("tuple == structural", #[1, "a"] == #[1, "a"] && !(#[1, 2] == #[1, 3]))

assert("a nested array compares by elements", #{ a: [1, [2]] } == #{ a: [1, [2]] })
assert("a nested array that differs is unequal", !(#{ a: [1] } == #{ a: [2] }))
assert("a top-level array is compared by identity", !([1] == [1]))

enum Shape { Circle(float), Rect(float, float), Unit }
assert("variant with equal payload", Shape.Circle(1.0) == Shape.Circle(1.0))
assert("variant with different payload", !(Shape.Circle(1.0) == Shape.Circle(2.0)))
assert("multi-field payload", Shape.Rect(1.0, 2.0) == Shape.Rect(1.0, 2.0) && !(Shape.Rect(1.0, 2.0) == Shape.Rect(2.0, 1.0)))
assert("different variants", !(Shape.Circle(1.0) == Shape.Unit))

print("[PASSED] 131. Object / Record / Class equality")
