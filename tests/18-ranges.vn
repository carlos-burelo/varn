import { describe, it, expect } from "std:test";

await describe("18 Ranges", async () => {
    await it("bounds", () => {
        const r1 = 0..5;
        const r2 = 1..=5;
        expect(r1.start).toBe(0);
        expect(r1.end).toBe(5);
        expect(r1.length).toBe(5);
        expect(r2.length).toBe(5);
        expect(r1.contains(3)).toBeTruthy();
        expect(!r1.contains(5)).toBeTruthy();
        expect(r2.contains(5)).toBeTruthy();
    });

    await it("conversion", () => {
        const arr2 = (0..4).toArray();
        expect(arr2.length).toBe(4);
        expect(arr2[0]).toBe(0);
        expect(arr2[3]).toBe(3);
        const stepped = (0..10).step(3);
        expect(stepped.length).toBe(4);
        expect(stepped[1]).toBe(3);
        expect(stepped.toArray().join(",")).toBe("0,3,6,9");
    });

    await it("iteration and from", () => {
        let rangeSum = 0;
        for (const i of 1..=10) {
            rangeSum = rangeSum + i;
        }
        expect(rangeSum).toBe(55);
        const r3 = Range.from(5, 10);
        expect(r3.start).toBe(5);
        expect(r3.end).toBe(10);
    });
});
