import { describe, it, expect } from "std:test";
import { sleep, TaskGroup, spawn, parallel } from "std:task";

async function asyncAdd(a: int, b: int): int {
    return a + b;
}
async function asyncChain(): str {
    const x = await asyncAdd(3, 4);
    const y = await asyncAdd(x, 10);
    return `result=${y}`;
}
async function asyncError(): str {
    try {
        throw new Error("async fail");
    } catch (e) {
        return "caught:" + e.message;
    }
}
async function asyncBoom(): int {
    throw new Error("boom");
}
async function asyncSquare(n: int): int {
    return n * n;
}
async function runAsync(): void {
    const r1 = await asyncAdd(5, 6);
    expect(r1).toBe(11);
    const r2 = await asyncChain();
    expect(r2).toBe("result=17");
    const r3 = await asyncError();
    expect(r3).toBe("caught:async fail");
    const h1 = spawn(asyncAdd(1, 2));
    expect(await h1).toBe(3);
    const all = await parallel([
        asyncSquare(2),
        asyncSquare(3),
        asyncSquare(4),
    ]);
    expect(all.length).toBe(3);
    expect(all[0]).toBe(4);
    expect(all[1]).toBe(9);
    expect(all[2]).toBe(16);
    using group = new TaskGroup<int>();
    const g1 = group.spawn(asyncAdd(7, 8));
    const g2 = group.spawn(asyncAdd(9, 10));
    const joined = await group.join();
    expect(joined.length).toBe(2);
    expect(joined[0]).toBe(15);
    expect(joined[1]).toBe(19);
    expect(await g1).toBe(15);
    expect(await g2).toBe(19);
    using failGroup = new TaskGroup<int>();
    failGroup.spawn(asyncAdd(2, 3));
    failGroup.spawn(asyncBoom());
    let joinThrew = false;
    try {
        await failGroup.join();
    } catch (e) {
        joinThrew = true;
    }
    expect(joinThrew).toBeTruthy();
    using cancelGroup = new TaskGroup<int>();
    const c1 = cancelGroup.spawn(asyncAdd(10, 20));
    cancelGroup.cancel();
    let cancelThrew = false;
    try {
        await c1;
    } catch (e) {
        cancelThrew = true;
    }
    expect(cancelThrew).toBeTruthy();
    using disposeGroup = new TaskGroup<int>();
    const d1 = disposeGroup.spawn(asyncAdd(30, 40));
    await disposeGroup.disposeAsync();
    let disposeThrew = false;
    try {
        await d1;
    } catch (e) {
        disposeThrew = true;
    }
    expect(disposeThrew).toBeTruthy();
}

await describe("21 Async", async () => {
    await it("async runtime", async () => {
        await runAsync();
    });
});
