// Tipos numéricos angostos (i8/i16/i32/u8/u16/u32/f32): distintos de
// int/float, exigen cast explícito para cruzar anchos, y ese cast verifica
// rango real (panic si no cabe, igual que `int` ya hace con su propio
// desbordamiento). La aritmética entre enteros SIEMPRE ensancha a `int`
// (`checker/binder/type_inference.rs::numeric_binary_type` trata todos los
// anchos enteros como una sola categoría a propósito) — angostar el
// resultado de vuelta exige el mismo cast explícito, que es donde vive el
// chequeo de rango real.
function addI8(a: i8, b: i8): i8 { return (a + b) as i8 }
assert("i8: suma en rango vuelve a angostar con cast", addI8(50 as i8, 20 as i8) === 70)

function subU8(a: u8, b: u8): u8 { return (a - b) as u8 }
assert("u8: resta en rango", subU8(200 as u8, 50 as u8) === 150)

let okI32: i32 = 2000000000 as i32
assert("i32: cast en rango preserva el valor", okI32 === 2000000000)

let smallU16: u16 = 500 as u16
assert("u16: cast en rango", smallU16 === 500)

let f: f32 = 3.5 as f32
assert("f32: cast en rango preserva el valor", f === 3.5)

// Unario `-` PRESERVA el tipo angosto en el checker (a diferencia de la
// aritmética binaria) — un `-i8::MIN` real se sale de rango sin pasar por
// ningún cast intermedio.
let fifty: i8 = 50 as i8
assert("i8: negacion en rango", -fifty === -50)

// Literal directo en la posición angosta: se infiere sin cast (es una
// constante conocida en compilación, igual que `let x: float = 5` hoy).
let literalI32: i32 = 300
assert("i32: literal directo sin cast", literalI32 === 300)
let literalU8: u8 = 5
assert("u8: literal directo sin cast", literalU8 === 5)

print("[PASSED] 107. Narrow numeric types")
