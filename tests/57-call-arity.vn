import { describe, it, expect } from "std:test";


// Cross-function call arity, from compiled and from interpreted code.
//
// The regression this pins: the CLIF `Call` lowering handed its arguments to
// `clif_call_fallback` as four flat C parameters while declaring the real
// argument count separately. Since the count includes the callee/receiver
// slot, any call with FOUR OR MORE real parameters staged too few values and
// `prepare_call` then read the callee's frame one slot low — silently, with
// no error. `f4(1,2,3,4)` returned 123 instead of 1234 and `f6(...)` returned
// 230123 instead of 123456. `VARN_NO_JIT=1` was correct throughout, so only a
// compiled caller exposed it.
//
// Arguments now travel through the caller's flushed register window, which
// has no arity ceiling. The asserts run twice: once at module top level and
// once from inside `driver`, so the same calls are exercised from both a
// compiled and an interpreted caller regardless of which tier each lands in.

function arity1(a: int): int { return a }
function arity2(a: int, b: int): int { return a * 10 + b }
function arity3(a: int, b: int, c: int): int { return a * 100 + b * 10 + c }
function arity4(a: int, b: int, c: int, d: int): int {
    return a * 1000 + b * 100 + c * 10 + d
}
function arity5(a: int, b: int, c: int, d: int, e: int): int {
    return a * 10000 + b * 1000 + c * 100 + d * 10 + e
}
function arity6(a: int, b: int, c: int, d: int, e: int, f: int): int {
    return a * 100000 + b * 10000 + c * 1000 + d * 100 + e * 10 + f
}
function arity8(a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int): int {
    return a * 10000000 + b * 1000000 + c * 100000 + d * 10000
         + e * 1000 + f * 100 + g * 10 + h
}

// Mixed parameter kinds: only `int` params travel unboxed to the direct
// entry, so a signature that mixes them exercises both staging paths.
function mixed(a: int, b: str, c: float, d: bool, e: int): str {
    let flag = "f"
    if (d) {
        flag = "t"
    }
    return a.toString() + b + c.toString() + flag + e.toString()
}

function checkAll(where: str) {
    expect(arity1(7)).toBe(7)
    expect(arity2(1, 2)).toBe(12)
    expect(arity3(1, 2, 3)).toBe(123)
    expect(arity4(1, 2, 3, 4)).toBe(1234)
    expect(arity5(1, 2, 3, 4, 5)).toBe(12345)
    expect(arity6(1, 2, 3, 4, 5, 6)).toBe(123456)
    expect(arity8(1, 2, 3, 4, 5, 6, 7, 8)).toBe(12345678)
    expect(mixed(1, "x", 2.5, true, 9)).toBe("1x2.5t9")
}

// Run the same calls in a loop so the caller crosses the tiering threshold and
// the later iterations execute compiled.
function driver(n: int): int {
    let acc = 0
    for (let i = 0; i < n; i = i + 1) {
        acc = acc + arity3(1, 2, 3)
        acc = acc + arity4(1, 2, 3, 4)
        acc = acc + arity5(1, 2, 3, 4, 5)
        acc = acc + arity6(1, 2, 3, 4, 5, 6)
        acc = acc + arity8(1, 2, 3, 4, 5, 6, 7, 8)
    }
    return acc
}
await describe("57 call arity", async () => {
    await it("tests", async () => {
        
        checkAll("top level")
        
        // 123 + 1234 + 12345 + 123456 + 12345678 = 12482836 per iteration.
        expect(driver(1)).toBe(12482836)
        expect(driver(64)).toBe(12482836 * 64)
        
        checkAll("after tiering")
        
    });
});
