import { describe, it, expect } from "std:test";



// --- NOT promotable: read by a top-level function --------------------------
let readByFunction = 41
function readsIt(): int {
    return readByFunction + 1
}

// --- NOT promotable: written by a top-level function -----------------------
let writtenByFunction = 0
function writesIt(): int {
    writtenByFunction = writtenByFunction + 5
    return writtenByFunction
}

// --- NOT promotable: touched from class bodies -----------------------------
let ctorRuns = 0
let getterRuns = 0
let setterRuns = 0
let methodRuns = 0
let staticRuns = 0

class Touches {
    value: int
    constructor(v: int) {
        ctorRuns = ctorRuns + 1
        this.value = v
    }
    get doubled(): int {
        getterRuns = getterRuns + 1
        return this.value * 2
    }
    set doubled(v: int) {
        setterRuns = setterRuns + 1
        this.value = v
    }
    bump(): int {
        methodRuns = methodRuns + 1
        return this.value + 1
    }
    static make(): int {
        staticRuns = staticRuns + 1
        return 1
    }
}
await describe("68 module locals", async () => {
    await it("tests", async () => {
        // Promotion of module-private top-level `let`/`const` to `<module>` registers
        // (`varn-opt/src/hir/module_locals.rs`).
        //
        // This file is about the cases that must NOT be promoted. A binding is only
        // safe as a register when every read happens in the module's own frame:
        // top-level functions are lowered with a fresh `Scope`, and closures, classes
        // and enums read globals directly rather than capturing them, so any of those
        // naming a binding keeps it a global. Promoting one anyway does not crash —
        // the read simply finds nothing — which is exactly why it needs pinning.
        //
        // The getter case below is not hypothetical: the first cut of the pass walked
        // only `HirClass::methods` and missed `getters`, promoting a global a getter
        // wrote. `tests/60-dce-purity.vn` caught it.
        
        // --- promotable: read and written only by top-level code -------------------
        let counter = 0
        let total = 0
        for (let i = 0; i < 1000; i = i + 1) {
            counter = counter + 1
            total = total + i
        }
        expect(counter).toBe(1000)
        expect(total).toBe(499500)
        expect(readsIt()).toBe(42)
        writesIt()
        writesIt()
        expect(writtenByFunction).toBe(10)
        
        // --- NOT promotable: captured by a closure ---------------------------------
        let readByClosure = 7
        let closure = (): int => readByClosure * 2
        expect(closure()).toBe(14)
        
        let t = Touches(21)
        expect(ctorRuns).toBe(1)
        expect(t.doubled).toBe(42)
        expect(getterRuns).toBe(1)
        t.doubled = 10
        expect(setterRuns).toBe(1)
        expect(t.value).toBe(10)
        expect(t.bump()).toBe(11)
        expect(methodRuns).toBe(1)
        Touches.make()
        expect(staticRuns).toBe(1)
        
        // --- a promotable binding living alongside all of the above ----------------
        let alsoPromotable = 0
        let j = 0
        while (j < 100) {
            alsoPromotable = alsoPromotable + 2
            j = j + 1
        }
        expect(alsoPromotable).toBe(200)
        
        
    });
});
