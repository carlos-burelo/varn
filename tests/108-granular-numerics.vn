// Test granular numeric types and static widening
let b: i8 = 42;
let s: i16 = 1000;
let w: i32 = 100000;
let ub: u8 = 255;
let us: u16 = 65535;
let uw: u32 = 4000000000;
let ul: u64 = 9000000000000000000;
let f: f32 = 3.14;

// Widening to canonical int
let canonical_int: int = b;
assert("i8 widens to int", canonical_int == 42);

let canonical_int2: int = w;
assert("i32 widens to int", canonical_int2 == 100000);

let canonical_int3: int = ub;
assert("u8 widens to int", canonical_int3 == 255);

// Widening to canonical float
let canonical_float: float = f;
assert("f32 widens to float", canonical_float > 3.13 && canonical_float < 3.15);

let int_to_float: float = b;
assert("i8 widens to float", int_to_float == 42.0);

// Arithmetic widening
let sum = b + s;
assert("arithmetic result is correct", sum == 1042);
print("GRANULAR NUMERICS PASSED");
