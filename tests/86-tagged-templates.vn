import { Database } from "std:sqlite";
import { describe, it, expect } from "std:test";

// Test Suite 86: Tagged Template Functions End-to-End

function customTag(strings: str[], ...values: dynamic[]): str {
    let res = "";
    for (let i = 0; i < strings.length; i = i + 1) {
        res = res + strings[i];
        if (i < values.length) {
            res = res + "[" + values[i] + "]";
        }
    }
    return res;
}

class Formatter {
    prefix: str = ">> ";

    format(strings: str[], ...values: dynamic[]): str {
        let res = this.prefix;
        for (let i = 0; i < strings.length; i = i + 1) {
            res = res + strings[i];
            if (i < values.length) {
                res = res + values[i];
            }
        }
        return res;
    }
}
await describe("86 tagged templates", async () => {
        await it("Free-function tagged template", async () => {
        let name = "Varn";
        let version = 1;
        let output = customTag`Language: ${name}, Version: ${version}!`;
        expect(output).toBe("Language: [Varn], Version: [1]!");

        let rawOnly = customTag`No interpolations here.`;
        expect(rawOnly).toBe("No interpolations here.");
        });
        await it("Class-method tagged template", async () => {
        let fmt = new Formatter();
        let user = "Alice";
        let score = 95;
        let formatted = fmt.format`Player ${user} scored ${score} points`;
        expect(formatted).toBe(">> Player Alice scored 95 points");
        });
        await it("Safe SQL parameterized queries with db.sql and db.sqlOne", async () => {
        let db = new Database(":memory:");
        db.exec("CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, role TEXT, active INTEGER);");
        db.exec("INSERT INTO users VALUES (1, 'Alice', 'admin', 1);");
        db.exec("INSERT INTO users VALUES (2, 'Bob', 'editor', 1);");
        db.exec("INSERT INTO users VALUES (3, 'Charlie', 'viewer', 0);");
        let targetRole = "admin";
        let isActive = 1;
        let rows = db.sql`SELECT id, name, role FROM users WHERE role = ${targetRole} AND active = ${isActive};`;
        expect(rows.length).toBe(1);
        expect(rows[0]["name"]).toBe("Alice");
        expect(rows[0]["id"]).toBe(1);
        let targetId = 2;
        let singleUser = db.sqlOne`SELECT id, name, role FROM users WHERE id = ${targetId};`;
        expect(singleUser !== null).toBe(true);
        if (singleUser !== null) {
        expect(singleUser["name"]).toBe("Bob");
        expect(singleUser["role"]).toBe("editor");
        }
        db.close();
        });
        

});
