import { describe, it, expect } from "std:test";

function outcome(f: () => void): str {
    try {
        f()
        return "ok"
    } catch (e) {
        if (e is TypeError) { return e.message }
        return "other: " + e.message
    }
}

function total(label: str, ...xs: int[]): int {
    let t = 0
    for (const x of xs) { t = t + x }
    return t
}
function letter(c: char): char { return c }
class Point {
    constructor(public a: int, public b: str) {}
    shift(a: int, ...rest: str[]): int { return a + rest.length }
}

const five: dynamic = 5
const word: dynamic = "w"
const nums: dynamic = [1, 2, 3]
const mixed: dynamic = [1, "two"]

await describe("170 dynamic boundary: arguments", async () => {
    await it("a rest parameter takes an explicitly converted argument", () => {
        expect(total("s", 1, 2)).toBe(3)
        expect(total("s", five as int)).toBe(5)
        expect(outcome(() => { total("s", word as int) })).toBe("other: convert: value is not numeric")
        expect(outcome(() => { total("s", 1, word as int) })).toBe("other: convert: value is not numeric")
    })

    await it("a spread array is cast to its element type first", () => {
        expect(total("s", ...(nums as int[]))).toBe(6)
        expect(outcome(() => { total("s", ...(mixed as int[])) })).toBe("type mismatch: expected 'int[]', got 'Array'")
    })

    await it("methods take a cast spread too", () => {
        const p = new Point(1, "a")
        const tail: dynamic = ["a", "b"]
        const badTail: dynamic = ["a", 2]
        expect(p.shift(1, ...(tail as str[]))).toBe(3)
        expect(outcome(() => { p.shift(1, ...(badTail as str[])) })).toBe("type mismatch: expected 'str[]', got 'Array'")
    })

    await it("a typed spread needs no cast", () => {
        const typed: int[] = [4, 5]
        expect(total("s", ...typed)).toBe(9)
    })

    await it("char is checked like the other scalars", () => {
        const z: dynamic = 'z'
        expect(letter(z as char)).toBe('z')
        expect(outcome(() => { letter(five as char) })).toBe("type mismatch: expected 'char', got 'int'")
    })

    await it("holds in a hot loop", () => {
        let n = 0
        for (let i = 0; i < 5000; i = i + 1) { n = n + total("s", ...(nums as int[])) }
        expect(n).toBe(30000)
    })
})
