import { describe, it, expect } from "std:test";

function takeBracket(arr: str[]): int { return arr.length; }
function takeGeneric(arr: Array<str>): int { return arr.length; }

await describe("05 Arrays", async () => {
    await it("basics", () => {
        const nums = [3, 1, 4, 1, 5, 9, 2, 6];
        const strs = ["banana", "apple", "cherry"];
        expect(nums.length).toBe(8);
        expect(nums.indexOf(5)).toBe(4);
        expect(nums.indexOf(99)).toBe(-1);
        expect(nums.includes(9)).toBeTruthy();
        expect(!nums.includes(99)).toBeTruthy();
        expect(nums.slice(2, 5).length).toBe(3);
        expect(nums.slice(0, 3)[0]).toBe(3);
        expect([1, 2].concat([3, 4]).length).toBe(4);
        expect([1, 2, 3].join("-")).toBe("1-2-3");
        expect([1, 2, 3].join()).toBe("1,2,3");
    });

    await it("higher-order methods", () => {
        const nums = [3, 1, 4, 1, 5, 9, 2, 6];
        const doubled = nums.map((n) => n * 2);
        expect(doubled.length).toBe(8);
        expect(doubled[0]).toBe(6);
        const evens = nums.filter((n) => n % 2 === 0);
        expect(evens.length).toBe(3);
        const sum = nums.reduce((acc, n) => acc + n, 0);
        expect(sum).toBe(31);
        const found = nums.find((n) => n > 5);
        expect(found).toBe(9);
        const fi = nums.findIndex((n) => n > 5);
        expect(fi).toBe(5);
        expect(nums.some((n) => n > 8)).toBeTruthy();
        expect(!nums.some((n) => n > 100)).toBeTruthy();
        expect([2, 4, 6].every((n) => n % 2 === 0)).toBeTruthy();
        expect(![2, 4, 5].every((n) => n % 2 === 0)).toBeTruthy();
    });

    await it("mutation and structure", () => {
        const strs = ["banana", "apple", "cherry"];
        const sorted = strs.sort();
        expect(sorted[0]).toBe("apple");
        const rev = [1, 2, 3].reverse();
        expect(rev[0]).toBe(3);
        const flat = [[1, 2], [3, 4]].flat();
        expect(flat.length).toBe(4);
        expect(flat[2]).toBe(3);
        const fm = [[1, 2], [3]].flatMap((a) => a);
        expect(fm.length).toBe(3);
        let counter = 0;
        [10, 20, 30].forEach((n) => { counter = counter + n; });
        expect(counter).toBe(60);
        const mut = [1, 2, 3];
        mut.push(4);
        expect(mut.length).toBe(4);
        expect(mut[3]).toBe(4);
        const popped = mut.pop();
        expect(popped).toBe(4);
        expect(mut.length).toBe(3);
        const spread = [...[1, 2], ...[3, 4]];
        expect(spread.length).toBe(4);
        expect(spread[2]).toBe(3);
    });

    await it("generic and bracket identity", () => {
        let explicitGeneric: Array<int> = [10, 20, 30];
        let explicitBracket: int[] = explicitGeneric;
        let crossGeneric: Array<int> = explicitBracket;
        expect(explicitBracket.length === 3 && explicitBracket[1] === 20).toBeTruthy();
        expect(crossGeneric.length === 3 && crossGeneric[2] === 30).toBeTruthy();
        let strGenericList: Array<str> = ["a", "b", "c"];
        let strBracketList: str[] = ["x", "y", "z"];
        expect(takeBracket(strGenericList)).toBe(3);
        expect(takeGeneric(strBracketList)).toBe(3);
        let nestedGen: Array<Array<int>> = [[1, 2], [3, 4]];
        let nestedBrk: int[][] = nestedGen;
        expect(nestedBrk[1][0]).toBe(3);
    });
});
