import { describe, it, expect } from "std:test";

const byId: Map<int, str> = new Map()

const big: Map<bigint, int> = new Map()

const flags: Map<bool, str> = new Map()

const letters: Map<char, int> = new Map()
letters.set('a', 1)

let keySum = 0
const counts: Map<int, int> = new Map()

const index: { [key: str]: int } = { a: 1 }
await describe("129 map generic keys", async () => {
        await it("group 1 part 1", async () => {
        byId.set(1, "one")
        byId.set(2, "two")
        expect(byId.get(1) === "one" && byId.get(3)).toBe(null);
        expect(byId.has(2) && byId.size).toBe(2);
        expect(byId.delete(1) && !byId.has(1)).toBeTruthy();
        big.set(10n ** 30n, 1)
        expect(big.get(10n ** 30n)).toBe(1);
        flags.set(true, "yes")
        expect(flags.get(true) === "yes" && flags.get(false)).toBe(null);
    });

    await it("group 1 part 2", async () => {
        expect(letters.get('a')).toBe(1);
        counts.set(3, 30)
        counts.set(4, 40)
        counts.forEach((v: int, k: int) => { keySum = keySum + k })
        expect(keySum).toBe(7);
        expect(counts.keys().length).toBe(2);
        expect(index["a"]).toBe(1);
    });


});
