import { describe, it, expect } from "std:test";



// is char narrowing
function describeChar(c: char): str {
    if (c is char) return "yes"
    return "no"
}
await describe("34 char type", async () => {
    await it("tests", async () => {
        
        // Literals and basic identity
        const a: char = 'a'
        const z: char = 'z'
        const excl: char = '!'
        expect(a).toBe('a')
        expect(a !== z).toBeTruthy()
        expect('A'.charCodeAt()).toBe(65)
        expect(char.fromCode(65)).toBe('A')
        expect(char.fromCode(122)).toBe('z')
        
        // Classification
        expect('a'.isAlphabetic()).toBeTruthy()
        expect(!('1'.isAlphabetic())).toBeTruthy()
        expect('a'.isAlphanumeric()).toBeTruthy()
        expect('7'.isAlphanumeric()).toBeTruthy()
        expect('5'.isDigit()).toBeTruthy()
        expect(!('a'.isDigit())).toBeTruthy()
        expect(' '.isWhitespace()).toBeTruthy()
        expect(!('a'.isWhitespace())).toBeTruthy()
        expect('A'.isUppercase()).toBeTruthy()
        expect(!('a'.isUppercase())).toBeTruthy()
        expect('a'.isLowercase()).toBeTruthy()
        expect(!('A'.isLowercase())).toBeTruthy()
        expect('a'.isAscii()).toBeTruthy()
        expect('.'.isPunctuation()).toBeTruthy()
        expect(!('a'.isPunctuation())).toBeTruthy()
        
        // Case conversion
        expect('a'.toUppercase()).toBe('A')
        expect('A'.toLowercase()).toBe('a')
        
        // toString
        expect('x'.toString()).toBe("x")
        expect(describeChar('q')).toBe("yes")
        
        // chars in array
        const vowels: char[] = ['a', 'e', 'i', 'o', 'u']
        expect(vowels.length).toBe(5)
        expect(vowels[0]).toBe('a')
        expect(vowels[4]).toBe('u')
        
        // char in loop
        let digitCount = 0
        const sample: char[] = ['1', 'a', '2', 'b', '3']
        for (const ch of sample) {
            if (ch.isDigit()) digitCount = digitCount + 1
        }
        expect(digitCount).toBe(3)
        
        // round-trip: codePoint -> char -> str
        const codes: int[] = [72, 101, 108, 108, 111]
        let built = ""
        for (const code of codes) {
            built = built + char.fromCode(code).toString()
        }
        expect(built).toBe("Hello")
        
    });
});
