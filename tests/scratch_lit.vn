function makeArr(a: int, b: int): dynamic { return [a, b, a + b] }
function makeObj(x: int): dynamic { return { val: x, double: x * 2 } }
function sumPair(a: int, b: int): int {
  let arr = [a, b]
  return arr[0] + arr[1]
}
function objField(n: int): int {
  let o = { n: n, sq: n * n }
  return o.n + o.sq
}
function nested(x: int): dynamic { return { list: [x, x + 1], name: "k" } }
let r = makeArr(3, 4)
print(r[0] + r[1] + r[2])
let o = makeObj(5)
print(o.val + o.double)
print(sumPair(10, 20))
print(objField(4))
let nx = nested(7)
print(nx.list[0] + nx.list[1])
