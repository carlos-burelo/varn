import { describe, it, expect } from "std:test";

class Box {
    value: int = 4;
    label: str = "box";
}

type Settings = { [key: str]: int };

class Animal {}
class Dog extends Animal {
    tricks: int = 3;
}

function countTricks(dog: Dog): int { return dog.tricks }
function describeAny(animal: Animal): int { return 1 }

await describe("264 index by name", async () => {
    await it("a literal key reads the member with its declared type", () => {
        const box = new Box();
        const value: int = box["value"];
        const label: str = box["label"];
        expect(value + 1).toBe(5);
        expect(label.length).toBe(3);
    });

    await it("an index signature yields an optional value", () => {
        const settings: Settings = { retries: 3 };
        const retries: int? = settings["retries"];
        const missing: int? = settings["timeout"];
        expect(retries).toBe(3);
        expect(missing).toBe(null);
    });

    await it("ranges and maps keep their indexing", () => {
        expect((2..6)[1]).toBe(3);
        const m: Map<str, int> = new Map();
        m.set("a", 1);
        expect(m["a"]).toBe(1);
    });

    await it("a function accepting a wider parameter stands in for a narrower one", () => {
        const narrow: (dog: Dog) => int = describeAny;
        expect(narrow(new Dog())).toBe(1);
        const same: (dog: Dog) => int = countTricks;
        expect(same(new Dog())).toBe(3);
    });
});
