import { describe, it, expect } from "std:test";

await describe("347 postfix update stays on its line", async () => {
    await it("a prefix update on the next line is a new statement, not a postfix on the previous value", () => {
        let a = 1
        let b = 1
        const pair = { a, b }
        ++a
        --b
        expect(a).toBe(2)
        expect(b).toBe(0)
        expect(pair.a).toBe(1)
    })

    await it("a postfix update on the same line still applies", () => {
        let n = 5
        const old = n++
        expect(old).toBe(5)
        expect(n).toBe(6)
    })
})
