// Salir de un `try { } catch { }` por `break`, `continue` o `return` debe
// cerrar la región guardada.
//
// La bajada a SSA registra las regiones con acción de salida en
// `finally_stack`, y `break`/`continue`/`return` emiten un `PopTry` por cada
// región que abandonan recorriendo esa pila. El `try/catch` sin `finally` no
// se registraba, así que una salida temprana se iba sin emitir su `PopTry` y
// dejaba un handler colgante en la pila `try_handlers` de la VM, apuntando a
// un frame ya muerto.
//
// Síntoma observable: el siguiente `throw` del programa lo intercepta ese
// handler fantasma en vez del `catch` que le corresponde. Cuando el frame ya
// no existe, la VM lee registros fuera de rango y revienta; cuando existe a
// medias, el error desaparece sin mensaje y el proceso sale con código 0 —
// un programa que debe fallar reporta éxito.

let testigo = 0;

function conBreak(): void {
    for (let i = 0; i < 3; i = i + 1) {
        try {
            if (i == 1) { break; }
        } catch (e) {
            // Inalcanzable: nada lanza aquí dentro.
            testigo = testigo + 1;
        }
    }
}

function conContinue(): void {
    for (let i = 0; i < 3; i = i + 1) {
        try {
            if (i == 1) { continue; }
        } catch (e) {
            testigo = testigo + 1;
        }
    }
}

function conReturn(): void {
    for (let i = 0; i < 3; i = i + 1) {
        try {
            if (i == 1) { return; }
        } catch (e) {
            testigo = testigo + 1;
        }
    }
}

// Lanza DESPUÉS de haber salido de la región por la vía temprana. Si quedó un
// handler colgante, éste se traga el error y el `catch` de fuera nunca corre.
function lanzaTrasSalir(via: str): void {
    if (via === "break") { conBreak(); }
    if (via === "continue") { conContinue(); }
    if (via === "return") { conReturn(); }
    throw new Error("debe llegar al catch del llamante");
}

function capturaEnElSitioCorrecto(via: str): bool {
    let llego = false;
    try {
        lanzaTrasSalir(via);
    } catch (e) {
        llego = true;
    }
    return llego;
}

assert("break fuera de try/catch no deja handler colgante", capturaEnElSitioCorrecto("break"))
assert("continue fuera de try/catch no deja handler colgante", capturaEnElSitioCorrecto("continue"))
assert("return fuera de try/catch no deja handler colgante", capturaEnElSitioCorrecto("return"))

// El caso con `finally` ya funcionaba: sirve de control. Si éste fallara, el
// fallo estaría en el mecanismo de salida entero y no en el `try/catch` pelado.
function conBreakYFinally(): int {
    let pasos = 0;
    for (let i = 0; i < 3; i = i + 1) {
        try {
            if (i == 1) { break; }
        } catch (e) {
        } finally {
            pasos = pasos + 1;
        }
    }
    return pasos;
}

assert("control: try/catch/finally con break ejecuta sus finally", conBreakYFinally() === 2)

// La región debe cerrarse, no quedarse abierta: tras salir por `break`, un
// `throw` dentro del mismo bucle en una iteración posterior no existe, pero sí
// debe poder lanzarse y capturarse con normalidad más adelante en la función.
function lanzaYCapturaTrasBreak(): bool {
    conBreak();
    let ok = false;
    try {
        throw new Error("local");
    } catch (e) {
        ok = true;
    }
    return ok;
}

assert("tras salir por break, try/catch posterior sigue funcionando", lanzaYCapturaTrasBreak())

// Bug hermano de éste, separado: una salida temprana (`break`/`return`, NO
// `continue`) desde dentro de un `try` con un `catch { }` de cuerpo VACÍO,
// dentro de un bucle, hacía panicar al compilador ("ssa: verify failed ...:
// pred bN has no edge to bM"), no a la VM. `jump_forwarding` (pase de
// simplificación del CFG) trataba el bloque `catch` vacío como un eslabón de
// reenvío puro (`catch: jump siguiente`) y, al reenviarlo, vaciaba su lista
// de preds sin saber que uno de ellos era la arista de excepción del `Try`
// que lo señala como handler — arista que no vive en ningún terminador y
// que el pase no sabe reescribir. El bloque quedaba con bookkeeping de preds
// mentiroso; `merge_blocks` confiaba en él para fusionar de más, y el
// verificador de SSA lo cazaba más adelante. Arreglado en el propio pase:
// ver comentario de `jump_forwarding` en crates/varn-compiler/src/passes/cfg.rs.

function vacioConBreak(): int {
    let pasos = 0;
    for (let i = 0; i < 3; i = i + 1) {
        try {
            pasos = pasos + 1;
            if (i == 1) { break; }
        } catch (e) { }
    }
    return pasos;
}

assert("catch vacio + break dentro de bucle no revienta el verificador", vacioConBreak() === 2)

function vacioConReturn(): int {
    let pasos = 0;
    for (let i = 0; i < 3; i = i + 1) {
        try {
            pasos = pasos + 1;
            if (i == 1) { return pasos; }
        } catch (e) { }
    }
    return -1;
}

assert("catch vacio + return dentro de bucle no revienta el verificador", vacioConReturn() === 2)

function vacioConContinue(): int {
    let pasos = 0;
    for (let i = 0; i < 3; i = i + 1) {
        try {
            if (i == 1) { continue; }
            pasos = pasos + 1;
        } catch (e) { }
    }
    return pasos;
}

assert("catch vacio + continue dentro de bucle no revienta el verificador", vacioConContinue() === 2)

// Control: fuera de bucle ya funcionaba (nunca dependió de `jump_forwarding`
// vaciando preds de un bloque destino de bucle). Si este fallara, el fallo
// estaría en otra parte del manejo de `catch` vacío, no en el CFG de bucles.
function retornaFueraDeBucle(): int {
    try {
        return 42;
    } catch (e) { }
    return -1;
}

assert("control: catch vacio + return fuera de bucle (ya funcionaba)", retornaFueraDeBucle() === 42)
