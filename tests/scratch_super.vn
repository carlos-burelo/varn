class Animal {
  name: str
  constructor(name: str) {
    this.name = name
  }
  describe(): str {
    return "Animal:" + this.name
  }
}
class Dog extends Animal {
  breed: str
  constructor(name: str, breed: str) {
    super(name)
    this.breed = breed
  }
  override describe(): str {
    return super.describe() + ":" + this.breed
  }
}
const d = Dog("Rex", "Lab")
print(d.name)
print(d.breed)
print(d.describe())
