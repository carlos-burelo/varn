import { describe, it, expect } from "std:test";
import { channel, ChannelClosed, spawnIsolate, Sender, Receiver } from "std:task";
import { echoWorker } from "./helpers/isolate-workers.vn";


async function testBasics(): void {
    const ch = channel<int>(2)
    await ch.tx.send(1)
    await ch.tx.send(2)
    expect(await ch.rx.receive()).toBe(1)
    expect(await ch.rx.receive()).toBe(2)
}

async function testTypedClose(): void {
    const ch = channel<str>(1)
    ch.tx.close()
    let typed = false
    let sendClosed = false
    try {
        await ch.rx.receive()
    } catch (e) {
        typed = e instanceof ChannelClosed
    }
    try {
        await ch.tx.send("nope")
    } catch (e) {
        sendClosed = e instanceof ChannelClosed
    }
    expect(typed).toBeTruthy()
    expect(sendClosed).toBeTruthy()
}

async function testForAwait(): void {
    const ch = channel<int>(4)
    await ch.tx.send(10)
    await ch.tx.send(20)
    ch.tx.close()
    let sum = 0
    for await (const v of ch.rx) {
        sum = sum + v
    }
    expect(sum).toBe(30)
}

async function testUsingDispose(): void {
    const ch = channel<int>(1)
    {
        using tx = ch.tx
        await tx.send(5)
    }
    // dispose cerró el canal: drena y termina
    expect(await ch.rx.receive()).toBe(5)
    let closed = false
    try { await ch.rx.receive() } catch (e) { closed = e instanceof ChannelClosed }
    expect(closed).toBeTruthy()
}

async function testCrossIsolate(): void {
    const a = channel<int>(4)
    const b = channel<int>(4)
    const handle = await spawnIsolate(echoWorker, [a.rx, b.tx])
    await a.tx.send(21)
    expect(await b.rx.receive()).toBe(42)
    a.tx.close()
    await handle.join()
    let done = false
    try { await b.rx.receive() } catch (e) { done = e instanceof ChannelClosed }
    expect(done).toBeTruthy()
}

async function main(): void {
    await testBasics()
    await testTypedClose()
    await testForAwait()
    await testUsingDispose()
    await testCrossIsolate()
}
await describe("54 channels", async () => {
    await it("tests", async () => {
        
        await main()
        
    });
});
