import { describe, it, expect } from "std:test";

class Resource {
    value: int = 7;
    dispose(): void {}
}

using held = new Resource(), second = new Resource();

function readHeld(): int {
    return held.value;
}

function readSecond(): int {
    return second.value;
}

function bumpHeld(): void {
    held.value = held.value + 1;
}

await describe("247 top-level using", async () => {
    await it("a top-level using binding is visible to functions", () => {
        expect(readHeld()).toBe(7);
        bumpHeld();
        expect(readHeld()).toBe(8);
    });
    await it("one using statement binds several declarators", () => {
        expect(readSecond()).toBe(7);
    });
});
