import { describe, it, expect } from "std:test";

// A `T?` field over a reference type is laid out as the reference itself
// (an 8-byte heap index) and `null` is its niche (spec §49). A field that is
// never written reads `null`, not whatever a zero-filled payload holds.

class NrNode {
    value: int
    next: NrNode?
    constructor(value: int) {
        this.value = value
    }
}

class NrHolder {
    node: NrNode?
    items: int[]?
    counts: Map<str, int>?
    tags: Set<int>?
    label: str?
}

// Never written: every nullable reference reads null.
const holder = new NrHolder()

// Written, read back, and cleared again.

// A linked list through a `T?` field, built hot enough for the JIT and
// under enough allocation to collect while it is live.
function nrBuild(n: int): NrNode {
    let head = new NrNode(0)
    for (let i = 1; i < n; i = i + 1) {
        const node = new NrNode(i)
        node.next = head
        head = node
    }
    return head
}
function nrSum(head: NrNode): int {
    let acc = 0
    let cur: NrNode? = head
    while (cur != null) {
        acc = acc + cur.value
        cur = cur.next
    }
    return acc
}
let nrLists: NrNode[] = []
let nrJunk: str[] = []
let nrTotal = 0
for (let round = 0; round < 20; round = round + 1) {
    nrLists.push(nrBuild(3000))
}
for (let i = 0; i < 60000; i = i + 1) {
    nrJunk.push("junk-" + i)
}
for (const l of nrLists) {
    nrTotal = nrTotal + nrSum(l)
}
await describe("140 nullable ref fields", async () => {
        await it("group 1 part 1", async () => {
        expect(holder.node == null).toBeTruthy();
        expect(holder.items == null).toBeTruthy();
        expect(holder.counts == null).toBeTruthy();
        expect(holder.tags == null).toBeTruthy();
    });

    await it("group 1 part 2", async () => {
        expect(holder.label == null).toBeTruthy();
        holder.node = new NrNode(5)
        holder.items = [1, 2, 3]
        holder.counts = new Map<str, int>()
        holder.counts?.set("a", 1)
        expect(holder.node?.value).toBe(5);
        expect(holder.items?.length).toBe(3);
        expect(holder.counts?.get("a")).toBe(1);
        holder.node = null
        holder.items = null
    });

    await it("group 1 part 3", async () => {
        expect(holder.node == null).toBeTruthy();
        expect(holder.items == null).toBeTruthy();
        expect(nrTotal).toBe(20 * 4498500);
        expect(nrBuild(1).next == null).toBeTruthy();
    });


});
