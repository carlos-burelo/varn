import { describe, it, expect } from "std:test";


// OSR enters compiled code MID-FRAME, so the interpreter's boxed frame slots
// must be converted into exactly the representation the target block expects
// (the kind-flow state at the loop header, NOT register_meta). Getting that
// wrong leaves a raw int where the lowering reads boxed VmValue bits: the
// counter stops comparing correctly and the loop never terminates.
//
// Each function below is entered ONCE and loops well past the OSR back-edge
// threshold, so every one of them tiers up in flight. Run under
// `VARN_JIT_TIER=999999` to prove it was OSR and not ordinary tiering.

function osrIntCounter(n: int): int {
  let s: int = 0
  for (let i: int = 0; i < n; i = i + 1) { s = s + (i % 7) }
  return s
}

function osrFloatAccum(n: int): float {
  let s: float = 0.0
  for (let i: int = 0; i < n; i = i + 1) { s = s + 0.5 }
  return s
}

// Mixed int/float registers across the OSR boundary.
function osrMixed(n: int): float {
  let f: float = 1.0
  let k: int = 0
  for (let i: int = 0; i < n; i = i + 1) { k = k + 1; if (i % 2 === 0) { f = f + 0.25 } }
  return f + (k as float)
}

// A loop whose body allocates: forces flush/reload safepoints under OSR.
class OsrBox {
  v: int
  constructor(v: int) { this.v = v }
}
function osrAlloc(n: int): int {
  let s: int = 0
  for (let i: int = 0; i < n; i = i + 1) { const b = new OsrBox(i % 3); s = s + b.v }
  return s
}

// Nested loops — the inner back edge is hot first; only one OSR variant is
// built, so the outer loop must keep working through the inner one's entry.
function osrNested(n: int): int {
  let s: int = 0
  for (let i: int = 0; i < n; i = i + 1) {
    for (let j: int = 0; j < 10; j = j + 1) { s = s + 1 }
  }
  return s
}

// Early return out of an OSR'd loop: the compiled body must return through
// the wrapper's retag path like any other exit.
function osrEarlyReturn(n: int): int {
  for (let i: int = 0; i < n; i = i + 1) { if (i === 15000) { return i } }
  return -1
}
await describe("62 jit osr", async () => {
    await it("tests", async () => {
        expect(osrIntCounter(20000)).toBe(59997)
        expect(osrFloatAccum(20000)).toBe(10000.0)
        expect(osrMixed(20000)).toBe(22501.0)
        expect(osrAlloc(20000)).toBe(19999)
        expect(osrNested(5000)).toBe(50000)
        expect(osrEarlyReturn(20000)).toBe(15000)
        
        
    });
});
