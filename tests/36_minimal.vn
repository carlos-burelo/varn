function memoize<T>(f: (a:int) => T): (b: int) => T {
    const cache: T[] = []
    const seen: bool[] = []
    return (n: int) => {
        if (n < seen.length && seen[n]) return cache[n]
        const result = f(n)
        while (cache.length <= n) { cache.push(result); seen.push(false) }
        cache[n] = result
        seen[n] = true
        return result
    }
}

let callCount = 0
const expensiveFib = memoize((n) => {
    callCount = callCount + 1
    if (n <= 1) return n
    return n
})
print("created expensiveFib")
expensiveFib(5)
print("called once")
