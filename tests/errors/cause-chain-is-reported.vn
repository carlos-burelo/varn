// expect: error[StdError: wrapped]
// expect: error[at high (tests/errors/cause-chain-is-reported.vn:11)]
// expect: error[caused by: DivisionByZero: division by zero]
// expect: error[at low (tests/errors/cause-chain-is-reported.vn:6)]
import { StdError } from "std:error"
function low(a: int, b: int): int { return a / b }
function high(): int {
    try {
        return low(1, 0)
    } catch (e) {
        throw new StdError("wrapped", e as Error)
    }
}
print(high())
