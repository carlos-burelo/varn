import { Math, exp, log, log10, log2, pow, hypot, cbrt, sign, trunc } from "std:math";
import { describe, it, expect } from "std:test";


// 1. exp and log
let e1 = Math.exp(1.0);
let lne = Math.log(Math.E);

let e1Free = exp(1.0);
let lneFree = log(Math.E);

// 2. log10 and log2

// 3. pow, cbrt, hypot

// 4. sign and trunc
await describe("96 stdlib math advanced", async () => {
        await it("group 1 part 1", async () => {
        expect(e1).toBeCloseTo(2.718281828459045, 0.0001);
        expect(lne).toBeCloseTo(1.0, 0.0001);
        expect(e1Free).toBeCloseTo(2.718281828459045, 0.0001);
        expect(lneFree).toBeCloseTo(1.0, 0.0001);
        expect(Math.log10(100.0)).toBeCloseTo(2.0, 0.0001);
        expect(log10(1000.0)).toBeCloseTo(3.0, 0.0001);
        expect(Math.log2(8.0)).toBeCloseTo(3.0, 0.0001);
    });

    await it("group 1 part 2", async () => {
        expect(log2(16.0)).toBeCloseTo(4.0, 0.0001);
        expect(Math.pow(2.0, 10.0)).toBeCloseTo(1024.0, 0.0001);
        expect(pow(3.0, 3.0)).toBeCloseTo(27.0, 0.0001);
        expect(Math.cbrt(27.0)).toBeCloseTo(3.0, 0.0001);
        expect(cbrt(64.0)).toBeCloseTo(4.0, 0.0001);
        expect(Math.hypot(3.0, 4.0)).toBeCloseTo(5.0, 0.0001);
        expect(hypot(5.0, 12.0)).toBeCloseTo(13.0, 0.0001);
    });

    await it("group 1 part 3", async () => {
        expect(Math.sign(42.0)).toBe(1.0);
        expect(Math.sign(-42.0)).toBe(-1.0);
        expect(Math.sign(0.0)).toBe(0.0);
        expect(Math.trunc(4.9)).toBe(4.0);
        expect(Math.trunc(-4.9)).toBe(-4.0);
    });


});
