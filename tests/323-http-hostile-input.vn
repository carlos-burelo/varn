import { describe, it, expect } from "std:test";
import { spawn, delay } from "std:task";
import { TcpStream, TcpListener } from "std:net";
import { HttpServer, Request, Response, fetch } from "std:http";

async function readToEnd(client: TcpStream): Task<str> {
    let text = "";
    while (true) {
        const chunk = await client.read(8192);
        if (chunk == null) {
            return text
        }
        text = text + (chunk as Bytes).toString();
    }
}

async function exchange(port: int, raw: str): Task<str> {
    const client = await TcpStream.connect("127.0.0.1", port, 1);
    await client.write(Bytes.fromString(raw));
    const reply = await readToEnd(client);
    client.close();
    return reply;
}

function status(reply: str): str {
    return reply.slice(0, 12);
}

async function fakeServer(listener: TcpListener, script: str): Task<void> {
    const conn = await listener.accept();
    await conn.read(4096);
    await conn.write(Bytes.fromString(script));
    conn.close();
}

async function fetchFails(port: int, script: str): Task<bool> {
    const listener = TcpListener.listen(port);
    spawn(fakeServer(listener, script));
    let failed = false;
    try {
        await fetch("http://127.0.0.1:" + port.toString() + "/");
    } catch (e) {
        failed = true;
    }
    listener.close();
    return failed;
}

await describe("323 http refuses hostile input", async () => {
    const server = new HttpServer();
    server.post("/echo", async (req: Request) => new Response(req.text(), 200));
    server.get("/hello", async (req: Request) => new Response("hello", 200));
    server.get("/inject", async (req: Request) => new Response("x", 200, new Map<str, str>([("X-A", "ok\r\nSet-Cookie: pwn=1")])));
    server.get("/inject-name", async (req: Request) => new Response("x", 200, new Map<str, str>([("X-A\r\nX-B", "v")])));
    server.get("/cookie", async (req: Request) => new Response("x", 200).setCookie("a", "b; Domain=evil.example"));
    server.get("/status-text", async (req: Request) => {
        const res = new Response("x", 200);
        res.statusText = "OK\r\nX-Evil: 1";
        return res;
    });
    server.listen(19920);
    await delay(150);

    await it("a request with both Transfer-Encoding and Content-Length is refused", async () => {
        const reply = await exchange(19920, "POST /echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\nContent-Length: 5\r\nConnection: close\r\n\r\n0\r\n\r\n");
        expect(status(reply)).toBe("HTTP/1.1 400");
    });

    await it("conflicting or repeated framing headers are refused", async () => {
        const twice = await exchange(19920, "POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\nContent-Length: 6\r\nConnection: close\r\n\r\nhello!");
        expect(status(twice)).toBe("HTTP/1.1 400");
        const spaced = await exchange(19920, "POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length : 5\r\nConnection: close\r\n\r\nhello");
        expect(status(spaced)).toBe("HTTP/1.1 400");
        const signed = await exchange(19920, "POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length: +5\r\nConnection: close\r\n\r\nhello");
        expect(status(signed)).toBe("HTTP/1.1 400");
    });

    await it("only a plain chunked coding is understood", async () => {
        const sub = await exchange(19920, "POST /echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: xchunkedx\r\nConnection: close\r\n\r\n0\r\n\r\n");
        expect(status(sub)).toBe("HTTP/1.1 501");
        const stacked = await exchange(19920, "POST /echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: gzip, chunked\r\nConnection: close\r\n\r\n0\r\n\r\n");
        expect(status(stacked)).toBe("HTTP/1.1 501");
        const plain = await exchange(19920, "POST /echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: Chunked\r\nConnection: close\r\n\r\n5\r\nhello\r\n0\r\n\r\n");
        expect(status(plain)).toBe("HTTP/1.1 200");
    });

    await it("a malformed chunk size is refused", async () => {
        const reply = await exchange(19920, "POST /echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\nzz\r\nhello\r\n0\r\n\r\n");
        expect(status(reply)).toBe("HTTP/1.1 400");
    });

    await it("a handler cannot split the response through a header, a status text or a cookie", async () => {
        const value = await exchange(19920, "GET /inject HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n");
        expect(status(value)).toBe("HTTP/1.1 500");
        expect(value.indexOf("pwn") == null).toBe(true);
        const name = await exchange(19920, "GET /inject-name HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n");
        expect(status(name)).toBe("HTTP/1.1 500");
        const cookie = await exchange(19920, "GET /cookie HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n");
        expect(status(cookie)).toBe("HTTP/1.1 500");
        const text = await exchange(19920, "GET /status-text HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n");
        expect(status(text)).toBe("HTTP/1.1 500");
        expect(text.indexOf("X-Evil") == null).toBe(true);
    });

    await it("a keep-alive connection serving many requests keeps working", async () => {
        let burst = "";
        for (let i = 0; i < 300; i = i + 1) {
            burst = burst + "GET /hello HTTP/1.1\r\nHost: x\r\n\r\n";
        }
        burst = burst + "GET /hello HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n";
        const reply = await exchange(19920, burst);
        let answered = 0;
        let rest = reply;
        while (true) {
            const at = rest.indexOf("HTTP/1.1 200");
            if (at == null) {
                break;
            }
            answered = answered + 1;
            rest = rest.slice(at + 12);
        }
        expect(answered).toBe(301);
    });

    server.close();

    await it("the client refuses a response with a bad status line, header name or framing", async () => {
        expect(await fetchFails(19921, "HTTP/1.1 99 Low\r\nContent-Length: 0\r\n\r\n")).toBe(true);
        expect(await fetchFails(19922, "HTTP/1.1 abc Odd\r\nContent-Length: 0\r\n\r\n")).toBe(true);
        expect(await fetchFails(19923, "NOTHTTP 200 OK\r\nContent-Length: 0\r\n\r\n")).toBe(true);
        expect(await fetchFails(19924, "HTTP/1.1 200 OK\r\nBad Name: 1\r\nContent-Length: 0\r\n\r\n")).toBe(true);
        expect(await fetchFails(19925, "HTTP/1.1 200 OK\r\nContent-Length: +3\r\n\r\nabc")).toBe(true);
        expect(await fetchFails(19926, "HTTP/1.1 200 OK\r\nTransfer-Encoding: xchunkedx\r\n\r\nabc")).toBe(true);
    });

    await it("the client bounds the number of response headers", async () => {
        let headers = "";
        for (let i = 0; i < 400; i = i + 1) {
            headers = headers + "X-H" + i.toString() + ": v\r\n";
        }
        expect(await fetchFails(19927, "HTTP/1.1 200 OK\r\n" + headers + "Content-Length: 0\r\n\r\n")).toBe(true);
    });

    await it("a well formed response still works", async () => {
        const listener = TcpListener.listen(19928);
        spawn(fakeServer(listener, "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nX-Ok: yes\r\n\r\nhi"));
        const res = await fetch("http://127.0.0.1:19928/");
        listener.close();
        expect(res.status).toBe(200);
        expect(res.text()).toBe("hi");
    });
});
