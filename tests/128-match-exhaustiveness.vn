type Method = "GET" | "POST"
function code(m: Method): int {
    return match (m) { "GET" => 1, "POST" => 2 }
}
assert("literal union match", code("GET") + code("POST") === 3)

function sign(b: bool): int { return match (b) { true => 1, false => -1 } }
assert("bool match", sign(true) + sign(false) === 0)

function orZero(x: int?): int { return match (x) { null => 0, n => n } }
assert("nullable match", orZero(null) === 0 && orZero(5) === 5)

function partial(b: bool): int { return match (b) { true => 1 } }
function raisesMatchError(f: () => int): bool {
    try { f(); return false } catch (e) { return e instanceof MatchError }
}
assert("no arm raises MatchError", raisesMatchError(() => partial(false)))
assert("covered arm still matches", partial(true) === 1)

print("[PASSED] 128. Match exhaustiveness")
