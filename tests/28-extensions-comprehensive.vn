import { describe, it, expect } from "std:test";

extension StringUtils on str {
    shout(): str { return this + "!"; }
    times(n: int): str {
        let result = "";
        let i = 0;
        while (i < n) { result = result + this; i = i + 1; }
        return result;
    }
    wordCount(): int {
        let count = 0;
        let inWord = false;
        let i = 0;
        while (i < this.length) {
            const ch = this[i];
            if (ch !== " " && !inWord) { count = count + 1; inWord = true; }
            else if (ch === " ") { inWord = false; }
            i = i + 1;
        }
        return count;
    }
    isEmpty(): bool { return this.length === 0; }
    repeatChars(n: int): str {
        if (n <= 0) return "";
        let result = "";
        let i = 0;
        while (i < this.length) {
            let j = 0;
            while (j < n) { result = result + this[i]; j = j + 1; }
            i = i + 1;
        }
        return result;
    }
}
class Point {
    x: int
    y: int
    constructor(x: int, y: int) { this.x = x; this.y = y; }
}
extension PointOps on Point {
    distanceTo(other: Point): float {
        let dx: float = (this.x - other.x) as float;
        let dy: float = (this.y - other.y) as float;
        return (dx * dx + dy * dy) ** 0.5;
    }
    isOrigin(): bool { return this.x === 0 && this.y === 0; }
    negate(): Point {
        return new Point(-this.x, -this.y);
    }
}
extension IntOps on int {
    isEven(): bool { return this % 2 === 0; }
    isOdd(): bool { return !this.isEven(); }
    squared(): int { return this * this; }
    clamp(lo: int, hi: int): int {
        if (this < lo) return lo;
        if (this > hi) return hi;
        return this;
    }
}

await describe("28 Extensions Comprehensive", async () => {
    await it("str extensions", () => {
        expect("hello".shout()).toBe("hello!");
        expect("ab".times(3)).toBe("ababab");
        expect("hello world foo".wordCount()).toBe(3);
        expect("".isEmpty()).toBe(true);
        expect("x".isEmpty()).toBe(false);
        expect("ab".repeatChars(2)).toBe("aabb");
    });

    await it("point extensions", () => {
        const p1 = new Point(3, 4);
        const p2 = new Point(0, 0);
        expect(p1.distanceTo(p2) > 4.9 && p1.distanceTo(p2) < 5.1).toBeTruthy();
        expect(p2.isOrigin()).toBe(true);
        expect(p1.isOrigin()).toBe(false);
        const neg = p1.negate();
        expect(neg.x).toBe(-3);
        expect(neg.y).toBe(-4);
    });

    await it("int extensions", () => {
        expect((4).isEven()).toBe(true);
        expect((7).isEven()).toBe(false);
        expect((3).isOdd()).toBe(true);
        expect((5).squared()).toBe(25);
        expect((2).clamp(5, 10)).toBe(5);
        expect((15).clamp(5, 10)).toBe(10);
        expect((7).clamp(5, 10)).toBe(7);
    });
});
