// Extension methods tests — comprehensive coverage for primitives, classes, and generics

extension StringUtils on str {
    shout(): str { return this + "!" }
    times(n: int): str {
        let result = ""
        let i = 0
        while (i < n) { result = result + this; i = i + 1 }
        return result
    }
    wordCount(): int {
        let count = 0
        let inWord = false
        let i = 0
        while (i < this.length) {
            const ch = this[i]
            if (ch !== " " && !inWord) { count = count + 1; inWord = true }
            else if (ch === " ") { inWord = false }
            i = i + 1
        }
        return count
    }
    isEmpty(): bool { return this.length === 0 }
    repeatChars(n: int): str {
        if (n <= 0) return ""
        let result = ""
        let i = 0
        while (i < this.length) {
            let j = 0
            while (j < n) { result = result + this[i]; j = j + 1 }
            i = i + 1
        }
        return result
    }
}

class Point {
    x: int
    y: int
    constructor(x: int, y: int) { this.x = x; this.y = y }
}

extension PointOps on Point {
    distanceTo(other: Point): float {
        let dx: float = this.x - other.x
        let dy: float = this.y - other.y
        return (dx * dx + dy * dy) ** 0.5
    }
    isOrigin(): bool { return this.x === 0 && this.y === 0 }
    negate(): Point { return new Point(-this.x, -this.y) }
}

extension IntOps on int {
    isEven(): bool { return this % 2 === 0 }
    isOdd(): bool { return !this.isEven() }
    squared(): int { return this * this }
    clamp(lo: int, hi: int): int {
        if (this < lo) return lo
        if (this > hi) return hi
        return this
    }
}


// ── String extensions ───────────────────────────────────────────
assert("str shout",          "hello".shout() === "hello!")
assert("str times",          "ab".times(3) === "ababab")
assert("str wordCount",      "hello world foo".wordCount() === 3)
assert("str isEmpty true",   "".isEmpty() === true)
assert("str isEmpty false",  "x".isEmpty() === false)
assert("str repeatChars",    "ab".repeatChars(2) === "aabb")

// ── Class extensions ────────────────────────────────────────────
const p1 = new Point(3, 4)
const p2 = new Point(0, 0)
assert("point distance",     p1.distanceTo(p2) > 4.9 && p1.distanceTo(p2) < 5.1)
assert("point isOrigin true",  p2.isOrigin() === true)
assert("point isOrigin false", p1.isOrigin() === false)

const neg = p1.negate()
assert("point negate x",     neg.x === -3)
assert("point negate y",     neg.y === -4)

// ── Int extensions ──────────────────────────────────────────────
assert("int isEven true",    (4).isEven() === true)
assert("int isEven false",   (7).isEven() === false)
assert("int isOdd true",     (3).isOdd() === true)
assert("int squared",        (5).squared() === 25)
assert("int clamp lo",       (2).clamp(5, 10) === 5)
assert("int clamp hi",       (15).clamp(5, 10) === 10)
assert("int clamp mid",      (7).clamp(5, 10) === 7)

print("[PASSED] 28. Extension methods ")