class Box {
  v: int
  constructor(v: int) {
    this.v = v
  }
  get(): int {
    return this.v
  }
}
function readVal(b: Box?): int {
  return b?.v ?? -1
}
function callGet(b: Box?): int {
  return b?.get() ?? -1
}
const b = Box(42)
print(readVal(b))
print(readVal(null))
print(callGet(b))
print(callGet(null))
