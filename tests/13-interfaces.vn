import { describe, it, expect } from "std:test";

interface Printable {
    toString(): str
}
interface Serializable {
    serialize(): str
}
class Config implements Printable, Serializable {
    key: str
    value: int
    constructor(k: str, v: int) {
        this.key = k;
        this.value = v;
    }
    toString(): str { return `${this.key}=${this.value}`; }
    serialize(): str { return `{"${this.key}":${this.value}}`; }
}
function printThing(p: Printable): str {
    return p.toString();
}
interface Options {
    verbose?: bool
    maxRetries?: int
    tag: str
}
function runWith(opts: Options): str {
    const v = opts.verbose ?? false;
    const r = opts.maxRetries ?? 3;
    return `${opts.tag}:v=${v}:r=${r}`;
}

await describe("13 Interfaces", async () => {
    await it("implementation", () => {
        const cfg = new Config("timeout", 30);
        expect(cfg.toString()).toBe("timeout=30");
        expect(cfg.serialize()).toBe(`{"timeout":30}`);
        expect(printThing(cfg)).toBe("timeout=30");
    });

    await it("optional fields", () => {
        const res = runWith({ tag: "job1" });
        expect(res).toBe("job1:v=false:r=3");
        expect(runWith({ tag: "job2", verbose: true })).toBe("job2:v=true:r=3");
        expect(runWith({ tag: "job3", verbose: false, maxRetries: 5 })).toBe("job3:v=false:r=5");
    });
});
