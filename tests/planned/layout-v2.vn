import { describe, it, expect } from "std:test";
import { UiWindow, UiFrame, Focus, Widget, Column, Row, Text, Box, Field, Responsive, Adaptive, WindowClass, Each, Expanded, TextEdit, render, present, signal, UiInjectKind, MOUSE_LEFT } from "std:ui";

function frameAt(win: UiWindow, fr: UiFrame, focus: Focus, tree: Widget, w: float): void {
    fr.update(win);
    win.clear(0xFF000000);
    render(win, fr, focus, tree, 0.0, 0.0, w, 300.0);
    present(win, fr);
}

await describe("layout v2 (planned)", async () => {
    await it("a field outside Responsive keeps its text when the class changes", () => {
        using win = UiWindow.open("t", 960, 300);
        const fr = new UiFrame(960, 300);
        const focus = new Focus();
        const ed = new TextEdit();
        ed.text = "kept";
        const tree = Column([
            Field(edit: ed, hint: "name"),
            Responsive((cls: WindowClass, c: Constraints): Widget => match cls {
                compact => Text("a"),
                medium => Text("b"),
                expanded => Column([Text("c"), Text("d")]),
            })
        ]);
        frameAt(win, fr, focus, tree, 320.0);
        frameAt(win, fr, focus, tree, 900.0);
        expect(ed.text).toBe("kept");
    });

    await it("each keeps item state when the list is reordered", () => {
        using win = UiWindow.open("t", 960, 300);
        const fr = new UiFrame(960, 300);
        const focus = new Focus();
        const items = signal(["a", "b"]);
        const store = new Map<str, TextEdit>();
        store.set("a", new TextEdit());
        store.set("b", new TextEdit());
        store.get("a")!.text = "first";
        const build = (): Widget => Each(items.value, (s: str): str => s, (s: str, at: int): Widget => Field(edit: store.get(s)!, hint: s));
        frameAt(win, fr, focus, build(), 320.0);
        items.set(["b", "a"]);
        frameAt(win, fr, focus, build(), 320.0);
        expect(store.get("a")!.text).toBe("first");
    });

    await it("box minW and maxW bound the child size", () => {
        using win = UiWindow.open("t", 960, 300);
        const fr = new UiFrame(960, 300);
        const focus = new Focus();
        const tree = Box(w: 1000.0, minW: 0.0, maxW: 200.0, child: Text("x"));
        render(win, fr, focus, tree, 0.0, 0.0, 960.0, 300.0);
        expect(win.drawn().some((c: DrawnItem): bool => c.kind == "rect" && c.x == 0.0 && c.y == 0.0 && c.w == 200.0)).toBe(true);
    });
});
