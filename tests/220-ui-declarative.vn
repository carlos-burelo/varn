import { describe, it, expect } from "std:test";
import {
    UiWindow, UiFrame, Focus, Widget, render, present, FlexNode, TextNode, BoxNode, PaddingNode, Axis, TextAlign,
    Column, Row, Text, Box, Padding, Stack, SizedBox, Spacer, Button, Input, Each,
    signal, computed, effect, component,
    TextStyle, MainAxis, CrossAxis, Alignment, BoxFit, Colors, Theme,
    textSizeFor, textColorFor, run
} from "std:ui";
import { MOUSE_LEFT, UiInjectKind } from "std:ui";
import { beginFrame, endFrame } from "std:ui/state";

let boots = 0;

@component
function Clicker(): Widget {
    const clicks = signal(0);
    const label = computed(() => `clicks: ${clicks.value}`);
    effect(() => { boots = boots + 1; });
    return Column(children: [
        Text(label.value),
        Button(text: "more", onPress: () => { clicks.value = clicks.value + 1; })
    ]);
}

function flex(w: Widget): FlexNode { return w as FlexNode; }
function label(w: Widget): TextNode { return w as TextNode; }

let reorder = false;

@component
function Reordering(): Widget {
    if (reorder) {
        computed(() => 1);
    }
    const kept = signal(0);
    return Text(`${kept.value}`);
}

@component
function Stable(): Widget {
    const kept = signal(0);
    kept.value = kept.value + 1;
    return Text(`${kept.value}`);
}

type Todo = {
    id: int,
    title: str
};

@component
function Counter(): Widget {
    return Column(
        children: [
            Text("Counter")
        ]
    );
}

@component
function Dashboard(): Widget {
    return Column(
        gap: 16.0,
        pad: 24.0,
        children: [
            Text(
                "Dashboard",
                style: TextStyle.title
            ),
            Row(
                gap: 12.0,
                mainAxis: MainAxis.spaceBetween,
                children: [
                    Text("Revenue"),
                    Text("$24,500")
                ]
            )
        ]
    );
}

@component
function ConnectionStatus(): Widget {
    const connected = signal(false);
    return Column(
        children: [
            Text(connected.value ? "Connected" : "Disconnected")
        ]
    );
}

@component
function TodoRow(todo: Todo): Widget {
    return Text(todo.title);
}

@component
@component
function PriceLabel(price: float): Widget {
    return Text(price.toString(), style: TextStyle.title);
}

await describe("220 ui declarative", async () => {
    await it("counter builds a column with one text", () => {
        const tree = Counter();
        expect(tree is FlexNode).toBe(true);
        expect(flex(tree).axis).toBe(Axis.vertical);
        expect(flex(tree).children.length).toBe(1);
        expect(flex(tree).children[0] is TextNode).toBe(true);
        expect(label(flex(tree).children[0]).text).toBe("Counter");
    });

    await it("dashboard composes title and revenue row", () => {
        const tree = Dashboard();
        expect(flex(tree).axis).toBe(Axis.vertical);
        expect(flex(tree).gap).toBe(16.0);
        expect(flex(tree).children.length).toBe(2);
        expect(label(flex(tree).children[0]).style).toBe(TextStyle.title);
        const rowNode = flex(flex(tree).children[1]);
        expect(rowNode.axis).toBe(Axis.horizontal);
        expect(rowNode.mainAxis).toBe(MainAxis.spaceBetween);
        expect(rowNode.children.length).toBe(2);
        expect(label(rowNode.children[0]).text).toBe("Revenue");
        expect(label(rowNode.children[1]).text).toBe("$24,500");
    });

    await it("connection status flips on signal", () => {
        const connected = signal(false);
        const build = (): Widget => Column(
            children: [
                Text(connected.value ? "Connected" : "Disconnected")
            ]
        );
        expect(label(flex(build()).children[0]).text).toBe("Disconnected");
        connected.value = true;
        expect(label(flex(build()).children[0]).text).toBe("Connected");
        expect(ConnectionStatus() is FlexNode).toBe(true);
    });

    await it("each keeps stable order with keys", () => {
        const todos: Todo[] = [{ id: 1, title: "a" }, { id: 2, title: "b" }];
        const list = Each(todos, (t: Todo): str => t.title, (t: Todo, index: int) => TodoRow(todo: t));
        expect(list is FlexNode).toBe(true);
        expect(flex(list).children.length).toBe(2);
        expect(label(flex(list).children[0]).text).toBe("a");
        expect(label(flex(list).children[1]).text).toBe("b");
        expect(label(PriceLabel(9.5)).text).toBe("9.5");
    });

    await it("disabled button ignores clicks", () => {
        using win = UiWindow.open("t", 800, 600);
        const fr = new UiFrame(800, 600);
        const focus = new Focus();
        const hits: bool[] = [];
        const tree = Column(children: [
            Button(text: "no", onPress: () => { hits.push(true); }, enabled: false)
        ]);
        renderTree(win, fr, focus, tree);
        present(win, fr);
        win.inject(UiInjectKind.MouseDown, 30, 20, MOUSE_LEFT);
        fr.update(win);
        renderTree(win, fr, focus, tree);
        present(win, fr);
        win.inject(UiInjectKind.MouseUp, 30, 20, MOUSE_LEFT);
        fr.update(win);
        renderTree(win, fr, focus, tree);
        present(win, fr);
        expect(hits.length).toBe(0);
        const hits2: bool[] = [];
        const tree2 = Column(children: [
            Button(text: "yes", onPress: () => { hits2.push(true); })
        ]);
        const fr2 = new UiFrame(800, 600);
        const focus2 = new Focus();
        renderTree(win, fr2, focus2, tree2);
        present(win, fr2);
        win.inject(UiInjectKind.MouseDown, 30, 20, MOUSE_LEFT);
        fr2.update(win);
        renderTree(win, fr2, focus2, tree2);
        present(win, fr2);
        win.inject(UiInjectKind.MouseUp, 30, 20, MOUSE_LEFT);
        fr2.update(win);
        renderTree(win, fr2, focus2, tree2);
        present(win, fr2);
        expect(hits2.length).toBe(1);
    });

    await it("input echoes typed text into signal", () => {
        using win = UiWindow.open("t", 800, 600);
        const fr = new UiFrame(800, 600);
        const focus = new Focus();
        const name = signal("");
        const build = (): Widget => Input(bind: name, hint: "Name");
        renderTree(win, fr, focus, build());
        present(win, fr);
        win.inject(UiInjectKind.MouseDown, 30, 30, MOUSE_LEFT);
        fr.update(win);
        win.inject(UiInjectKind.MouseUp, 30, 30, MOUSE_LEFT);
        fr.update(win);
        renderTree(win, fr, focus, build());
        present(win, fr);
        win.inject(UiInjectKind.Key, 72, 1, 0);
        fr.update(win);
        renderTree(win, fr, focus, build());
        present(win, fr);
        win.inject(UiInjectKind.Key, 72, 0, 0);
        fr.update(win);
        renderTree(win, fr, focus, build());
        present(win, fr);
        expect(name.value).toBe("H");
    });

    await it("a component keeps its signals between frames", () => {
        const seen: str[] = [];
        run("t", build: (fr: UiFrame, focus: Focus): Widget => {
            const tree = Clicker();
            seen.push(label(flex(tree).children[0]).text);
            return tree;
        }, w: 400, h: 200, maxFrames: 4);
        expect(seen[0]).toBe("clicks: 0");
        expect(seen.length).toBe(4);
        expect(boots).toBe(1);
    });

    await it("run loop renders declarative trees headless", () => {
        const builds: int[] = [];
        run("t", build: (fr: UiFrame, focus: Focus): Widget => {
            builds.push(1);
            return Counter();
        }, w: 200, h: 100, maxFrames: 3);
        expect(builds.length).toBe(3);
    });

    await it("theme and style resolve", () => {
        expect(textSizeFor(TextStyle.title)).toBe(Theme.text.titleSize);
        expect(textSizeFor(TextStyle.body)).toBe(Theme.text.bodySize);
        expect(textColorFor(TextStyle.caption)).toBe(Theme.colors.muted);
        expect(textColorFor(TextStyle.body)).toBe(Theme.colors.onSurface);
        expect(Theme.colors.surface).toBe(0xFF1E2128);
        expect(label(Text("x")).size).toBe(Theme.text.bodySize);
        expect(label(Text("x", style: TextStyle.title)).size).toBe(Theme.text.titleSize);
        expect(CrossAxis.stretch == CrossAxis.stretch).toBe(true);
        expect(Alignment.center == Alignment.center).toBe(true);
        expect(BoxFit.cover == BoxFit.cover).toBe(true);
    });

    await it("layout primitives nest", () => {
        const tree = Box(
            pad: 16.0,
            color: Theme.colors.surface,
            radius: 12.0,
            child: Padding(
                all: 8.0,
                child: Stack(
                    alignment: Alignment.center,
                    children: [
                        SizedBox(w: 120.0, h: 48.0, child: Text("Fixed")),
                        Spacer()
                    ]
                )
            )
        );
        expect(tree is BoxNode).toBe(true);
        expect((tree as BoxNode).child is PaddingNode).toBe(true);
        using win = UiWindow.open("t", 800, 600);
        const fr = new UiFrame(800, 600);
        const focus = new Focus();
        win.clear(Theme.colors.surface);
        renderTree(win, fr, focus, tree);
        expect(win.drawn().length > 0).toBe(true);
        expect(win.present() > 0).toBe(true);
    });
    await it("component state survives frames", () => {
        beginFrame();
        expect(label(Stable()).text).toBe("1");
        endFrame();
        beginFrame();
        expect(label(Stable()).text).toBe("2");
        endFrame();
    });

    await it("a component that creates its state in another order is reported", () => {
        beginFrame();
        Reordering();
        endFrame();
        reorder = true;
        beginFrame();
        let failed = false;
        try {
            Reordering();
        } catch (e) {
            failed = true;
        }
        endFrame();
        reorder = false;
        expect(failed).toBe(true);
    });
});

function renderTree(win: UiWindow, fr: UiFrame, focus: Focus, tree: Widget): void {
    render(win, fr, focus, tree, 0.0, 0.0, 800.0, 600.0);
}
