import { describe, it, expect } from "std:test";

function double2(n: int): int { return n * 2; }
function addN(n: int, x: int): int { return n + x; }
function clamp2(lo: int, hi: int, v: int): int {
    if (v < lo) return lo;
    if (v > hi) return hi;
    return v;
}

await describe("19 Pipeline", async () => {
    await it("pipe operator", () => {
        expect(5 |> double2).toBe(10);
        expect(7 |> addN(_, 3)).toBe(10);
        expect(4 |> addN(_, _)).toBe(8);
        expect(-5 |> clamp2(0, 10, _)).toBe(0);
        expect(15 |> clamp2(0, 10, _)).toBe(10);
        const piped = (3 |> double2) |> double2;
        expect(piped).toBe(12);
    });
});
