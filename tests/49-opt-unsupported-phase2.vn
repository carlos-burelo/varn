import { describe, it, expect } from "std:test";



// 2. Index updates
let arr = [100, 200];

// 4. Updates on instance fields in subclass (via `this`)
class ParentClass {
    prop: int;
    arr: int[];
    constructor() {
        this.prop = 50;
        this.arr = [500];
    }
}

class ChildClass extends ParentClass {
    constructor() {
        super();
    }
    testInstanceUpdates(): void {
        let r10 = this.prop++;
        expect(r10).toBe(50);
        expect(this.prop).toBe(51);

        let r11 = ++this.prop;
        expect(r11).toBe(52);
        expect(this.prop).toBe(52);

        let r12 = this.arr[0]++;
        expect(r12).toBe(500);
        expect(this.arr[0]).toBe(501);
    }
}
await describe("49 opt unsupported phase2", async () => {
    await it("tests", async () => {
        // Tests for Phase 2: Updates on Members and Indices
        
        // 1. Member updates
        let obj = { x: 10, y: 20 };
        let r1 = obj.x++;
        expect(r1).toBe(10);
        expect(obj.x).toBe(11);
        
        let r2 = ++obj.x;
        expect(r2).toBe(12);
        expect(obj.x).toBe(12);
        
        let r3 = obj.y--;
        expect(r3).toBe(20);
        expect(obj.y).toBe(19);
        
        let r4 = --obj.y;
        expect(r4).toBe(18);
        expect(obj.y).toBe(18);
        let r5 = arr[0]++;
        expect(r5).toBe(100);
        expect(arr[0]).toBe(101);
        
        let r6 = ++arr[0];
        expect(r6).toBe(102);
        expect(arr[0]).toBe(102);
        
        let r7 = arr[1]--;
        expect(r7).toBe(200);
        expect(arr[1]).toBe(199);
        
        let r8 = --arr[1];
        expect(r8).toBe(198);
        expect(arr[1]).toBe(198);
        
        // 3. Nested updates
        let complex = { arr: [{ val: 5 }] };
        let r9 = complex.arr[0].val++;
        expect(r9).toBe(5);
        expect(complex.arr[0].val).toBe(6);
        
        let c = new ChildClass();
        c.testInstanceUpdates();
        
        
    });
});
