function sumArr(a: dynamic): int {
  let s = 0
  for (let x of a) { s = s + x }
  return s
}
function countArr(a: dynamic): int {
  let n = 0
  for (let x of a) { n = n + 1 }
  return n
}
function sumRange(n: int): int {
  let s = 0
  for (let x of 0..n) { s = s + x }
  return s
}
print(sumArr([10, 20, 30]))
print(countArr([1, 2, 3, 4]))
print(sumRange(5))
