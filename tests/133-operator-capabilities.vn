import { describe, it, expect } from "std:test";

class Vec2 {
    x: int
    y: int
    constructor(x: int, y: int) { this.x = x; this.y = y }
    add(o: Vec2): Vec2 { return new Vec2(this.x + o.x, this.y + o.y) }
    sub(o: Vec2): Vec2 { return new Vec2(this.x - o.x, this.y - o.y) }
    mul(k: int): Vec2 { return new Vec2(this.x * k, this.y * k) }
    div(k: int): Vec2 { return new Vec2(this.x / k, this.y / k) }
    neg(): Vec2 { return new Vec2(-this.x, -this.y) }
    rem(k: int): Vec2 { return new Vec2(this.x % k, this.y % k) }
    pow(k: int): Vec2 { return new Vec2(this.x ** k, this.y ** k) }
    equals(o: Vec2): bool { return this.x === o.x && this.y === o.y }
    compare(o: Vec2): int { return (this.x * this.x + this.y * this.y) - (o.x * o.x + o.y * o.y) }
}

const a = new Vec2(1, 2)
const b = new Vec2(3, 4)
const s = a + b

let maybe: Vec2? = null

class Plain { v: int; constructor(v: int) { this.v = v } }
const p = new Plain(1)
await describe("133 operator capabilities", async () => {
        await it("group 1 part 1", async () => {
        expect(s.x === 4 && s.y).toBe(6);
        expect((b - a).x).toBe(2);
        expect((a * 3).y).toBe(6);
        expect((b / 1).x).toBe(3);
        expect((-a).x).toBe(-1);
    });

    await it("group 1 part 2", async () => {
        expect((b % 2).x === 1 && (b % 2).y).toBe(0);
        expect((b ** 2).x === 9 && (b ** 2).y).toBe(16);
        expect((a + b - a).equals(b)).toBeTruthy();
        expect(a + b == new Vec2(4, 6)).toBeTruthy();
        expect(a != b).toBeTruthy();
    });

    await it("group 1 part 3", async () => {
        expect(a < b && !(b < a)).toBeTruthy();
        expect(a <= a && b >= a).toBeTruthy();
        expect(!(a == null)).toBeTruthy();
        expect(maybe == null).toBeTruthy();
        expect(p == p && !(p == new Plain(1))).toBeTruthy();
    });


});
