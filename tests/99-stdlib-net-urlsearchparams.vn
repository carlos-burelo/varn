import { URLSearchParams, Query, Url, parseURL } from "std:net";
import { describe, it, expect } from "std:test";


// 1. URLSearchParams basic operations
let params = new URLSearchParams("foo=1&bar=2&foo=3");

// 2. URLSearchParams from object
let paramsObj = new URLSearchParams({ page: "1", filter: ["a", "b"] });

// 3. Url.resolve (Relativization)
let base = "https://example.com/api/v1/users";
let rel1 = Url.resolve(base, "123");

let rel2 = Url.resolve(base, "/auth/login?redirect=dashboard#section");

let absUrl = Url.resolve(base, "http://other.org/test");
await describe("99 stdlib net urlsearchparams", async () => {
        await it("group 1 part 1", async () => {
        expect(params.get("foo")).toBe("1");
        expect(params.get("bar")).toBe("2");
        expect(params.getAll("foo").length).toBe(2);
        expect(params.has("bar")).toBeTruthy();
        expect(params.has("baz")).toBeFalsy();
        params.append("baz", "4");
        expect(params.get("baz")).toBe("4");
        params.set("foo", "single");
    });

    await it("group 1 part 2", async () => {
        expect(params.getAll("foo").length).toBe(1);
        expect(params.get("foo")).toBe("single");
        params.delete("bar");
        expect(params.has("bar")).toBeFalsy();
        let strResult = params.toString();
        expect(strResult.includes("foo=single")).toBeTruthy();
        expect(strResult.includes("baz=4")).toBeTruthy();
        expect(paramsObj.get("page")).toBe("1");
    });

    await it("group 1 part 3", async () => {
        expect(paramsObj.getAll("filter").length).toBe(2);
        expect(rel1.toString()).toBe("https://example.com/api/v1/123");
        expect(rel2.toString()).toBe("https://example.com/auth/login?redirect=dashboard#section");
        expect(absUrl.toString()).toBe("http://other.org/test");
    });


});
