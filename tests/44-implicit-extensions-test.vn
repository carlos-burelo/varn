import { describe, it, expect } from "std:test";
import { File, exists as fsExists, remove as fsRemove, FileMode } from "std:fs";
import { Reader, Writer } from "std:io";


function runTest(): void {
    let testFile = "./temp_implicit_ext.txt";
    let backupFile = "./temp_implicit_ext.bak";

    // 1. Escribir a un archivo usando el Stream Writer
    {
        using file = File.open(testFile, FileMode.Write);
        file.write("Maestría de Greenfield en Varn!");
    }

    // Verificar que el archivo existe por el namespace normal
    expect(fsExists(testFile)).toBeTruthy();

    // 2. Leer del archivo usando el método de extensión implícito .readAll()
    let content = "";
    {
        using file: Reader = File.open(testFile, FileMode.Read);
        // .readAll() es un método de extensión en std:io sobre Reader.
        // ¡Se autopropaga y funciona sin imports manuales de extensiones!
        content = file.readAll();
    }
    expect(content).toBe("Maestría de Greenfield en Varn!");

    // 3. Copiar archivo usando el método de extensión implícito .pipeTo()
    {
        using src: Reader = File.open(testFile, FileMode.Read);
        using dst: Writer = File.open(backupFile, FileMode.Write);
        // .pipeTo() es otro método de extensión en std:io sobre Reader.
        src.pipeTo(dst);
    }

    // Verificar que el backup contiene lo mismo
    let backupContent = "";
    {
        using file: Reader = File.open(backupFile, FileMode.Read);
        backupContent = file.readAll();
    }
    expect(backupContent).toBe("Maestría de Greenfield en Varn!");

    // Limpieza
    fsRemove(testFile);
    fsRemove(backupFile);

}
await describe("44 implicit extensions test", async () => {
    await it("tests", async () => {
        
        runTest();
        
    });
});
