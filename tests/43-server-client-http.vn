import { describe, it, expect } from "std:test";
import { fetch, HttpServer, serve, Request, Response, Headers, json, redirect, error } from "std:http";
import { isIP, isIPv4, isIPv6, encodeURIComponent, decodeURIComponent } from "std:net";


async function runHttpVerification() {
    // 1. Test Client: Fetch GET
    let getTask = fetch("http://%/");
    let getRes = await getTask;
    expect(getRes.status).toBe(200);
    expect(getRes.text().length > 0).toBeTruthy();

    // 2. Test Client: Fetch POST with body & headers
    let postTask = fetch("http://%/api", "POST", { "Content-Type": "application/json" }, '{"message":"hello"}');
    let postRes = await postTask;
    expect(postRes.status).toBe(200);
    expect(postRes.text().length > 0).toBeTruthy();

    // 3. Web Standard Headers
    let hdrs = new Headers({ "Content-Type": "application/json", "X-Varn-Engine": "v1" });
    expect(hdrs.get("content-type")).toBe("application/json");
    expect(hdrs.has("x-varn-engine")).toBe(true);
    hdrs.set("Authorization", "Bearer token123");
    expect(hdrs.get("authorization")).toBe("Bearer token123");
    hdrs.delete("x-varn-engine");
    expect(hdrs.has("x-varn-engine")).toBe(false);

    // 4. Web Standard Request & Response
    let req = new Request("http://localhost:8080/api/users", {
        method: "POST",
        headers: { "Accept": "application/json" },
        body: '{"name":"Varn"}'
    });
    expect(req.method).toBe("POST");
    expect(req.url).toBe("http://localhost:8080/api/users");
    expect(req.text()).toBe('{"name":"Varn"}');

    let resp = json({ success: true, count: 42 });
    expect(resp.status).toBe(200);
    expect(resp.ok).toBe(true);
    expect(resp.text().indexOf('"success":true') >= 0).toBeTruthy();

    let redir = redirect("https://varn.dev", 301);
    expect(redir.status).toBe(301);
    expect(redir.headers.get("location")).toBe("https://varn.dev");

    let errResp = error(404, "Not Found");
    expect(errResp.status).toBe(404);
    expect(errResp.ok).toBe(false);

    // 5. Test Server registration & routing configuration
    let app = serve();
    expect(app !== null).toBeTruthy();

    app.get("/api/v1/users", (req: Request) => {
        return json({ users: ["alice", "bob"] });
    })
    .post("/api/v1/users", (req: Request) => {
        return json({ created: true });
    })
    .get("/api/v1/users/:id", (req: Request) => {
        return new Response("<h1>User Profile</h1>", 200, { "Content-Type": "text/html" });
    });

    // 6. Net helpers from std:net
    expect(isIPv4("127.0.0.1")).toBe(true);
    expect(isIPv4("999.999.999.999")).toBe(false);
    expect(isIPv6("::1")).toBe(true);
    expect(isIP("192.168.1.1")).toBe(true);
    expect(encodeURIComponent("hello world&foo=bar")).toBe("hello%20world%26foo%3Dbar");
    expect(decodeURIComponent("hello%20world%26foo%3Dbar")).toBe("hello world&foo=bar");

}
await describe("43 server client http", async () => {
    await it("tests", async () => {
        
        if (!isIsolate) {
            await runHttpVerification();
        }
        
    });
});
