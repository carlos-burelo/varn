import { describe, it, expect } from "std:test";

type StringOrInt = str | int
type MaybeStr = str | null
function processValue(v: StringOrInt): str {
    if (v instanceof str) {
        return "string: " + v;
    } else {
        return "number: " + v;
    }
}
function orNull(v: MaybeStr): int {
    if (v === null) return 0;
    return v.length;
}
class Square2 {
    side: float
    constructor(s: float) { this.side = s; }
    area(): float { return this.side * this.side; }
}
class Circle2 {
    radius: float
    constructor(r: float) { this.radius = r; }
    area(): float { return 3.14 * this.radius * this.radius; }
}
type Shape2 = Square2 | Circle2
function totalArea(shapes: Shape2[]): float {
    let total = 0.0;
    for (const s of shapes) {
        total = total + s.area();
    }
    return total;
}

await describe("15 Unions", async () => {
    await it("primitive unions", () => {
        expect(processValue("hello")).toBe("string: hello");
        expect(processValue(42)).toBe("number: 42");
        expect(orNull(null)).toBe(0);
        expect(orNull("hi")).toBe(2);
    });

    await it("class unions", () => {
        const shapes: Shape2[] = [new Square2(2.0), new Circle2(1.0), new Square2(3.0)];
        const ta = totalArea(shapes);
        expect(ta > 16.0 && ta < 20.0).toBeTruthy();
    });
});
