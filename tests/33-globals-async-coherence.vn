import { describe, it, expect } from "std:test";
import { sleep, parallel } from "std:task"



let shared = 0

async function writer(): int {
    //await sleep(1)
    shared = 7
    return shared
}

async function reader(): int {
    //await sleep(1)
    return shared
}

async function runTest() {
    const results = await parallel([writer(), reader()])
    expect(results[0]).toBe(7)
    expect(results[1]).toBe(7)
}
await describe("33 globals async coherence", async () => {
    await it("tests", async () => {
        
        await runTest()
        
    });
});
