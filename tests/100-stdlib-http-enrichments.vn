import { HttpServer, Request, HttpResponse, Response, json, HttpStatus } from "std:http";
import { describe, it, expect } from "std:test";


// 1. Request Cookies parsing
let reqWithCookies = new Request("http://localhost:3000/api", "GET", {
    "cookie": "session_id=xyz789; theme=dark; logged_in=true"
});

// 2. Request.json and Request.formData
let reqJson = new Request("http://localhost:3000/api", "POST", {
    "content-type": "application/json"
}, "{\"name\":\"Varn\",\"version\":1}");

let parsedJson: dynamic = reqJson.json();

let reqForm = new Request("http://localhost:3000/api", "POST", {
    "content-type": "application/x-www-form-urlencoded"
}, "user=alice&action=login");

let parsedForm = reqForm.formData();

// 3. Middleware Pipeline
let server = new HttpServer();
let middlewareLog: str[] = [];
await describe("100 stdlib http enrichments", async () => {
        await it("group 1 part 1", async () => {
        expect(reqWithCookies.cookies["session_id"]).toBe("xyz789");
        expect(reqWithCookies.cookies["theme"]).toBe("dark");
        expect(reqWithCookies.cookies["logged_in"]).toBe("true");
        expect(parsedJson.name).toBe("Varn");
    });

    await it("group 1 part 2", async () => {
        expect(parsedJson.version).toBe(1);
        expect(parsedForm["user"]).toBe("alice");
        expect(parsedForm["action"]).toBe("login");
        server.use(async (req: Request, res: HttpResponse, next: () => Task<void>) => {
        middlewareLog.push("mw1_before");
        await next();
        middlewareLog.push("mw1_after");
        });
        server.use(async (req: Request, res: HttpResponse, next: () => Task<void>) => {
        middlewareLog.push("mw2_before");
        await next();
        middlewareLog.push("mw2_after");
        });
        server.get("/test", (req: Request, res: HttpResponse) => {
        middlewareLog.push("handler");
        return json({ ok: true });
        });
    });


});
