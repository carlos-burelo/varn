import { describe, it, expect } from "std:test";
import { fromISO, toISOString, fromParts, durationFromString } from "std:time";

function rejects(run: () => int): bool {
    try {
        run()
        return false
    } catch (e) {
        return true
    }
}

await describe("281 time parsing is strict", async () => {
    await it("fromISO reads an instant, with offsets", async () => {
        expect(toISOString(fromISO("2024-02-29T12:00:00Z"))).toBe("2024-02-29T12:00:00.000Z");
        expect(toISOString(fromISO("2024-01-01T00:00:00+05:30"))).toBe("2023-12-31T18:30:00.000Z");
        expect(fromISO("1970-01-01T00:00:01.500Z")).toBe(1500);
    });

    await it("fromISO rejects what is not an instant", async () => {
        expect(rejects(() => fromISO("hello"))).toBeTruthy();
        expect(rejects(() => fromISO("2023-02-29T12:00:00Z"))).toBeTruthy();
        expect(rejects(() => fromISO("2023-13-01T00:00:00Z"))).toBeTruthy();
    });

    await it("durations parse and malformed ones are rejected", async () => {
        expect(durationFromString("PT1H30M")).toBe(5400000);
        expect(durationFromString("P1DT0.5S")).toBe(86400500);
        expect(durationFromString("P2W")).toBe(1209600000);
        expect(rejects(() => durationFromString("1h30m"))).toBeTruthy();
        expect(rejects(() => durationFromString("P"))).toBeTruthy();
        expect(rejects(() => durationFromString("PT5X"))).toBeTruthy();
        expect(rejects(() => durationFromString("PT5"))).toBeTruthy();
    });

    await it("fromParts validates every range", async () => {
        const base = { year: 2024, month: 1, day: 1, hour: 0, minute: 0, second: 0, millisecond: 0 };
        expect(fromParts(base)).toBe(1704067200000);
        expect(rejects(() => fromParts({ year: 2024, month: 1, day: 1, hour: 0, minute: 0, second: 0, millisecond: 5000 }))).toBeTruthy();
        expect(rejects(() => fromParts({ year: 2024, month: -1, day: 1, hour: 0, minute: 0, second: 0, millisecond: 0 }))).toBeTruthy();
    });
});
