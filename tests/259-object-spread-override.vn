import { describe, it, expect } from "std:test";

class Box { v: int = 1; w: int = 2 }

await describe("259 object spread override", async () => {
    await it("a later key replaces the spread member and its type", () => {
        const base = { x: 1, y: 2 };
        const merged = { ...base, x: "s" };
        expect(merged.x.length).toBe(1);
        expect(merged.y + 1).toBe(3);
    });

    await it("a spread after a key replaces it as well", () => {
        const merged = { x: 1, ...{ x: "t" } };
        expect(merged.x).toBe("t");
    });

    await it("class instances spread their fields", () => {
        const merged = { ...new Box(), v: "s" };
        expect(merged.v).toBe("s");
        expect(merged.w).toBe(2);
    });
});
