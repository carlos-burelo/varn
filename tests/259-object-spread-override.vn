import { describe, it, expect } from "std:test";

class Box { v: int = 1; w: int = 2 }

await describe("259 record spread merges", async () => {
    await it("spreading records with different fields merges them", () => {
        const base = { x: 1, y: 2 };
        const merged = { ...base, z: "s" };
        expect(merged.x + merged.y).toBe(3);
        expect(merged.z.length).toBe(1);
    });

    await it("when two spread records share a field the later one wins", () => {
        const defaults = { retries: 3, name: "a", verbose: false };
        const given = { retries: 5, name: "b" };
        const merged = { ...defaults, ...given };
        expect(merged.retries).toBe(5);
        expect(merged.name).toBe("b");
        expect(merged.verbose).toBe(false);
        const retyped = { ...defaults, ...{ retries: "many" } };
        expect(retyped.retries).toBe("many");
        expect(defaults.retries).toBe(3);
    });

    await it("with replaces a field, keeps the type and leaves the original", () => {
        const base = { x: 1, y: 2 };
        const next = base with { x: 5 };
        expect(next.x).toBe(5);
        expect(next.y).toBe(2);
        expect(base.x).toBe(1);
    });

    await it("class instances spread their fields", () => {
        const merged = { ...new Box(), extra: "s" };
        expect(merged.v).toBe(1);
        expect(merged.w).toBe(2);
        expect(merged.extra).toBe("s");
    });
});
