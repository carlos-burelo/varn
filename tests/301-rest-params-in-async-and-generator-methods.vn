import { describe, it, expect } from "std:test";

class Counter {
    async countAsync(label: str, ...extra: int[]): Task<int> {
        return extra.length;
    }

    async noneAsync(label: str, ...extra: int[]): Task<int> {
        return extra.length;
    }

    *each(label: str, ...extra: int[]): Generator<int> {
        for (const n of extra) {
            yield n;
        }
    }
}

await describe("301 rest parameters in async and generator methods", async () => {
    await it("an async method receives its rest arguments as an array", async () => {
        const counter = new Counter();
        expect(await counter.countAsync("a", 1, 2, 3)).toBe(3);
        expect(await counter.noneAsync("a")).toBe(0);
    });

    await it("a generator method receives its rest arguments as an array", async () => {
        const counter = new Counter();
        let sum = 0;
        for (const n of counter.each("a", 4, 5, 6)) {
            sum = sum + n;
        }
        expect(sum).toBe(15);
    });
});
