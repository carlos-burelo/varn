import { describe, it, expect } from "std:test";

function takesFloat(x: float): float { return x + 1; }
function takesDecimal(x: decimal): decimal { return x + 1; }

await describe("26 Numeric Coercion", async () => {
    await it("implicit conversions", () => {
        const i: int = 42;
        const bi: bigint = i;
        expect(bi.toString()).toBe("42");
        const d: decimal = i;
        expect(d.toString()).toBe("42");
    });

    await it("literal adopts context", () => {
        const f: float = 5;
        expect(f).toBe(5.0);
        const neg: float = -3;
        expect(neg).toBe(0.0 - 3.0);
        expect(takesFloat(5)).toBe(6.0);
        expect(takesFloat(1.5) * 2).toBe(5.0);
        expect(2 * takesFloat(1.5)).toBe(5.0);
        expect(takesFloat(1.0) > 1).toBeTruthy();
        expect(takesDecimal(3)).toBe(4.0d);
    });

    await it("explicit and array context", () => {
        const i: int = 42;
        const explicit: float = (i as float) + 2.5;
        expect(explicit).toBe(44.5);
        const xs: float[] = [1, 2, 3];
        expect(xs[2]).toBe(3.0);
    });
});
