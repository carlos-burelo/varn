import { describe, it, expect } from "std:test";

await describe("329 regex match index is in code points", async () => {
    await it("exec reports the index the string methods use", async () => {
        const text = "ñé😀x";
        const m = new Regex("x").exec(text);
        expect(m!.index).toBe(3);
        expect(text.substring(m!.index, m!.index + 1)).toBe("x");
    });
    await it("findAll advances the index across multibyte text", async () => {
        const all = new Regex("a").findAll("éaé😀a");
        expect(all.length).toBe(2);
        expect(all[0].index).toBe(1);
        expect(all[1].index).toBe(4);
    });
    await it("an ascii text keeps byte and code point indexes equal", async () => {
        expect(new Regex("c").exec("abc")!.index).toBe(2);
    });
});
