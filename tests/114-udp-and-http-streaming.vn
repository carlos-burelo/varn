import { UdpSocket, UdpPacket } from "std:net";
import { HttpResponse } from "std:http";
import { AsyncReader } from "std:io";
import { assertEqual, assertTrue, assertNotNull } from "std:test";

print("=== Suite: UDP Sockets & HTTP Streaming Response ===");

async function testUdpCommunication(): Task<void> {
    let srvPort = 19881;
    let cliPort = 19882;

    let server = UdpSocket.bind(srvPort, "127.0.0.1");
    let client = UdpSocket.bind(cliPort, "127.0.0.1");

    assertTrue(server.isOpen);
    assertTrue(client.isOpen);
    assertEqual(server.localPort, srvPort);
    assertEqual(client.localPort, cliPort);

    // 1. Send text datagram
    let sent1 = client.send("127.0.0.1", srvPort, "hello_udp_world");
    assertTrue(sent1 > 0);

    let pkt1 = await server.recv(1024);
    assertNotNull(pkt1);
    let packet1 = pkt1 as UdpPacket;
    assertEqual(packet1.data.toString(), "hello_udp_world");
    assertEqual(packet1.host, "127.0.0.1");
    assertEqual(packet1.port, cliPort);

    // 2. Send binary datagram (Bytes)
    let binData = Bytes.alloc(4);
    binData.setByte(0, 0xDE);
    binData.setByte(1, 0xAD);
    binData.setByte(2, 0xBE);
    binData.setByte(3, 0xEF);

    let sent2 = client.send("127.0.0.1", srvPort, binData);
    assertTrue(sent2 > 0);

    let pkt2 = await server.recv(1024);
    assertNotNull(pkt2);
    let packet2 = pkt2 as UdpPacket;
    assertEqual(packet2.data.length, 4);
    assertEqual(packet2.data.toHex(), "deadbeef");

    server.close();
    client.close();
    assertTrue(!server.isOpen);
    assertTrue(!client.isOpen);

    print("  ✔ std:net (UdpSocket bind, send text/Bytes, recv, close)");
}

class MockChunkReader implements AsyncReader {
    private chunks: Bytes[];
    private idx: int = 0;

    constructor(chunks: Bytes[]) {
        this.chunks = chunks;
    }

    async read(size?: int): Task<Bytes?> {
        if (this.idx >= this.chunks.length) {
            return null;
        }
        let chunk = this.chunks[this.idx];
        this.idx = this.idx + 1;
        return chunk;
    }
}

function testHttpResponseStreamShape(): void {
    let mockChunks: Bytes[] = [
        Bytes.fromString("first chunk\n"),
        Bytes.fromString("second chunk\n")
    ];
    let reader = new MockChunkReader(mockChunks);

    // Verify AsyncReader interface implementation
    assertNotNull(reader);

    // Verify HttpResponse has stream method declared
    let res = new HttpResponse(1);
    assertTrue(res.connId === 1);

    print("  ✔ std:http (HttpResponse.stream interface contracts)");
}

await testUdpCommunication();
testHttpResponseStreamShape();
