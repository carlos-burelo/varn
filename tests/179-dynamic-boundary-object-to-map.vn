import { describe, it, expect } from "std:test";
import { Json } from "std:encoding";

function outcome(f: () => void): str {
    try {
        f()
        return "ok"
    } catch (e) {
        if (e is TypeError) { return e.message }
        return "other: " + e.message
    }
}

function size(m: Map<str, int>): int { return m.size }
function pick(a: int, m: Map<str, int>?, b: str): str {
    if (m == null) { return `${a}${b}-`}
    return `${a}${b}${m.get("k")}`
}
class Bag {
    constructor(public items: Map<str, int>) {}
    count(extra: Map<str, int>): int { return this.items.size + extra.size }
}
type Config = { name: str; limits: Map<str, int> }

await describe("179 explicit collection decoding", async () => {
    await it("a typed decoder constructs a Map without changing its source", () => {
        const parsed: dynamic = Json.parse("{\"a\":1,\"b\":2}")
        const m = Json.parse<Map<str, int>>(Json.stringify(parsed))
        expect(m::type).toBe("Map")
        expect(m.get("a")).toBe(1)
        expect(m.size).toBe(2)
        expect(m.has("b")).toBe(true)
        m.set("z", 9)
        expect(m.get("z")).toBe(9)
        expect(parsed::type).toBe("Object")
    })

    await it("an index signature takes the object as it is, without copying", () => {
        const parsed: dynamic = Json.parse("{\"a\":1,\"b\":2}")
        const dict: { [k: str]: int } = parsed as { [k: str]: int }
        expect(dict::type).toBe("Object")
        expect(dict["a"]).toBe(1)
        dict["c"] = 3
        expect(dict["c"]).toBe(3)
        expect((parsed as { [k: str]: int })["c"]).toBe(3)
        let total = 0
        for (const (k, v) of dict) { total = total + v }
        expect(total).toBe(6)
        let caught = ""
        try { const bad: { [k: str]: int } = Json.parse<{ [k: str]: int }>("{\"a\":\"x\"}") } catch (e) { caught = e.message }
        expect(caught).toBe("type mismatch: expected '{ [key: str]: int }', got 'object'")
    })

    await it("typed decoders check values and construct nested collections", () => {
        expect(outcome(() => { const m: Map<str, int> = Json.parse<Map<str, int>>("{\"a\":\"x\"}") }))
            .toBe("type mismatch: expected 'Map<str, int>', got 'Map'")
        const nested = Json.parse<Map<str, Map<str, int>>>("{\"x\":{\"y\":1}}")
        expect(nested.get("x")?.get("y")).toBe(1)
        const cfg = Json.parse<Config>("{\"name\":\"n\",\"limits\":{\"cpu\":4}}")
        expect(cfg.limits.get("cpu")).toBe(4)
        const many = Json.parse<Map<str, int>[]>("[{\"a\":1},{\"b\":2}]")
        expect(many[1].get("b")).toBe(2)
    })


    await it("holds in a hot loop", () => {
        const o = Json.parse<Map<str, int>>('{"k":1,"j":2}')
        let n = 0
        for (let i = 0; i < 5000; i = i + 1) { n = n + size(o) }
        expect(n).toBe(10000)
    })
})
