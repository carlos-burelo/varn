import { describe, it, expect } from "std:test";
import { Duration, PlainDateTime, nowInstant, Instant } from 'std:time';
import { List, Stack, Queue } from 'std:collections';
import { fetch } from 'std:http';
import { Json } from 'std:encoding';
import { uuid, sha256 } from 'std:crypto';
import { writeText as fsWrite, exists as fsExists, readText as fsRead } from 'std:fs';
import { write as ioWrite, writeln as ioWriteln } from 'std:io';
import { PI as mathPI, abs as mathAbs, min as mathMin, max as mathMax } from 'std:math';
import { platform as sysPlatform, cwd as sysCwd } from 'std:sys';
import { isIP as netIsIP, Query, Url } from 'std:net';
import { Path } from 'std:path';
import { defineMetadata, getMetadata, hasMetadata, MetaKey } from 'std:reflect';
import { sleep, TaskGroup, spawn, parallel } from 'std:task';


// Disposable, AsyncDisposable, Partial, Required, Readonly, Mutable, Record
// are now globally available (prelude) — no import needed.
// Option/Result are core types: in scope with no import.

class ResourceImpl implements Disposable {
    disposed: bool = false;
    dispose(): void {
        this.disposed = true;
    }
}

async function runComprehensiveTest(): Task<void> {

    // 1. std:time
    let d = Duration.from("PT1H30M");
    expect(d.hours).toBe(1);
    let dt = new PlainDateTime(2026, 4, 21, 10, 0, 0, 0);
    expect(dt.year).toBe(2026);
    let t1 = nowInstant();
    expect(t1.toString().length > 0).toBeTruthy();

    // 2. std:math
    expect(mathPI > 3.14 && mathPI < 3.15).toBeTruthy();
    expect(mathAbs(-10.5)).toBe(10.5);
    expect(mathMin(5.0, 3.0, 8.0)).toBe(3.0);
    expect(mathMax(5.0, 3.0, 8.0)).toBe(8.0);

    // 3. std:crypto
    let uuidVal = uuid();
    expect(uuidVal.length).toBe(36);
    let hash = sha256("Hello");
    expect(hash.length).toBe(64);

    // 4. std:json
    let serialized = Json.stringify({ test: "json", value: 123 });
    let parsed = Json.parse(serialized);
    expect(parsed["test"]).toBe("json");
    expect(parsed["value"]).toBe(123);

    
    // 5. std:collections
    let list = new List<str>(["A"]);
    list.add("B");
    expect(list.toArray()[1]).toBe("B");

    let stack = new Stack<int>();
    stack.push(42);
    expect(stack.peek()).toBe(42);
    expect(stack.pop()).toBe(42);

    let queue = new Queue<str>();
    queue.enqueue("first");
    expect(queue.peek()).toBe("first");
    expect(queue.dequeue()).toBe("first");

    let mapInst = new Map<str, int>();
    mapInst.set("key", 100);
    expect(mapInst.has("key")).toBeTruthy();
    expect(mapInst.get("key")).toBe(100);

    let rangeObj = Range.from(1, 5);
    expect(rangeObj.start).toBe(1);
    expect(rangeObj.contains(3)).toBeTruthy();

    // 6. std:fs
    let testFile = "./temp_test_file.txt";
    fsWrite(testFile, "Varn File System Test");
    expect(fsExists(testFile)).toBeTruthy();
    let readContent = fsRead(testFile);
    expect(readContent).toBe("Varn File System Test");

    // 7. std:io
    ioWrite(""); 
    ioWriteln(""); 

    // 8. std:sys
    expect(sysPlatform().length > 0).toBeTruthy();
    expect(sysCwd().length > 0).toBeTruthy();

    // 9. std:net
    expect(netIsIP("127.0.0.1")).toBeTruthy();
    expect(!netIsIP("not-an-ip")).toBeTruthy();
    let urlObj = Url.parse("https://varn-lang.dev:8080/docs?q=1#main");
    expect(urlObj.protocol).toBe("https");
    expect(urlObj.host).toBe("varn-lang.dev");
    expect(urlObj.port).toBe(8080);
    expect(urlObj.path).toBe("/docs");
    expect(urlObj.query.get("q")).toBe("1");
    expect(urlObj.fragment).toBe("main");

    // 10. std:path
    let isWindows = sysPlatform() === "windows";
    let expectedNormalize = isWindows ? "a\\c" : "a/c";
    let expectedJoin = isWindows ? "a\\b\\c" : "a/b/c";
    expect(Path.normalize("a/b/../c")).toBe(expectedNormalize);
    expect(Path.dirname("a/b/c")).toBe("a/b");
    expect(Path.basename("a/b/file.txt")).toBe("file.txt");
    let ext_res = Path.extname("file.txt");
    expect(ext_res).toBe(".txt");
    expect(Path.join("a", "b", "c")).toBe(expectedJoin);

    // 11. std:reflect
    defineMetadata("my_key", "my_val", list);
    expect(getMetadata("my_key", list)).toBe("my_val");
    expect(hasMetadata("my_key", list)).toBeTruthy();

    let mkey = MetaKey.create<str>();
    expect(getMetadata("my_key", list)).toBe("my_val");
    expect(hasMetadata("my_key", list)).toBeTruthy();

    // 12. std:http
    expect(fetch !== null).toBeTruthy();
    let clientTask = fetch("http://%/");
    let clientRes = await clientTask;
    expect(clientRes.status).toBe(200);
    expect(clientRes.body.length > 0).toBeTruthy();

    // 13. std:task
    async function threeHundred(): Task<int> {
        return 100 + 200;
    }
    let h1 = spawn(threeHundred);
    let val = await h1;
    expect(val).toBe(300);

    async function one(): Task<int> { return 1; }
    async function two(): Task<int> { return 2; }
    let all = await parallel([
        one(),
        two(),
    ]);
    expect(all[0] === 1 && all[1] === 2).toBeTruthy();

    using group = new TaskGroup<int>();
    async function ten(): Task<int> { return 10; }
    async function twenty(): Task<int> { return 20; }
    let g1 = group.spawn(ten());
    let g2 = group.spawn(twenty());
    let joined = await group.join();
    expect(joined[0] === 10 && joined[1] === 20).toBeTruthy();

    // 14. std:dispose
    let dispObj = new ResourceImpl();
    {
        using r = dispObj;
        expect(r !== null).toBeTruthy();
        expect(dispObj.disposed).toBe(false);
    }
    expect(dispObj.disposed).toBe(true);

    // 15. std:result (Option) — the ADT, so `Some(x)` is a constructor and the
    // variants can be matched on, not a nullable in disguise.
    let optSome = Some<int>(99);
    let optNone = None;
    expect(optSome.isSome()).toBeTruthy();
    expect(!optNone.isSome()).toBeTruthy();
    expect(optNone.isNone()).toBeTruthy();
    expect(optSome.unwrap()).toBe(99);
    expect(optSome.unwrapOr(50)).toBe(99);
    expect(optNone.unwrapOr(50)).toBe(50);
    match (optSome) {
        Some(v) => expect(v).toBe(99),
        None => expect(false).toBeTruthy(),
    }

    // 16. std:result (Result)
    let resOk = Ok<str, int>("success");
    let resErr = Err<str, int>(500);
    match (resOk) {
        Ok(v) => expect(v).toBe("success"),
        Err(_) => expect(false).toBeTruthy(),
    }
    match (resErr) {
        Ok(_) => expect(false).toBeTruthy(),
        Err(e) => expect(e).toBe(500),
    }
    let resTry = Result.catching<int>(() => {
        return 888;
    });
    match (resTry) {
        Ok(v) => expect(v).toBe(888),
        Err(_) => expect(false).toBeTruthy(),
    }

    // 17. std:test
    expect(true).toBeTruthy();
    expect(true).toBeTruthy();
    expect(777).toBe(777);

    // 18. std:types
    let partialVar: Partial<{ x: int, y: str }> = { x: 42 };
    let readonlyVar: Readonly<{ a: bool }> = { a: true };
    let requiredVar: Required<{ x?: int, y?: str }> = { x: 10, y: "yes" };
    let mutableVar: Mutable<{ readonly a: bool }> = { a: false };
    let recordVar: { [key: str]: int } = { "tested": 100 };

    expect(partialVar.x).toBe(42);
    expect(readonlyVar.a).toBe(true);
    expect(requiredVar.x === 10 && requiredVar.y === "yes").toBeTruthy();
    expect(mutableVar.a).toBe(false);
    expect(recordVar["tested"]).toBe(100);
}
await describe("42 stdlib comprehensive test", async () => {
    await it("tests", async () => {
        if (!isIsolate) {
            await runComprehensiveTest()
        }
    });
});
