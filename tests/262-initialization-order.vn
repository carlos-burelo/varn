import { describe, it, expect } from "std:test";

function readLater(): int { return later }
const later: int = 5

const deferred = () => laterStill
const laterStill: int = 6

function recurse(n: int): int { return n == 0 ? 0 : recurse(n - 1) + 1 }

await describe("262 initialization order", async () => {
    await it("a function body may read a binding declared after it once it ran", () => {
        expect(readLater()).toBe(5);
        expect(deferred()).toBe(6);
        expect(recurse(4)).toBe(4);
    });

    await it("a block shadows the name it declares for the whole block", () => {
        const value = 1;
        {
            const inner = value + 1;
            expect(inner).toBe(2);
        }
        expect(value).toBe(1);
    });
});
