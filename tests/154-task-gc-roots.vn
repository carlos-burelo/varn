import { describe, it, expect } from "std:test";
import { parallel, sleep, Task } from "std:task";

class TaskGcBox {
    v: int
    constructor(v: int) {
        this.v = v
    }
}

async function holdAcrossSuspend(n: int): Task<int> {
    let box = new TaskGcBox(n)
    let items: Array<int> = [n, n + 1, n + 2]
    await sleep(40)
    return box.v + items[2]
}

async function churn(): Task<int> {
    let acc = 0
    for (let i = 0; i < 400000; i = i + 1) {
        let t = new TaskGcBox(i)
        acc = acc + t.v % 3
    }
    return acc
}

async function failsLater(n: int): Task<int> {
    await sleep(10)
    throw new Error("later " + n.toString())
}

async function catchesAfterSuspend(n: int): Task<int> {
    let box = new TaskGcBox(n)
    try {
        await failsLater(n)
    } catch (e) {
        return box.v
    }
    return -1
}

await describe("154 task GC roots", async () => {
    await it("1. parked tasks and the awaiting root survive a collection run by another task", async () => {
        let rootBox = new TaskGcBox(777)
        let rootItems: Array<int> = [1, 2, 3]
        let batch: Array<Task<int>> = []
        for (let i = 0; i < 300; i = i + 1) {
            batch.push(holdAcrossSuspend(i))
        }
        batch.push(churn())
        let res = await parallel(batch)
        let sum = 0
        for (let i = 0; i < 300; i = i + 1) {
            sum = sum + res[i]
        }
        expect(sum).toBe(90300)
        expect(rootBox.v).toBe(777)
        expect(rootItems[2]).toBe(3)
    })

    await it("2. a rejection delivered to a parked task reaches its handler with its locals intact", async () => {
        let batch: Array<Task<int>> = []
        for (let i = 0; i < 200; i = i + 1) {
            batch.push(catchesAfterSuspend(i))
        }
        batch.push(churn())
        let res = await parallel(batch)
        let sum = 0
        for (let i = 0; i < 200; i = i + 1) {
            sum = sum + res[i]
        }
        expect(sum).toBe(19900)
    })

    await it("3. thousands of parked tasks resume with their own state", async () => {
        let batch: Array<Task<int>> = []
        for (let i = 0; i < 5000; i = i + 1) {
            batch.push(holdAcrossSuspend(i))
        }
        let res = await parallel(batch)
        let sum = 0
        for (let i = 0; i < res.length; i = i + 1) {
            sum = sum + res[i]
        }
        expect(sum).toBe(25005000)
    })
})
