import { describe, it, expect } from "std:test";

// A constructor's parameters have the types they declare: an `int`
// parameter is an `int` in the body, not `dynamic`.

class CtorNeg {
    b: int
    constructor(i: int) {
        this.b = -i
    }
}

class CtorMixed {
    total: float
    label: str
    constructor(n: int, f: float, s: str) {
        this.total = (n as float) + f
        this.label = s.toUpperCase()
    }
}

class CtorChild extends CtorNeg {
    c: int
    constructor(i: int, j: int) {
        super(i)
        this.c = -j
    }
}

const mixed = new CtorMixed(2, 0.5, "ok")
const child = new CtorChild(4, 5)
await describe("138 constructor signature", async () => {
    await it("negation in constructor", async () => {
        expect(new CtorNeg(3).b).toBe(-3);
    });

    await it("mixed params and inheritance", async () => {
        expect(mixed.total === 2.5 && mixed.label == "OK").toBeTruthy();
        expect(child.b === -4 && child.c === -5).toBeTruthy();
    });

});
