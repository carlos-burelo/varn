import { randomBytes, pbkdf2, timingSafeEqual, hashPassword, verifyPassword } from "std:crypto";
import { MsgPack } from "std:encoding";
import { describe, it, expect } from "std:test";


function testCryptoPrimitives(): void {
    // 1. randomBytes returning Bytes
    let rnd = randomBytes(32);
        expect(rnd.length).toBe(32);;
    let rndHex = rnd.toHex();
        expect(rndHex.length).toBe(64);;

    // 2. pbkdf2 derivation
    let salt = Bytes.fromString("mysalt123");
    let key1 = pbkdf2("my_password", salt, 1000, 32);
    let key2 = pbkdf2("my_password", salt, 1000, 32);
        expect(key1.length).toBe(32);;
        expect(key1.toHex()).toBe(key2.toHex());;

    let differentKey = pbkdf2("other_password", salt, 1000, 32);
        expect(key1.toHex() !== differentKey.toHex()).toBeTruthy();;

    // 3. timingSafeEqual
        expect(timingSafeEqual(key1, key2)).toBeTruthy();;
        expect(timingSafeEqual(key1, differentKey)).toBeFalsy();;
        expect(timingSafeEqual("constant_time_secret", "constant_time_secret")).toBeTruthy();;
        expect(timingSafeEqual("constant_time_secret", "wrong_secret")).toBeFalsy();;

    // 4. hashPassword and verifyPassword
    let hash = hashPassword("super_secure_varn_2026", 1000);
        expect(hash.startsWith("$pbkdf2-sha256$i=1000$")).toBeTruthy();;
        expect(verifyPassword("super_secure_varn_2026", hash)).toBeTruthy();;
        expect(verifyPassword("wrong_attempt", hash)).toBeFalsy();;
        expect(verifyPassword("super_secure_varn_2026_suffix", hash)).toBeFalsy();;

}

function testMsgPackPrimitives(): void {
    // Null
    let nullBytes = MsgPack.encode(null);
    let nullDec = MsgPack.decode(nullBytes);
        expect(nullDec).toBe(null);;

    // Booleans
    let trueBytes = MsgPack.encode(true);
        expect(MsgPack.decode(trueBytes)).toBe(true);;
    let falseBytes = MsgPack.encode(false);
        expect(MsgPack.decode(falseBytes)).toBe(false);;

    // Small integers (positive and negative fixint)
        expect(MsgPack.decode(MsgPack.encode(0))).toBe(0);;
        expect(MsgPack.decode(MsgPack.encode(42))).toBe(42);;
        expect(MsgPack.decode(MsgPack.encode(127))).toBe(127);;
        expect(MsgPack.decode(MsgPack.encode(-1))).toBe(-1);;
        expect(MsgPack.decode(MsgPack.encode(-32))).toBe(-32);;

    // Larger integers
        expect(MsgPack.decode(MsgPack.encode(250))).toBe(250);;
        expect(MsgPack.decode(MsgPack.encode(65000))).toBe(65000);;
        expect(MsgPack.decode(MsgPack.encode(1000000))).toBe(1000000);;

    // Strings
    let shortStr = "Hello Varn MsgPack";
        expect(MsgPack.decode(MsgPack.encode(shortStr))).toBe(shortStr);;

    let mediumStr = "Varn ".repeat(50);
        expect(MsgPack.decode(MsgPack.encode(mediumStr))).toBe(mediumStr);;

    // Raw Bytes (binary format)
    let rawBin = Bytes.alloc(4);
    rawBin.setByte(0, 10);
    rawBin.setByte(1, 20);
    rawBin.setByte(2, 30);
    rawBin.setByte(3, 40);
    let binEncoded = MsgPack.encode(rawBin);
    let binDecoded: Bytes = MsgPack.decode(binEncoded);
        expect(binDecoded.length).toBe(4);;
        expect(binDecoded.getByte(0)).toBe(10);;
        expect(binDecoded.getByte(3)).toBe(40);;

}

function testMsgPackStructured(): void {
    // Arrays
    let list = [1, 2, 3, "four", true];
    let listEnc = MsgPack.encode(list);
    let listDec: dynamic[] = MsgPack.decode(listEnc);
        expect(listDec.length).toBe(5);;
        expect(listDec[0]).toBe(1);;
        expect(listDec[3]).toBe("four");;
        expect(listDec[4]).toBe(true);;

    // Objects / Maps
    let user = {
        name: "Alice",
        age: 30,
        active: true,
        skills: ["systems", "compilers"],
        meta: {
            tier: 1
        }
    };

    let userEnc = MsgPack.encode(user);
    let userDec: dynamic = MsgPack.decode(userEnc);
        expect(userDec["name"]).toBe("Alice");;
        expect(userDec["age"]).toBe(30);;
        expect(userDec["active"]).toBe(true);;
        expect(userDec["skills"].length).toBe(2);;
        expect(userDec["skills"][0]).toBe("systems");;
        expect(userDec["skills"][1]).toBe("compilers");;
        expect(userDec["meta"]["tier"]).toBe(1);;

}
await describe("115 crypto kdf and msgpack", async () => {
    await it("crypto primitives", async () => {
        testCryptoPrimitives();
    });

    await it("msgpack primitives", async () => {
        testMsgPackPrimitives();
    });

    await it("msgpack structured", async () => {
        testMsgPackStructured();
    });

});
