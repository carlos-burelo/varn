import { describe, it, expect } from "std:test";


// Tests for Phase 3 of varn-opt unsupported features parity

// 1. for-await-of loops (asynchronous iteration)
class AsyncCounter {
    i: int;
    constructor() {
        this.i = 0;
    }
    async next() {
        if (this.i < 3) {
            let val = this.i;
            this.i = this.i + 1;
            return { value: val, done: false };
        } else {
            return { value: null, done: true };
        }
    }
}

const myAsyncIterable = {
    "Symbol.asyncIterator": function() {
        return new AsyncCounter();
    }
};

async function testForAwait(): int {
    let sum = 0;
    for await (let x of myAsyncIterable) {
        sum = sum + x;
    }
    return sum;
}

// 2. using statement destructuring
class PremiumDisposable {
    res1: int;
    res2: int;
    disposed: bool;
    constructor() {
        this.res1 = 100;
        this.res2 = 200;
        this.disposed = false;
    }
    dispose(): void {
        this.disposed = true;
    }
}

function testUsingDestructure(): void {
    let resource = new PremiumDisposable();
    {
        using { res1, res2 } = resource;
        expect(res1).toBe(100);
        expect(res2).toBe(200);
    }
    expect(resource.disposed).toBeTruthy();
}

// 3. destructuring a caught error after instanceof narrowing
class CustomError extends Error {
    code: int;
    constructor(message: str, code: int) {
        super(message);
        this.code = code;
    }
}

function testCatchDestructure(): void {
    try {
        throw new CustomError("process failed", 500);
    } catch (e) {
        if (e instanceof CustomError) {
            const { message, code } = e;
            expect(message).toBe("process failed");
            expect(code).toBe(500);
        }
    }
}

// 4. Nested namespaces
namespace OuterNS {
    export namespace InnerNS {
        export function getVal(): int {
            return 42;
        }
    }
}

function testNestedNamespace(): void {
    expect(OuterNS.InnerNS.getVal()).toBe(42);
}

function testLocalNamespace(): void {
    namespace LocalNS {
        export function nested(): str {
            return "local";
        }
    }
    expect(LocalNS.nested()).toBe("local");
}

// Execution block
async function runAll(): void {
    let sum = await testForAwait();
    expect(sum).toBe(3);

    testUsingDestructure();
    testCatchDestructure();
    testNestedNamespace();
    testLocalNamespace();
}
await describe("50 opt unsupported phase3", async () => {
    await it("tests", async () => {
        
        await runAll();
        
        
    });
});
