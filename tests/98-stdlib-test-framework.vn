import { describe, it, expect, beforeEach, afterEach } from "std:test";

let hookCounter = 0;

await describe("Math & Assertions Subsuite", async () => {
    beforeEach(() => {
        hookCounter = hookCounter + 1;
    });

    afterEach(() => {
        hookCounter = hookCounter * 2;
    });

    await it("runs test with lifecycle hooks", () => {
        expect(hookCounter).toBe(1);
        expect(false).toBeFalsy();
        expect(null).toBeNull();
        expect("hello").toBeNotNull();
        expect(10 === 20).toBeFalsy();
        expect("abcdef").toContain("bcd");
        expect([1, 2, 3]).toContain(2);
        expect(3.14159).toBeCloseTo(3.14160, 0.001);
    });

    await it("verifies assertThrows", () => {
        expect(() => {
            throw new Error("Custom Error Message");
        }).toThrow("Custom Error");
    });
});

expect(hookCounter).toBe(6);
