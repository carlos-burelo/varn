import { describe, it, expect } from "std:test";

await describe("03 Strings", async () => {
    await it("trim and case", () => {
        const s = "  Hello, World!  ";
        expect(s.trim()).toBe("Hello, World!");
        expect(s.trimStart()).toBe("Hello, World!  ");
        expect(s.trimEnd()).toBe("  Hello, World!");
        expect("hello".toUpperCase()).toBe("HELLO");
        expect("WORLD".toLowerCase()).toBe("world");
    });

    await it("search and slice", () => {
        expect("typescript".includes("script")).toBeTruthy();
        expect(!"typescript".includes("java")).toBeTruthy();
        expect("hello world".startsWith("hello")).toBeTruthy();
        expect("hello world".endsWith("world")).toBeTruthy();
        expect("abcabc".indexOf("c")).toBe(2);
        expect("abcabc".indexOf("z")).toBe(-1);
        expect("hello world".slice(6, 11)).toBe("world");
        expect("hello world".slice(-5)).toBe("world");
        expect("foo bar foo".replace("foo", "baz")).toBe("baz bar foo");
        expect("foo bar foo".replaceAll("foo", "baz")).toBe("baz bar baz");
        expect("a,b,c".split(",").length).toBe(3);
        expect("a,b,c".split(",")[1]).toBe("b");
    });

    await it("padding and char inspection", () => {
        expect("ab".repeat(3)).toBe("ababab");
        expect("5".padStart(3, "0")).toBe("005");
        expect("5".padEnd(3, "0")).toBe("500");
        expect("hello".length).toBe(5);
        expect("hello".at(1)).toBe("e");
        expect("A".charCode()).toBe(65);
        expect("Hello".concat(" World")).toBe("Hello World");
        expect("abcdef".substr(2, 3)).toBe("cde");
        expect("abcdef".substr(1)).toBe("bcdef");
    });

    await it("predicates and str helpers", () => {
        expect("".isEmpty()).toBeTruthy();
        expect(!"hi".isEmpty()).toBeTruthy();
        expect("   ".isBlank()).toBeTruthy();
        expect(!"hi".isBlank()).toBeTruthy();
        expect("7".isDigit()).toBeTruthy();
        expect(!"a".isDigit()).toBeTruthy();
        expect("z".isLetter()).toBeTruthy();
        expect(!" ".isLetter()).toBeTruthy();
        expect("abc".reverse()).toBe("cba");
        expect("hello".capitalize()).toBe("Hello");
        expect("a\nb\nc".lines().length).toBe(3);
        expect("  foo bar  ".words().length).toBe(2);
        expect(str.from(42)).toBe("42");
        expect(str.from(true)).toBe("true");
        expect(str.EMPTY).toBe("");
        expect(str.fromCharCode(72, 105)).toBe("Hi");
        expect(str.join(["a", "b", "c"], "-")).toBe("a-b-c");
        expect(str.join([], ",")).toBe("");
    });
});
