function sliceLen(a: dynamic): int {
  let s = a.slice(1, 3)
  return s.length
}
function pushLen(a: dynamic): int {
  a.push(40)
  return a.length
}
function firstPlus(a: dynamic): int {
  return a.slice(0, 1).length + a.length
}
let arr = [10, 20, 30]
print(sliceLen(arr))
print(pushLen(arr))
print(firstPlus(arr))
