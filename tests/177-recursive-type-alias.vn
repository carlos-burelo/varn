import { describe, it, expect } from "std:test";

type Link = { value: int, next: Link? }
type Branch = { label: str, kids: Branch[] }

function length(head: Link?): int {
    let node: Link? = head
    let count = 0
    while (node != null) {
        count = count + 1
        node = node.next
    }
    return count
}

function leaves(tree: Branch): int {
    if (tree.kids.length == 0) { return 1 }
    let total = 0
    for (const kid of tree.kids) { total = total + leaves(kid) }
    return total
}

await describe("177 recursive type alias", async () => {
    await it("a recursive alias is assignable to itself through its fields", () => {
        const list: Link = { value: 9, next: { value: 8, next: { value: 7, next: null } } }
        expect(length(list)).toBe(3)
        expect(length(null)).toBe(0)
    })

    await it("a recursive alias through an array", () => {
        const tree: Branch = {
            label: "root",
            kids: [{ label: "a", kids: [] }, { label: "b", kids: [{ label: "c", kids: [] }] }],
        }
        expect(leaves(tree)).toBe(2)
    })
})
