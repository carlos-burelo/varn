import { describe, it, expect } from "std:test";


// 1. Basic Enums & Singleton Identity
enum Direction {
    North,
    South,
    East,
    West
}

// 2. Explicit Raw Values
enum Status {
    Pending,
    Success = 10,
    Error
}

// 3. Payload Variants & Construction (Positional & Named)
enum Token {
    Identifier(name: str),
    Number(value: float),
    String(value: str),
    Plus,
    Minus
}

// 4. Shared Fields & Constructors
enum CustomHttpStatus {
    Ok(200, "OK"),
    NotFound(404, "Not Found");

    code: int
    message: str

    constructor(code: int, message: str) {
        this.code = code
        this.message = message
    }
}

// 5. Instance Methods with Pattern Matching on 'this'
enum Shape {
    Circle(radius: float),
    Rectangle(width: float, height: float);

    area(): float {
        return match (this) {
            Circle(radius) => 3.14159 * radius * radius,
            Rectangle(width, height) => width * height
        }
    }
}

// 6. Generic Enums
enum Result<T, E> {
    Ok(value: T),
    Err(error: E)
}

// 7. Interface Implementation
interface Display {
    toString(): str
}

enum CustomDisplay implements Display {
    A,
    B;

    toString(): str {
        return "CustomDisplay." + this.name
    }
}
await describe("41 advanced enums", async () => {
    await it("tests", async () => {
        
        const dir = Direction.North
        expect(dir.name).toBe("North")
        expect(dir.rawValue).toBe(0)
        expect(Direction.North).toBe(Direction.North)
        expect(Direction.North !== Direction.South).toBeTruthy()
        
        expect(Status.Pending.rawValue).toBe(0)
        expect(Status.Success.rawValue).toBe(10)
        expect(Status.Error.rawValue).toBe(11)
        
        const t1 = Token.Number(123)
        const t2 = Token.Identifier(name: "hello")
        
        Token.Number(456) // Another instance of Number variant
        
        expect(t1.name).toBe("Number")
        expect(t1.value).toBe(123)
        expect(t2.name).toBe("hello")
        
        // Pattern matching on payload variants
        const v1 = match (t1) {
            Number(val) => val,
            _ => 0
        }
        expect(v1).toBe(123)
        
        const v2 = match (t2) {
            Identifier(n) => n,
            _ => "none"
        }
        expect(v2).toBe("hello")
        
        expect(CustomHttpStatus.Ok.code).toBe(200)
        expect(CustomHttpStatus.Ok.message).toBe("OK")
        expect(CustomHttpStatus.NotFound.code).toBe(404)
        expect(CustomHttpStatus.NotFound.message).toBe("Not Found")
        
        const circle = Shape.Circle(10.0)
        const rect = Shape.Rectangle(10.0, 20.0)
        
        expect(circle.area()).toBe(314.159)
        expect(rect.area()).toBe(200.0)
        
        const resOk = Result.Ok<int, str>(42)
        const valOk = match (resOk) {
            Ok(val) => val,
            Err(err) => 0
        }
        expect(valOk).toBe(42)
        
        expect(CustomDisplay.A.toString()).toBe("CustomDisplay.A")
        
        
    });
});
