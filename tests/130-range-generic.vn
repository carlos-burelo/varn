import { describe, it, expect } from "std:test";

const ints: Range<int> = 0..5

const letters: Range<char> = 'a'..='e'

let word = ""

const evens = (0..10).step(2)

let total = 0

function badStep(): bool {
    try { (0..3).step(0); return false } catch (e) { return true }
}
await describe("130 range generic", async () => {
        await it("group 1 part 1", async () => {
        expect(ints.length === 5 && ints.end).toBe(5);
        expect(letters.length).toBe(5);
        expect(letters.start === 'a' && letters.end).toBe('e');
        expect(letters.contains('c') && !letters.contains('z')).toBeTruthy();
        expect(letters.toArray().join("")).toBe("abcde");
        for (const c of 'x'..='z') { word = word + c }
        expect(word).toBe("xyz");
    });

    await it("group 1 part 2", async () => {
        expect(evens.length === 5 && evens[4]).toBe(8);
        expect(evens.contains(4) && !evens.contains(5)).toBeTruthy();
        expect(evens.step(2).toArray().join(",")).toBe("0,4,8");
        for (const i of (1..=9).step(4)) { total = total + i }
        expect(total).toBe(1 + 5 + 9);
        expect(badStep()).toBeTruthy();
    });


});
