import { describe, it, expect } from "std:test";

function kindInLoopFunction(): str {
    const pair = #[1, "a"]
    let n = 0
    for (let i = 0; i < 2000; i = i + 1) { n = n + 1 }
    return typeof pair
}

function make(i: int): #[int, str] { return #[i, "x"] }

function sumFirsts(count: int): int {
    let total = 0
    for (let i = 0; i < count; i = i + 1) {
        const pair = make(i)
        if (typeof pair == "Tuple") { total = total + pair[0] }
    }
    return total
}

await describe("166 tuple literal in compiled code", async () => {
    await it("a tuple literal stays a tuple in a function with a loop", () => {
        expect(kindInLoopFunction()).toBe("Tuple")
    })

    await it("a tuple built in a hot callee stays a tuple", () => {
        expect(sumFirsts(3000)).toBe(4498500)
    })
})
