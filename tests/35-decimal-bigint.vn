import { describe, it, expect } from "std:test";



// Arithmetic with widened int
function sumDecimal(a: decimal, b: decimal): decimal { return a + b }

// decimal is decimal narrowing
function isDecimalType(v: decimal): bool { return v is decimal }

// bigint is bigint
function isBigInt(v: bigint): bool { return v is bigint }

function decKind(f: () => decimal): str {
    try { f(); return "none" } catch (e) {
        if (e instanceof DivisionByZero) { return "zero" }
        return "other"
    }
}
await describe("35 decimal bigint", async () => {
    await it("tests", async () => {
        
        // ── Decimal literals and arithmetic ─────────────────────────────
        const d1: decimal = 1.5d
        const d2: decimal = 2.5d
        expect(d1 + d2).toBe(4.0d)
        expect(d2 - d1).toBe(1.0d)
        expect(d1 * d2).toBe(3.75d)
        expect(1.0d).toBe(1.0d)
        expect(1.0d !== 2.0d).toBeTruthy()
        expect(d1 < d2).toBeTruthy()
        expect(d1 <= d1).toBeTruthy()
        expect(d2 > d1).toBeTruthy()
        expect(d2 >= d2).toBeTruthy()
        
        // toFixed — exact decimal rounding
        const pi_d: decimal = 3.14159d
        expect(pi_d.toFixed(2)).toBe("3.14")
        expect(pi_d.toFixed(0)).toBe("3")
        expect(pi_d.toFixed(4)).toBe("3.1416")
        
        // Instance methods
        const neg: decimal = -7.5d
        expect(neg.abs()).toBe(7.5d)
        expect(neg.negate()).toBe(7.5d)
        expect(d2.floor()).toBe(2.0d)
        expect(d1.ceil()).toBe(2.0d)
        expect(d1.round()).toBe(2.0d)
        expect((0.0d).isZero()).toBeTruthy()
        expect(d1.isPositive()).toBeTruthy()
        expect(neg.isNegative()).toBeTruthy()
        expect((2.9d).trunc()).toBe(2.0d)
        
        // Widening from int
        const iv: int = 5
        const dv: decimal = iv
        expect(dv.toString()).toBe("5")
        expect(sumDecimal(3, 2.0d)).toBe(5.0d)
        expect(isDecimalType(1.0d)).toBeTruthy()
        
        // ── BigInt ───────────────────────────────────────────────────────
        const bi1: bigint = 100n
        const bi2: bigint = 1n
        expect(bi1.toString()).toBe("100")
        expect(bi2.toStr()).toBe("1")
        expect(bi1.toInt()).toBe(100)
        expect(bi2.toFloat()).toBe(1.0)
        expect(100n).toBe(100n)
        expect(1n !== 2n).toBeTruthy()
        expect(bi2 < bi1).toBeTruthy()
        expect(bi1 > bi2).toBeTruthy()
        
        // int ↔ bigint equality (cross-type comparison)
        expect(42n).toBe(42n)
        expect(42n !== 43n).toBeTruthy()
        expect(isBigInt(100n)).toBeTruthy()
        
        // ── Arbitrary precision (ADR-0016) ───────────────────────────────
        const wide: decimal = 12345678901234567890.123456789012345678d
        expect((wide + 0.000000000000000001d).toString()).toBe("12345678901234567890.123456789012345679")
        expect((1.5d * 2.0d).toString()).toBe("3.00")
        expect((1.0d / 4.0d)).toBe(0.25d)
        expect((1.0d / 3.0d).toString()).toBe("0.3333333333333333333333333333333333")
        expect((-7.5d % 2.0d)).toBe(-1.5d)
        expect(1.0d).toBe(1.00d)
        expect((1.1d).pow(2)).toBe(1.21d)
        expect(decimal.parse(" 2.50 ")).toBe(2.5d)
        expect(decimal.tryParse("x")).toBe(null)
        expect(decKind(() => 1.0d / 0.0d)).toBe("zero")
        expect(decKind(() => 1.0d % 0.0d)).toBe("zero")
        
    });
});
