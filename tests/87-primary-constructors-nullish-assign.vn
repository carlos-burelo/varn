import { describe, it, expect } from "std:test";

// Test Suite 87: Primary Constructors (C# & TypeScript styles) and Null-Coalescing Assignment (??=)

// C# / Kotlin style Primary Constructor
class User(public id: int, public name: str, private role: str = "guest") {
    greet(): str {
        return `User #${this.id}: ${this.name} [${this.role}]`;
    }

    getRole(): str {
        return this.role;
    }
}

// C# / Kotlin style without explicit modifiers
class Point(x: int, y: int) {
    sum(): int {
        return this.x + this.y;
    }
}

// TypeScript style Parameter Properties in constructor
class Hero {
    constructor(public id: int, public name: str, private power: float = 95.5) {}

    getPower(): float {
        return this.power;
    }
}

class AppConfig {
    timeout: int? = null;
    retries: int? = null;
}
await describe("87 primary constructors nullish assign", async () => {
    await it("primary constructors", async () => {
        let u1 = new User(1, "Alice", "admin");
        expect(u1.id).toBe(1);
        expect(u1.name).toBe("Alice");
        expect(u1.getRole()).toBe("admin");
        expect(u1.greet()).toBe("User #1: Alice [admin]");
        let u2 = new User(2, "Bob");
        expect(u2.id).toBe(2);
        expect(u2.name).toBe("Bob");
        expect(u2.getRole()).toBe("guest");
        expect(u2.greet()).toBe("User #2: Bob [guest]");
        let pt = new Point(10, 25);
        expect(pt.x).toBe(10);
        expect(pt.y).toBe(25);
        expect(pt.sum()).toBe(35);
    });

    await it("parameter properties", async () => {
        let h1 = new Hero(101, "Superman");
        expect(h1.id).toBe(101);
        expect(h1.name).toBe("Superman");
        expect(h1.getPower()).toBe(95.5);
        let h2 = new Hero(102, "Batman", 80.0);
        expect(h2.id).toBe(102);
        expect(h2.name).toBe("Batman");
        expect(h2.getPower()).toBe(80.0);
    });

    await it("nullish assignment", async () => {
        let a: int? = null;
        a ??= 42;
        expect(a).toBe(42);
        a ??= 999;
        expect(a).toBe(42);
        let cfg = new AppConfig();
        expect(cfg.timeout).toBeNull();
        cfg.timeout ??= 3000;
        expect(cfg.timeout).toBe(3000);
        cfg.timeout ??= 8000;
        expect(cfg.timeout).toBe(3000);
        let items: dynamic[] = [null, "existing", null];
        items[0] ??= "filled_0";
        items[1] ??= "overwritten_1";
        items[2] ??= "filled_2";
        expect(items[0]).toBe("filled_0");
        expect(items[1]).toBe("existing");
        expect(items[2]).toBe("filled_2");
    });
});
