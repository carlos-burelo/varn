import { describe, it, expect } from "std:test";
import { delay } from "std:task";
import { fetch, HttpServer, HttpMethod, Request, Response, redirect } from "std:http";

async function failureOf(run: () => Task<dynamic>): Task<str> {
    try {
        await run()
        return ""
    } catch (e) {
        return e.message
    }
}

await describe("294 fetch follows redirects", async () => {
    const origin = new HttpServer();
    const other = new HttpServer();

    origin.get("/start", async (req: Request) => redirect("/two", 302));
    origin.get("/two", async (req: Request) => new Response("arrived", 200, {}));
    origin.get("/dir/start", async (req: Request) => redirect("sub/page?x=1", 302));
    origin.get("/dir/sub/page", async (req: Request) => new Response("relative " + (req.query["x"] ?? "none"), 200, {}));
    origin.get("/up/start", async (req: Request) => redirect("../two", 302));
    origin.post("/post-redirect", async (req: Request) => redirect("/method", 302));
    origin.get("/method", async (req: Request) => new Response(req.method === HttpMethod.GET ? "GET" : "other", 200, {}));
    origin.post("/keep", async (req: Request) => redirect("/echo-body", 307));
    origin.post("/echo-body", async (req: Request) => new Response("body=" + req.text(), 200, {}));
    origin.get("/loop", async (req: Request) => redirect("/loop", 302));
    origin.get("/to-other", async (req: Request) => redirect("http://127.0.0.1:19921/who", 302));
    other.get("/who", async (req: Request) => new Response("auth=" + (req.headers.get("authorization") ?? "none"), 200, {}));
    origin.get("/who", async (req: Request) => new Response("auth=" + (req.headers.get("authorization") ?? "none"), 200, {}));
    origin.get("/same", async (req: Request) => redirect("/who", 302));

    origin.listen(19920);
    other.listen(19921);
    await delay(150);

    await it("a 302 is followed and the final url is reported", async () => {
        const res = await fetch("http://127.0.0.1:19920/start");
        expect(res.status).toBe(200);
        expect(res.text()).toBe("arrived");
        expect(res.url).toBe("http://127.0.0.1:19920/two");
    });

    await it("relative locations resolve against the current path", async () => {
        const sibling = await fetch("http://127.0.0.1:19920/dir/start");
        expect(sibling.text()).toBe("relative 1");
        const parent = await fetch("http://127.0.0.1:19920/up/start");
        expect(parent.text()).toBe("arrived");
    });

    await it("a POST becomes a GET on 302 but keeps its method and body on 307", async () => {
        const turned = await fetch("http://127.0.0.1:19920/post-redirect", { method: HttpMethod.POST, body: "payload" });
        expect(turned.text()).toBe("GET");
        const kept = await fetch("http://127.0.0.1:19920/keep", { method: HttpMethod.POST, body: "payload" });
        expect(kept.text()).toBe("body=payload");
    });

    await it("credentials are sent to the same origin but dropped across origins", async () => {
        const headers: { [key: str]: str } = { "Authorization": "Bearer secret" };
        const same = await fetch("http://127.0.0.1:19920/same", { headers: headers });
        expect(same.text()).toBe("auth=Bearer secret");
        const cross = await fetch("http://127.0.0.1:19920/to-other", { headers: headers });
        expect(cross.text()).toBe("auth=none");
    });

    await it("followRedirects: false returns the redirect itself", async () => {
        const res = await fetch("http://127.0.0.1:19920/start", { followRedirects: false });
        expect(res.status).toBe(302);
        expect(res.headers.get("location")).toBe("/two");
    });

    await it("a redirect loop stops at the limit", async () => {
        const message = await failureOf(() => fetch("http://127.0.0.1:19920/loop", { maxRedirects: 3 }));
        expect(message.indexOf("more than 3 redirects") !== null).toBeTruthy();
    });

    origin.close();
    other.close();
});
