import { CSV, JSON } from "std:encoding";
import { describe, it, expect } from "std:test";

// 1. Basic CSV parsing with header and automatic type coercion via CSV.parse
let csvBasic = "id,name,age,active,score\n1,Alice,30,true,95.5\n2,Bob,25,false,88.0\n3,Charlie,35,true,99.25";
let users = CSV.parse(csvBasic);


// 2. Custom delimiter parsing (semicolon)
let csvSemi = "id;product;price;inStock\n101;Mechanical Keyboard;129.99;true\n102;Wireless Mouse;49.50;false";
let products = CSV.parse(csvSemi, { delimiter: ";" });


// 3. RFC 4180 Escaped quotes, commas inside quotes, and newlines inside quotes
let csvQuotes = "id,title,description\n1,\"Special, Item\",\"Item with \"\"double quotes\"\" inside\"\n2,\"Multi-line\nItem\",\"Second line content\"";
let items = CSV.parse(csvQuotes);


// 4. Raw Matrix Parsing (hasHeader = false)
let csvMatrix = "10,20,30\n40,50,60\n70,80,90";
let matrix = CSV.parse(csvMatrix, { hasHeader: false });

// 5. Stringify Objects to CSV
let serialized = CSV.stringify(users);

// 6. Roundtrip Serialization / Deserialization
let roundtrip = CSV.parse(serialized);

// 7. Stringify Raw Rows (Arrays of Arrays)
let serializedMatrix = CSV.stringify(matrix);
let roundtripMatrix = CSV.parse(serializedMatrix, { hasHeader: false });

// 8. JSON Namespace validation (JSON.parse, JSON.stringify)
let jsonObj = JSON.parse("{\"message\": \"hello\", \"status\": 200}");
let jsonStr = JSON.stringify(jsonObj);

// 9. Generic Typed JSON.parse<T> & CSV.parse<T>
class UserDto {
    id: int;
    name: str;
}
let typedUsers = CSV.parse<UserDto>(csvBasic);

class ApiResponse {
    message: str;
    status: int;
}
let typedJson = JSON.parse<ApiResponse>("{\"message\": \"hello\", \"status\": 200}");
await describe("82 std csv", async () => {
        await it("group 1 part 1", async () => {
        expect(users.length).toBe(3);
        expect(users[0].id).toBe(1);
        expect(users[0].name).toBe("Alice");
        expect(users[0].age).toBe(30);
        expect(users[0].active).toBe(true);
        expect(users[0].score).toBe(95.5);
        expect(users[1].id).toBe(2);
        expect(users[1].name).toBe("Bob");
        expect(users[1].active).toBe(false);
        expect(products.length).toBe(2);
        expect(products[0].id).toBe(101);
        expect(products[0].product).toBe("Mechanical Keyboard");
        expect(products[0].price).toBe(129.99);
        expect(products[0].inStock).toBe(true);
        expect(products[1].id).toBe(102);
        expect(products[1].product).toBe("Wireless Mouse");
    });

    await it("group 1 part 2", async () => {
        expect(products[1].price).toBe(49.50);
        expect(products[1].inStock).toBe(false);
        expect(items.length).toBe(2);
        expect(items[0].id).toBe(1);
        expect(items[0].title).toBe("Special, Item");
        expect(items[0].description).toBe("Item with \"double quotes\" inside");
        expect(items[1].id).toBe(2);
        expect(items[1].title).toBe("Multi-line\nItem");
        expect(items[1].description).toBe("Second line content");
        expect(matrix.length).toBe(3);
        expect(matrix[0][0]).toBe(10);
        expect(matrix[0][1]).toBe(20);
        expect(matrix[0][2]).toBe(30);
        expect(matrix[1][0]).toBe(40);
        expect(matrix[2][2]).toBe(90);
        expect(serialized.startsWith("id,name,age,active,score\n")).toBeTruthy();
    });

    await it("group 1 part 3", async () => {
        expect(serialized.includes("1,Alice,30,true,95.5")).toBeTruthy();
        expect(serialized.includes("2,Bob,25,false,88")).toBeTruthy();
        expect(roundtrip.length).toBe(3);
        expect(roundtrip[0].id).toBe(1);
        expect(roundtrip[0].name).toBe("Alice");
        expect(roundtrip[2].id).toBe(3);
        expect(roundtrip[2].score).toBe(99.25);
        expect(roundtripMatrix.length).toBe(3);
        expect(roundtripMatrix[1][1]).toBe(50);
        expect((jsonObj as dynamic).status).toBe(200);
        expect(jsonStr.includes("\"status\":200")).toBeTruthy();
        expect(typedUsers[0].name).toBe("Alice");
        expect(typedUsers[1].id).toBe(2);
        expect(typedJson.status).toBe(200);
        expect(typedJson.message).toBe("hello");
    });


});
