import { describe, it, expect } from "std:test";
import {
    UiWindow, UiFrame, Focus, TextEdit, Widget,
    Text, Box, Column, Row, Button, Field, render, present, run,
    Checkbox, Each, Spacer, Divider,
    MOUSE_LEFT, UiInjectKind
} from "std:ui";
import { measure, ascent, descent } from "std:ui/text";

function tapEnter(win: UiWindow, fr: UiFrame, focus: Focus, tree: Widget): void {
    win.inject(UiInjectKind.Key, 13, 1, 0);
    fr.update(win);
    render(win, fr, focus, tree, 10.0, 10.0, 200.0, 44.0);
    present(win, fr);
    win.inject(UiInjectKind.Key, 13, 0, 0);
    fr.update(win);
    render(win, fr, focus, tree, 10.0, 10.0, 200.0, 44.0);
    present(win, fr);
}

await describe("219 widgets", async () => {
    await it("renders a tree headless", () => {
        using win = UiWindow.open("t", 800, 600, true);
        const fr = new UiFrame(800, 600);
        const focus = new Focus();
        const ed = new TextEdit();
        const hits: bool[] = [];
        const tree = Column([
            Text("hola"),
            Button("ok", onPress: () => { hits.push(true); }),
            Field(ed, hint: "type")
        ]);
        win.clear(0);
        render(win, fr, focus, tree, 0.0, 0.0, 800.0, 600.0);
        const cmds = win.drawn();
        expect(cmds.length > 3).toBe(true);
        expect(cmds[0].kind).toBe("clear");
    });

    await it("button fires onPress on click", () => {
        using win = UiWindow.open("t", 800, 600, true);
        const fr = new UiFrame(800, 600);
        const focus = new Focus();
        const hits: bool[] = [];
        const tree = Column([Button("ok", onPress: () => { hits.push(true); })]);
        render(win, fr, focus, tree, 0.0, 0.0, 800.0, 600.0);
        present(win, fr);
        expect(hits.length).toBe(0);
        win.inject(UiInjectKind.MouseDown, 30, 20, MOUSE_LEFT);
        fr.update(win);
        render(win, fr, focus, tree, 0.0, 0.0, 800.0, 600.0);
        present(win, fr);
        win.inject(UiInjectKind.MouseUp, 30, 20, MOUSE_LEFT);
        fr.update(win);
        render(win, fr, focus, tree, 0.0, 0.0, 800.0, 600.0);
        present(win, fr);
        expect(hits.length).toBe(1);
    });

    await it("field types through render", () => {
        using win = UiWindow.open("t", 800, 600, true);
        const fr = new UiFrame(800, 600);
        const focus = new Focus();
        const ed = new TextEdit();
        const tree = Field(ed);
        render(win, fr, focus, tree, 10.0, 10.0, 200.0, 44.0);
        present(win, fr);
        expect(ed.focused).toBe(false);
        win.inject(UiInjectKind.MouseDown, 30, 30, MOUSE_LEFT);
        fr.update(win);
        win.inject(UiInjectKind.MouseUp, 30, 30, MOUSE_LEFT);
        fr.update(win);
        render(win, fr, focus, tree, 10.0, 10.0, 200.0, 44.0);
        present(win, fr);
        render(win, fr, focus, tree, 10.0, 10.0, 200.0, 44.0);
        present(win, fr);
        expect(ed.focused).toBe(true);
        win.inject(UiInjectKind.Key, 65, 1, 0);
        fr.update(win);
        render(win, fr, focus, tree, 10.0, 10.0, 200.0, 44.0);
        present(win, fr);
        expect(ed.text).toBe("A");
        win.inject(UiInjectKind.Key, 65, 0, 0);
        fr.update(win);
    });

    await it("row distributes widget widths", () => {
        using win = UiWindow.open("t", 800, 600, true);
        const fr = new UiFrame(800, 600);
        const focus = new Focus();
        const left: bool[] = [];
        const right: bool[] = [];
        const tree = Row([
            Button("l", w: 100.0, onPress: () => { left.push(true); }),
            Button("r", onPress: () => { right.push(true); })
        ], h: 60.0);
        render(win, fr, focus, tree, 0.0, 0.0, 800.0, 60.0);
        present(win, fr);
        win.inject(UiInjectKind.MouseDown, 50, 30, MOUSE_LEFT);
        fr.update(win);
        win.inject(UiInjectKind.MouseUp, 50, 30, MOUSE_LEFT);
        fr.update(win);
        render(win, fr, focus, tree, 0.0, 0.0, 800.0, 60.0);
        present(win, fr);
        expect(left.length).toBe(1);
        expect(right.length).toBe(0);
    });

    await it("checkbox toggles on click", () => {
        using win = UiWindow.open("t", 800, 600, true);
        const fr = new UiFrame(800, 600);
        const focus = new Focus();
        const state = { on: false };
        const tree = Checkbox(state.on, onChange: (next: bool) => { state.on = next; });
        render(win, fr, focus, tree, 10.0, 10.0, 30.0, 30.0);
        present(win, fr);
        win.inject(UiInjectKind.MouseDown, 25, 25, MOUSE_LEFT);
        fr.update(win);
        win.inject(UiInjectKind.MouseUp, 25, 25, MOUSE_LEFT);
        fr.update(win);
        const tree2 = Checkbox(state.on, onChange: (next: bool) => { state.on = next; });
        render(win, fr, focus, tree2, 10.0, 10.0, 30.0, 30.0);
        present(win, fr);
        expect(state.on).toBe(true);
    });

    await it("each builds one row per item", () => {
        using win = UiWindow.open("t", 800, 600, true);
        const fr = new UiFrame(800, 600);
        const focus = new Focus();
        const seen: int[] = [];
        const tree = Each(["a", "b", "c"], (t: str): str => t, (t: str, i: int) => {
            seen.push(i);
            return Text(t);
        }, gap: 4.0);
        win.clear(0);
        render(win, fr, focus, tree, 0.0, 0.0, 300.0, 200.0);
        expect(seen).toEqual([0, 1, 2]);
        const n = win.drawn().length;
        expect(n > 0).toBe(true);
    });

    await it("spacer divider and run own the loop, building once", () => {
        const builds: int[] = [];
        run("t", build: (fr: UiFrame, focus: Focus) => {
            builds.push(1);
            return Column([Spacer(), Divider(), Text("x")]);
        }, w: 200, h: 100, maxFrames: 3);
        expect(builds.length).toBe(1);
    });

    await it("field submits and clears on enter", () => {
        using win = UiWindow.open("t", 800, 600, true);
        const fr = new UiFrame(800, 600);
        const focus = new Focus();
        const got: str[] = [];
        const tree = Field(hint: "type", onSubmit: (t: str) => { got.push(t); });
        render(win, fr, focus, tree, 10.0, 10.0, 200.0, 44.0);
        present(win, fr);
        win.inject(UiInjectKind.MouseDown, 30, 30, MOUSE_LEFT);
        fr.update(win);
        win.inject(UiInjectKind.MouseUp, 30, 30, MOUSE_LEFT);
        fr.update(win);
        render(win, fr, focus, tree, 10.0, 10.0, 200.0, 44.0);
        present(win, fr);
        win.inject(UiInjectKind.Key, 65, 1, 0);
        fr.update(win);
        render(win, fr, focus, tree, 10.0, 10.0, 200.0, 44.0);
        present(win, fr);
        win.inject(UiInjectKind.Key, 65, 0, 0);
        fr.update(win);
        render(win, fr, focus, tree, 10.0, 10.0, 200.0, 44.0);
        present(win, fr);
        expect(got.length).toBe(0);
        tapEnter(win, fr, focus, tree);
        expect(got).toEqual(["A"]);
        render(win, fr, focus, tree, 10.0, 10.0, 200.0, 44.0);
        present(win, fr);
        expect(got.length).toBe(1);
    });
});
