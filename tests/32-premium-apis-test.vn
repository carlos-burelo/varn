import { describe, it, expect } from "std:test";


await describe("32 premium apis test", async () => {
    await it("tests", async () => {
        const d1: decimal = 10.50d;
        const d2: decimal = 2.00d;
        expect(d1 + d2).toBe(12.50d);
        const r = 1..5;
        const r2 = 1..=5;
        expect(r.length).toBe(4);
        expect(r2.length).toBe(5);
        expect("  hello world  ".trim()).toBe("hello world");
    });
});
