import { describe, it, expect } from "std:test";

enum Hue { Red, Green }
enum Figure { Circle(r: float), Square }

function isHue(d: dynamic): bool { return d instanceof Hue }
function asHue(d: dynamic): Hue { return d }

await describe("175 enum instanceof", async () => {
    await it("a variant is an instance of its own enum", () => {
        expect(Hue.Red instanceof Hue).toBe(true)
        expect(Figure.Square instanceof Figure).toBe(true)
        expect(Figure.Circle(1.0) instanceof Figure).toBe(true)
    })

    await it("and of no other enum", () => {
        expect(isHue(Figure.Square)).toBe(false)
        expect(isHue(Figure.Circle(2.0))).toBe(false)
        expect(isHue(Hue.Green)).toBe(true)
        expect(isHue(1)).toBe(false)
        expect(isHue(null)).toBe(false)
    })

    await it("the dynamic boundary uses the same identity", () => {
        expect(asHue(Hue.Green) == Hue.Green).toBe(true)
        let caught = ""
        try { asHue(Figure.Square) } catch (e) { caught = e.message }
        expect(caught).toBe("type mismatch: expected 'Hue', got 'enum'")
    })

    await it("holds in a hot loop", () => {
        let n = 0
        for (let i = 0; i < 5000; i = i + 1) {
            if (isHue(Hue.Red)) { n = n + 1 }
            if (isHue(Figure.Square)) { n = n + 100 }
        }
        expect(n).toBe(5000)
    })
})
