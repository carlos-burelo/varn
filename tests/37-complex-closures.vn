
// ── Closure capturing mutable state ─────────────────────────────
function makeStateMachine(initial: str): {
    transition: (event: str) => str,
    state: () => str,
    history: () => str[],
} {
    let current = initial
    const hist: str[] = [initial]
    return {
        transition: (event: str) => {
            current = current + "→" + event
            hist.push(current)
            return current
        },
        state: () => current,
        history: () => hist,
    }
}

const sm = makeStateMachine("idle")
assert("sm initial",        sm.state() === "idle")
sm.transition("start")
assert("sm after start",    sm.state() === "idle→start")
sm.transition("run")
assert("sm after run",      sm.state() === "idle→start→run")
const h = sm.history()
assert("sm history len",    h.length === 3)
assert("sm history[0]",     h[0] === "idle")
assert("sm history[2]",     h[2] === "idle→start→run")

// ── Closure sharing state between siblings ───────────────────────
function makeSharedCounter(): { inc: () => void, dec: () => void, get: () => int } {
    let n = 0
    return {
        inc: () => { n = n + 1 },
        dec: () => { n = n - 1 },
        get: () => n,
    }
}

const sc = makeSharedCounter()
sc.inc()
sc.inc()
sc.inc()
sc.dec()
assert("shared counter",    sc.get() === 2)

// ── Recursive closure via self-reference ─────────────────────────
function makeRecursiveFib(): (n: int) => int {
    let memo: int[] = []
    const fib = (n: int):int => {
        if (n <= 1) return n
        while (memo.length <= n) memo.push(-1)
        if (memo[n] >= 0) return memo[n]
        const result = fib(n - 1) + fib(n - 2)
        memo[n] = result
        return result
    }
    return fib
}

const recFib = makeRecursiveFib()
assert("recursive fib 0",   recFib(0) === 0)
assert("recursive fib 1",   recFib(1) === 1)
assert("recursive fib 10",  recFib(10) === 55)
assert("recursive fib 15",  recFib(15) === 610)

// ── Closure over loop variable (capture by binding) ──────────────
function makeMultipliers(count: int): ((n: int) => int)[] {
    const fns: ((n: int) => int)[] = []
    for (let i = 1; i <= count; i = i + 1) {
        const factor = i
        fns.push((n: int) => n * factor)
    }
    return fns
}

const mults = makeMultipliers(5)
assert("multiplier[0](3)",  mults[0](3) === 3)
assert("multiplier[1](3)",  mults[1](3) === 6)
assert("multiplier[4](3)",  mults[4](3) === 15)

// ── Partial application ──────────────────────────────────────────
function partial<A, B, C>(f: (A, B) => C, a: A): (b: B) => C {
    return (b: B) => f(a, b)
}

function add3(x: int, y: int): int { return x + y }
const add10 = partial(add3, 10)
assert("partial add",       add10(5) === 15)
assert("partial add 0",     add10(0) === 10)

function concat(a: str, b: str): str { return a + b }
const greet = partial(concat, "Hello, ")
assert("partial concat",    greet("World") === "Hello, World")

// ── Curried function ─────────────────────────────────────────────
function curry<A, B, C>(f: (A, B) => C): (a: A) => (b: B) => C {
    return (a: A) => (b: B) => f(a, b)
}

function mul(x: int, y: int): int { return x * y }
const curriedMul = curry(mul)
const triple = curriedMul(3)
assert("curried 3*4",       triple(4) === 12)
assert("curried 3*0",       triple(0) === 0)
assert("curried fresh",     curriedMul(5)(7) === 35)

// ── Closure capturing class instance ─────────────────────────────
class EventBus {
    private handlers: ((data: str) => void)[] = []
    subscribe(h: (data: str) => void): void { this.handlers.push(h) }
    emit(data: str): void {
        for (const h of this.handlers) h(data)
    }
}

const bus = new EventBus()
const received: str[] = []
bus.subscribe((d) => { received.push(d) })
bus.subscribe((d) => { received.push(d + "!") })
bus.emit("hello")
bus.emit("world")
assert("event bus count",   received.length === 4)
assert("event bus[0]",      received[0] === "hello")
assert("event bus[1]",      received[1] === "hello!")
assert("event bus[2]",      received[2] === "world")
assert("event bus[3]",      received[3] === "world!")

print("[PASSED] 37. Complex closures")