import { describe, it, expect } from "std:test";

class A { x: int = 1 }
class B { x: int = 1 }
class Base {}
class Derived extends Base {}

function kind(v: dynamic): str {
    if (v is A) { return "A" }
    if (v is B) { return "B" }
    return "none"
}

function add(a: int, b: int): int { return a + b }

function caught(f: () => void): str {
    try { f(); return "none" } catch (e) {
        if (e is IntegerOverflow) { return "overflow" }
        if (e is DivisionByZero) { return "zero" }
        return "other"
    }
}

await describe("340 is tests identity", async () => {
    await it("classes with the same fields are different types", () => {
        expect(kind(new A())).toBe("A")
        expect(kind(new B())).toBe("B")
        expect(kind(1)).toBe("none")
    })

    await it("a subclass is its base", () => {
        const d: dynamic = new Derived()
        expect(d is Base).toBe(true)
        expect(d is Derived).toBe(true)
        expect((new Base()) is Derived).toBe(false)
    })

    await it("native error classes are told apart", () => {
        expect(caught(() => { 1 / 0 })).toBe("zero")
        expect(caught(() => { add(9223372036854775807, 1) })).toBe("overflow")
    })

    await it("builtin kinds are tested by kind", () => {
        const b: dynamic = 100n
        const s: dynamic = "text"
        expect(b is bigint).toBe(true)
        expect(s is str).toBe(true)
        expect(s is int).toBe(false)
    })
})
