import { describe, it, expect } from "std:test";


// 1. Generics
function identity<T>(x: T): T {
    return x;
}

class Container<T> {
    val: T;
    constructor(val: T) {
        this.val = val;
    }
    getVal(): T {
        return this.val;
    }
}

// 5. Computed super compound assignment
class Parent {
    _val: int;
    constructor() {
        this._val = 10;
    }
    getVal(): int {
        return this._val;
    }
    setVal(v: int): void {
        this._val = v;
    }
}
class Child extends Parent {
    constructor() {
        super();
    }
    mutateSuper(add: int): void {
        super.setVal(super.getVal() + add);
    }
}

// 4. Variant record matching
enum VariantRecord {
    Point(x: int, y: int)
}

// 6. Extended enums (static blocks, methods, fields)
enum ExtendedEnum {
    A, B;
    
    static val: int;
    static {
        ExtendedEnum.val = 42;
    }
    
    getVal(): int {
        return ExtendedEnum.val;
    }
}
let AnonClass: dynamic = class {
    x: int;
    constructor(x: int) {
        this.x = x;
    }
    getX(): int {
        return this.x;
    }
};
let namedExpr: dynamic = function foo(x: int): int {
    return x + 1;
};
await describe("51 opt unsupported phase4", async () => {
    await it("tests", async () => {
        expect(identity<int>(123)).toBe(123);
        expect(identity<str>("hello")).toBe("hello");
        let container = new Container<int>(456);
        expect(container.val).toBe(456);
        expect(container.getVal()).toBe(456);
        let child = new Child();
        child.mutateSuper(5);
        expect(child.getVal()).toBe(15);
        // 2. Anonymous classes
        let anonInst = new AnonClass(789);
        expect(anonInst.x).toBe(789);
        expect(anonInst.getX()).toBe(789);
        
        // 3. Named function expressions
        expect(namedExpr(10)).toBe(11);
        let pt = VariantRecord.Point(3, 4);
        let ptArea = match pt {
            Point { x, y } => x * y,
            _ => 0
        };
        expect(ptArea).toBe(12);
        expect(ExtendedEnum.val).toBe(42);
        let inst = ExtendedEnum.A;
        expect(inst.getVal()).toBe(42);
        
        
    });
});
