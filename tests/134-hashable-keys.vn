import { describe, it, expect } from "std:test";

class Point {
    x: int
    y: int
    constructor(x: int, y: int) { this.x = x; this.y = y }
    hash(): int { return this.x * 31 + this.y }
    equals(o: Point): bool { return this.x === o.x && this.y === o.y }
}

const names: Map<Point, str> = new Map()

const seen: Set<Point> = new Set()

class Collide {
    v: int
    constructor(v: int) { this.v = v }
    hash(): int { return 7 }
    equals(o: Collide): bool { return this.v === o.v }
}
const c: Map<Collide, int> = new Map()

class Plain { v: int; constructor(v: int) { this.v = v } }
const ids: Map<Plain, int> = new Map()
const p = new Plain(1)

function churn(): bool {
    const m: Map<Point, int> = new Map()
    for (let i = 0; i < 2000; i = i + 1) { m.set(new Point(i % 50, 0), i) }
    let junk = 0
    for (let i = 0; i < 20000; i = i + 1) { const t = [i, i + 1]; junk = junk + t.length }
    return m.size === 50 && m.get(new Point(49, 0)) === 1999
}
const churnOk = churn()
await describe("134 hashable keys", async () => {
        await it("group 1 part 1", async () => {
        names.set(new Point(1, 2), "a")
        expect(names.get(new Point(1, 2))).toBe("a");
        expect(names.has(new Point(1, 2)) && !names.has(new Point(2, 1))).toBeTruthy();
        names.set(new Point(1, 2), "b")
        expect(names.size === 1 && names.get(new Point(1, 2)) === "b").toBeTruthy();
        expect(names.delete(new Point(1, 2)) && names.size === 0).toBeTruthy();
    });

    await it("set dedup", async () => {
        seen.add(new Point(0, 0));
        seen.add(new Point(0, 0));
        seen.add(new Point(0, 1));
        expect(seen.size).toBe(2);
        expect(seen.has(new Point(0, 1))).toBeTruthy();
    });

    await it("colliding hashes", async () => {
        c.set(new Collide(1), 10);
        c.set(new Collide(2), 20);
        expect(c.size).toBe(2);
        expect(c.get(new Collide(2))).toBe(20);
    });

    await it("identity keys and churn", async () => {
        ids.set(p, 1);
        expect(ids.has(p)).toBeTruthy();
        expect(ids.has(new Plain(1))).toBeFalsy();
        expect(churnOk).toBeTruthy();
    });


});
