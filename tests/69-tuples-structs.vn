import { describe, it, expect } from "std:test";

struct Release {
    name: str;
    version: int;
}

struct Marker {
    point: (int, int);
    active: bool;
}

await describe("69 tuples structs", async () => {
    await it("tuple creation and element access", async () => {
        let t1 = (1, "hello", true)
        expect(t1[0] == 1).toBeTruthy()
        expect(t1[1] == "hello").toBeTruthy()
        expect(t1[2] == true).toBeTruthy()
        expect(t1.length == 3).toBeTruthy()
    });

    await it("tuple structural equality", async () => {
        let t1 = (1, "hello", true)
        let t2 = (1, "hello", true)
        let t3 = (1, "hello", false)
        expect(t1 == t2).toBeTruthy()
        expect(t1 != t3).toBeTruthy()

        let a1 = [1, 2]
        let a2 = [1, 2]
        expect(!sameValue(a1, a2)).toBeTruthy()
    });

    await it("struct creation, access and equality", async () => {
        let r1 = new Release("Varn", 1)
        expect(r1.name == "Varn").toBeTruthy()
        expect(r1.version == 1).toBeTruthy()
        expect(r1["name"] == "Varn").toBeTruthy()
        expect(r1 == new Release("Varn", 1)).toBeTruthy()
        expect(r1 != new Release("Varn", 2)).toBeTruthy()
    });

    await it("structs holding tuples compare deeply", async () => {
        let a = new Marker((10, 20), true)
        expect(a == new Marker((10, 20), true)).toBeTruthy()
        expect(a != new Marker((10, 99), true)).toBeTruthy()
    });
});
