export class Meter {
    constructor(public readonly value: int) {}
}

export extension MeterMath on Meter {
    doubled(): int { return this.value * 2 }
    get label(): str { return `${this.value}m` }
}

export extension<T> on readonly T[] {
    second(): T? { return this.at(1) }
}

extension Hidden on Meter {
    secret(): int { return 42 }
}
