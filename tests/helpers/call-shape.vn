export class Tally {
    total: int
    constructor(start: int? = null) { this.total = start ?? 0 }
    add(n: int?): int { return this.total + (n ?? 1) }
    scale(by: float = 2): str { return typeof by }
    label(prefix: str, n: int?, suffix?: str): str { return prefix + (n ?? 0).toString() + (suffix ?? "") }
}

function marked(cls: dynamic): dynamic { cls.marked = true; return cls }

@marked
export class Marked {
    n: int
    constructor(n: int) { this.n = n }
}

export class Bare {
    items: int[] = []
    count: int = 3
}

export class Holder<T> {
    held: T
    constructor(held: T) { this.held = held }
}
