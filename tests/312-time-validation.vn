import { describe, it, expect } from "std:test";
import { Duration, DateTime, PlainDateTime, toISOString, fromISO } from "std:time";
import { ParseError } from "std:error";

function outcome(f: () => str): str {
    try { return f(); } catch (e) {
        return e instanceof RangeError ? "range" : e instanceof ParseError ? "parse" : "other:" + e.name;
    }
}

await describe("312 time values reject what they cannot hold", async () => {
    await it("PlainDateTime checks every field, including leap years", async () => {
        expect(outcome(() => new PlainDateTime(2024, 2, 29).toString())).toBe("2024-02-29T00:00:00.000");
        expect(outcome(() => new PlainDateTime(2000, 2, 29).toString())).toBe("2000-02-29T00:00:00.000");
        expect(outcome(() => new PlainDateTime(2023, 2, 29).toString())).toBe("range");
        expect(outcome(() => new PlainDateTime(1900, 2, 29).toString())).toBe("range");
        expect(outcome(() => new PlainDateTime(2025, 13, 1).toString())).toBe("range");
        expect(outcome(() => new PlainDateTime(2025, 0, 1).toString())).toBe("range");
        expect(outcome(() => new PlainDateTime(2025, 4, 31).toString())).toBe("range");
        expect(outcome(() => new PlainDateTime(2025, 1, 1, 24).toString())).toBe("range");
        expect(outcome(() => new PlainDateTime(2025, 1, 1, 0, 60).toString())).toBe("range");
        expect(outcome(() => new PlainDateTime(2025, 1, 1, 0, 0, 60).toString())).toBe("range");
        expect(outcome(() => new PlainDateTime(2025, 1, 1, 0, 0, 0, 1000).toString())).toBe("range");
        expect(outcome(() => new PlainDateTime(-5, 1, 1).toString())).toBe("range");
    });

    await it("a timestamp the calendar cannot represent is a RangeError", async () => {
        expect(outcome(() => new DateTime(9223372036854775807).toISOString())).toBe("range");
        expect(outcome(() => new DateTime(0).toISOString())).toBe("1970-01-01T00:00:00.000Z");
    });

    await it("Duration parts that do not fit a fixed span are refused, not dropped", async () => {
        expect(outcome(() => Duration.from({ years: 1 }).totalMilliseconds.toString())).toBe("range");
        expect(outcome(() => Duration.from({ months: 2, days: 1 }).totalMilliseconds.toString())).toBe("range");
        expect(outcome(() => Duration.from({ hours: 1, sign: -1 }).totalMilliseconds.toString())).toBe("-3600000");
        expect(outcome(() => Duration.from({ hours: 1, sign: 2 }).totalMilliseconds.toString())).toBe("range");
        expect(outcome(() => Duration.from({ minutes: 90 }).totalMilliseconds.toString())).toBe("5400000");
    });

    await it("years outside 0..9999 use the signed six-digit form and parse back", async () => {
        expect(toISOString(253402300800000)).toBe("+010000-01-01T00:00:00.000Z");
        expect(toISOString(-62198755200000)).toBe("-000001-01-01T00:00:00.000Z");
        expect(toISOString(-62167219200000)).toBe("0000-01-01T00:00:00.000Z");
        expect(toISOString(253402300799999)).toBe("9999-12-31T23:59:59.999Z");
        expect(fromISO("+010000-01-01T00:00:00.000Z")).toBe(253402300800000);
        expect(fromISO("-000001-01-01T00:00:00.000Z")).toBe(-62198755200000);
        let ms = -8000000000000000;
        let bad = 0;
        while (ms < 8000000000000000) {
            if (fromISO(toISOString(ms)) !== ms) bad = bad + 1;
            ms = ms + 123456789012345;
        }
        expect(bad).toBe(0);
        expect(outcome(() => fromISO("-000000-01-01T00:00:00.000Z").toString())).toBe("parse");
    });
});
