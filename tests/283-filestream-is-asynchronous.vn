import { describe, it, expect } from "std:test";
import { sleep, spawn } from "std:task";
import { FileStream, FileMode, tempDir, remove } from "std:fs";
import { StdError } from "std:error";

const path = tempDir() + "/varn-283-filestream.bin";

await describe("283 FileStream is asynchronous", async () => {
    await it("writes, reads in chunks and reads everything", async () => {
        const out = new FileStream(path, FileMode.Write);
        expect(await out.write(Bytes.fromString("hello, "))).toBe(7);
        expect(await out.write(Bytes.fromString("world"))).toBe(5);
        out.close();

        const chunks = new FileStream(path, FileMode.Read);
        const first = await chunks.read(5);
        expect(first !== null).toBeTruthy();
        expect((first as Bytes).length).toBe(5);
        const rest = await chunks.readAll();
        expect(rest.length).toBe(7);
        expect(await chunks.read(5)).toBe(null);
        chunks.close();
    });

    await it("other tasks keep running while a read is pending", async () => {
        const stream = new FileStream(path, FileMode.Read);
        let ticks = 0;
        let running = true;
        async function ticker(): Task<void> {
            while (running) {
                await sleep(1);
                ticks = ticks + 1;
            }
        }
        spawn(ticker());
        const data = await stream.readAll();
        running = false;
        expect(data.length).toBe(12);
        stream.close();
    });

    await it("a closed stream rejects with a coded StdError", async () => {
        const stream = new FileStream(path, FileMode.Read);
        stream.close();
        let code = "";
        try {
            await stream.readAll();
        } catch (e) {
            code = (e as StdError).code;
        }
        expect(code).toBe("E_FS_BAD_FD");
        remove(path);
    });
});
