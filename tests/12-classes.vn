import { describe, it, expect } from "std:test";

class IdGen {
    private static _next: int = 1
    static next(): int {
        const id = IdGen._next;
        IdGen._next = IdGen._next + 1;
        return id;
    }
    static reset(): void { IdGen._next = 1; }
}
class Temperature {
    private _celsius: float
    constructor(c: float) { this._celsius = c; }
    get celsius() { return this._celsius; }
    set celsius(v: float) { this._celsius = v; }
    get fahrenheit() { return this._celsius * 1.8 + 32.0; }
}
class Animal {
    name: str
    constructor(n: str) { this.name = n; }
    speak() { return "..."; }
    toString() { return `Animal(${this.name})`; }
}
class Dog extends Animal {
    constructor(n: str) { super(n); }
    override speak() { return "Woof"; }
}
class PoliceDog extends Dog {
    badge: int
    constructor(n: str, badge: int) {
        super(n);
        this.badge = badge;
    }
    override speak() { return super.speak() + "!"; }
}
abstract class Shape {
    abstract area(): float
    describe(): str { return `shape with area ${this.area()}`; }
}
class Circle extends Shape {
    r: float
    constructor(r: float) { this.r = r; }
    override area(): float { return 3.14159 * this.r * this.r; }
}
class Rect extends Shape {
    w: float
    h: float
    constructor(w: float, h: float) { this.w = w; this.h = h; }
    override area(): float { return this.w * this.h; }
}

await describe("12 Classes", async () => {
    await it("getters and setters", () => {
        const t = new Temperature(100.0);
        expect(t.celsius).toBe(100.0);
        expect(t.fahrenheit).toBe(212.0);
        t.celsius = 0.0;
        expect(t.celsius).toBe(0.0);
        expect(t.fahrenheit).toBe(32.0);
    });

    await it("inheritance", () => {
        const a = new Animal("generic");
        const d = new Dog("Rex");
        const pd = new PoliceDog("K9", 42);
        expect(a.speak()).toBe("...");
        expect(d.speak()).toBe("Woof");
        expect(pd.speak()).toBe("Woof!");
        expect(pd.badge).toBe(42);
        expect(pd.name).toBe("K9");
        expect(pd instanceof PoliceDog).toBeTruthy();
        expect(pd instanceof Dog).toBeTruthy();
        expect(pd instanceof Animal).toBeTruthy();
        expect(!(d instanceof PoliceDog)).toBeTruthy();
    });

    await it("static state", () => {
        IdGen.reset();
        expect(IdGen.next()).toBe(1);
        expect(IdGen.next()).toBe(2);
        expect(IdGen.next()).toBe(3);
        IdGen.reset();
        expect(IdGen.next()).toBe(1);
    });

    await it("abstract shapes", () => {
        const circ = new Circle(1.0);
        const rect2 = new Rect(3.0, 4.0);
        expect(circ.area() > 3.14 && circ.area() < 3.15).toBeTruthy();
        expect(rect2.area()).toBe(12.0);
        expect(circ.describe().startsWith("shape with area")).toBeTruthy();
    });
});
