import { describe, it, expect } from "std:test";

await describe("17 Map Set", async () => {
    await it("map ops", () => {
        const map = new Map<str, int>();
        map.set("a", 1);
        map.set("b", 2);
        map.set("c", 3);
        expect(map.size).toBe(3);
        expect(map.get("b")).toBe(2);
        expect(map.has("c")).toBeTruthy();
        expect(!map.has("z")).toBeTruthy();
        map.delete("b");
        expect(map.size).toBe(2);
        expect(map.get("b")).toBe(null);
        const mk = map.keys();
        expect(mk.length).toBe(2);
        const mv = map.values();
        expect(mv.length).toBe(2);
        map.clear();
        expect(map.size).toBe(0);
    });

    await it("set ops", () => {
        const set = new Set<str>();
        set.add("x");
        set.add("y");
        set.add("x");
        expect(set.size).toBe(2);
        expect(set.has("x")).toBeTruthy();
        expect(!set.has("z")).toBeTruthy();
        set.delete("x");
        expect(set.size).toBe(1);
        set.clear();
        expect(set.size).toBe(0);
    });
});
