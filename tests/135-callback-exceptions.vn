import { describe, it, expect } from "std:test";

class Boom extends Error { constructor(msg: str) { super(msg) } }
function boom(x: int): int { if (x === 2) { throw new Boom("boom") } return x }

function raisesBoom(f: () => void): bool {
    try { f(); return false } catch (e) { return e instanceof Boom && e.message === "boom" }
}

const byKey: Map<int, int> = new Map()
const inSet: Set<int> = new Set()

class BadKey {
    hash(): int { throw new Boom("boom") }
    equals(o: BadKey): bool { return true }
}
const bad: Map<BadKey, int> = new Map()

class Ver {
    n: int
    constructor(n: int) { this.n = n }
    compare(o: Ver): int { return this.n - o.n }
}

function unsortable(): bool {
    try { [{ a: 1 }, { a: 2 }].sort(); return false } catch (e) { return true }
}
await describe("135 callback exceptions", async () => {
        await it("group 1 part 1", async () => {
        expect(raisesBoom(() => { [1, 2, 3].map(boom) })).toBeTruthy();
        expect(raisesBoom(() => { [1, 2, 3].filter((x: int) => boom(x) > 0) })).toBeTruthy();
        expect(raisesBoom(() => { [1, 2, 3].forEach((x: int) => { boom(x) }) })).toBeTruthy();
        expect(raisesBoom(() => { [1, 2, 3].find((x: int) => boom(x) > 5) })).toBeTruthy();
        expect(raisesBoom(() => { [1, 2, 3].reduce((a: int, x: int) => a + boom(x), 0) })).toBeTruthy();
        expect(raisesBoom(() => { [3, 2, 1].sort((a: int, b: int) => boom(a) - b) })).toBeTruthy();
    });

    await it("group 1 part 2", async () => {
        expect(raisesBoom(() => { [1, 2].every((x: int) => boom(x) > 0) }) && raisesBoom(() => { [1, 2].some((x: int) => boom(x) > 5) })).toBeTruthy();
        byKey.set(2, 2)
        expect(raisesBoom(() => { byKey.forEach((v: int, k: int) => { boom(v) }) })).toBeTruthy();
        inSet.add(2)
        expect(raisesBoom(() => { inSet.forEach((v: int) => { boom(v) }) })).toBeTruthy();
        expect(raisesBoom(() => { (1..4).map(boom) })).toBeTruthy();
        expect(raisesBoom(() => { bad.set(new BadKey(), 1) })).toBeTruthy();
        expect([10, 9, 1, 100].sort().join(",")).toBe("1,9,10,100");
    });

    await it("group 1 part 3", async () => {
        expect([2.5, 10.0, 1.0].sort().join(",")).toBe("1,2.5,10");
        expect(["b", "a", "c"].sort().join("")).toBe("abc");
        expect([#[1, "a"], #[0, "b"], #[1, "c"]].sort((x: #[int, str], y: #[int, str]) => x[0] - y[0]).map((t: #[int, str]) => t[1]).join("")).toBe("bac");
        expect([new Ver(3), new Ver(1), new Ver(2)].sort().map((v: Ver) => v.n).join(",")).toBe("1,2,3");
        expect(unsortable()).toBeTruthy();
    });


});
