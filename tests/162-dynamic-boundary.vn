import { describe, it, expect } from "std:test";

function failed(f: () => void): bool {
    try {
        f()
        return false
    } catch (e) {
        return true
    }
}

class Holder {
    name: str = ""
    on: bool = false
}

function declStr(d: dynamic): int {
    let s: str = d
    return s.length
}

function declBool(d: dynamic): bool {
    let b: bool = d
    return b
}

function assignStr(d: dynamic): int {
    let s = "a"
    s = d
    return s.length
}

function fieldStr(d: dynamic): int {
    const h = new Holder()
    h.name = d
    return h.name.length
}

function fieldBool(d: dynamic): bool {
    const h = new Holder()
    h.on = d
    return h.on
}

function retStr(d: dynamic): str { return d }
function retBool(d: dynamic): bool { return d }

class Returner {
    name(d: dynamic): str { return d }
}

const arrowStr = (d: dynamic): str => d

function lenOf(s: str): int { return s.length }
function pick(a: int, flag: bool): int { return flag ? a : 0 }
function passStr(d: dynamic): int { return lenOf(d) }
function passBool(d: dynamic): int { return pick(7, d) }
function identity<T>(x: T): T { return x }

class Taker {
    label: str
    constructor(label: str) { this.label = label }
    measure(s: str): int { return s.length }
}

const arrowLen = (s: str): int => s.length

function optStr(d: dynamic): str {
    let s: str? = d
    return s ?? "none"
}

function optBool(d: dynamic): bool {
    let b: bool? = d
    return b ?? false
}

function optArg(s: str?): int { return (s ?? "").length }
function passOpt(d: dynamic): int { return optArg(d) }
function retOpt(d: dynamic): str? { return d }

function messageOf(f: () => void): str {
    try {
        f()
        return "none"
    } catch (e) {
        return e.message
    }
}

function kindOf(f: () => void): str {
    try {
        f()
        return "none"
    } catch (e) {
        if (e instanceof TypeError) { return "TypeError" }
        return "Error"
    }
}

class Animal {
    legs: int = 4
}

class Dog extends Animal {
    name: str = "rex"
}

class Rock {
    weight: int = 9
}

function legsOf(a: Animal): int { return a.legs }
function declAnimal(d: dynamic): int {
    let a: Animal = d
    return a.legs
}
function passAnimal(d: dynamic): int { return legsOf(d) }
function castAnimal(d: dynamic): int { return (d as Animal).legs }
function optAnimal(d: dynamic): bool {
    let a: Animal? = d
    return a == null
}

class Reading {
    count: int = 0
    ratio: float = 0.0
}

function declInt(d: dynamic): int {
    let n: int = d
    return n + 1
}
function declFloat(d: dynamic): float {
    let f: float = d
    return f / 2.0
}
function optInt(d: dynamic): int {
    let n: int? = d
    return n ?? -1
}
function optFloat(d: dynamic): float {
    let f: float? = d
    return f ?? -1.0
}
function retInt(d: dynamic): int { return d }
function double(f: float): float { return f * 2.0 }
function passFloat(d: dynamic): float { return double(d) }
function fieldInt(d: dynamic): int {
    const r = new Reading()
    r.count = d
    return r.count
}
function fieldFloat(d: dynamic): float {
    const r = new Reading()
    r.ratio = d
    return r.ratio
}

function asStr(d: dynamic): str { return d as str }
function asBool(d: dynamic): bool { return d as bool }

await describe("162 dynamic boundary", async () => {
    await it("as str accepts strings and rejects everything else", () => {
        expect(asStr("hola").length).toBe(4)
        expect(asStr("ñandú").length).toBe(5)
        expect(failed(() => { asStr(5) })).toBe(true)
        expect(failed(() => { asStr(true) })).toBe(true)
        expect(failed(() => { asStr(null) })).toBe(true)
        expect(failed(() => { asStr([1, 2]) })).toBe(true)
    })

    await it("as bool accepts booleans and rejects everything else", () => {
        expect(asBool(true)).toBe(true)
        expect(asBool(false)).toBe(false)
        expect(failed(() => { asBool(1) })).toBe(true)
        expect(failed(() => { asBool("true") })).toBe(true)
        expect(failed(() => { asBool(null) })).toBe(true)
    })

    await it("a typed declaration checks what it receives from dynamic", () => {
        expect(declStr("hola")).toBe(4)
        expect(declBool(true)).toBe(true)
        expect(failed(() => { declStr(5) })).toBe(true)
        expect(failed(() => { declStr(null) })).toBe(true)
        expect(failed(() => { declBool(1) })).toBe(true)
    })

    await it("assignments and field stores check too", () => {
        expect(assignStr("hola")).toBe(4)
        expect(fieldStr("hola")).toBe(4)
        expect(fieldBool(true)).toBe(true)
        expect(failed(() => { assignStr(5) })).toBe(true)
        expect(failed(() => { fieldStr(5) })).toBe(true)
        expect(failed(() => { fieldBool("yes") })).toBe(true)
    })

    await it("a typed return checks what it hands back", () => {
        expect(retStr("hola").length).toBe(4)
        expect(retBool(false)).toBe(false)
        expect(new Returner().name("ab").length).toBe(2)
        expect(arrowStr("abc").length).toBe(3)
        expect(failed(() => { retStr(5) })).toBe(true)
        expect(failed(() => { retBool("no") })).toBe(true)
        expect(failed(() => { new Returner().name(5) })).toBe(true)
        expect(failed(() => { arrowStr(5) })).toBe(true)
    })

    await it("typed parameters check dynamic arguments", () => {
        expect(passStr("hola")).toBe(4)
        expect(passBool(true)).toBe(7)
        expect(failed(() => { passStr(5) })).toBe(true)
        expect(failed(() => { passBool("x") })).toBe(true)
        const d: dynamic = 5
        const ok: dynamic = "abc"
        expect(new Taker(ok).label.length).toBe(3)
        expect(new Taker("t").measure(ok)).toBe(3)
        expect(arrowLen(ok)).toBe(3)
        expect(failed(() => { new Taker(d) })).toBe(true)
        expect(failed(() => { new Taker("t").measure(d) })).toBe(true)
        expect(failed(() => { arrowLen(d) })).toBe(true)
        expect(identity(d)).toBe(5)
    })

    await it("nullable targets take null or the type, nothing else", () => {
        expect(optStr(null)).toBe("none")
        expect(optStr("ab")).toBe("ab")
        expect(optBool(null)).toBe(false)
        expect(optBool(true)).toBe(true)
        expect(passOpt(null)).toBe(0)
        expect(passOpt("abc")).toBe(3)
        expect(retOpt(null) ?? "n").toBe("n")
        expect(failed(() => { optStr(5) })).toBe(true)
        expect(failed(() => { optBool("x") })).toBe(true)
        expect(failed(() => { passOpt(5) })).toBe(true)
        expect(failed(() => { retOpt(5) })).toBe(true)
    })

    await it("a class target takes instances of the class or a subclass", () => {
        expect(declAnimal(new Animal())).toBe(4)
        expect(passAnimal(new Dog())).toBe(4)
        expect(castAnimal(new Animal())).toBe(4)
        expect(optAnimal(null)).toBe(true)
        expect(optAnimal(new Dog())).toBe(false)
        expect(failed(() => { declAnimal(new Rock()) })).toBe(true)
        expect(failed(() => { declAnimal({ legs: 4 }) })).toBe(true)
        expect(failed(() => { declAnimal(null) })).toBe(true)
        expect(failed(() => { passAnimal(new Rock()) })).toBe(true)
        expect(failed(() => { castAnimal(5) })).toBe(true)
        expect(failed(() => { optAnimal(new Rock()) })).toBe(true)
        expect(kindOf(() => { declAnimal(new Rock()) })).toBe("TypeError")
    })

    await it("int targets take ints only", () => {
        expect(declInt(7)).toBe(8)
        expect(retInt(9)).toBe(9)
        expect(fieldInt(4)).toBe(4)
        expect(optInt(null)).toBe(-1)
        expect(optInt(5)).toBe(5)
        expect(failed(() => { declInt(3.7) })).toBe(true)
        expect(failed(() => { declInt("7") })).toBe(true)
        expect(failed(() => { declInt(null) })).toBe(true)
        expect(failed(() => { declInt(true) })).toBe(true)
        expect(failed(() => { retInt("x") })).toBe(true)
        expect(failed(() => { fieldInt("x") })).toBe(true)
        expect(failed(() => { optInt("x") })).toBe(true)
    })

    await it("float targets take floats, widen ints and reject null", () => {
        expect(declFloat(5.0)).toBe(2.5)
        expect(declFloat(3)).toBe(1.5)
        expect(passFloat(2)).toBe(4.0)
        expect(fieldFloat(1.5)).toBe(1.5)
        expect(optFloat(null)).toBe(-1.0)
        expect(optFloat(2.5)).toBe(2.5)
        expect(failed(() => { declFloat(null) })).toBe(true)
        expect(failed(() => { declFloat("1.5") })).toBe(true)
        expect(failed(() => { declFloat(true) })).toBe(true)
        expect(failed(() => { passFloat(null) })).toBe(true)
        expect(failed(() => { fieldFloat(null) })).toBe(true)
        expect(failed(() => { optFloat("x") })).toBe(true)
    })

    await it("an explicit numeric cast still converts", () => {
        const d: dynamic = 3.7
        expect(d as int).toBe(3)
    })

    await it("the failure is a TypeError", () => {
        expect(kindOf(() => { asStr(5) })).toBe("TypeError")
        expect(kindOf(() => { declBool(1) })).toBe("TypeError")
        expect(kindOf(() => { optStr(5) })).toBe("TypeError")
        expect(kindOf(() => { asStr("ok") })).toBe("none")
    })

    await it("a class mismatch names the expected class", () => {
        expect(messageOf(() => { declAnimal(new Rock()) })).toBe("type mismatch: expected 'Animal', got 'object'")
        expect(messageOf(() => { declAnimal(5) })).toBe("type mismatch: expected 'Animal', got 'int'")
        expect(messageOf(() => { optAnimal(new Rock()) })).toBe("type mismatch: expected 'Animal?', got 'object'")
        expect(kindOf(() => { optAnimal(new Rock()) })).toBe("TypeError")
    })

    await it("holds in a hot loop", () => {
        let total = 0
        for (let i = 0; i < 5000; i = i + 1) { total = total + asStr("abc").length }
        expect(total).toBe(15000)
        let rejected = 0
        for (let i = 0; i < 5000; i = i + 1) {
            if (failed(() => { asStr(i) })) { rejected = rejected + 1 }
        }
        expect(rejected).toBe(5000)
    })

    await it("truthiness, interpolation and concatenation still take any value", () => {
        const d: dynamic = { a: 1 }
        let seen = false
        if (d) { seen = true }
        expect(seen).toBe(true)
        const xs: dynamic[] = [1, "x", null]
        expect(`${xs[0]}-${xs[1]}-${xs[2]}`).toBe("1-x-null")
        expect(`v=${null}`).toBe("v=null")
    })
    await it("reading a property of a primitive dynamic value is an error, not null", () => {
        const n: dynamic = 5
        expect(() => {
            const v = n.missing
        }).toThrow("cannot read property")
    })
})
