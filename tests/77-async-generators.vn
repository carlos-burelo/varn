import { describe, it, expect } from "std:test";
import { sleep } from "std:task"

// `async function*` — a generator whose body may `await`.
//
// Everything on the consumer side was already built: `for await (… of …)`
// lowers to `Symbol.asyncIterator` plus an `await` on each `next()`, the
// runtime has `Symbol.asyncIterator`, and `GeneratorDriver` carried an
// `is_async()` hook with no implementation behind it. What was missing was the
// producer: a driver that settles the body's awaits instead of refusing them.
//
// Varn settles inside `next()`, so `AsyncGenerator<T>.next()` hands back a
// settled `{ value, done }` rather than a task. `await` on a non-task is the
// identity, which is why `for await` reads the same over an async generator
// and over a plain one.


async function tenTimes(n: int): int {
    return n * 10
}

async function* awaitsThenYields() {
    yield await tenTimes(1)
    yield await tenTimes(2)
    yield await tenTimes(3)
}

async function* awaitsBetweenYields() {
    const first = await tenTimes(4)
    yield first
    // `int / int` is a float in Varn, so step by subtraction instead.
    const second = await tenTimes(first - 35)
    yield second
}

async function* yieldsHeapValues() {
    yield [await tenTimes(1), await tenTimes(2)]
}

async function* throwsAfterAYield() {
    yield 1
    throw new Error("boom")
}

async function* catchesItsOwnRejection() {
    try {
        await failing()
        yield -1
    } catch (e) {
        yield 99
    }
}

async function failing(): int {
    throw new Error("rejected")
}

async function runAsyncGenerators() {
    // Manual driving: each `next()` runs the body up to the next `yield`,
    // settling every `await` on the way.
    const manual = awaitsThenYields()
    expect(manual.next().value).toBe(10)
    expect(manual.next().value).toBe(20)
    expect(manual.next().value).toBe(30)
    expect(manual.next().done).toBeTruthy()

    // More than one await between two yields.
    const between = awaitsBetweenYields()
    expect(between.next().value).toBe(40)
    expect(between.next().value).toBe(50)

    let total = 0
    for await (const v of awaitsThenYields()) {
        total = total + v
    }
    expect(total).toBe(60)

    // A plain `for..of` works too: the values are already settled.
    let plain = 0
    for (const v of awaitsThenYields()) {
        plain = plain + v
    }
    expect(plain).toBe(60)

    const heaps = yieldsHeapValues().next().value
    expect(heaps.length === 2 && heaps[1] === 20).toBeTruthy()

    // A generator can await a real suspension, not just an already-settled task.
    async function* awaitsSleep() {
        await sleep(1)
        yield 7
    }
    expect(awaitsSleep().next().value).toBe(7)

    // A rejected `await` unwinds to a `try` inside the generator body, exactly
    // as it does inside an async function.
    expect(catchesItsOwnRejection().next().value).toBe(99)

    // Not covered here: a `throw` that escapes the body. It is not catchable at
    // the `next()` call site for a plain `function*` either — the driver
    // surfaces it as a runtime error rather than a Varn throw — so it is a
    // generator gap, not an async one.
    const throwing = throwsAfterAYield()
    expect(throwing.next().value).toBe(1)
}
await describe("77 async generators", async () => {
    await it("tests", async () => {
        
        await runAsyncGenerators()
        
        
    });
});
