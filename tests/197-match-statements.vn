import { describe, it, expect } from "std:test";

function kind(n: int): str {
    let out = ""
    match (n) {
        1 => { out = out + "one" },
        2 => { out = out + "two" },
        _ => { out = out + "many" }
    }
    return out
}

function walk(limit: int): str {
    let seen = ""
    for (let i = 0; i < limit; i = i + 1) {
        match (i) {
            1 => { continue },
            2 => {},
            _ => { seen = seen + i.toString() }
        }
        seen = seen + "."
    }
    return seen
}

function inner(n: int): int {
    let total = 0
    match (n) {
        1 => {
            for (let i = 0; i < 9; i = i + 1) {
                if (i == 3) { break }
                total = total + 1
            }
        },
        _ => { total = 9 }
    }
    return total
}

function stop(limit: int): int {
    let reached = 0
    for (let i = 0; i < limit; i = i + 1) {
        match (i) {
            3 => { break },
            _ => { reached = reached + 1 }
        }
    }
    return reached
}

await describe("197 match as a statement", async () => {
    await it("an arm runs alone and never falls through to the next", () => {
        expect(kind(1)).toBe("one")
        expect(kind(2)).toBe("two")
        expect(kind(3)).toBe("many")
    })

    await it("continue in an arm continues the loop around the match", () => {
        expect(walk(4)).toBe("0..3.")
        let last = ""
        for (let k = 0; k < 300; k = k + 1) { last = walk(4) }
        expect(last).toBe("0..3.")
    })

    await it("break in an arm leaves the loop around the match", () => {
        expect(stop(10)).toBe(3)
    })

    await it("a break inside a loop inside an arm leaves that loop", () => {
        expect(inner(1)).toBe(3)
        expect(inner(2)).toBe(9)
    })
})
