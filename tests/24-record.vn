import { describe, it, expect } from "std:test";

await describe("24 Record", async () => {
    await it("index map and record", () => {
        const scores: { [key: str]: int } = {
            "alice": 95,
            "bob": 87,
            "charlie": 72
        };
        expect(scores["alice"]).toBe(95);
        expect(scores["bob"]).toBe(87);
        expect(scores["charlie"]).toBe(72);
        scores["dave"] = 60;
        expect(scores["dave"]).toBe(60);
        const rec = #{ x: 10, y: 20 };
        expect(rec.x).toBe(10);
        expect(rec.y).toBe(20);
    });
});
