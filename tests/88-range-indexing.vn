import { describe, it, expect } from "std:test";

// Test Suite 88: Range Indexing in Strings and Arrays (arr[a..b], str[a..b])
let text = "Hello, World!";
let numbers = [10, 20, 30, 40, 50, 60];
await describe("88 range indexing", async () => {
    await it("String exclusive and inclusive range indexing", async () => {
        let world = text[7..12];
        expect(world).toBe("World");
        let worldInc = text[7..=11];
        expect(worldInc).toBe("World");
    });
    await it("Array exclusive and inclusive range indexing", async () => {
        let head = numbers[0..2];
        expect(head.length).toBe(2);
        expect(head[0]).toBe(10);
        expect(head[1]).toBe(20);
    });
    await it("Range indexing with dynamic variable bounds", async () => {
        let fruits = ["apple", "banana", "cherry", "date", "elderberry"];
        let start = 1;
        let end = 4;
        let picked = fruits[start..end];
        expect(picked.length).toBe(3);
        expect(picked[0]).toBe("banana");
        expect(picked[1]).toBe("cherry");
        expect(picked[2]).toBe("date");
    });
        

    await it("Exclusive range [0..5]; Exclusive slice [1..4] -> indices 1, 2, 3", async () => {
        let greeting = text[0..5];
        expect(greeting).toBe("Hello");
        let slice1 = numbers[1..4];
        expect(slice1.length).toBe(3);
        expect(slice1[0]).toBe(20);
        expect(slice1[1]).toBe(30);
        expect(slice1[2]).toBe(40);
    });

    await it("Inclusive range [0..=4]; Inclusive slice [1..=3] -> indices 1, 2, 3", async () => {
        let greetingInc = text[0..=4];
        expect(greetingInc).toBe("Hello");
        let slice2 = numbers[1..=3];
        expect(slice2.length).toBe(3);
        expect(slice2[0]).toBe(20);
        expect(slice2[1]).toBe(30);
        expect(slice2[2]).toBe(40);
    });

});
