import { describe, it, expect } from "std:test";

function pushInt(): int {
    let a: int[] = []
    a.push(1)
    a.push(2)
    a.push(3)
    let sum = 0
    for (let i = 0; i < a.length; i = i + 1) {
        sum = sum + a[i]
    }
    return sum
}

function indexWrite(): int {
    let a: int[] = []
    for (let i = 0; i < 5; i = i + 1) {
        a.push(0)
    }
    for (let i = 0; i < 5; i = i + 1) {
        a[i] = i * 2
    }
    let sum = 0
    for (let i = 0; i < a.length; i = i + 1) {
        sum = sum + a[i]
    }
    return sum
}

function mixedContents(): str {
    let a: (int | str)[] = []
    a.push(1)
    a.push("two")
    return `${a[0]}-${a[1]}`
}

function sumOf(arr: int[]): int {
    let total = 0
    for (let i = 0; i < arr.length; i = i + 1) {
        total = total + arr[i]
    }
    return total
}

function passedToAnotherFunction(): int {
    let a: int[] = []
    a.push(1)
    a.push(2)
    a.push(3)
    return sumOf(a)
}

function matmulShape(): int {
    let n = 4
    let a: int[] = []
    let b: int[] = []
    let c: int[] = []
    for (let i = 0; i < n * n; i = i + 1) {
        a.push(i + 1)
        b.push(i + 1)
        c.push(0)
    }
    for (let row = 0; row < n; row = row + 1) {
        for (let col = 0; col < n; col = col + 1) {
            let sum = 0
            for (let k = 0; k < n; k = k + 1) {
                sum = sum + a[row * n + k] * b[k * n + col]
            }
            c[row * n + col] = sum
        }
    }
    return c[0] + c[n * n - 1]
}

function shadowedByArrayPattern(): float {
    let a: int[] = []
    a.push(1)
    let r = 0.0
    {
        let [a] = [[2.5, 3.5]]
        r = a[0] + a[1]
    }
    return r
}

function shadowedByObjectPattern(): float {
    let a: int[] = []
    a.push(1)
    let r = 0.0
    {
        let { a } = { a: [2.5, 3.5] }
        r = a[0] + a[1]
    }
    return r
}

function genericSpelling(): int {
    let a: Array<int> = []
    a.push(10)
    a.push(20)
    a[0] = a[0] + 5
    return a[0] + a[1] + a.length
}

function suffixSpelling(): int {
    let a: int[] = []
    a.push(10)
    a.push(20)
    a[0] = a[0] + 5
    return a[0] + a[1] + a.length
}

function genericSpellingParam(arr: Array<float>): float {
    let total = 0.0
    for (let i = 0; i < arr.length; i = i + 1) {
        total = total + arr[i]
    }
    return total
}

function reprRoundTrip(): str {
    let ints: (int | str)[] = []
    ints.push(7)
    ints.push(-3)
    let alias = ints
    ints.push("s")
    alias.push(9)
    let floats: float[] = []
    floats.push(1.5)
    floats.push(-0.25)
    return `${ints[0]}${ints[1]}${ints[2]}${ints[3]}${alias.length}${floats[0] + floats[1]}`
}

await describe("55 array element types", async () => {
    await it("tests", async () => {
        expect(pushInt()).toBe(6)
        expect(indexWrite()).toBe(20)
        expect(mixedContents()).toBe("1-two")
        expect(passedToAnotherFunction()).toBe(6)
        expect(matmulShape()).toBe(690)
        expect(shadowedByArrayPattern()).toBe(6.0)
        expect(shadowedByObjectPattern()).toBe(6.0)
        expect(genericSpelling()).toBe(suffixSpelling())
        expect(genericSpelling()).toBe(37)
        expect(genericSpellingParam([1.5, 2.5])).toBe(4.0)
        expect(reprRoundTrip()).toBe("7-3s941.25")
    });
});
