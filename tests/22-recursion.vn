import { describe, it, expect } from "std:test";

function isEven2(n: int): bool {
    if (n === 0) return true;
    return isOdd2(n - 1);
}
function isOdd2(n: int): bool {
    if (n === 0) return false;
    return isEven2(n - 1);
}
function fib(n: int): int {
    if (n <= 1) return n;
    return fib(n - 1) + fib(n - 2);
}
function power(base: int, exp: int): int {
    if (exp === 0) return 1;
    return base * power(base, exp - 1);
}

await describe("22 Recursion", async () => {
    await it("fibonacci and power", () => {
        expect(fib(0)).toBe(0);
        expect(fib(1)).toBe(1);
        expect(fib(10)).toBe(55);
        expect(power(2, 0)).toBe(1);
        expect(power(2, 10)).toBe(1024);
        expect(power(0, 5)).toBe(0);
    });

    await it("mutual recursion", () => {
        expect(isEven2(4)).toBeTruthy();
        expect(isOdd2(7)).toBeTruthy();
        expect(isEven2(0)).toBeTruthy();
    });
});
