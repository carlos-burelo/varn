function sumTo(n: int): int {
  let s = 0
  let i = 0
  while (i < n) {
    s = s + i
    i = i + 1
  }
  return s
}

function fact(n: int): int {
  let r = 1
  for (let i = 1; i <= n; i = i + 1) {
    r = r * i
  }
  return r
}

function classify(x: int): int {
  if (x < 0) {
    return 0 - 1
  } else {
    if (x == 0) { return 0 }
  }
  return 1
}

function countDown(n: int): int {
  let c = 0
  while (true) {
    if (n <= 0) { break }
    n = n - 1
    c = c + 1
  }
  return c
}

function skipEvens(n: int): int {
  let total = 0
  for (let i = 0; i < n; i = i + 1) {
    if (i % 2 == 0) { continue }
    total = total + i
  }
  return total
}

print(sumTo(100))
print(fact(5))
print(classify(0 - 5))
print(classify(0))
print(classify(7))
print(countDown(10))
print(skipEvens(10))
