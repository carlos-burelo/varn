import { Task, TaskGroup, delay, sleep } from "std:task";
import { describe, it, expect } from "std:test";


let trackerArray = [false];

await describe("97 stdlib task combinators", async () => {

    await it("1. Task.all", async () => {
        let t1 = (async () => { await delay(10); return 100; })();
        let t2 = (async () => { await delay(5); return 200; })();
        let allRes = await Task.all([t1, t2]);
        expect(allRes.length).toBe(2);
        expect(allRes[0]).toBe(100);
        expect(allRes[1]).toBe(200);
    });

    await it("2. Task.allSettled", async () => {
        let okTask = (async () => { return "success"; })();
        let errTask = (async () => { throw new Error("failure"); })();
        let settled = await Task.allSettled([okTask, errTask]);
        expect(settled.length).toBe(2);
        expect(settled[0].status).toBe("fulfilled");
        expect(settled[0].value).toBe("success");
        expect(settled[1].status).toBe("rejected");
    });

    await it("3. Task.race", async () => {
        let fastTask = (async () => { await delay(5); return "first"; })();
        let slowTask = (async () => { await delay(100); return "second"; })();
        let winner = await Task.race([fastTask, slowTask]);
        expect(winner).toBe("first");
    });

    await it("4. TaskGroup concurrency and lifecycle hooks", async () => {
        let tg = TaskGroup();
        tg.finally(() => {
        trackerArray[0] = true;
        });
        tg.spawn((async () => {
        return 1;
        })());
        tg.spawn((async () => {
        return 2;
        })());
        let groupResults = await tg.join();
        expect(groupResults.length).toBe(2);
        expect(groupResults[0]).toBe(1);
        expect(groupResults[1]).toBe(2);
        expect(trackerArray[0]).toBeTruthy();
    });

});
