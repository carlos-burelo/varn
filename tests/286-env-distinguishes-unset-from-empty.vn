import { describe, it, expect } from "std:test";
import { Env } from "std:env";

function fails(run: () => bool): bool {
    try {
        run()
        return false
    } catch (e) {
        return true
    }
}

await describe("286 env distinguishes unset from empty", async () => {
    await it("an empty variable exists", async () => {
        Env.set("VN_286_EMPTY", "");
        expect(Env.has("VN_286_EMPTY")).toBe(true);
        expect(Env.get("VN_286_EMPTY", "fallback")).toBe("");
        expect(Env.has("VN_286_NEVER_SET")).toBe(false);
        expect(Env.get("VN_286_NEVER_SET", "fallback")).toBe("fallback");
    });

    await it("a malformed boolean is an error, not the default", async () => {
        Env.set("VN_286_FLAG", "yes");
        expect(fails(() => Env.getBool("VN_286_FLAG", false))).toBeTruthy();
        expect(Env.getBool("VN_286_NEVER_SET", true)).toBe(true);
        Env.set("VN_286_FLAG", "0");
        expect(Env.getBool("VN_286_FLAG", true)).toBe(false);
    });
});
