import { describe, it, expect } from "std:test";
import { Multipart } from "std:http";
import { ParseError } from "std:error";

function body(parts: str[], boundary: str): str {
    return "preamble\r\n" + parts.map((p: str) => "--" + boundary + "\r\n" + p + "\r\n").join("") + "--" + boundary + "--\r\nepilogue";
}

function parseFails(input: str, boundary: str): bool {
    try {
        Multipart.parse(input, boundary);
        return false;
    } catch (e) {
        return e is ParseError;
    }
}

await describe("327 multipart forms", async () => {
    await it("a field is found whatever the order of the disposition parameters", async () => {
        const parts = Multipart.parse(body([
            "Content-Disposition: form-data; filename=\"photo.png\"; name=\"avatar\"\r\nContent-Type: image/png\r\n\r\nPNGDATA",
            "Content-Disposition: form-data; name=\"title\"\r\n\r\nhello"
        ], "XyZ"), "XyZ");
        expect(parts.length).toBe(2);
        expect(parts[0].name).toBe("avatar");
        expect(parts[0].filename).toBe("photo.png");
        expect(parts[0].contentType).toBe("image/png");
        expect(parts[1].name).toBe("title");
        expect(parts[1].filename).toBe(null);
        expect(parts[1].body).toBe("hello");
    });

    await it("quoted values keep escaped quotes and semicolons", async () => {
        const parts = Multipart.parse(body([
            "Content-Disposition: form-data; name=\"a;b\"; filename=\"x\\\"y.txt\"\r\n\r\nv"
        ], "B"), "B");
        expect(parts[0].name).toBe("a;b");
        expect(parts[0].filename).toBe("x\"y.txt");
    });

    await it("binary content survives byte for byte", async () => {
        const raw = Bytes.alloc(300);
        for (let i = 0; i < raw.length; i = i + 1) { raw.setByte(i, i % 256); }
        const head = Bytes.fromString("--B\r\nContent-Disposition: form-data; name=\"f\"; filename=\"b.bin\"\r\n\r\n");
        const tail = Bytes.fromString("\r\n--B--\r\n");
        const message = Bytes.alloc(head.length + raw.length + tail.length);
        head.copy(message, 0, 0, head.length);
        raw.copy(message, head.length, 0, raw.length);
        tail.copy(message, head.length + raw.length, 0, tail.length);
        const parts = Multipart.parse(message, "B");
        expect(parts[0].data.length).toBe(300);
        for (let i = 0; i < 300; i = i + 1) {
            expect(parts[0].data.getByte(i)).toBe(i % 256);
        }
    });

    await it("content that ends with a line break or mentions the boundary text is kept whole", async () => {
        const parts = Multipart.parse(body([
            "Content-Disposition: form-data; name=\"t\"\r\n\r\nline\r\n",
            "Content-Disposition: form-data; name=\"u\"\r\n\r\nmentions --B inline"
        ], "B"), "B");
        expect(parts[0].body).toBe("line\r\n");
        expect(parts[1].body).toBe("mentions --B inline");
    });

    await it("the boundary is read from the Content-Type parameters only", async () => {
        expect(Multipart.boundaryOf("multipart/form-data; boundary=abc123")).toBe("abc123");
        expect(Multipart.boundaryOf("multipart/form-data; boundary=\"a b;c\"")).toBe("a b;c");
        expect(Multipart.boundaryOf("multipart/form-data; Boundary=X; charset=utf-8")).toBe("X");
        expect(Multipart.boundaryOf("multipart/form-data; x-boundary=nope")).toBe(null);
        expect(Multipart.boundaryOf("multipart/form-data")).toBe(null);
    });

    await it("a malformed body is an error", async () => {
        expect(parseFails("--B\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nno end", "B")).toBe(true);
        expect(parseFails("--Bjunk", "B")).toBe(true);
        expect(parseFails("--B\r\nname: a", "B")).toBe(true);
        expect(parseFails("x", "")).toBe(true);
    });
});
