function setField(o: dynamic): int {
  o.x = 99
  return o.x
}
function setElem(a: dynamic): int {
  a[1] = 50
  return a[1]
}
function bumpField(o: dynamic): int {
  o.count = o.count + 1
  return o.count
}
function fillArr(a: dynamic, n: int): int {
  for (let i = 0; i < n; i = i + 1) { a[i] = i * 2 }
  let s = 0
  for (let i = 0; i < n; i = i + 1) { s = s + a[i] }
  return s
}
let o = { x: 0, count: 10 }
let a = [0, 0, 0]
print(setField(o))
print(setElem(a))
print(bumpField(o))
print(fillArr(a, 3))
