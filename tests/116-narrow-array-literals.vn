// Literales de array contra un tipo de elemento angosto (i8/i16/i32/u8/u16/u32/f32).
//
// `[1, 2, 3]` infiere `int[]` y un tipo angosto no es supertipo de `int`, asi que
// la compatibilidad pura de tipos rechazaba incluso el caso valido. El chequeo
// contextual de elementos ahora pasa por `value_assignable_to`, que mira el VALOR
// del literal — mismo camino que `let x: i8 = 42`. El caso fuera de rango vive en
// `tests/errors/narrow-array-literal-overflow.vn`.

let i8s: Array<i8> = [-128, 0, 127]
assert("i8: cota inferior en literal de array", i8s[0] == -128)
assert("i8: cota superior en literal de array", i8s[2] == 127)

let i16s: Array<i16> = [-32768, 32767]
assert("i16: cotas en literal de array", i16s[0] == -32768 && i16s[1] == 32767)

let i32s: Array<i32> = [-2147483648, 2147483647]
assert("i32: cotas en literal de array", i32s[1] == 2147483647)

let u8s: Array<u8> = [0, 255]
assert("u8: cota superior en literal de array", u8s[1] == 255)

let u16s: Array<u16> = [0, 65535]
assert("u16: cota superior en literal de array", u16s[1] == 65535)

let u32s: Array<u32> = [0, 4000000000]
assert("u32: literal por encima del rango de i32", u32s[1] == 4000000000)

let f32s: Array<f32> = [1.5, -2.5, 3]
assert("f32: literales float y int en literal de array", f32s[0] == 1.5 && f32s[1] == -2.5)

// La forma corta del tipo (`i8[]`) toma el mismo camino contextual.
let shorthand: i8[] = [1, -1]
assert("i8[]: forma corta acepta literales en rango", shorthand[0] + shorthand[1] == 0)

let total = 0
for (const v of i8s) { total = total + v }
assert("i8: los elementos conservan su valor en runtime", total == -1)

// Los otros contextos que aportan un tipo esperado pasan por el mismo embudo.
function makeI8s(): Array<i8> { return [1, 2, 3] }
assert("return: literal de array angosto en posicion de retorno", makeI8s()[2] == 3)

class Palette { channels: Array<u8> = [0, 128, 255] }
assert("campo de clase: literal de array angosto", new Palette().channels[2] == 255)

let box: { xs: Array<i8> } = { xs: [-1, 1] }
assert("propiedad de objeto: literal de array angosto", box.xs[1] == 1)

// Una propiedad requerida NO angosta al lado no hunde al literal, y una
// opcional puede omitirse. La que falta y es requerida si es error de
// compilacion (tests/errors/narrow-array-object-missing-prop.vn).
let mixed: { xs: Array<u8>, name: str } = { xs: [0, 255], name: "paleta" }
assert("objeto mixto: propiedad angosta y propiedad plana juntas", mixed.name == "paleta" && mixed.xs[1] == 255)

let partial: { xs: Array<i8>, name?: str } = { xs: [7] }
assert("objeto: la propiedad opcional puede omitirse", partial.xs[0] == 7)

let grid: Array<Array<i8>> = [[1, 2], [3, 4]]
assert("anidado: Array<Array<i8>> acepta literales en rango", grid[1][1] == 4)

print("NARROW ARRAY LITERALS PASSED")
