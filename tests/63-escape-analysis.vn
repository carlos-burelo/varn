import { describe, it, expect } from "std:test";


// `passes::escape` deletes a class instance that never escapes, answering
// every `getfixed` on it from the constructor's argument instead. The whole
// optimization rests on a compile-time claim — "this global still holds the
// class it was declared with" — which is FALSE in general, because class
// bindings are reassignable. Most of this file pins the cases where the pass
// must refuse.
//
// Any assert here that starts failing means an allocation was removed whose
// effects were still observable.

class EaPoint {
  x: int
  y: int
  constructor(x: int, y: int) { this.x = x; this.y = y }
}

// The shape the pass exists for: built, read, never escapes.
function eaSum(n: int): int {
  let s = 0
  for (let i = 0; i < n; i = i + 1) { const p = new EaPoint(i, i + 1); s = s + p.x + p.y }
  return s
}

// Argument order must survive: reading slot 1 has to yield the SECOND
// argument, not whichever the summary happened to visit first.
function eaOrder(): int { const p = new EaPoint(7, 11); return p.y * 100 + p.x }

// --- the instance escapes: the allocation must stay ---------------------

function eaEscapeReturn(v: int): EaPoint { return new EaPoint(v, v) }

function eaEscapeArray(n: int): int {
  const acc = []
  for (let i = 0; i < n; i = i + 1) { acc.push(new EaPoint(i, i)) }
  return acc.length + acc[0].x + acc[4].y
}

function eaTakes(p: EaPoint): int { return p.x + p.y }
function eaEscapeArg(v: int): int { return eaTakes(new EaPoint(v, v)) }

// Identity is observable: `===` on objects is the address, so two separately
// constructed instances must stay distinct even with identical fields.
function eaIdentity(): bool {
  const a = new EaPoint(1, 2)
  const b = new EaPoint(1, 2)
  return a === b
}

// --- shapes the summary must refuse -------------------------------------

// A constructor that computes rather than copies is not a parameter map.
class EaComputed {
  v: int
  constructor(v: int) { this.v = v * 2 + 1 }
}
function eaComputedSum(): int { const c = new EaComputed(10); return c.v }

// A field the constructor never assigns reads null, not the argument.
class EaPartial {
  a: int
  b: int
  constructor(a: int) { this.a = a }
}
function eaPartialB(): bool { const p = new EaPartial(4); return p.b === null }

// Inheritance brings a super constructor whose effects are not in this body.
class EaBase {
  a: int
  constructor(a: int) { this.a = a }
}
class EaDerived extends EaBase {
  b: int
  constructor(a: int, b: int) { super(a); this.b = b }
}
function eaDerivedSum(): int { const d = new EaDerived(3, 4); return d.a + d.b }

// A getter gives the name behaviour a raw slot read does not have.
class EaGetter {
  v: int
  constructor(v: int) { this.v = v }
  get doubled(): int { return this.v * 2 }
}
function eaGetterRead(): int { const g = new EaGetter(21); return g.doubled }

await describe("63 escape analysis", async () => {
    await it("tests", async () => {
        expect(eaSum(1000)).toBe(1000000)
        expect(eaOrder()).toBe(1107)
        const eaKept = eaEscapeReturn(3)
        expect(eaKept.x === 3 && eaKept.y === 3).toBeTruthy()
        expect(eaEscapeArray(5)).toBe(9)
        expect(eaEscapeArg(6)).toBe(12)
        expect(eaIdentity()).toBe(false)
        expect(eaComputedSum()).toBe(21)
        expect(eaPartialB()).toBe(true)
        expect((new EaPartial(4)).a).toBe(4)
        expect(eaDerivedSum()).toBe(7)
        expect(eaGetterRead()).toBe(42)
        
        
    });
});
