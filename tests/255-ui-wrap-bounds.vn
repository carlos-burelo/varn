import { describe, it, expect } from "std:test";
import { Widget, Constraints, Box, Row, Expanded, Wrap } from "std:ui";

function chips(): Widget[] {
    const out: Widget[] = [];
    for (let i = 0; i < 5; i = i + 1) {
        out.push(Box(w: 50.0, h: 20.0));
    }
    return out;
}

await describe("255 wrap, bounds and flex", async () => {
    await it("box clamps its size to minW and maxW", () => {
        expect(Box(minW: 120.0).layout(Constraints.loose(400.0, 100.0)).size.w).toBe(120.0);
        expect(Box(Box(w: 300.0, h: 10.0), maxW: 200.0).layout(Constraints.loose(400.0, 100.0)).size.w).toBe(200.0);
        expect(Box(Box(w: 300.0, h: 10.0), maxH: 4.0).layout(Constraints.loose(400.0, 100.0)).size.h).toBe(4.0);
    });

    await it("expanded children share the leftover room by flex weight", () => {
        const row = Row([Expanded(Box(h: 10.0), 1.0), Expanded(Box(h: 10.0), 2.0)], gap: 0.0);
        const p = row.layout(Constraints.loose(300.0, 50.0));
        expect(p.children[0].size.w).toBe(100.0);
        expect(p.children[1].size.w).toBe(200.0);
        expect(p.children[1].x).toBe(100.0);
    });

    await it("wrap breaks lines at the available width", () => {
        const narrow = Wrap(chips(), gap: 10.0, runGap: 10.0).layout(Constraints.loose(130.0, 500.0));
        expect(narrow.children[1].x).toBe(60.0);
        expect(narrow.children[2].x).toBe(0.0);
        expect(narrow.children[2].y).toBe(30.0);
        expect(narrow.children[4].y).toBe(60.0);

        const medium = Wrap(chips(), gap: 10.0, runGap: 10.0).layout(Constraints.loose(240.0, 500.0));
        expect(medium.children[3].x).toBe(180.0);
        expect(medium.children[4].x).toBe(0.0);
        expect(medium.children[4].y).toBe(30.0);

        const wide = Wrap(chips(), gap: 10.0, runGap: 10.0).layout(Constraints.loose(500.0, 500.0));
        expect(wide.children[4].x).toBe(240.0);
        expect(wide.children[4].y).toBe(0.0);
        expect(wide.size.w).toBe(290.0);
        expect(wide.size.h).toBe(20.0);
    });
});
