import { describe, it, expect } from "std:test";

const MAX: int = 9223372036854775807
const MIN: int = 0 - 9223372036854775807 - 1

const forty: int = 40

const m7: int = 0 - 7
const p7: int = 7

function kind(f: () => int): str {
    try { f(); return "none" } catch (e) {
        if (e instanceof IntegerOverflow) { return "ovf" }
        if (e instanceof DivisionByZero) { return "zero" }
        return "other"
    }
}
const ten: int = 10
const one: int = 1

const dyn: dynamic = MIN
await describe("123 int api", async () => {
        await it("group 1 part 1", async () => {
        expect(MAX.wrappingAdd(1)).toBe(MIN);
        expect(MIN.wrappingSub(1)).toBe(MAX);
        expect(MAX.wrappingMul(2)).toBe(0 - 2);
        expect(MAX.saturatingAdd(1)).toBe(MAX);
        expect(MIN.saturatingSub(1)).toBe(MIN);
        expect(MIN.saturatingMul(2)).toBe(MIN);
        expect(MAX.checkedAdd(1)).toBe(null);
        expect(forty.checkedAdd(2)).toBe(42);
    });

    await it("group 1 part 2", async () => {
        expect(m7.div(2)).toBe(0 - 3);
        expect(m7.floorDiv(2)).toBe(0 - 4);
        expect(p7.ceilDiv(2)).toBe(4);
        expect(m7.rem(2)).toBe(0 - 1);
        expect(m7.mod(2)).toBe(1);
        expect(kind(() => MIN.abs())).toBe("ovf");
        expect(kind(() => MIN.negate())).toBe("ovf");
        expect(kind(() => ten.pow(30))).toBe("ovf");
    });

    await it("group 1 part 3", async () => {
        expect(ten.pow(3)).toBe(1000);
        expect(kind(() => one.floorDiv(0))).toBe("zero");
        expect(kind(() => int.parse("abc"))).toBe("other");
        expect(int.parse(" 42 ")).toBe(42);
        expect(int.tryParse("abc")).toBe(null);
        expect(kind(() => dyn.abs())).toBe("ovf");
    });


});
