import { describe, it, expect } from "std:test";

// Test Suite 89: Raw String Literals ("""...""") and `with` Expressions

class User(public id: int, public name: str, public role: str = "guest") {}

class ServerNode(public host: str, public port: int, public isMaster: bool = false) {}
await describe("89 raw strings and with expressions", async () => {
        await it("Raw string with unescaped quotes, backslashes and multiline content", async () => {
        let jsonStr = """{
        "name": "Varn",
        "path": "C:\Program Files\Varn",
        "escapes": "\n \t \r"
        }""";
        expect(jsonStr.includes("\"name\": \"Varn\"")).toBe(true);
        expect(jsonStr.includes("C:\Program Files\Varn")).toBe(true);
        expect(jsonStr.includes("""\n \t \r""")).toBe(true);
        });
        await it("Single-line raw string with double quotes", async () => {
        let text = """Hello "world" and 'quotes' without escapes!""";
        expect(text).toBe("Hello \"world\" and 'quotes' without escapes!");
        });
        
        await it("`with` expression on Class instances", async () => {
        let u1 = new User(10, "Alice", "admin");
        let u2 = u1 with { name: "Bob", role: "editor" };
        expect(u2.id).toBe(10);
        expect(u2.name).toBe("Bob");
        expect(u2.role).toBe("editor");
        expect(u1.id).toBe(10);
        expect(u1.name).toBe("Alice");
        expect(u1.role).toBe("admin");
        });
        await it("`with` expression on Plain Objects", async () => {
        let baseConfig = {
        host: "localhost",
        port: 3000,
        debug: true
        };
        let prodConfig = baseConfig with {
        port: 8080,
        debug: false
        };
        expect(prodConfig.host).toBe("localhost");
        expect(prodConfig.port).toBe(8080);
        expect(prodConfig.debug).toBe(false);

        expect(baseConfig.port).toBe(3000);
        expect(baseConfig.debug).toBe(true);
        });
        await it("Chained or nested `with` expressions", async () => {
        let node1 = new ServerNode("10.0.0.1", 5000, false);
        let node2 = node1 with { port: 5001 };
        let node3 = node2 with { isMaster: true };
        expect(node3.host).toBe("10.0.0.1");
        expect(node3.port).toBe(5001);
        expect(node3.isMaster).toBe(true);
        expect(node1.port).toBe(5000);
        expect(node1.isMaster).toBe(false);
        });
        

});
