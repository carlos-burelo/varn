import { describe, it, expect } from "std:test";

function total(m: Map<str, int>): int {
    let sum = 0;
    for (const (k, v) of m) {
        sum += v;
    }
    return sum;
}

function table(): Map<int, bool> {
    return [1: true, 2: false];
}

class Registry {
    names: Map<int, str> = [1: "uno"];
    lookup(id: int): str {
        return this.names.get(id) ?? "?";
    }
}

await describe("333 map literal", async () => {
    await it("a map literal pairs keys with values", async () => {
        const ages = ["ana": 31, "luis": 27];
        expect(ages.size).toBe(2);
        expect(ages.get("ana")).toBe(31);
        expect(ages.get("nadie")).toBe(null);
        expect(ages.has("luis")).toBe(true);
    });

    await it("keys can be any type, not only strings", async () => {
        const byId: Map<int, str> = [1: "uno", 2: "dos"];
        expect(byId.get(2)).toBe("dos");
        const pairs = [("a", 1): true];
        expect(pairs.size).toBe(1);
        const flags = [true: "yes", false: "no"];
        expect(flags.get(false)).toBe("no");
    });

    await it("an empty map needs its type and is written [:]", async () => {
        const empty: Map<str, int> = [:];
        expect(empty.size).toBe(0);
        empty.set("a", 1);
        expect(empty.get("a")).toBe(1);
    });

    await it("keys and values are expressions, and a trailing comma is allowed", async () => {
        const k = "dyn";
        const n = 5;
        const built = [k + "1": n * 2, k + "2": n + 1,];
        expect(built.get("dyn1")).toBe(10);
        expect(built.get("dyn2")).toBe(6);
        const choose = true;
        const picked = [choose ? 1 : 2: "ok"];
        expect(picked.get(1)).toBe("ok");
    });

    await it("a repeated key keeps the last value and the insertion order is kept", async () => {
        const m = ["a": 1, "b": 2, "a": 3];
        expect(m.size).toBe(2);
        expect(m.get("a")).toBe(3);
        const keys: str[] = [];
        for (const (key, value) of m) {
            keys.push(key);
        }
        expect(keys.join(",")).toBe("a,b");
    });

    await it("maps nest and hold other collections", async () => {
        const nested = ["xs": [1, 2, 3], "ys": [4]];
        expect(nested.get("xs")!.length).toBe(3);
        const grid = ["a": ["b": 1]];
        expect(grid.get("a")!.get("b")).toBe(1);
        const withTuples = [1: (1, "x"), 2: (2, "y")];
        expect(withTuples.get(2)![1]).toBe("y");
    });

    await it("a map literal is an argument, a return value and a field initializer", async () => {
        expect(total(["x": 1, "y": 2, "z": 3])).toBe(6);
        expect(table().get(1)).toBe(true);
        expect(new Registry().lookup(1)).toBe("uno");
        expect(new Registry().lookup(9)).toBe("?");
    });

    await it("values of different types make a union value type", async () => {
        const mixed: Map<str, int | str> = ["a": 1, "b": "x"];
        expect(mixed.size).toBe(2);
        expect(mixed.get("b")).toBe("x");
    });

    await it("a map is a mutable reference and an array with a ternary stays an array", async () => {
        const m = ["a": 1];
        m.set("b", 2);
        m.delete("a");
        expect(m.size).toBe(1);
        const c = true;
        const arr = [c ? 1 : 2, 3];
        expect(arr.length).toBe(2);
    });
});
