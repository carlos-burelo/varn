import { Process } from "std:process";
import { Compress } from "std:compress";
import { CLI } from "std:cli";
import { Env } from "std:env";
import { Path } from "std:path";
import { describe, it, expect } from "std:test";

// ==========================================
// 1. Process Execution (std:process)
// ==========================================
let procRes = Process.exec("echo VarnProcessTest");

// ==========================================
// 2. Compression & Decompression (std:compress)
// ==========================================
let originalText = "Varn Language: Fast, Type-Safe, High-Performance Systems Language with Register VM!";

// Gzip roundtrip
let gzipped = Compress.gzip(originalText);
let unzipped = Compress.gunzip(gzipped);

// Deflate / Inflate roundtrip
let deflated = Compress.deflate(originalText);
let inflated = Compress.inflate(deflated);

// ==========================================
// 3. CLI Argument Parser (std:cli)
// ==========================================
let sampleArgs = ["--port=9000", "--host=localhost", "-d", "serve", "api/v1"];
let parsed = CLI.parse(sampleArgs);

// ==========================================
// 4. Environment Variables (std:env)
// ==========================================

let dotEnvContent = "# Configuration\nAPP_NAME=VarnServer\nPORT=4000\nDEBUG=true\n";
let envMap = Env.parse(dotEnvContent);

// ==========================================
// 5. Canonical Path Namespace (std:path)
// ==========================================
let joinedPath = Path.join("src", "modules", "app.vn");
await describe("84 stdlib process compress cli env", async () => {
        await it("group 1 part 1", async () => {
        expect(procRes.exitCode).toBe(0);
        expect(procRes.success).toBe(true);
        expect(procRes.stdout.includes("VarnProcessTest")).toBeTruthy();
        expect(gzipped.length > 0).toBeTruthy();
        expect(unzipped.toString()).toBe(originalText);
        expect(deflated.length > 0).toBeTruthy();
        expect(inflated.toString()).toBe(originalText);
        expect(parsed.flags["port"]).toBe("9000");
    });

    await it("group 1 part 2", async () => {
        expect(parsed.flags["host"]).toBe("localhost");
        expect(parsed.flags["d"]).toBe("true");
        expect(parsed.positionals.length).toBe(2);
        expect(parsed.positionals[0]).toBe("serve");
        expect(parsed.positionals[1]).toBe("api/v1");
        Env.set("VARN_TEST_PORT", "8080");
        expect(Env.get("VARN_TEST_PORT")).toBe("8080");
        expect(Env.getInt("VARN_TEST_PORT", 3000)).toBe(8080);
        expect(Env.getInt("VARN_NON_EXISTING_KEY", 5000)).toBe(5000);
        Env.set("VARN_DEBUG_FLAG", "true");
    });

    await it("group 1 part 3", async () => {
        expect(Env.getBool("VARN_DEBUG_FLAG", false)).toBe(true);
        expect(envMap["APP_NAME"]).toBe("VarnServer");
        expect(envMap["PORT"]).toBe("4000");
        expect(envMap["DEBUG"]).toBe("true");
        expect(joinedPath.includes("src") && joinedPath.includes("app.vn")).toBeTruthy();
        expect(Path.extname("archive.tar.gz")).toBe(".gz");
        expect(Path.extname("index.html")).toBe(".html");
    });


});
