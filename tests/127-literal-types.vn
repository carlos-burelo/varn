import { describe, it, expect } from "std:test";

type Method = "GET" | "POST"

function send(m: Method): int { return m.length }

let m: Method = "GET"
const asStr: str = m

const code: 200 | 404 = 404
const neg: -1 | 1 = -1

const on: true = true
const ch: 'x' | 'y' = 'y'

function status(): 200 | 500 { return 200 }
await describe("127 literal types", async () => {
        await it("group 1 part 1", async () => {
        expect(send("POST")).toBe(4);
        expect(m).toBe("GET");
        expect(asStr).toBe("GET");
        expect(code + 1).toBe(405);
    });

    await it("group 1 part 2", async () => {
        expect(neg).toBe(-1);
        expect(on && ch).toBe('y');
        expect(status()).toBe(200);
    });


});
