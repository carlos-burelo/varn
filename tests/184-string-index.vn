import { describe, it, expect } from "std:test";

function countB(text: str): int {
    let n = 0
    for (let i = 0; i < text.length; i = i + 1) {
        if (text[i] == "b") { n = n + 1 }
    }
    return n
}
function at(text: str, i: int): str? { return text[i] }
function viaDynamic(d: dynamic, i: int): dynamic { return d[i] }

await describe("184 string index", async () => {
    await it("indexes by character, short and long strings", () => {
        expect("abc"[1]).toBe("b")
        expect(at("abcabcabcabcabcabcabcabc", 22)).toBe("b")
        expect(typeof "abc"[0]).toBe("str")
    })

    await it("counts characters, not bytes", () => {
        expect("ñandú"[0]).toBe("ñ")
        expect("ñandú"[4]).toBe("ú")
        expect(at("añoañoañoañoañoañoaño", 19)).toBe("ñ")
    })

    await it("out of range and negative give null", () => {
        expect(at("abc", 3)).toBe(null)
        expect(at("abc", -1)).toBe(null)
        expect(at("", 0)).toBe(null)
    })

    await it("the untyped path agrees", () => {
        expect(viaDynamic("abc", 2)).toBe("c")
        expect(viaDynamic("ñandú", 4)).toBe("ú")
        expect(viaDynamic("abc", 9)).toBe(null)
    })

    await it("holds in a hot loop", () => {
        let total = 0
        for (let r = 0; r < 300; r = r + 1) { total = total + countB("abcabcabcabc") }
        expect(total).toBe(1200)
    })
})
