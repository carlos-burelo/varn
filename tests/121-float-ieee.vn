import { describe, it, expect } from "std:test";

function fdiv(a: float, b: float): float { return a / b }
function fmod(a: float, b: float): float { return a % b }

const inf: float = fdiv(1.0, 0.0)
const nan: float = fdiv(0.0, 0.0)
const modNan: float = fmod(1.0, 0.0)

const negZero: float = 0.0 * (0.0 - 1.0)

const tiny: float = 5e-324

let i = 0
let hotInf = 0.0
await describe("121 float ieee", async () => {
        await it("group 1 part 1", async () => {
        expect(inf).toBe(Infinity);
        expect(fdiv(0.0 - 1.0, 0.0)).toBe(0.0 - Infinity);
        expect(nan !== nan).toBeTruthy();
        expect(modNan !== modNan).toBeTruthy();
    });

    await it("group 1 part 2", async () => {
        expect(negZero).toBe(0.0);
        expect(fdiv(1.0, negZero)).toBe(0.0 - Infinity);
        expect(tiny > 0.0 && tiny / 2.0).toBe(0.0);
        while (i < 500) { hotInf = fdiv(1.0, 0.0); i = i + 1 }
        expect(hotInf).toBe(Infinity);
    });


});
