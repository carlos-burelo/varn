// Real-world Functional Collection Processing Pipeline

class OrderItem {
    id: int;
    sku: str;
    category: str;
    quantity: int;
    unitPrice: float;
    isDiscounted: bool;
    status: str;

    constructor(id: int, sku: str, category: str, quantity: int, unitPrice: float, isDiscounted: bool, status: str) {
        this.id = id;
        this.sku = sku;
        this.category = category;
        this.quantity = quantity;
        this.unitPrice = unitPrice;
        this.isDiscounted = isDiscounted;
        this.status = status;
    }
}

class OrderSummary {
    id: int;
    category: str;
    grossTotal: float;
    tax: float;
    netTotal: float;

    constructor(id: int, category: str, grossTotal: float, tax: float, netTotal: float) {
        this.id = id;
        this.category = category;
        this.grossTotal = grossTotal;
        this.tax = tax;
        this.netTotal = netTotal;
    }
}

// 1. Generate 100,000 Order Items
let categories = ["Electronics", "Apparel", "Home", "Books", "Sports"];
let statuses = ["completed", "pending", "cancelled", "completed", "completed"];

let orders: OrderItem[] = [];
for (let i = 0; i < 100000; i = i + 1) {
    let cat = categories[i % 5];
    let stat = statuses[i % 5];
    let qty = (i % 8) + 1;
    let price = ((i % 150) + 10) * 1.5;
    let disc = (i % 3) === 0;
    orders.push(new OrderItem(
        i,
        "SKU_" + (i % 2000),
        cat,
        qty,
        price,
        disc,
        stat
    ));
}

// 2. Multi-Stage Pipeline Execution

// Stage 1: Filter active completed orders
let validOrders: OrderItem[] = [];
for (let i = 0; i < orders.length; i = i + 1) {
    let o = orders[i];
    if (o.status === "completed" && o.quantity > 0) {
        validOrders.push(o);
    }
}

// Stage 2: Map to financial summaries with tax and discounts
let summaries: OrderSummary[] = [];
for (let i = 0; i < validOrders.length; i = i + 1) {
    let o = validOrders[i];
    let gross = (o.quantity as float) * o.unitPrice;
    if (o.isDiscounted) {
        gross = gross * 0.9;
    }
    let tax = gross * 0.16;
    let net = gross + tax;
    summaries.push(new OrderSummary(o.id, o.category, gross, tax, net));
}

// Stage 3: Filter high value summaries
let highValueSummaries: OrderSummary[] = [];
for (let i = 0; i < summaries.length; i = i + 1) {
    let s = summaries[i];
    if (s.netTotal >= 50.0) {
        highValueSummaries.push(s);
    }
}

// Stage 4: Reduce to totals
let totalGross = 0.0;
let totalTax = 0.0;
let totalNet = 0.0;

for (let i = 0; i < highValueSummaries.length; i = i + 1) {
    let s = highValueSummaries[i];
    totalGross = totalGross + s.grossTotal;
    totalTax = totalTax + s.tax;
    totalNet = totalNet + s.netTotal;
}

// Stage 5: Find & Verification
let foundItem: OrderSummary? = null;
let targetId = 4242;
for (let i = 0; i < highValueSummaries.length; i = i + 1) {
    if (highValueSummaries[i].id === targetId) {
        foundItem = highValueSummaries[i];
        break;
    }
}

print("Collection Pipeline: Processed " + orders.length + " orders -> " + highValueSummaries.length + " high value summaries, Total Net = $" + totalNet + ", Target Found = " + (foundItem != null));
