import { parallel, sleep, Task } from "std:task";

async function loaded(n: int): Task<int> {
    let dead: Array<int> = [];
    for (let i = 0; i < 200; i = i + 1) {
        dead.push(i * n);
    }
    let live = n + 1;
    await sleep(300);
    let acc = live;
    for (let i = 0; i < dead.length; i = i + 1) {
        acc = acc + 0 * dead[i];
    }
    return live;
}

let batch: Array<Task<int>> = [];
for (let i = 0; i < 3000; i = i + 1) {
    batch.push(loaded(i));
}
let res = await parallel(batch);
let sum = 0;
for (let i = 0; i < res.length; i = i + 1) {
    sum = sum + res[i];
}
print("soak3000 sum=" + sum.toString());
