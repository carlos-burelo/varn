import { Json } from "std:encoding";

let items = [];
for (let i = 0; i < 50000; i = i + 1) {
    items.push({
        id: i,
        name: "Item_" + i,
        active: (i % 2) === 0,
        score: ((i % 100) as float) * 1.25
    });
}

let jsonStr = Json.stringify(items);
let parsed = Json.parse(jsonStr) as dynamic[];

print(parsed.length);
let totalScore = 0.0;
for (let i = 0; i < parsed.length; i = i + 1) {
    totalScore = totalScore + (parsed[i]["score"] as float);
}
print((totalScore as int).toString());
print("bytes: " + jsonStr.length.toString());
