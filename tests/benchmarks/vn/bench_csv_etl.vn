import { Csv } from "std:encoding";

type Row = {
    id: int,
    customer_id: str,
    product_category: str,
    amount: int,
    tax_rate: float,
    status: str,
    created_at: str
};
type Enriched = {
    id: int,
    customer_id: str,
    category: str,
    base_amount: float,
    final_total: float,
    tier: str,
    date: str
};

// Real-world CSV ETL: Parse, Validate, Enrich, Aggregate, and Re-export

// 1. Generate realistic 10,000 row CSV dataset
let csvLines: str[] = ["id,customer_id,product_category,amount,tax_rate,status,created_at"];
let categories = ["Electronics", "Fashion", "Home", "Automotive", "Garden"];
let statuses = ["completed", "refunded", "completed", "pending", "completed"];

for (let i = 1; i <= 10000; i = i + 1) {
    let cat = categories[i % 5];
    let stat = statuses[i % 5];
    let amt = ((i * 17) % 1000) + 15;
    let tax = 0.16;
    let cust = `CUST_${(i % 800)}`;
    let date = `2026-08-${((i % 28) + 1)}`;
    csvLines.push(`${i},${cust},${cat},${amt},${tax},${stat},${date}`);
}

let rawCsv = csvLines.join("\n");

// 2. Parse CSV Dataset
let parsedRows = Csv.parse<Row>(rawCsv);

// 3. Filter & Enrich Records
let enrichedRows: Enriched[] = [];
let totalCompletedRevenue = 0.0;
let vipCount = 0;

for (let i = 0; i < parsedRows.length; i = i + 1) {
    let row = parsedRows[i];
    if (row.status === "completed") {
        let amt = row.amount as float;
        let taxRate = row.tax_rate;
        let finalTotal = amt * (1.0 + taxRate);
        let isVip = amt >= 500.0;

        if (isVip) {
            vipCount = vipCount + 1;
        }
        totalCompletedRevenue = totalCompletedRevenue + finalTotal;

        enrichedRows.push({
            id: row.id,
            customer_id: row.customer_id,
            category: row.product_category,
            base_amount: amt,
            final_total: finalTotal,
            tier: isVip ? "VIP" : "Standard",
            date: row.created_at
        });
    }
}

// 4. Serialize back to CSV format
let exportedCsv = Csv.stringify(enrichedRows);

print("CSV ETL Benchmark:");
print(`  Total parsed rows: ${parsedRows.length}`);
print(`  Enriched completed rows: ${enrichedRows.length}`);
print(`  VIP Transactions: ${vipCount}`);
print(`  Total Completed Revenue: ${totalCompletedRevenue}`);
print(`  Exported CSV length: ${exportedCsv.length} bytes`);
