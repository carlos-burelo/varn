let words = ["alpha", "beta", "gamma", "delta", "epsilon", "zeta", "eta", "theta", "iota", "kappa", "lambda", "mu"];
let parts: str[] = [];
let seed = 7;
for (let i = 0; i < 300000; i = i + 1) {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    parts.push(words[seed % 12] + (seed % 50).toString());
}
let text = parts.join(" ");
let counts = new Map<str, int>();
let tokens = text.split(" ");
for (let i = 0; i < tokens.length; i = i + 1) {
    let t = tokens[i];
    let c = counts.get(t);
    counts.set(t, (c ?? 0) + 1);
}
let best = "";
let bestCount = 0;
let total = 0;
for (const (word, n) of counts) {
    total = total + n;
    if (n > bestCount || (n == bestCount && word < best)) {
        best = word;
        bestCount = n;
    }
}
print(`words=${tokens.length} distinct=${counts.size} best=${best}:${bestCount} total=${total}`);
