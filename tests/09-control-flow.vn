import { describe, it, expect } from "std:test";

function classify(n: int): str {
    return n < 0 ? "neg" : n === 0 ? "zero" : "pos";
}
function firstAbove(arr: int[], threshold: int): int {
    let i = 0;
    let result = -1;
    while (i < arr.length) {
        if (arr[i] > threshold) {
            result = arr[i];
            break;
        }
        i = i + 1;
    }
    return result;
}
function sumOdds(max: int): int {
    let total = 0;
    for (let i = 0; i <= max; i = i + 1) {
        if (i % 2 === 0) continue;
        total = total + i;
    }
    return total;
}

await describe("09 Control Flow", async () => {
    await it("ternary and while", () => {
        expect(classify(-1)).toBe("neg");
        expect(classify(0)).toBe("zero");
        expect(classify(1)).toBe("pos");
        expect(firstAbove([1, 2, 10, 3], 5)).toBe(10);
        expect(sumOdds(10)).toBe(25);
    });

    await it("for loops", () => {
        let forOfSum = 0;
        for (const n of [10, 20, 30]) {
            forOfSum = forOfSum + n;
        }
        expect(forOfSum).toBe(60);
        let forOfBreak = 0;
        for (const n of [1, 2, 3, 4, 5]) {
            if (n === 3) break;
            forOfBreak = forOfBreak + n;
        }
        expect(forOfBreak).toBe(3);
        const obj2 = { x: 1, y: 2, z: 3 };
        let keyCount = 0;
        for (const k in obj2) {
            keyCount = keyCount + 1;
        }
        expect(keyCount).toBe(3);
    });
});
