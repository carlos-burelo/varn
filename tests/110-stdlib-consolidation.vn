import { JSON, Base64, Hex, TOML } from "std:encoding";
import { Color, Table, CLI, Prompt, prompt, confirm, password } from "std:cli";
import { Mutex, Semaphore, WaitGroup, delay, spawn, Task } from "std:task";
import { LogLevel, Logger, getLogger } from "std:log";
import { PriorityQueue, LRUCache } from "std:collections";
import { describe, it, expect } from "std:test";



function testCli(): void {
    // 1. Color & ANSI stripping
    let styled = Color.red("critical error");
        expect(styled.includes("\x1b[31m")).toBeTruthy();;
        expect(Color.stripAnsi(styled)).toBe("critical error");;
    let isTermInteractive = Color.isInteractive();
        expect(isTermInteractive === true || isTermInteractive === false).toBeTruthy();;

    // 2. Table
    let table = new Table(["ID", "Name", "Role"]);
    table.addRow(["1", "Alice", "Admin"]);
    table.addRow(["2", "Bob", "User"]);
    let renderedTable = table.render();
        expect(renderedTable.includes("Alice")).toBeTruthy();;
        expect(renderedTable.includes("Admin")).toBeTruthy();;
        expect(renderedTable.includes("+")).toBeTruthy();;

    // 3. CLI Args
    let parsed = CLI.parse(["--env=production", "-v", "src/main.vn"]);
        expect(parsed.flags["env"]).toBe("production");;
        expect(parsed.flags["v"]).toBe("true");;
        expect(parsed.positionals.length).toBe(1);;
        expect(parsed.positionals[0]).toBe("src/main.vn");;

    // 4. Prompt exports
        expect(Prompt !== null).toBeTruthy();;
        expect(prompt !== null).toBeTruthy();;
        expect(confirm !== null).toBeTruthy();;
        expect(password !== null).toBeTruthy();;

}

class SyncState {
    counter: int = 0;
    semCounter: int = 0;
    wgProgress: int = 0;
}

let syncState = new SyncState();

let logCapturedLines: str[] = [];
let logJsonLines: str[] = [];

function testLog(): void {
    let logger = new Logger("service", LogLevel.Info, false, false, (line: str): void => {
        logCapturedLines.push(line);
    });

    // Level filtering
    logger.debug("should be filtered");
        expect(logCapturedLines.length).toBe(0);;

    logger.info("service initialized", { "port": 3000 });
        expect(logCapturedLines.length).toBe(1);;
        expect(logCapturedLines[0].includes("[INFO]")).toBeTruthy();;
        expect(logCapturedLines[0].includes("(service)")).toBeTruthy();;
        expect(logCapturedLines[0].includes("service initialized")).toBeTruthy();;
        expect(logCapturedLines[0].includes("\"port\":3000")).toBeTruthy();;

    // JSON format output
    let jsonLogger = new Logger("jsonApp", LogLevel.Debug, true, false, (line: str): void => {
        logJsonLines.push(line);
    });
    jsonLogger.debug("testing json", { "ok": true });
        expect(logJsonLines.length).toBe(1);;

    let parsedRecord = JSON.parse(logJsonLines[0]) as { [key: str]: dynamic };
        expect(parsedRecord["level"]).toBe("DEBUG");;
        expect(parsedRecord["target"]).toBe("jsonApp");;
        expect(parsedRecord["message"]).toBe("testing json");;

    // Child logger
    let childLogger = logger.child("worker");
        expect(childLogger.name).toBe("service.worker");;

}

function testCollections(): void {
    // 1. PriorityQueue (Min-Heap default)
    let minPq = new PriorityQueue<int>();
    minPq.push(40);
    minPq.push(10);
    minPq.push(30);
    minPq.push(20);
        expect(minPq.size).toBe(4);;
        expect(minPq.peek()).toBe(10);;
        expect(minPq.pop()).toBe(10);;
        expect(minPq.pop()).toBe(20);;
        expect(minPq.pop()).toBe(30);;
        expect(minPq.pop()).toBe(40);;
        expect(minPq.pop()).toBe(null);;

    // Custom comparator (Max-Heap)
    let maxPq = new PriorityQueue<int>((a: int, b: int): int => {
        if (a > b) return -1;
        if (a < b) return 1;
        return 0;
    });
    maxPq.push(15);
    maxPq.push(95);
    maxPq.push(42);
        expect(maxPq.pop()).toBe(95);;
        expect(maxPq.pop()).toBe(42);;
        expect(maxPq.pop()).toBe(15);;

    // 2. LRUCache
    let cache = new LRUCache<str>(2);
    cache.set("key1", "val1");
    cache.set("key2", "val2");
        expect(cache.get("key1")).toBe("val1");; // key1 becomes most recently used
    cache.set("key3", "val3"); // evicts key2 (LRU)
        expect(cache.get("key2")).toBe(null);;
        expect(cache.get("key1")).toBe("val1");;
        expect(cache.get("key3")).toBe("val3");;

}
async function testEncoding(): Task<void> {
let tomlSample = "[server]\nhost = \"localhost\"\nport = 8080\nenabled = true\n";
let parsedToml = TOML.parse(tomlSample);
let serverObj = parsedToml["server"] as { [key: str]: dynamic };
expect(serverObj["host"]).toBe("localhost");
expect(serverObj["port"]).toBe(8080);
expect(serverObj["enabled"]).toBe(true);
let stringifiedToml = TOML.stringify(parsedToml);
expect(stringifiedToml.includes("[server]")).toBeTruthy();
expect(stringifiedToml.includes("host = \"localhost\"")).toBeTruthy();
}

await describe("110 stdlib consolidation", async () => {
    await it("3. TOML; 3. WaitGroup", async () => {
        async function testTaskSync(): Task<void> {
        let wg = new WaitGroup();
        wg.add(2);
        spawn((async (): Task<void> => {
        await delay(5);
        syncState.wgProgress = syncState.wgProgress + 1;
        wg.done();
        })());
        spawn((async (): Task<void> => {
        await delay(5);
        syncState.wgProgress = syncState.wgProgress + 10;
        wg.done();
        })());
        await wg.wait();
        expect(syncState.wgProgress).toBe(11);
        }
        async function main(): Task<void> {
        await testEncoding();
        testCli();
        await testTaskSync();
        testLog();
        testCollections();
        }
        await main();
    });

    await it("1. Base64; 1. Mutex", async () => {
        let originalText = "Hello Varn Language!";
        let encoded = Base64.encode(originalText);
        let decoded = Base64.decode(encoded);
        expect(decoded).toBe(originalText);
        let mutex = new Mutex();
        await mutex.withLock(async (): Task<void> => {
        syncState.counter = syncState.counter + 5;
        });
        expect(syncState.counter).toBe(5);
    });

    await it("2. Hex; 2. Semaphore", async () => {
        let hexEncoded = Hex.encode("Varn");
        let hexDecoded = Hex.decode(hexEncoded);
        expect(hexDecoded).toBe("Varn");
        let semaphore = new Semaphore(2);
        await semaphore.withPermit(async (): Task<void> => {
        syncState.semCounter = syncState.semCounter + 2;
        });
        expect(syncState.semCounter).toBe(2);
    });

});
