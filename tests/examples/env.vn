import { describe, it, expect, summary } from "std:test";
import { Env } from "std:env";

await describe("example std:env", async () => {
    await it("reads with defaults", () => {
        expect(Env.get("EX_DEFINITELY_MISSING_VAR", "fallback")).toBe("fallback");
        expect(Env.has("EX_DEFINITELY_MISSING_VAR")).toBe(false);
    });

    await it("sets and reads back", () => {
        Env.set("EX_MODE", "dev");
        expect(Env.get("EX_MODE")).toBe("dev");
        expect(Env.has("EX_MODE")).toBe(true);
    });

    await it("typed getters coerce", () => {
        Env.set("EX_PORT", "8080");
        Env.set("EX_DEBUG", "true");
        expect(Env.getInt("EX_PORT", 0)).toBe(8080);
        expect(Env.getBool("EX_DEBUG", false)).toBe(true);
        expect(Env.getInt("EX_MISSING_INT", 9090)).toBe(9090);
    });

    await it("parses dotenv content", () => {
        let parsed = Env.parse("A=1\nB=\"hi there\"\n# comment\nC='x'\n");
        expect(parsed["A"]).toBe("1");
        expect(parsed["B"]).toBe("hi there");
        expect(parsed["C"]).toBe("x");
    });
});

summary();
