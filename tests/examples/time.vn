import { describe, it, expect, summary } from "std:test";
import { now, toParts, fromParts, durationToString, formatDurationMs, Duration, DateTime } from "std:time";

await describe("example std:time", async () => {
    await it("reads the wall clock", () => {
        let ms = now();
        expect(ms > 0).toBe(true);
        let parts = toParts(ms);
        expect(parts.year >= 2026).toBe(true);
        expect(parts.month >= 1 && parts.month <= 12).toBe(true);
    });

    await it("roundtrips calendar parts", () => {
        let back = fromParts({ year: 2026, month: 1, day: 15, hour: 12, minute: 0, second: 0, millisecond: 0 });
        let parts = toParts(back);
        expect(parts.year).toBe(2026);
        expect(parts.day).toBe(15);
    });

    await it("formats durations", () => {
        expect(durationToString(90000)).toBe("Duration(90000ms)");
        expect(formatDurationMs(90000)).toBe("1m 30s");
        let span = Duration.from({ hours: 1, minutes: 30 });
        expect(span.add(60000).subtract(60000).equals(span)).toBe(true);
    });

    await it("computes with DateTime", () => {
        let start = DateTime.now();
        let later = start.addDays(1).addHours(2);
        expect(later.diff(start)).toBe(26 * 3600 * 1000);
        expect(start.toISOString().indexOf("T") >= 0).toBe(true);
        expect(DateTime.fromTimestamp(start.toMs).toMs).toBe(start.toMs);
    });
});

summary();
