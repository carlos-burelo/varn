import { describe, it, expect, summary } from "std:test";
import { join, dirname, basename, extname, normalize, isAbsolute, resolve, Path, SEP } from "std:path";

await describe("example std:path", async () => {
    await it("joins and splits paths", () => {
        expect(join("a", "b", "c.txt")).toBe("a" + SEP + "b" + SEP + "c.txt");
        expect(dirname("/a/b/c.txt")).toBe("/a/b");
        expect(basename("/a/b/c.txt")).toBe("c.txt");
        expect(basename("/a/app.exe", ".exe")).toBe("app");
        expect(extname("archive.tar.gz")).toBe(".gz");
    });

    await it("normalizes and classifies", () => {
        expect(normalize("a//b/../c")).toBe("a" + SEP + "c");
        expect(isAbsolute("/tmp/x")).toBe(true);
        expect(isAbsolute("relative/y")).toBe(false);
        expect(resolve("src").indexOf("src") >= 0).toBe(true);
    });

    await it("mirrors the Path namespace", () => {
        expect(Path.join("x", "y")).toBe(join("x", "y"));
        expect(Path.extname("a/b.png")).toBe(".png");
        expect(Path.SEP).toBe(SEP);
    });
});

summary();
