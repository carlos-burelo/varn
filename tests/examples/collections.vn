import { describe, it, expect, summary } from "std:test";
import { List, Stack, Queue, PriorityQueue, LRUCache } from "std:collections";

await describe("example std:collections", async () => {
    await it("List add/get/remove", () => {
        let list = new List<int>([1, 2]);
        list.add(3);
        expect(list.length).toBe(3);
        expect(list.get(0)).toBe(1);
        expect(list.contains(2)).toBe(true);
        expect(list.removeAt(0)).toBe(1);
        expect(list.toArray().length).toBe(2);
    });

    await it("Stack push/pop/peek", () => {
        let stack = new Stack<str>();
        expect(stack.isEmpty).toBe(true);
        stack.push("a");
        stack.push("b");
        expect(stack.peek()).toBe("b");
        expect(stack.pop()).toBe("b");
        expect(stack.size).toBe(1);
    });

    await it("Queue fifo order", () => {
        let queue = new Queue<str>();
        queue.enqueue("first");
        queue.enqueue("second");
        expect(queue.dequeue()).toBe("first");
        expect(queue.peek()).toBe("second");
        expect(queue.size).toBe(1);
    });

    await it("PriorityQueue pops minimum first", () => {
        let pq = new PriorityQueue<int>();
        pq.push(30);
        pq.push(10);
        pq.push(20);
        expect(pq.pop()).toBe(10);
        expect(pq.pop()).toBe(20);
    });

    await it("LRUCache evicts least recently used", () => {
        let cache = new LRUCache<str>(2);
        cache.set("a", "alpha");
        cache.set("b", "beta");
        expect(cache.get("a")).toBe("alpha");
        cache.set("c", "gamma");
        expect(cache.has("b")).toBe(false);
        expect(cache.get("c")).toBe("gamma");
        expect(cache.size).toBe(2);
    });
});

summary();
