import { describe, it, expect, summary } from "std:test";
import { connect, UdpSocket, Url, Query, parseUrl, isIPv4, isIPv6, encodeURIComponent, decodeURIComponent } from "std:net";
import { Process } from "std:process";
import { delay } from "std:task";

await describe("example std:net", async () => {
    await it("echoes over tcp loopback via child server", async () => {
        let proc = Process.spawn("target/debug/vn.exe", ["run", "tests/examples/servers/tcp-echo.vn"]);
        await delay(500);
        let cli = await connect("127.0.0.1", 19881);
        expect(cli.isOpen).toBe(true);
        expect(cli.remotePort).toBe(19881);
        await cli.writeAll("hello-net\n");
        expect((await cli.readText()).trim()).toBe("ECHO:hello-net");
        cli.close();
        let status = proc.wait();
        expect(status.exitCode).toBe(0);
    });

    await it("sends datagrams over udp loopback", async () => {
        let srv = UdpSocket.bind(19882, "127.0.0.1");
        let cli = UdpSocket.bind(19883, "127.0.0.1");
        cli.send("127.0.0.1", 19882, "ping-udp");
        let packet = await srv.recv();
        expect(packet !== null).toBe(true);
        expect(packet!!.data.toString()).toBe("ping-udp");
        cli.close();
        srv.close();
    });

    await it("parses urls and query strings", () => {
        let url = parseUrl("https://example.com:8080/docs?q=varn#top");
        expect(url.protocol).toBe("https");
        expect(url.host).toBe("example.com");
        expect(url.port).toBe(8080);
        expect(url.query.get("q")).toBe("varn");
        expect(url.toString().indexOf("https://") >= 0).toBe(true);
        let query = Query.parse("?a=1&a=2&b=3");
        expect(query.getAll("a").length).toBe(2);
        expect(query.get("b")).toBe("3");
    });

    await it("validates ips and uri components", () => {
        expect(isIPv4("127.0.0.1")).toBe(true);
        expect(isIPv4("999.1.1.1")).toBe(false);
        expect(isIPv6("::1")).toBe(true);
        expect(decodeURIComponent(encodeURIComponent("a b&c=x"))).toBe("a b&c=x");
    });
});

summary();
