import { describe, it, expect, summary } from "std:test";
import { Semver } from "std:pm";

await describe("example std:pm", async () => {
    await it("parses versions", () => {
        let version = Semver.parse("1.2.3");
        expect(version.major).toBe(1);
        expect(version.minor).toBe(2);
        expect(version.patch).toBe(3);
        expect(Semver.toString(version)).toBe("1.2.3");
    });

    await it("parses prerelease and build", () => {
        let version = Semver.parse("v2.0.0-alpha.1+build.5");
        expect(version.major).toBe(2);
        expect(version.pre[0]).toBe("alpha");
        expect(version.build).toBe("build.5");
    });

    await it("compares versions", () => {
        expect(Semver.compare(Semver.parse("1.2.3"), Semver.parse("1.3.0")) < 0).toBe(true);
        expect(Semver.compare(Semver.parse("2.0.0"), Semver.parse("2.0.0"))).toBe(0);
        expect(Semver.compare(Semver.parse("3.0.0"), Semver.parse("2.9.9")) > 0).toBe(true);
    });

    await it("matches ranges", () => {
        let version = Semver.parse("1.5.0");
        expect(Semver.satisfies(version, ">=1.0.0 <2.0.0")).toBe(true);
        expect(Semver.satisfies(version, ">=2.0.0")).toBe(false);
        expect(Semver.satisfiesText("1.5.0", "^1.2.0")).toBe(true);
        expect(Semver.satisfiesText("2.0.0", "^1.2.0")).toBe(false);
    });
});

summary();
