import { describe, it, expect, summary } from "std:test";
import { Json, Csv, Base64, Base32, Hex, Html, Toml, MsgPack } from "std:encoding";

await describe("example std:encoding", async () => {
    await it("json parses and stringifies", () => {
        let value = Json.parse("{\"a\":1,\"b\":[true,null]}");
        expect(Json.stringify(value).indexOf("\"a\":1") >= 0).toBe(true);
        expect(Json.tryParse("not json {") === null).toBe(true);
    });

    await it("csv parses with header row by default", () => {
        let rows = Csv.parse("a,b\n1,2\n3,4");
        expect(rows.length).toBe(2);
        expect(rows[0]["a"]).toBe(1);
        expect(Csv.stringify(rows).indexOf("a,b") >= 0).toBe(true);
        let noHeader = Csv.parse("a,b\n1,2", { hasHeader: false });
        expect(noHeader.length).toBe(2);
    });

    await it("base64 and base32 roundtrip", () => {
        expect(Base64.decode(Base64.encode("hello"))).toBe("hello");
        let raw = Bytes.fromString("hello");
        expect(Base32.decode(Base32.encode(raw)).toString()).toBe("hello");
    });

    await it("hex roundtrip", () => {
        expect(Hex.decode(Hex.encode("data"))).toBe("data");
    });

    await it("html escapes", () => {
        expect(Html.escape("<b>a&b</b>")).toBe("&lt;b&gt;a&amp;b&lt;/b&gt;");
        expect(Html.unescape("&lt;b&gt;")).toBe("<b>");
    });

    await it("toml parses and stringifies", () => {
        let parsed = Toml.parse("[server]\nhost = \"localhost\"\nport = 8080\n");
        expect(parsed["server"]["port"]).toBe(8080);
        expect(Toml.stringify(parsed).indexOf("localhost") >= 0).toBe(true);
    });

    await it("msgpack roundtrip", () => {
        let back = MsgPack.decode(MsgPack.encode({ a: 1, b: "x" }));
        expect(back["a"]).toBe(1);
        expect(back["b"]).toBe("x");
    });
});

summary();
