import { describe, it, expect, assertEqual, assertTrue, assertThrows, summary } from "std:test";

await describe("example std:test", async () => {
    await it("matches with expect", () => {
        expect(1 + 1).toBe(2);
        expect([1, 2, 3]).toContain(2);
        expect(3.14159).toBeCloseTo(3.14, 0.01);
        expect(null as int?).toBeNull();
        expect("value" as str?).toBeNotNull();
        expect(true).toBeTruthy();
        expect(false).toBeFalsy();
    });

    await it("asserts with helpers", () => {
        assertEqual(2, 1 + 1);
        assertTrue(1 < 2);
        assertThrows(() => {
            throw new Error("expected");
        }, "expected");
    });
});

summary();
