import { describe, it, expect, summary } from "std:test";
import { WebSocket, WsServer, WebSocketReadyState } from "std:ws";
import { Process } from "std:process";
import { delay } from "std:task";

await describe("example std:ws", async () => {
    await it("exposes the ready-state enum", () => {
        expect(WebSocketReadyState.Connecting as int).toBe(0);
        expect(WebSocketReadyState.Open as int).toBe(1);
        expect(WebSocketReadyState.Closing as int).toBe(2);
        expect(WebSocketReadyState.Closed as int).toBe(3);
    });

    await it("echoes over a loopback socket via child server", async () => {
        let proc = Process.spawn("target/debug/vn.exe", ["run", "tests/examples/servers/ws-echo.vn"]);
        await delay(800);
        let client = await WebSocket.connect("ws://127.0.0.1:19884/chat");
        expect(client.isOpen).toBe(true);
        await client.send("hello-ws");
        let echo = await client.read();
        expect(echo !== null).toBe(true);
        expect(echo!!.toString()).toBe("ECHO:hello-ws");
        client.close();
        let status = proc.wait();
        expect(status.exitCode).toBe(0);
    });
});

summary();
