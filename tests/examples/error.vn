import { describe, it, expect, summary } from "std:test";
import { StdError, IoError, FsError, FsNotFoundError, ParseError, DecodeError } from "std:error";
import { readText } from "std:fs";

await describe("example std:error", async () => {
    await it("a class is the discriminant and carries typed fields", () => {
        let err = new FsNotFoundError("/data/report.csv");
        expect(err.code).toBe("fs.not_found");
        expect(err.path).toBe("/data/report.csv");
        expect(err.message).toBe("no such file or directory: /data/report.csv");
        expect(err instanceof Error).toBe(true);
    });

    await it("catching a parent class catches every child", () => {
        let seen = "";
        try {
            throw new FsNotFoundError("/missing");
        } catch (e: IoError) {
            seen = e.code;
        }
        expect(seen).toBe("fs.not_found");
    });

    await it("a catch for another class lets the error through", () => {
        let outer = "";
        try {
            try {
                throw new ParseError("bad input");
            } catch (e: FsError) {
                outer = "wrong";
            }
        } catch (e: StdError) {
            outer = e.code;
        }
        expect(outer).toBe("parse");
    });

    await it("natives raise the same classes", () => {
        let path = "";
        try {
            readText("/definitely/not/here");
        } catch (e: FsNotFoundError) {
            path = e.path;
        }
        expect(path).toBe("/definitely/not/here");
    });

    await it("errors chain their cause", () => {
        let cause = new ParseError("unexpected token", 3);
        let wrapped = new DecodeError("$.user.age", "age is not a number", cause);
        expect(wrapped.cause === cause).toBe(true);
        expect(wrapped.path).toBe("$.user.age");
        expect(wrapped instanceof ParseError).toBe(true);
    });
});

summary();
