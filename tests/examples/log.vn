import { describe, it, expect, summary } from "std:test";
import { Logger, LogLevel, getLogger, info } from "std:log";

await describe("example std:log", async () => {
    await it("filters by level", () => {
        let lines: str[] = [];
        let log = getLogger("filter", LogLevel.Warn);
        log.setSink((line: str) => {
            lines.push(line);
        });
        log.setUseColors(false);
        log.info("dropped");
        log.error("kept");
        expect(lines.length).toBe(1);
        expect(lines[0].indexOf("kept") >= 0).toBe(true);
    });

    await it("child loggers inherit the sink", () => {
        let lines: str[] = [];
        let log = new Logger("svc", LogLevel.Info, false, false, (line: str) => {
            lines.push(line);
        });
        let child = log.child("db");
        child.info("connected");
        expect(lines.length).toBe(1);
        expect(lines[0].indexOf("svc.db") >= 0).toBe(true);
    });

    await it("global helpers emit", () => {
        info("global info line");
        expect(true).toBe(true);
    });
});

summary();
