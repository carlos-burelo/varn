import { describe, it, expect, summary } from "std:test";
import { PI, sqrt, pow, sin, floor, random, Math, Stats } from "std:math";

await describe("example std:math", async () => {
    await it("computes with free functions", () => {
        expect(sqrt(16.0)).toBe(4.0);
        expect(pow(2.0, 10.0)).toBe(1024.0);
        expect(floor(3.9)).toBe(3.0);
        expect(sin(PI / 2.0)).toBe(1.0);
        let dice = floor(random() * 6.0) + 1.0;
        expect(dice >= 1.0 && dice <= 6.0).toBe(true);
    });

    await it("mirrors the Math class", () => {
        expect(Math.sqrt(9.0)).toBe(3.0);
        expect(Math.trunc(-3.7)).toBe(-3.0);
        expect(Math.max(1.0, 7.5, 3.0)).toBe(7.5);
        expect(Math.min(1.0, 7.5, 3.0)).toBe(1.0);
    });

    await it("aggregates with Stats", () => {
        expect(Stats.sum([1.0, 2.0, 3.0])).toBe(6.0);
        expect(Stats.mean([1.0, 2.0, 3.0, 4.0])).toBe(2.5);
        expect(Stats.median([3.0, 1.0, 2.0])).toBe(2.0);
        expect(Stats.min([5.0, 2.0, 8.0])).toBe(2.0);
        expect(Stats.max([5.0, 2.0, 8.0])).toBe(8.0);
    });
});

summary();
