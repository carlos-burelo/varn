import { describe, it, expect, summary } from "std:test";
import { writeln, Stream } from "std:io";
import { FileStream } from "std:fs";
import { join } from "std:path";
import { tempDir } from "std:fs";
import { mkdirAll, removeAll, readText, exists } from "std:fs";

function clean(path: str): void {
    if (exists(path)) {
        removeAll(path);
    }
}

await describe("example std:io", async () => {
    await it("prints to stdout", () => {
        writeln("io example line");
        expect(1).toBe(1);
    });

    await it("pipes a file stream into another file", async () => {
        let base = join(tempDir(), "ex-io");
        clean(base);
        mkdirAll(base);
        let src = new FileStream(join(base, "in.bin"), "w");
        await src.write(Bytes.fromString("stream-payload"));
        src.close();
        let reader = new FileStream(join(base, "in.bin"), "r");
        let writer = new FileStream(join(base, "out.bin"), "w");
        let bytes = await Stream.pipe(reader, writer, 8192);
        expect(bytes).toBe(14);
        reader.close();
        writer.close();
        expect(readText(join(base, "out.bin"))).toBe("stream-payload");
        clean(base);
    });
});

summary();
