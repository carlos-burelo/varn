import { describe, it, expect, summary } from "std:test";
import { Markdown } from "std:markdown";

await describe("example std:markdown", async () => {
    await it("renders markdown to html", () => {
        let html = Markdown.render("# Title\n\nHello **bold** and *italic*.");
        expect(html.indexOf("<h1>") >= 0).toBe(true);
        expect(html.indexOf("<strong>bold</strong>") >= 0).toBe(true);
    });

    await it("renders lists and code", () => {
        let html = Markdown.render("- one\n- two\n\n`code`");
        expect(html.indexOf("<li>one</li>") >= 0).toBe(true);
        expect(html.indexOf("<code>code</code>") >= 0).toBe(true);
    });

    await it("parses an ast and extracts structure", () => {
        let source = "# A\n## B\nSee [x](https://example.com).";
        let ast = Markdown.parse(source);
        expect(Markdown.renderAst(ast).indexOf("<h1>") >= 0).toBe(true);
        let headings = Markdown.extractHeadings(source);
        expect(headings.length).toBe(2);
        expect(headings[0].level).toBe(1);
        expect(headings[0].text).toBe("A");
        let links = Markdown.extractLinks(source);
        expect(links.length).toBe(1);
        expect(links[0].url).toBe("https://example.com");
    });

    await it("converts to plain text", () => {
        expect(Markdown.toPlainText("# Hi **there**").indexOf("Hi") >= 0).toBe(true);
        expect(Markdown.slugify("Hello World!")).toBe("hello-world");
    });
});

summary();
