import { describe, it, expect, summary } from "std:test";
import { Cli, Color, Table } from "std:cli";

await describe("example std:cli", async () => {
    await it("parses flags and positionals", () => {
        let parsed = Cli.parse(["--port=8080", "-v", "serve"]);
        expect(parsed.flags["port"]).toBe("8080");
        expect(parsed.positionals[0]).toBe("serve");
    });

    await it("colors and strips ansi", () => {
        let painted = Color.red("boom");
        expect(painted === "boom").toBe(false);
        expect(Color.stripAnsi(painted)).toBe("boom");
        expect(Color.stripAnsi(Color.bold(Color.green("ok")))).toBe("ok");
    });

    await it("renders tables", () => {
        let table = new Table(["name", "port"]);
        table.addRow(["api", "8080"]);
        table.addRow(["web", "3000"]);
        let out = table.render();
        expect(out.indexOf("api") >= 0).toBe(true);
        expect(out.indexOf("3000") >= 0).toBe(true);
    });
});

summary();
