function classify(x: int): str {
  switch (x) {
    case 1: return "one"
    case 2: return "two"
    case 3: return "three"
    default: return "other"
  }
}
function fallthrough(x: int): int {
  let r = 0
  switch (x) {
    case 1: r = r + 1
    case 2: r = r + 10
    case 3: r = r + 100
    default: r = r + 1000
  }
  return r
}
function withBreak(x: int): int {
  let r = 0
  switch (x) {
    case 1: r = 1; break
    case 2: r = 2; break
    default: r = 99
  }
  return r
}
print(classify(2))
print(classify(9))
print(fallthrough(2))
print(withBreak(1))
print(withBreak(5))
