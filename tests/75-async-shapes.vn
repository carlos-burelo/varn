import { describe, it, expect } from "std:test";
import { asyncImportedMethod, importedAsyncFn, AsyncNs, ImportedAsyncBox } from "./75-async-shapes-lib.vn"

// Varn has no explicit Promise wrapper: writing `async` is what makes the call
// produce a task. So `async f(): int` declares a body returning `int` and a
// value of type `Task<int>`, and `await` on that call must find something to
// unwrap.
//
// That rule used to live in five separate places, each covering a different
// subset of callables, so `await` on an imported method, a namespace function
// or an async arrow reported "'await' applied to non-Future type". Every shape
// that can be `async` is exercised here; the types themselves are pinned in
// tests/golden/types/75-async-shapes.txt, which is where a regression would
// show up — a wrong type here is a warning, not a runtime failure.


class LocalBox {
    async method(): int { return 1 }
    async noReturnType() { return 2 }
    async returnsVoid(): void { }
    async returnsArray(): int[] { return [3] }
    async alreadyTask(): Task<int> { return 4 }
}

async function localFn(): int { return 5 }
async function localFnInferred() { return 6 }

const localArrow = async (): int => { return 7 }
const localFnExpr = async function (): int { return 14 }
// Not async, but the same gap: the checker had no arm for function
// expressions, so this used to read as `(...args: dynamic[]) => void` and the
// call site got `dynamic`. Pinned here for the signature, not the value.
const syncFnExpr = function (x: int): int { return x * 2 }

const literal = {
    async method(): int { return 15 },
    plainMethod(x: int): int { return x + 1 }
}

interface AsyncApi {
    async load(): int
    async nothing(): void
    plain(): str
}

class ApiImpl implements AsyncApi {
    async load(): int { return 16 }
    async nothing(): void { }
    plain(): str { return "p" }
}

extension on LocalBox {
    async extensionMethod(): int { return 8 }
}

async function runAsyncShapes() {
    const box = new LocalBox()

    expect(await box.method()).toBe(1)
    expect(await box.noReturnType()).toBe(2)
    await box.returnsVoid()
    expect((await box.returnsArray())[0]).toBe(3)
    expect(await box.alreadyTask()).toBe(4)

    expect(await localFn()).toBe(5)
    expect(await localFnInferred()).toBe(6)
    expect(await localArrow()).toBe(7)
    expect(await box.extensionMethod()).toBe(8)

    // The four shapes below reach the checker through a module boundary or a
    // namespace, which is where the rule used to be missing entirely.
    const imported = new ImportedAsyncBox()
    expect(await imported.method()).toBe(9)
    expect((await imported.all())[0]).toBe(10)
    expect(await importedAsyncFn()).toBe(11)
    expect(await AsyncNs.fn()).toBe(12)
    expect(await asyncImportedMethod()).toBe(13)

    // Forms that could not even be written before: an `async function`
    // expression did not parse, an object literal dropped its methods, and an
    // interface could not carry `async` on a signature.
    expect(await localFnExpr()).toBe(14)
    expect(syncFnExpr(7)).toBe(14)
    expect(await literal.method()).toBe(15)
    expect(literal.plainMethod(1)).toBe(2)

    const api: AsyncApi = new ApiImpl()
    // Held before awaiting on purpose: the golden records this as `Task<int>`,
    // which is the only place the interface's `async` is observable — a
    // missing wrap is a warning, and warnings do not fail a run.
    const pending = api.load()
    expect(await pending).toBe(16)
    await api.nothing()
    expect(api.plain()).toBe("p")
}
await describe("75 async shapes", async () => {
    await it("tests", async () => {
        
        await runAsyncShapes()
        
        
    });
});
