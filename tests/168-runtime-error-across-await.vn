import { describe, it, expect } from "std:test";

async function divide(a: int, b: int): int { return a % b }
async function convert(d: dynamic): int {
    const n: int = d
    return n
}
async function raise(): int { throw new RangeError("out") }

async function describeFailure(f: () => Task<int>): str {
    try {
        await f()
        return "none"
    } catch (e) {
        if (e instanceof TypeError) { return "TypeError: " + e.message }
        if (e instanceof RangeError) { return "RangeError: " + e.message }
        if (e instanceof Error) { return "Error: " + e.message }
        return "untyped"
    }
}

await describe("168 runtime error across await", async () => {
    await it("a runtime error raised in a task keeps its class and message", async () => {
        expect(await describeFailure(() => convert("x")))
            .toBe("TypeError: type mismatch: expected 'int', got 'str'")
    })

    await it("a thrown error still arrives as thrown", async () => {
        expect(await describeFailure(raise)).toBe("RangeError: out")
    })

    await it("a successful task is unaffected", async () => {
        expect(await describeFailure(() => divide(7, 2))).toBe("none")
        expect(await describeFailure(() => convert(3))).toBe("none")
    })
})
