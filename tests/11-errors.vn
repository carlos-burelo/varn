import { describe, it, expect } from "std:test";

let finallyRan = false;
function safeDivide(a: int, b: int): float {
    try {
        if (b === 0) throw new RangeError("division by zero");
        return (a as float) / (b as float);
    } catch (e) {
        return -1;
    }
}
class ValidationError extends Error {
    field: str
    constructor(field: str, msg: str) {
        super(msg);
        this.name = "ValidationError";
        this.field = field;
    }
}
function withFinally(): int {
    try {
        return 42;
    } finally {
        finallyRan = true;
    }
}
function divideOrDefault(a: int, b: int): int {
    try {
        return a / b;
    } catch (e) {
        return -1;
    }
}
function inner(): int {
    let z: int[] = [0];
    return 5 % z[0];
}

await describe("11 Errors", async () => {
    await it("try catch basics", () => {
        expect(safeDivide(10, 2)).toBe(5);
        expect(safeDivide(10, 0)).toBe(-1);
        let caughtName = "";
        try {
            throw new TypeError("bad type");
        } catch (e) {
            caughtName = e.name;
        }
        expect(caughtName).toBe("TypeError");
        let isRangeError = false;
        try {
            throw new RangeError("too big");
        } catch (e) {
            isRangeError = e instanceof RangeError;
        }
        expect(isRangeError).toBeTruthy();
    });

    await it("nested and custom errors", () => {
        let innerCaught = false;
        let outerCaught = false;
        try {
            try {
                throw new Error("inner");
            } catch (e) {
                innerCaught = true;
                throw e;
            }
        } catch (e) {
            outerCaught = true;
        }
        expect(innerCaught).toBeTruthy();
        expect(outerCaught).toBeTruthy();
        let ve: ValidationError | null = null;
        try {
            throw new ValidationError("email", "invalid format");
        } catch (e) {
            if (e instanceof ValidationError) {
                ve = e;
            }
        }
        expect(ve?.name).toBe("ValidationError");
        expect(ve?.message).toBe("invalid format");
        expect(ve?.field).toBe("email");
        expect(ve instanceof Error).toBeTruthy();
    });

    await it("finally", () => {
        const fres = withFinally();
        expect(fres).toBe(42);
        expect(finallyRan).toBeTruthy();
    });

    await it("runtime errors are catchable", () => {
        let zeros: int[] = [0];
        let divCaught = false;
        let divMsg = "";
        try {
            let q = 10 / zeros[0];
        } catch (e) {
            divCaught = true;
            divMsg = e.message;
        }
        expect(divCaught).toBeTruthy();
        expect(divMsg).toBe("division by zero");
        let modCaught = false;
        try {
            let q = 10 % zeros[0];
        } catch (e) {
            modCaught = true;
        }
        expect(modCaught).toBeTruthy();
        expect(divideOrDefault(10, 0)).toBe(-1);
        expect(10.0 / 0.0 === Infinity).toBeTruthy();
        let nestedCaught = false;
        try {
            let v = inner();
        } catch (e) {
            nestedCaught = true;
        }
        expect(nestedCaught).toBeTruthy();
    });
});
