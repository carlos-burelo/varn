import { File, readBytes, writeBytes, remove, FileStream } from "std:fs";
import { Compress } from "std:compress";
import { Stream } from "std:io";
import { describe, it, expect } from "std:test";


function testBinaryFsOps(): void {
    let testPath = "target/test_fs_binary.bin";
    let testData = Bytes.alloc(4);
    testData.setByte(0, 0xDE);
    testData.setByte(1, 0xAD);
    testData.setByte(2, 0xBE);
    testData.setByte(3, 0xEF);

    // 1. Standalone writeBytes and readBytes
    writeBytes(testPath, testData);
    let readBack = readBytes(testPath);
        expect(readBack.length).toBe(4);;
        expect(readBack.getByte(0)).toBe(0xDE);;
        expect(readBack.getByte(1)).toBe(0xAD);;
        expect(readBack.getByte(2)).toBe(0xBE);;
        expect(readBack.getByte(3)).toBe(0xEF);;
        expect(readBack.toHex()).toBe("deadbeef");;

    // 2. File instance operations
    let file = new File(testPath);
    let appendData = Bytes.alloc(2);
    appendData.setByte(0, 0xCA);
    appendData.setByte(1, 0xFE);
    file.appendBytes(appendData);

    let fullData = file.readBytes();
        expect(fullData.length).toBe(6);;
        expect(fullData.toHex()).toBe("deadbeefcafe");;

}

function testBinaryCompression(): void {
    let raw = Bytes.alloc(256);
    for (let i = 0; i < 256; i = i + 1) {
        raw.setByte(i, 42); // Highly compressible
    }

    // Gzip roundtrip on Bytes
    let gzipped = Compress.gzip(raw);
        expect(gzipped.length < raw.length).toBeTruthy();;
    let gunzipped = Compress.gunzip(gzipped);
        expect(gunzipped.length).toBe(256);;
        expect(gunzipped.getByte(0)).toBe(42);;
        expect(gunzipped.getByte(255)).toBe(42);;

    // Deflate roundtrip on Bytes
    let deflated = Compress.deflate(raw);
        expect(deflated.length < raw.length).toBeTruthy();;
    let inflated = Compress.inflate(deflated);
        expect(inflated.length).toBe(256);;
        expect(inflated.getByte(0)).toBe(42);;
        expect(inflated.getByte(255)).toBe(42);;

}
async function testFileStreamAsync(): Task<void> {
let srcPath = "target/stream_src.bin";
let dstPath = "target/stream_dst.bin";
let payload = Bytes.alloc(1024);
for (let i = 0; i < 1024; i = i + 1) {
payload.setByte(i, i & 0xFF);
}
writeBytes(srcPath, payload);
let srcStream = new FileStream(srcPath, "r");
let dstStream = new FileStream(dstPath, "w");
let piped = await Stream.pipe(srcStream, dstStream);
expect(piped).toBe(1024);
srcStream.close();
dstStream.close();
let dstData = readBytes(dstPath);
expect(dstData.length).toBe(1024);
expect(dstData.getByte(255)).toBe(255);
expect(dstData.getByte(256)).toBe(0);
}

await describe("113 fs compress binary", async () => {
    await it("binary fs ops", async () => {
        testBinaryFsOps();
    });

    await it("file stream async", async () => {
        await testFileStreamAsync();
    });

    await it("binary compression and cleanup", async () => {
        testBinaryCompression();
        remove("target/test_fs_binary.bin");
        remove("target/stream_src.bin");
        remove("target/stream_dst.bin");
    });
});

