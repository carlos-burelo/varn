import { describe, it, expect } from "std:test";

class Animal { name: str = "animal" }
class Dog extends Animal {}

function count(animals: readonly Animal[]): int { return animals.length }
function total(xs: readonly int[]): int {
    let sum = 0
    for (const x of xs) { sum += x }
    return sum
}
function lookup(m: ReadonlyMap<str, int>, key: str): int? { return m.get(key) }
function sizeOf(s: ReadonlySet<int>): int { return s.size }

await describe("350 read-only views", async () => {
    await it("an array is a read-only array of its own type and of a supertype of it", () => {
        const dogs: Dog[] = [new Dog(), new Dog()]
        expect(count(dogs)).toBe(2)
        const ro: readonly int[] = [1, 2, 3]
        expect(ro.length).toBe(3)
    })

    await it("a view reads by index, by iteration, by spread and by destructuring", () => {
        const ro: readonly int[] = [4, 5, 6]
        expect(ro[1]).toBe(5)
        expect(total(ro)).toBe(15)
        const copy: int[] = [...ro, 7]
        expect(copy.length).toBe(4)
        const [first, second] = ro
        expect(first + second).toBe(9)
    })

    await it("a view keeps the read members of the array", () => {
        const ro: readonly int[] = [3, 1, 2]
        expect(ro.map((n: int): int => n * 2)).toEqual([6, 2, 4])
        expect(ro.filter((n: int): bool => n > 1).length).toBe(2)
        expect(ro.find((n: int): bool => n == 2)).toBe(2)
        expect(ro.join("-")).toBe("3-1-2")
        expect(ro.at(0)).toBe(3)
        expect(ro.slice(1).length).toBe(2)
        expect(ro.reduce((acc: int, n: int): int => acc + n, 0)).toBe(6)
        expect(ro.some((n: int): bool => n == 3)).toBe(true)
        expect(ro.every((n: int): bool => n > 0)).toBe(true)
    })

    await it("a view of nested arrays is a view of the outer one", () => {
        const nested: readonly int[][] = [[1], [2, 3]]
        expect(nested[1].length).toBe(2)
    })

    await it("a view sees the later changes of the array it was made from", () => {
        const xs: int[] = [1]
        const ro: readonly int[] = xs
        xs.push(2)
        expect(ro.length).toBe(2)
    })

    await it("a Map and a Set are read through their views", () => {
        const m: Map<str, int> = { a: 1, b: 2 }
        expect(lookup(m, "b")).toBe(2)
        expect(lookup(m, "z")).toBe(null)
        const view: ReadonlyMap<str, int> = m
        expect(view.size).toBe(2)
        expect("a" in view).toBe(true)
        expect(view.keys().length).toBe(2)
        let seen = 0
        for (const (k, v) of view) { seen += v }
        expect(seen).toBe(3)
        const s = new Set([1, 2, 3])
        expect(sizeOf(s)).toBe(3)
        const items: ReadonlySet<int> = s
        expect(items.has(2)).toBe(true)
        let sum = 0
        for (const n of items) { sum += n }
        expect(sum).toBe(6)
    })

    await it("a view of values is covariant and a view of keys is not", () => {
        const dogs: Map<str, Dog> = { rex: new Dog() }
        const animals: ReadonlyMap<str, Animal> = dogs
        expect(animals.get("rex")?.name).toBe("animal")
    })
})
