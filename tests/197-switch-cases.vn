import { describe, it, expect } from "std:test";

function kind(n: int): str {
    let out = ""
    switch (n) {
        case 1:
            out = out + "one"
            break
        case 2:
            out = out + "two"
        default:
            out = out + "many"
    }
    return out
}

function walk(limit: int): str {
    let seen = ""
    for (let i = 0; i < limit; i = i + 1) {
        switch (i) {
            case 1:
                continue
            case 2:
                break
            default:
                seen = seen + i.toString()
        }
        seen = seen + "."
    }
    return seen
}

function inner(n: int): int {
    let total = 0
    switch (n) {
        case 1:
            for (let i = 0; i < 9; i = i + 1) {
                if (i == 3) { break }
                total = total + 1
            }
            break
        default:
            total = 9
    }
    return total
}

await describe("197 switch cases", async () => {
    await it("a case runs alone and never falls through to the next", () => {
        expect(kind(1)).toBe("one")
        expect(kind(2)).toBe("two")
        expect(kind(3)).toBe("many")
    })

    await it("a closing break leaves the switch, not the loop around it", () => {
        expect(walk(4)).toBe("0..3.")
        let last = ""
        for (let k = 0; k < 300; k = k + 1) { last = walk(4) }
        expect(last).toBe("0..3.")
    })

    await it("a break inside a loop inside a case leaves that loop", () => {
        expect(inner(1)).toBe(3)
        expect(inner(2)).toBe(9)
    })
})
