import { TaskGroup, parallel } from "std:task"

async function add(a: int, b: int): int {
    return a + b
}

async function main(): void {
    // Test 1: basic parallel works
    const p = await parallel([add(1, 2), add(3, 4)])
    print("parallel:", p[0], p[1])

    // Test 2: TaskGroup basic join
    const g = TaskGroup<int>()
    const t1 = g.spawn(add(7, 8))
    const t2 = g.spawn(add(9, 10))
    print("tasks stored:", g.tasks.length)
    const joined = await g.join()
    print("joined:", joined)
    print("joined len:", joined.length)
    print("joined[0]:", joined[0])
    print("joined[1]:", joined[1])
}

await main()
