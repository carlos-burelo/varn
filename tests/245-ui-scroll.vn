import { describe, it, expect } from "std:test";
import { UiWindow, UiFrame, Focus, Column, Text, Scroll, Widget, render, present, signal, UiInjectKind, Box } from "std:ui";

function rows(n: int): Widget[] {
    const out: Widget[] = [];
    for (let at = 0; at < n; at = at + 1) {
        out.push(Box(w: 200.0, h: 30.0, color: 0xFFFFFFFF));
    }
    return out;
}

function frameAt(win: UiWindow, fr: UiFrame, focus: Focus, tree: Widget): void {
    fr.update(win);
    win.clear(0xFF000000);
    render(win, fr, focus, tree, 0.0, 0.0, 200.0, 100.0);
    present(win, fr);
}

function settle(win: UiWindow, fr: UiFrame, focus: Focus, tree: Widget): void {
    for (let i = 0; i < 120; i = i + 1) {
        frameAt(win, fr, focus, tree);
    }
}

await describe("245 ui scroll", async () => {
    await it("the wheel moves the content with momentum and clamps at the ends", () => {
        using win = UiWindow.open("t", 200, 100);
        const fr = new UiFrame(200, 100);
        const focus = new Focus();
        const at = signal(0.0);
        const tree = Scroll(Column(rows(10), gap: 0.0), at, 100.0);
        frameAt(win, fr, focus, tree);
        win.inject(UiInjectKind.Mouse, 50, 50, 0);
        frameAt(win, fr, focus, tree);
        win.inject(UiInjectKind.Wheel, -40, 0, 0);
        frameAt(win, fr, focus, tree);
        expect(at.value > 0.0).toBe(true);
        settle(win, fr, focus, tree);
        expect(at.value > 39.0 && at.value < 41.0).toBe(true);
        win.inject(UiInjectKind.Wheel, -10000, 0, 0);
        settle(win, fr, focus, tree);
        expect(at.value).toBe(200.0);
        win.inject(UiInjectKind.Wheel, 10000, 0, 0);
        settle(win, fr, focus, tree);
        expect(at.value).toBe(0.0);
    });

    await it("the content is clipped to the viewport", () => {
        using win = UiWindow.open("t", 200, 100);
        const fr = new UiFrame(200, 100);
        const focus = new Focus();
        const tree = Scroll(Column(rows(10), gap: 0.0), signal(0.0), 100.0);
        render(win, fr, focus, tree, 0.0, 0.0, 200.0, 100.0);
        const cmds = win.commands();
        expect(cmds.indexOf("clip 0 0 200 100") >= 0).toBe(true);
        expect(cmds[cmds.length - 1]).toBe("unclip");
    });
});
