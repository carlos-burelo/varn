function getField(o: dynamic): int { return o.x }
function getElem(a: dynamic, i: int): int { return a[i] }
function sumArr(a: dynamic, n: int): int {
  let s = 0
  for (let i = 0; i < n; i = i + 1) { s = s + a[i] }
  return s
}
let obj = { x: 42 }
let arr = [10, 20, 30]
print(getField(obj))
print(getElem(arr, 1))
print(sumArr(arr, 3))
