import { describe, it, expect } from "std:test";

const u = ()

function nothing(): Unit { return () }
function alsoNothing(): () { return () }

const pair: #[int, str] = #[1, "a"]

const results: Unit[] = [nothing(), ()]
await describe("126 unit", async () => {
        await it("group 1 part 1", async () => {
        expect(`${u}`).toBe("()");
        expect(u == ()).toBeTruthy();
        expect(typeof u).toBe("Tuple");
        expect(nothing() == alsoNothing()).toBeTruthy();
    });

    await it("group 1 part 2", async () => {
        expect(pair[0] === 1 && pair[1]).toBe("a");
        expect(`${pair}`).toBe("#[1, a]");
        expect(results.length).toBe(2);
    });


});
