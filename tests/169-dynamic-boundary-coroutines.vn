import { describe, it, expect } from "std:test";

async function asInt(d: dynamic): int { return d }
async function asInts(d: dynamic): Task<int[]> { return d }
const asStr = async (d: dynamic): str => d
class Reader {
    async flag(d: dynamic): bool { return d }
}
function* numbers(d: dynamic): int {
    yield 1
    yield d
}
async function* words(d: dynamic): str {
    yield "a"
    yield d
}

async function outcome(f: () => Task<dynamic>): str {
    try {
        const r = await f()
        return "ok " + r
    } catch (e) {
        if (e instanceof TypeError) { return e.message }
        return "other"
    }
}

function sum(d: dynamic): str {
    try {
        let total = 0
        for (const n of numbers(d)) { total = total + n }
        return `sum ${total}`
    } catch (e) {
        return e.message
    }
}

async function join(d: dynamic): str {
    try {
        let text = ""
        for await (const w of words(d)) { text = text + w }
        return "text " + text
    } catch (e) {
        return e.message
    }
}

await describe("169 dynamic boundary: coroutines", async () => {
    await it("an async function checks what it returns", async () => {
        expect(await outcome(async () => await asInt(5))).toBe("ok 5")
        expect(await outcome(async () => await asInt("x"))).toBe("type mismatch: expected 'int', got 'str'")
        expect(await outcome(async () => (await asInts([1, 2])).length)).toBe("ok 2")
        expect(await outcome(async () => await asInts(["a"]))).toBe("type mismatch: expected 'int[]', got 'Array'")
    })

    await it("async arrows and methods check too", async () => {
        expect(await outcome(async () => await asStr("s"))).toBe("ok s")
        expect(await outcome(async () => await asStr(3))).toBe("type mismatch: expected 'str', got 'int'")
        expect(await outcome(async () => await new Reader().flag(true))).toBe("ok true")
        expect(await outcome(async () => await new Reader().flag(1))).toBe("type mismatch: expected 'bool', got 'int'")
    })

    await it("a generator checks what it yields", async () => {
        expect(sum(2)).toBe("sum 3")
        expect(sum("x")).toBe("type mismatch: expected 'int', got 'str'")
        expect(await join("b")).toBe("text ab")
        expect(await join(7)).toBe("type mismatch: expected 'str', got 'int'")
    })
})
