import { describe, it, expect } from "std:test";

function describeNum(n: int): str {
    return match (n) {
        0 => "zero",
        1 => "one",
        2 | 3 => "two or three",
        _ => "other"
    };
}
function httpStatus(code: int): str {
    return match (code) {
        200 => "OK",
        404 => "Not Found",
        500 => "Server Error",
        _ => "dynamic"
    };
}

await describe("10 Match", async () => {
    await it("int patterns", () => {
        expect(describeNum(0)).toBe("zero");
        expect(describeNum(1)).toBe("one");
        expect(describeNum(2)).toBe("two or three");
        expect(describeNum(3)).toBe("two or three");
        expect(describeNum(99)).toBe("other");
    });

    await it("status codes", () => {
        expect(httpStatus(200)).toBe("OK");
        expect(httpStatus(404)).toBe("Not Found");
        expect(httpStatus(302)).toBe("dynamic");
    });
});
