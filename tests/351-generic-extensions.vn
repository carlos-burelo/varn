import { describe, it, expect } from "std:test";

class Crate<T> {
    constructor(public readonly item: T) {}
}

extension Tools<T> on readonly T[] {
    head(): T? { return this.at(0) }
    has(x: T): bool {
        for (const v of this) {
            if (sameValue(v, x)) { return true }
        }
        return false
    }
}

extension Pairs<K extends Hashable, V> on ReadonlyMap<K, V> {
    anyValue(): V? {
        for (const (_, v) of this) { return v }
        return null
    }
}

extension<T> on Crate<T> {
    unwrap(): T { return this.item }
}

await describe("351 generic extensions", async () => {
    await it("a type parameter of the extension is the type argument of its receiver", () => {
        const names: readonly str[] = ["ann", "bob"]
        expect(names.head()).toBe("ann")
        expect(names.has("bob")).toBe(true)
        expect(names.has("zed")).toBe(false)
        const first: str? = names.head()
        expect(first).toBe("ann")
    })

    await it("several type parameters follow the receiver in order", () => {
        const ages: ReadonlyMap<str, int> = { ann: 30 }
        expect(ages.anyValue()).toBe(30)
        const empty: ReadonlyMap<str, int> = {}
        expect(empty.anyValue()).toBe(null)
    })

    await it("an anonymous extension on a generic class", () => {
        expect(new Crate<int>(7).unwrap()).toBe(7)
        expect(new Crate<str>("x").unwrap()).toBe("x")
    })
})
