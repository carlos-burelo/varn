import { List, Queue } from "std:collections";
import { appendQuery } from "std:net";
import { Duration } from "std:time";
import { max as mathMax, min as mathMin } from "std:math";
import { assert, assertEqual, assertTrue } from "std:test";

function testCollections(): void {
    // 1. List.toArray() returns copy
    let list = new List<str>(["A", "B"]);
    let arr1 = list.toArray();
    let arr2 = list.toArray();
    
    // Changing returned array should not affect internal list items
    arr1.push("C");
    assertEqual(list.toArray().length, 2, "List.toArray() should return a copy");
    
    // 2. Queue dual-stack O(1) correctness
    let queue = new Queue<int>();
    assertTrue(queue.isEmpty, "Queue should be empty initially");
    assertEqual(queue.size, 0, "Queue size should be 0");
    
    queue.enqueue(10);
    queue.enqueue(20);
    queue.enqueue(30);
    
    assertEqual(queue.size, 3, "Queue size should be 3");
    assertEqual(queue.peek(), 10, "Queue peek should be 10");
    
    assertEqual(queue.dequeue(), 10, "Queue dequeue should return 10");
    assertEqual(queue.size, 2, "Queue size should be 2");
    
    queue.enqueue(40);
    assertEqual(queue.dequeue(), 20, "Queue dequeue should return 20");
    assertEqual(queue.dequeue(), 30, "Queue dequeue should return 30");
    assertEqual(queue.dequeue(), 40, "Queue dequeue should return 40");
    assertTrue(queue.isEmpty, "Queue should be empty after dequeuing all");
    assertEqual(queue.dequeue(), null, "Queue dequeue on empty should return null");
    assertEqual(queue.peek(), null, "Queue peek on empty should return null");
    
    print("[PASSED] collections test");
}

function testNetQueryMerge(): void {
    // appendQuery merges instead of replacing
    let res = appendQuery("http://example.com/api?a=1&b=2", { c: "3", d: ["4", "5"] });
    
    // It should contain a=1, b=2, c=3, d=4, d=5
    assertTrue(res.indexOf("a=1") !== -1, "Should preserve existing param a=1");
    assertTrue(res.indexOf("b=2") !== -1, "Should preserve existing param b=2");
    assertTrue(res.indexOf("c=3") !== -1, "Should merge new param c=3");
    assertTrue(res.indexOf("d=4") !== -1, "Should merge new array param d=4");
    assertTrue(res.indexOf("d=5") !== -1, "Should merge new array param d=5");
    
    // Test empty query append
    let unchanged = appendQuery("http://example.com/api?a=1", {});
    assertEqual(unchanged, "http://example.com/api?a=1", "Empty query append should return original URL");
    
    print("[PASSED] net query merge test");
}

function testDurationSeconds(): void {
    // Duration.seconds should be total seconds
    let dur = Duration.from(3605000); // 1 hour and 5 seconds = 3605 seconds total
    assertEqual(dur.hours, 1, "Duration hours should be 1");
    assertEqual(dur.minutes, 0, "Duration minutes should be 0");
    assertEqual(dur.seconds, 3605, "Duration seconds should be 3605");
    assertEqual(dur.milliseconds, 0, "Duration milliseconds should be 0");
    
    print("[PASSED] duration seconds test");
}

function testMathMinMax(): void {
    // min and max with huge values exceeding old 1,000,000,000.0 limit
    let valMax = mathMax(2000000000.0, -2000000000.0, 5.0);
    assertEqual(valMax, 2000000000.0, "mathMax should support values exceeding 1B");
    
    let valMin = mathMin(2000000000.0, -2000000000.0, 5.0);
    assertEqual(valMin, -2000000000.0, "mathMin should support values exceeding -1B");
    
    // Single argument
    assertEqual(mathMax(42.0), 42.0, "mathMax of single arg should be arg");
    assertEqual(mathMin(42.0), 42.0, "mathMin of single arg should be arg");
    
    print("[PASSED] math min/max test");
}

testCollections();
testNetQueryMerge();
testDurationSeconds();
testMathMinMax();

print("[ALL PASSED] stdlib specific tests successful");
