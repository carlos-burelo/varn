// Test suite for the core Result/Option ADTs and extensions
import { sha256 } from "std:crypto";
import { Base64 } from "std:encoding";

extension StringExtensions on str {
    sha256(): str {
        return sha256(this);
    }

    toBase64(): str {
        return Base64.encode(this);
    }
}

extension IntExtensions on int {
    seconds(): int {
        return this * 1000;
    }

    minutes(): int {
        return this * 60000;
    }
}

// 1. Result ADT with match and helper functions
const okRes: Result<int, str> = Ok(42);
const errRes: Result<int, str> = Err("something went wrong");

assert("isOk true", okRes.isOk());
assert("isOk false", !errRes.isOk());
assert("isErr true", errRes.isErr());
assert("unwrap ok", okRes.unwrap() === 42);
assert("unwrapOr default", errRes.unwrapOr(100) === 100);

const matchedVal = match (okRes) {
    Ok(val) => val,
    Err(_) => 0
};
assert("match Ok payload", matchedVal === 42);

// 2. Option ADT
const someOpt: Option<str> = Some("varn");
const noneOpt: Option<str> = None;

assert("isSome true", someOpt.isSome());
assert("isNone true", noneOpt.isNone());

// 3. Failure paths
const caught = Result.catching<int>(() => {
    throw new TypeError("boom");
});
assert("catching turns a throw into Err", caught.isErr());
const caughtMessage = match (caught) {
    Ok(_) => "",
    Err(e) => e.message
};
assert("catching keeps the error", caughtMessage === "boom");

let unwrapNoneThrew = false;
try {
    noneOpt.unwrap();
} catch (e) {
    unwrapNoneThrew = true;
}
assert("unwrap on None throws", unwrapNoneThrew);

// 4. Extension methods
assert("str.sha256 extension", "hello".sha256().length === 64);
assert("int.seconds extension", 5.seconds() === 5000);
assert("int.minutes extension", 2.minutes() === 120000);

print("[PASSED] 70. Result/Option ADTs and extensions");
