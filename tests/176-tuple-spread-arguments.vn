import { describe, it, expect } from "std:test";

function pair(a: int, b: str): str { return a + ":" + b }
function sum(label: str, ...xs: int[]): int {
    let t = 0
    for (const x of xs) { t = t + x }
    return t
}
class Point {
    constructor(public a: int, public b: str) {}
    join(a: int, b: str): str { return b + a }
}

const mixed: #[int, str] = #[1, "x"]
const numbers: #[int, int] = #[2, 3]

await describe("176 tuple spread in arguments", async () => {
    await it("a tuple fills the parameters by position", () => {
        expect(pair(...mixed)).toBe("1:x")
        expect(new Point(...mixed).b).toBe("x")
        expect(new Point(1, "q").join(...mixed)).toBe("x1")
    })

    await it("a tuple can feed a rest parameter and sit between arguments", () => {
        expect(sum("l", ...numbers)).toBe(5)
        expect(sum("l", 1, ...numbers, 4)).toBe(10)
    })

    await it("holds in a hot loop", () => {
        let k = 0
        for (let i = 0; i < 5000; i = i + 1) { k = k + pair(...mixed).length + sum("l", ...numbers) }
        expect(k).toBe(40000)
    })
})
