import { describe, it, expect } from "std:test";

await describe("02 Boolean", async () => {
    await it("short-circuit and negation", () => {
        expect((false && (1 / 0 === 0)) === false).toBeTruthy();
        expect(true || (1 / 0 === 0) === true).toBeTruthy();
        expect(!!true).toBe(true);
        expect(!false).toBe(true);
        expect(!true).toBe(false);
        expect(!(1 === 2)).toBe(true);
        expect(!(1 === 1)).toBe(false);
    });

    await it("strict equality", () => {
        expect("abc").toBe("abc");
        expect("abc" !== "def").toBeTruthy();
        expect(null).toBe(null);
        expect(null !== 0).toBeTruthy();
    });
});
