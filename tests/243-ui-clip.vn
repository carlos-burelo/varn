import { describe, it, expect } from "std:test";
import { UiWindow } from "std:ui";

await describe("243 ui clip commands", async () => {
    await it("clip and unclip are recorded in paint order", () => {
        using win = UiWindow.open("t", 200, 100, true);
        win.clear(0xFF000000);
        win.clip(10.0, 20.0, 30.0, 40.0);
        win.rect(0.0, 0.0, 5.0, 5.0, 0xFFFFFFFF, 0.0);
        win.clip(12.0, 22.0, 4.0, 4.0);
        win.text(12.0, 22.0, "a", 12.0, 0xFFFFFFFF);
        win.unclip();
        win.unclip();
        const cmds = win.drawn();
        expect(cmds[1].kind == "clip" && cmds[1].x == 10.0 && cmds[1].y == 20.0 && cmds[1].w == 30.0 && cmds[1].h == 40.0).toBe(true);
        expect(cmds[2].kind).toBe("rect");
        expect(cmds[3].kind == "clip" && cmds[3].x == 12.0 && cmds[3].w == 4.0).toBe(true);
        expect(cmds[4].kind).toBe("text");
        expect(cmds[5].kind).toBe("unclip");
        expect(cmds[6].kind).toBe("unclip");
        expect(cmds.length).toBe(7);
    });
});
