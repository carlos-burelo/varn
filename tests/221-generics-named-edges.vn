import { describe, it, expect } from "std:test";

type Todo = {
    id: int,
    title: str
};

function ident<T>(value: T, label: str): T {
    return value;
}

function swapNamed<A, B>(first: A, second: B, tag: str = ""): B {
    return second;
}

function applyBoth<T>(items: T[], key: (v: T) => dynamic, render: (v: T) => str): str[] {
    const out: str[] = [];
    for (let i = 0; i < items.length; i = i + 1) {
        out.push(render(items[i]));
    }
    return out;
}

function pick<T>(items: T[], index: int = 0): T {
    return items[index];
}

function withRest<T>(first: T, ...rest: T[]): T[] {
    const out: T[] = [first];
    for (let i = 0; i < rest.length; i = i + 1) {
        out.push(rest[i]);
    }
    return out;
}

function maybeMap<T>(value: T | null, map: (v: T) => str, fallback: str = ""): str {
    if (value == null) {
        return fallback;
    }
    return map(value as T);
}

function optFn<T>(value: T, cb?: (v: T) => void): T {
    if (cb != null) {
        const f = cb as (v: T) => void;
        f(value);
    }
    return value;
}

function nested<T>(items: T[], wrap: (v: T) => T[]): T[][] {
    const out: T[][] = [];
    for (let i = 0; i < items.length; i = i + 1) {
        out.push(wrap(items[i]));
    }
    return out;
}

function pairOf<A, B>(a: A, b: B): [A, B] {
    return #[a, b];
}

function boxPair<A, B>(a: A, b: B): Box<[A, B]> {
    return new Box<[A, B]>(#[a, b]);
}

namespace tools {
    export function eachLocal<T>(items: T[], key: (v: T) => dynamic, render: (v: T) => str): str[] {
        const out: str[] = [];
        for (let i = 0; i < items.length; i = i + 1) {
            out.push(render(items[i]));
        }
        return out;
    }
}

const toolbox = {
    eachObj: applyBoth
};

class Box<T> {
    value: T;
    constructor(v: T) {
        this.value = v;
    }
    get(): T {
        return this.value;
    }
    map<U>(f: (x: T) => U, suffix: str = ""): Box<U> {
        return new Box<U>(f(this.value));
    }
}

class Point {
    x: int;
    y: int;
    constructor(x: int, y: int) {
        this.x = x;
        this.y = y;
    }
}

function input<T>(value: T): T {
    return value;
}

await describe("221 generics named edges", async () => {
    await it("generic all named in order", () => {
        expect(ident(value: 42, label: "n")).toBe(42);
        expect(ident(value: "s", label: "s")).toBe("s");
    });

    await it("generic all named out of order", () => {
        expect(ident(label: "n", value: 7)).toBe(7);
        expect(swapNamed(tag: "t", second: "b", first: 1)).toBe("b");
    });

    await it("generic mixed positional and named", () => {
        expect(ident(42, label: "n")).toBe(42);
        expect(swapNamed(1, second: "b")).toBe("b");
        expect(swapNamed(1, "b", tag: "t")).toBe("b");
    });

    await it("generic named omits defaults", () => {
        expect(swapNamed(first: 1, second: 2)).toBe(2);
        expect(pick(items: [10, 20, 30])).toBe(10);
        expect(pick(items: [10, 20, 30], index: 2)).toBe(30);
    });

    await it("generic explicit type args with named", () => {
        expect(ident<Todo>(value: { id: 1, title: "a" }, label: "t").title).toBe("a");
        expect(swapNamed<int, str>(first: 1, second: "b")).toBe("b");
    });

    await it("generic named annotated closure", () => {
        const todos: Todo[] = [{ id: 1, title: "a" }, { id: 2, title: "b" }];
        expect(applyBoth(todos, key: (t: Todo) => t.id, render: (t: Todo) => t.title)).toEqual(["a", "b"]);
    });

    await it("generic named bare closures infer from items", () => {
        const todos: Todo[] = [{ id: 1, title: "a" }, { id: 2, title: "b" }];
        expect(applyBoth(todos, key: t => t.id, render: t => t.title)).toEqual(["a", "b"]);
    });

    await it("generic named bare closures in fn and async", async () => {
        const todos: Todo[] = [{ id: 1, title: "a" }];
        const build = (): str[] => applyBoth(todos, key: t => t.id, render: t => t.title);
        expect(build()).toEqual(["a"]);
        expect(applyBoth(todos, key: t => t.id, render: t => t.title)).toEqual(["a"]);
    });

    await it("generic namespace member bare lambdas", () => {
        const todos: Todo[] = [{ id: 1, title: "a" }, { id: 2, title: "b" }];
        expect(tools.eachLocal(todos, key: t => t.id, render: t => t.title)).toEqual(["a", "b"]);
    });

    await it("generic namespace member bare lambdas async", async () => {
        const todos: Todo[] = [{ id: 1, title: "a" }];
        expect(tools.eachLocal(todos, key: t => t.id, render: t => t.title)).toEqual(["a"]);
    });

    await it("generic object member bare lambdas", () => {
        const todos: Todo[] = [{ id: 1, title: "a" }, { id: 2, title: "b" }];
        expect(toolbox.eachObj(todos, key: t => t.id, render: t => t.title)).toEqual(["a", "b"]);
    });

    await it("generic object member bare lambdas async", async () => {
        const todos: Todo[] = [{ id: 1, title: "a" }];
        expect(toolbox.eachObj(todos, key: t => t.id, render: t => t.title)).toEqual(["a"]);
    });

    await it("generic method named args", () => {
        const b = new Box<int>(10);
        expect(b.map(f: (n: int) => n * 2).get()).toBe(20);
        expect(b.map(f: n => n + 1, suffix: "!").get()).toBe(11);
    });

    await it("generic method explicit type args", () => {
        const b = new Box<int>(10);
        expect(b.map<str>((n) => n.toString()).get()).toBe("10");
    });

    await it("generic rest with named first", () => {
        expect(withRest(1, 2, 3)).toEqual([1, 2, 3]);
        expect(withRest(first: "a")).toEqual(["a"]);
        expect(withRest(first: "a", ...["b"])).toEqual(["a", "b"]);
        expect(withRest(first: "a", ...["b", "c"])).toEqual(["a", "b", "c"]);
    });

    await it("generic spread positional", () => {
        const nums: int[] = [1, 2, 3];
        expect(withRest(...nums)).toEqual([1, 2, 3]);
    });

    await it("generic nullable and union named", () => {
        expect(maybeMap(value: "hi", map: s => s + "!")).toBe("hi!");
        expect(maybeMap(value: null as str?, map: (s: str) => s, fallback: "dflt")).toBe("dflt");
    });

    await it("generic optional closure named", () => {
        const seen: int[] = [];
        expect(optFn(value: 5, cb: v => { seen.push(v); })).toBe(5);
        expect(seen).toEqual([5]);
        expect(optFn(value: 6)).toBe(6);
    });

    await it("nested generic named", () => {
        expect(nested(items: [1, 2], wrap: x => [x])).toEqual([[1], [2]]);
    });

    await it("generic tuple return substitutes through index", () => {
        const t = pairOf(7, "seven");
        expect(t[0] + 1).toBe(8);
        expect(t[1] + "!").toBe("seven!");
        expect(pairOf<int, str>(1, "a")[0]).toBe(1);
        const bp = boxPair(7, "seven");
        expect(bp.get()[0] + 1).toBe(8);
        expect(bp.get()[1] + "!").toBe("seven!");
    });

    await it("shadowed global name generic", () => {
        expect(input(value: 42)).toBe(42);
        expect(input(value: "s")).toBe("s");
        expect(input<int>(value: 1)).toBe(1);
    });

    await it("named constructor args", () => {
        const p = new Point(x: 3, y: 4);
        expect(p.x).toBe(3);
        expect(p.y).toBe(4);
        const b = new Box<int>(v: 10);
        expect(b.get()).toBe(10);
    });

    await it("concrete named closure infers param", () => {
        const seen: str[] = [];
        function takeCb(value: str, cb: (v: str) => void): str {
            cb(value);
            return value;
        }
        expect(takeCb(value: "hi", cb: v => { seen.push(v); })).toBe("hi");
    });

    await it("dynamic call stays lenient and correct", () => {
        const todos: Todo[] = [{ id: 1, title: "a" }];
        const f: dynamic = applyBoth;
        expect(f(todos, key: (t: int) => t, render: (t: Todo) => t.title)).toEqual(["a"]);
    });
});
