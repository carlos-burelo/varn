// A compiled branch whose condition is not a `bool` takes the interpreter's
// truthiness rule (`VmValue::is_truthy`), not "the boxed value is
// non-zero": a boxed `false`, `0` or `0.0` has a non-zero tag. Each function
// runs past the tiering threshold and has two statements, so it executes
// compiled instead of being inlined.

function btDynamic(v: dynamic): int {
    let n = 0
    if (v) { n = 1 }
    return n
}

// A method answering a `dynamic` `bool`, branched on directly.
function btMethod(v: dynamic): int {
    let n = 10
    if (Array.isArray(v)) { n = 100 }
    return n
}

let truthy = 0
let arrays = 0
const probes: dynamic[] = ["1", "", [1, 2], 0, 7, 0.0, 2.5, null, false, true, { a: 1 }]
for (let i = 0; i < 2200; i = i + 1) {
    const p = probes[i % 11]
    truthy = truthy + btDynamic(p)
    arrays = arrays + btMethod(p)
}

// Only null, false, 0 and 0.0 are falsy: "1", "", [1, 2], 7, 2.5, true and
// { a: 1 } are truthy.
assert("branches follow the interpreter's truthiness", truthy === 200 * 7)
// One array among the 11 probes, 200 rounds.
assert("a method's dynamic bool in a branch", arrays === 200 * (100 + 10 * 10))

print("[PASSED] 146. JIT branch truthiness")
