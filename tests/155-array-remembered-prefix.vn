import { describe, it, expect } from "std:test";

class PfBox {
    v: int
    constructor(v: int) {
        this.v = v
    }
}

let pfSink: PfBox = new PfBox(0)

function pfChurn(n: int): int {
    for (let i = 0; i < n; i = i + 1) {
        pfSink = new PfBox(i)
    }
    return pfSink.v
}

function pfFill(n: int): Array<PfBox> {
    const a: Array<PfBox> = []
    for (let i = 0; i < n; i = i + 1) {
        a.push(new PfBox(i))
    }
    return a
}

function pfSum(a: Array<PfBox>): int {
    let s = 0
    for (let i = 0; i < a.length; i = i + 1) {
        s = s + a[i].v
    }
    return s
}

await describe("155 array remembered prefix", async () => {
    await it("1. a write below the clean prefix survives later collections", async () => {
        const a = pfFill(60000)
        pfChurn(300000)
        a[3] = new PfBox(1000000)
        a[59999] = new PfBox(2000000)
        pfChurn(300000)
        expect(a[3].v).toBe(1000000)
        expect(a[59999].v).toBe(2000000)
        expect(a[10].v).toBe(10)
        expect(pfSum(a)).toBe(1799970000 - 3 - 59999 + 1000000 + 2000000)
    })

    await it("2. a pop followed by a push into the clean region is rescanned", async () => {
        const a = pfFill(60000)
        pfChurn(300000)
        a.pop()
        a.push(new PfBox(7))
        pfChurn(300000)
        expect(a[59999].v).toBe(7)
        expect(a.length).toBe(60000)
    })

    await it("3. reordering moves a young reference below the clean prefix", async () => {
        const a = pfFill(60000)
        pfChurn(300000)
        a.push(new PfBox(777))
        a.reverse()
        pfChurn(300000)
        expect(a[0].v).toBe(777)
        expect(a[1].v).toBe(59999)
        expect(a[60000].v).toBe(0)
    })

    await it("4. repeated appends across collections keep every element", async () => {
        const a: Array<PfBox> = []
        for (let round = 0; round < 6; round = round + 1) {
            for (let i = 0; i < 20000; i = i + 1) {
                a.push(new PfBox(round * 20000 + i))
            }
            pfChurn(120000)
        }
        expect(a.length).toBe(120000)
        expect(pfSum(a)).toBe(7199940000)
    })
})
