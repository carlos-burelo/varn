import { describe, it, expect } from "std:test";

class Cell {
    x: int = 0;
    y: int = 0;
}

class Point {
    x: int;
    y: int;
    constructor(a: int, b: int) {
        ;(this.x, this.y) = (a, b);
    }
}

struct Pair {
    left: int;
    right: int;
}

function pair(): (int, int) {
    return (1, 2);
}

let evaluations = 0;
function counted(): (int, int) {
    evaluations = evaluations + 1;
    return (1, 2);
}

await describe("337 destructuring assignment", async () => {
    await it("swaps two variables through a tuple", async () => {
        let a = 1;
        let b = 2;
        ;(a, b) = (b, a);
        expect(a).toBe(2);
        expect(b).toBe(1);
    });

    await it("swaps two variables through an array", async () => {
        let a = 1;
        let b = 2;
        ;[a, b] = [b, a];
        expect(a).toBe(2);
        expect(b).toBe(1);
    });

    await it("assigns object fields and renames them", async () => {
        let x = 0;
        let y = 0;
        let renamed = 0;
        ;({ x, y } = { x: 3, y: 4 });
        expect(x + y).toBe(7);
        ;({ left: renamed } = new Pair(8, 9));
        expect(renamed).toBe(8);
    });

    await it("collects the rest of an array", async () => {
        let first = 0;
        let rest: int[] = [];
        ;[first, ...rest] = [1, 2, 3];
        expect(first).toBe(1);
        expect(rest.length).toBe(2);
    });

    await it("skips holes and the placeholder", async () => {
        let b = 0;
        ;[, b] = [1, 2];
        expect(b).toBe(2);
        let a = 0;
        ;(a, _) = (5, 6);
        expect(a).toBe(5);
    });

    await it("falls back to a default when the element is null", async () => {
        let a: int? = 0;
        let b = 0;
        ;[a, b = 9] = [1, null];
        expect(a).toBe(1);
        expect(b).toBe(9);
    });

    await it("nests tuples", async () => {
        let a = 0;
        let b = 0;
        let c = 0;
        ;(a, (b, c)) = (1, (2, 3));
        expect(a + b + c).toBe(6);
    });

    await it("assigns members and indexes", async () => {
        const cell = new Cell();
        ;(cell.x, cell.y) = (5, 6);
        expect(cell.x).toBe(5);
        expect(cell.y).toBe(6);
        const slots = [0, 0];
        ;(slots[0], slots[1]) = (7, 8);
        expect(slots[1]).toBe(8);
    });

    await it("is the value of the expression and evaluates its right side once", async () => {
        let a = 0;
        let b = 0;
        ;(a, b) = counted();
        expect(evaluations).toBe(1);
        expect(a + b).toBe(3);
        const whole = ((a, b) = (3, 4));
        expect(whole[1]).toBe(4);
    });

    await it("works in a loop and inside a closure", async () => {
        let a = 0;
        let b = 1;
        for (let i = 0; i < 10; i++) {
            ;(a, b) = (b, a + b);
        }
        expect(a).toBe(55);
        let x = 1;
        let y = 2;
        const swap = () => {
            ;(x, y) = (y, x);
        };
        swap();
        expect(x).toBe(2);
    });

    await it("assigns the fields of a constructor through destructuring", async () => {
        const p = new Point(1, 2);
        expect(p.y).toBe(2);
        let l = 0;
        let r = 0;
        ;(l, r) = pair();
        expect(l + r).toBe(3);
    });
});
