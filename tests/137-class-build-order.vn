import { describe, it, expect } from "std:test";

// A class is laid out after its parent whatever their names: `Zebra` sorts
// after `Horse`, which extends it, and `Horse` must still inherit Zebra's
// fields at Zebra's slots instead of re-declaring them as its own.

class Zebra {
    stripes: int
    constructor(stripes: int) {
        this.stripes = stripes
    }
    describe(): str {
        return "stripes " + this.stripes
    }
}

class Horse extends Zebra {
    name: str
    constructor(name: str) {
        super(0)
        this.name = name
    }
}

// Three levels whose names sort child first.
class Omega {
    o: int
    constructor() {
        this.o = 3
    }
}
class Mid extends Omega {
    m: int
    constructor() {
        super()
        this.m = 2
    }
}
class Alpha extends Mid {
    a: int
    constructor() {
        super()
        this.a = 1
    }
}

const horse = new Horse("h")
const alpha = new Alpha()
await describe("137 class build order", async () => {
        await it("group 1 part 1", async () => {
        expect(horse.name == "h").toBeTruthy();
        expect(horse.stripes).toBe(0);
    });

    await it("group 1 part 2", async () => {
        expect(horse.describe() == "stripes 0").toBeTruthy();
        expect(alpha.a + alpha.m + alpha.o).toBe(6);
    });


});
