import { describe, it, expect } from "std:test";

function* range_gen(start: int, end: int) {
    let i = start;
    while (i < end) {
        yield i;
        i = i + 1;
    }
}
function* fib_gen() {
    let a = 0;
    let b = 1;
    while (true) {
        yield a;
        const tmp = a + b;
        a = b;
        b = tmp;
    }
}

await describe("20 Generators", async () => {
    await it("range generator", () => {
        const gen = range_gen(0, 5);
        const g0 = gen.next();
        expect(g0.value).toBe(0);
        expect(!g0.done).toBeTruthy();
        gen.next();
        gen.next();
        const g3 = gen.next();
        expect(g3.value).toBe(3);
        const g4 = gen.next();
        expect(g4.value).toBe(4);
        const gend = gen.next();
        expect(gend.done).toBeTruthy();
    });

    await it("fibonacci generator", () => {
        const fib2 = fib_gen();
        const fibs: int[] = [];
        for (let i = 0; i < 8; i = i + 1) {
            fibs.push(fib2.next().value);
        }
        expect(fibs[0]).toBe(0);
        expect(fibs[1]).toBe(1);
        expect(fibs[7]).toBe(13);
    });
});
