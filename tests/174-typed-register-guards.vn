import { describe, it, expect } from "std:test";

await describe("174 typed register guards", async () => {
    await it("an int converts explicitly into a float", () => {
        const ints: int[] = [1, 2]
        const out: float[] = ints.map((n: int) => (n as float) + 0.5)
        expect(out[0]).toBe(1.5)
        expect(out[1]).toBe(2.5)
    })

    await it("a nullable float parameter takes null", () => {
        const nulls: float?[] = [null, 1.5]
        const out: float?[] = nulls.map((f: float?) => f)
        expect(out[0]).toBe(null)
        expect(out[1]).toBe(1.5)
    })
})
