import { describe, it, expect } from "std:test";

function join(head: int[], pair: #[int, int]): int[] {
    return [...head, ...pair, 9]
}

await describe("191 spread sources", async () => {
    await it("an array literal spreads arrays and tuples", () => {
        let total = 0
        for (let i = 0; i < 300; i = i + 1) { total = total + join([i], #[1, 2]).length }
        expect(total).toBe(1200)
        expect(join([5, 6], #[7, 8]).join(",")).toBe("5,6,7,8,9")
        const loose: dynamic = [3, 4]
        expect([...loose, 5].length).toBe(3)
    })
})
