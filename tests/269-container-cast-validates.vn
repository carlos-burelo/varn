import { describe, it, expect } from "std:test";

function castFails(source: dynamic[]): bool {
    try {
        const ints = source as int[];
        let total = 0;
        for (const x of ints) { total = total + x }
        return false
    } catch (e) {
        return true
    }
}

await describe("269 container cast validates", async () => {
    await it("a dynamic array whose elements fit is accepted", () => {
        const source: dynamic[] = [1, 2, 3];
        const ints = source as int[];
        expect(ints.length).toBe(3);
        expect(ints[2] + 1).toBe(4);
    });

    await it("an element of another type is rejected at the cast", () => {
        const mixed: dynamic[] = [1, "x"];
        const floats: dynamic[] = [1.5];
        expect(castFails(mixed)).toBeTruthy();
        expect(castFails(floats)).toBeTruthy();
    });

    await it("the hot path agrees", () => {
        const source: dynamic[] = [1.5];
        let rejected = 0;
        for (let i = 0; i < 1000; i = i + 1) { if (castFails(source)) { rejected = rejected + 1 } }
        expect(rejected).toBe(1000);
    });
});
