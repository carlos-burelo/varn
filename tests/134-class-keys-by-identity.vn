import { describe, it, expect } from "std:test";

class Point {
    x: int
    y: int
    constructor(x: int, y: int) { this.x = x; this.y = y }
}

struct Cell { x: int; y: int }

const names: Map<Point, str> = new Map()
const seen: Set<Point> = new Set()
const cells: Map<Cell, str> = new Map()

function churn(): bool {
    const m: Map<Cell, int> = new Map()
    for (let i = 0; i < 2000; i = i + 1) { m.set(new Cell(i % 50, 0), i) }
    let junk = 0
    for (let i = 0; i < 20000; i = i + 1) { const t = [i, i + 1]; junk = junk + t.length }
    return m.size == 50 && m.get(new Cell(49, 0)) == 1999
}
const churnOk = churn()

await describe("134 class keys are identity", async () => {
    await it("a class instance is found by that instance only", () => {
        const first = new Point(1, 2)
        names.set(first, "a")
        expect(names.get(first)).toBe("a")
        expect(names.has(new Point(1, 2))).toBeFalsy()
        names.set(new Point(1, 2), "b")
        expect(names.size).toBe(2)
        expect(names.delete(first)).toBeTruthy()
        expect(names.size).toBe(1)
    })

    await it("a set keeps every distinct instance", () => {
        const origin = new Point(0, 0)
        seen.add(origin)
        seen.add(origin)
        seen.add(new Point(0, 0))
        expect(seen.size).toBe(2)
        expect(seen.has(origin)).toBeTruthy()
    })

    await it("a struct is found by value", () => {
        cells.set(new Cell(1, 2), "a")
        cells.set(new Cell(1, 2), "b")
        expect(cells.size).toBe(1)
        expect(cells.get(new Cell(1, 2))).toBe("b")
        expect(cells.has(new Cell(2, 1))).toBeFalsy()
    })

    await it("struct keys survive collection churn", () => {
        expect(churnOk).toBeTruthy()
    })
})
