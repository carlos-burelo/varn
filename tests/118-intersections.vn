import { describe, it, expect } from "std:test";

interface Named { name(): str }
interface Aged { age(): int }

class Person {
    n: str
    a: int
    constructor(n: str, a: int) {
        this.n = n
        this.a = a
    }
    name(): str { return this.n }
    age(): int { return this.a }
}

function describePerson(x: Named & Aged): str {
    return x.name() + ":" + x.age().toString()
}

class Base {
    greet(): str { return "hi" }
}
class Child extends Base {
    extra(): int { return 1 }
}

interface Pos { x: int }
interface Tagged { tag: str }
const both: Pos & Tagged = { x: 1, tag: "p" }

interface Loose { id: int? }
interface Strict { id: int }
const narrowed: Loose & Strict = { id: 3 }

type Method = "GET" | "POST"
const onlyGet: "GET" & str = "GET"
await describe("118 intersections", async () => {
        await it("group 1 part 1", async () => {
        expect(describePerson(new Person("ana", 30))).toBe("ana:30");
        expect(new Child().greet()).toBe("hi");
        expect(both.x === 1 && both.tag === "p").toBeTruthy();
    });

    await it("group 1 part 2", async () => {
        expect(narrowed.id).toBe(3);
        expect(onlyGet).toBe("GET");
    });


});
