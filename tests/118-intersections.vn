interface Named { name(): str }
interface Aged { age(): int }

class Person {
    n: str
    a: int
    constructor(n: str, a: int) {
        this.n = n
        this.a = a
    }
    name(): str { return this.n }
    age(): int { return this.a }
}

function describe(x: Named & Aged): str {
    return x.name() + ":" + x.age().toString()
}

assert("intersection param", describe(new Person("ana", 30)) === "ana:30")

class Base {
    greet(): str { return "hi" }
}
class Child extends Base {
    extra(): int { return 1 }
}
assert("extends in the same module binds", new Child().greet() === "hi")

interface Pos { x: int }
interface Tagged { tag: str }
const both: Pos & Tagged = { x: 1, tag: "p" }
assert("intersection has both members", both.x === 1 && both.tag === "p")

interface Loose { id: int? }
interface Strict { id: int }
const narrowed: Loose & Strict = { id: 3 }
assert("shared member keeps the narrower type", narrowed.id === 3)

type Method = "GET" | "POST"
const onlyGet: "GET" & str = "GET"
assert("literal & base is the literal", onlyGet === "GET")

print("[PASSED] 118. Intersections")
