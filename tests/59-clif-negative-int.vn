import { describe, it, expect } from "std:test";


// Negative `int` results crossing the Cranelift return boundary.
//
// The regression: a raw clif function returning `int` always yields an
// UNBOXED i48 payload — every arm of `emit_return_value`'s `SlotKind::Int`
// case produces one. The wrapper re-tagged it only when the high bits were
// clear, on the theory that a set NaN-box tag meant "already boxed". That
// test cannot tell a boxed value from a negative payload: `-3` is
// `0xFFFF_FFFF_FFFF_FFFD`, whose high bits are all set. So every negative
// `int` return escaped untagged and decoded as null.
//
// `function sub(a: int, b: int): int` returned null for `sub(1, 4)`. The
// existing suite never caught it because its int-returning functions happened
// to stay non-negative.
//
// Second regression, same file: `Negate` chose its inline path from the
// DESTINATION register's meta alone, so a boxed operand went through
// `use_int` — which accepts boxed registers — and `ineg` ran over a
// heap-tagged VmValue's payload bits. `-(7.5d)` resolved to null.

function sub(a: int, b: int): int { return a - b }
function negLit(): int { return -3 }
function negParam(a: int): int { return -a }
function viaZero(a: int): int { let z = 0; return z - a }
function mulNeg(a: int, b: int): int { return a * b }

// A negative int returned through a chain of calls: each hop re-tags.
function outer(n: int): int { return sub(0, negParam(n)) }

// Large magnitudes, still inside i48.
function bigNeg(): int { return -140737488355327 }

function negFloat(f: float): float { return -f }

function negMixed(a: int, f: float): float { return ((-a) as float) + (-f) }
await describe("59 clif negative int", async () => {
    await it("tests", async () => {
        
        expect(sub(1, 4)).toBe(-3)
        expect(negLit()).toBe(-3)
        expect(negParam(3)).toBe(-3)
        expect(viaZero(3)).toBe(-3)
        expect(mulNeg(-2, 3)).toBe(-6)
        expect(negParam(negParam(7))).toBe(7)
        expect(sub(4, 4)).toBe(0)
        expect(sub(9, 4)).toBe(5)
        expect(outer(5)).toBe(5)
        expect(bigNeg()).toBe(-140737488355327)
        expect(-bigNeg()).toBe(140737488355327)
        
        // Negation of the boxed representations. Negating a decimal allocates, which
        // is why `Negate` is in the `has_alloc` set in the first place.
        const d: decimal = 7.5d
        expect((-d)).toBe(-7.5d)
        expect((-d).abs()).toBe(7.5d)
        expect(negFloat(1.5)).toBe(-1.5)
        expect(negMixed(3, 1.5)).toBe(-4.5)
        
    });
});
