import { describe, it, expect } from "std:test";

class Base {
    x: int = 7
    label: str = "base"
}

class Child extends Base {
    y: int = 1
}

class LevelA { a: int = 1 }
class LevelB extends LevelA { b: int = 2 }
class LevelC extends LevelB { c: int = 3 }

class Plain {
    five(): int { return 5 }
}

class OverPlain extends Plain {
    n: int = 2
}

class Sized {
    size: int
    tag: str
    constructor(size: int, tag: str) {
        this.size = size
        this.tag = tag
    }
}

class SizedChild extends Sized {
    extra: int = 10
}

class SizedGrandchild extends SizedChild {
    more: int = 100
}

class Coded extends Error {
    code: int = 42
}

class Shadow extends Base {
    x: int = 8
}

function buildMany(n: int): int {
    let total = 0
    for (let i = 0; i < n; i = i + 1) {
        const c = new SizedChild(i, "t")
        total = total + c.size + c.extra
    }
    return total
}

function spreadIntoBound(n: int): int {
    const items = [1]
    const push = items.push
    const more = [5]
    for (let i = 0; i < n; i = i + 1) { push(...more) }
    return items.length
}

await describe("163 implicit constructor chain", async () => {
    await it("a subclass with its own defaults keeps the inherited ones", () => {
        const c = new Child()
        expect(c.x).toBe(7)
        expect(c.label).toBe("base")
        expect(c.y).toBe(1)
        const deep = new LevelC()
        expect(deep.a + deep.b + deep.c).toBe(6)
        expect(new Shadow().x).toBe(8)
    })

    await it("works when no ancestor declares a constructor", () => {
        const o = new OverPlain()
        expect(o.n + o.five()).toBe(7)
    })

    await it("forwards its arguments to the parent constructor", () => {
        const c = new SizedChild(5, "tag")
        expect(c.size).toBe(5)
        expect(c.tag).toBe("tag")
        expect(c.extra).toBe(10)
        const g = new SizedGrandchild(3, "g")
        expect(g.size + g.extra + g.more).toBe(113)
        expect(g.tag).toBe("g")
        expect(buildMany(5000)).toBe(12547500)
    })

    await it("forwards to a native parent", () => {
        const e = new Coded("boom")
        expect(e.code).toBe(42)
        expect(e.message).toBe("boom")
        expect(e instanceof Error).toBe(true)
    })

    await it("a bound native method keeps its receiver under spread", () => {
        expect(spreadIntoBound(3000)).toBe(3001)
    })
})
