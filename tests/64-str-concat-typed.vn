// `+` with a statically-proven string operand now emits `StrConcat` instead
// of the generic `Add`. That opcode was previously NEVER emitted — its
// interpreter arm, its Cranelift lowering, its runtime helper and its
// register-allocator handling were all unreachable code. This file is the
// coverage that path never had.
//
// The specialization must be semantics-preserving: `arith::add` routes to
// `str_concat` whenever EITHER operand is a string, so every case below has
// to read the same as it did through the generic path — including the ones
// where the string is on the right, and where the other operand is not a
// number.

function scLeft(n: int): string { return "n=" + n }
assert("strconcat: string on the left", scLeft(42) === "n=42")

function scRight(n: int): string { return n + " items" }
assert("strconcat: string on the right", scRight(7) === "7 items")

// NOTE: `a + b` with both operands DECLARED `string` is rejected by the
// checker (`WR3010: invalid binary operation '+' between 'string' and
// 'string'`), so the two-literal form is the only way to reach a
// string/string concat from source.
assert("strconcat: two string literals", ("ab" + "cd") === "abcd")

// Non-numeric right operands must stringify, not coerce.
function scNull(): string { return "v=" + null }
assert("strconcat: null stringifies", scNull() === "v=null")

function scBool(): string { return "b=" + true }
assert("strconcat: bool stringifies", scBool() === "b=true")

function scFloat(): string { return "f=" + 1.5 }
assert("strconcat: float stringifies", scFloat() === "f=1.5")

// A float that happens to be integral prints without a fractional part —
// pinned because `str_repr_into` has a dedicated branch for it.
function scWholeFloat(): string { return "w=" + 3.0 }
assert("strconcat: integral float stringifies", scWholeFloat() === "w=3")

// Negative and zero through the itoa path.
assert("strconcat: negative int", ("x" + -5) === "x-5")
assert("strconcat: zero", ("x" + 0) === "x0")

// Empty string operands.
assert("strconcat: empty left", ("" + 9) === "9")
assert("strconcat: empty right", ("9" + "") === "9")

// Results crossing the small-string-optimization boundary: <=5 bytes stays
// inline in the value, longer ones become heap strings. Both must compare and
// concatenate the same.
assert("strconcat: sso-sized result", ("a" + 1) === "a1")
assert("strconcat: heap-sized result", ("abcdefgh" + 123456) === "abcdefgh123456")

// Accumulation in a loop — the shape `str_concat`'s extensible-buffer fast
// path exists for. Length is checked through a dynamic binding because the
// static `string` type exposes no `.length`.
function scAccum(n: int): int {
  let s = ""
  for (let i = 0; i < n; i = i + 1) { s = s + "xy" }
  return s.length
}
assert("strconcat: accumulation stays exact", scAccum(1000) === 2000)

// Chained concatenation mixing types, evaluated left to right.
function scChain(n: int): string { return "a" + n + "b" + (n + 1) }
assert("strconcat: chain mixes types left to right", scChain(1) === "a1b2")

// The Cranelift fast path builds a small-string-optimized result inline and
// falls back to the helper otherwise, so every boundary of "fits inline"
// needs pinning: exactly at the limit, one past it, and non-ASCII (which the
// SSO encoding refuses regardless of length).
assert("strconcat: result exactly at the sso limit", ("ab" + 123) === "ab123")
assert("strconcat: result one past the sso limit", ("ab" + 1234) === "ab1234")
assert("strconcat: empty + empty", ("" + "") === "")
assert("strconcat: non-ascii refuses the inline path", ("é" + 1) === "é1")
assert("strconcat: non-ascii on the right", ("a" + "ñ") === "añ")
assert("strconcat: multibyte stays correct", ("日本" + 5) === "日本5")

// Byte-order inside the packed result: `a`'s bytes must land before `b`'s, and
// an asymmetric pair is the only thing that catches them swapped. Both operands
// vary in length so every (len_a, len_b) split up to the limit is exercised.
assert("strconcat: order 1+1", ("x" + "y") === "xy")
assert("strconcat: order 1+4", ("x" + "wxyz") === "xwxyz")
assert("strconcat: order 4+1", ("wxyz" + "x") === "wxyzx")
assert("strconcat: order 2+3", ("ab" + "cde") === "abcde")
assert("strconcat: order 3+2", ("abc" + "de") === "abcde")
assert("strconcat: empty left keeps right", ("" + "abcde") === "abcde")
assert("strconcat: empty right keeps left", ("abcde" + "") === "abcde")

// Inside a hot loop, where the fast path is actually reached: results stay
// exact and comparable both to a literal and to a second concat.
function scFastLoop(n: int): int {
  let hits = 0
  for (let i = 0; i < n; i = i + 1) {
    const s = "a" + (i % 100)
    if (s === ("a" + (i % 100))) { hits = hits + 1 }
  }
  return hits
}
assert("strconcat: fast path exact in a loop", scFastLoop(50000) === 50000)

// The same loop, but straddling: half the results fit inline and half do not,
// so both arms are taken from one compiled body.
function scStraddle(n: int): int {
  let hits = 0
  for (let i = 0; i < n; i = i + 1) {
    const s = i % 2 === 0 ? ("a" + (i % 100)) : ("abcdefgh" + (i % 100))
    if (s.length > 0) { hits = hits + 1 }
  }
  return hits
}
assert("strconcat: both arms from one body", scStraddle(50000) === 50000)

print("[PASSED] 64. Typed string concat ")
