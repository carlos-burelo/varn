import { describe, it, expect } from "std:test";

async function ready(): Task<int> {
    return 1;
}

async function nativeFails(s: str): Task<int> {
    await ready();
    try {
        return int.parse(s);
    } catch (err) {
        throw new Error("replaced after native error");
    }
}

async function awaitInsideTry(s: str): Task<int> {
    try {
        await ready();
        return int.parse(s);
    } catch (err) {
        throw new Error("replaced after await in try");
    }
}

async function rethrown(s: str): Task<int> {
    await ready();
    try {
        return int.parse(s);
    } catch (err) {
        throw err;
    }
}

async function messageOf(run: () => Task<int>): Task<str> {
    try {
        return "value " + (await run()).toString();
    } catch (e) {
        return e.message;
    }
}

await describe("293 a throw inside a catch replaces the caught native error", async () => {
    await it("the new error is the one that propagates", async () => {
        expect(await messageOf(() => nativeFails("abc"))).toBe("replaced after native error");
        expect(await messageOf(() => awaitInsideTry("abc"))).toBe("replaced after await in try");
    });

    await it("a rethrown error keeps its own message", async () => {
        const message = await messageOf(() => rethrown("abc"));
        expect(message.indexOf("invalid digit") !== null).toBeTruthy();
    });

    await it("a function that succeeds is unaffected", async () => {
        expect(await messageOf(() => nativeFails("42"))).toBe("value 42");
    });
});
