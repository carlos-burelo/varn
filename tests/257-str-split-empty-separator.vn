import { describe, it, expect } from "std:test";

function splitHot(text: str, sep: str): str[] { return text.split(sep) }

await describe("257 str split empty separator", async () => {
    await it("empty separator splits into characters", () => {
        expect("abc".split("")).toEqual(["a", "b", "c"]);
        expect("a😀".split("").length).toBe(2);
        expect("".split("").length).toBe(0);
    });

    await it("non-empty separators keep their boundaries", () => {
        expect("a,b,".split(",")).toEqual(["a", "b", ""]);
        expect("".split(",")).toEqual([""]);
        expect("a--b".split("--")).toEqual(["a", "b"]);
    });

    await it("hot path agrees with the cold path", () => {
        let total = 0;
        for (let i = 0; i < 2000; i = i + 1) {
            total = total + splitHot("héllo", "").length;
        }
        expect(total).toBe(10000);
    });
});
