import { describe, it, expect } from "std:test";
import { toParts, fromParts, toISOString, fromISO } from "std:time";

class Probe {
    n: int;
    constructor(n: int) { this.n = n; }
    read(): int { return this.n; }
}

function weekdayOf(ms: int): int { return toParts(ms).weekday ?? -1; }

function manyReads(p: Probe): int {
    let t = 0;
    t = t + p.read() + p.n; t = t + p.read() + p.n; t = t + p.read() + p.n; t = t + p.read() + p.n;
    t = t + p.read() + p.n; t = t + p.read() + p.n; t = t + p.read() + p.n; t = t + p.read() + p.n;
    t = t + p.read() + p.n; t = t + p.read() + p.n; t = t + p.read() + p.n; t = t + p.read() + p.n;
    t = t + p.read() + p.n; t = t + p.read() + p.n; t = t + p.read() + p.n; t = t + p.read() + p.n;
    return t;
}

