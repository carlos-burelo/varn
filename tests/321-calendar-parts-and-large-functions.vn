function inlinedDates(base: int): int {
    let sum = 0;
    sum = sum + toParts(base).year + toParts(base + 1).month + toParts(base + 2).day;
    sum = sum + toParts(base + 3).hour + toParts(base + 4).minute + toParts(base + 5).second;
    sum = sum + toParts(base + 6).year + toParts(base + 7).month + toParts(base + 8).day;
    return sum;
}

await describe("321 calendar parts carry the weekday and big functions still compile", async () => {
    await it("toParts reports the weekday, Sunday first, also before 1970", async () => {
        expect(weekdayOf(0)).toBe(4);
        expect(weekdayOf(-1)).toBe(3);
        expect(weekdayOf(-62135596800000)).toBe(1);
        expect(weekdayOf(253402300799999)).toBe(5);
        expect(weekdayOf(951782400000)).toBe(2);
    });

    await it("parts round-trip across leap years and century boundaries", async () => {
        for (const ms of [951782400000, 4107542400000, -2203891200000, -62135596800000, 253402300799999]) {
            expect(fromParts(toParts(ms))).toBe(ms);
            expect(fromISO(toISOString(ms))).toBe(ms);
        }
        expect(toISOString(951782400000)).toBe("2000-02-29T00:00:00.000Z");
        expect(toParts(4107542400000).day).toBe(1);
    });

    await it("an offset in an ISO text is applied", async () => {
        expect(fromISO("2024-02-29T12:30:45+05:30")).toBe(fromISO("2024-02-29T07:00:45Z"));
        expect(fromISO("2024-01-01T00:00:00-08:00")).toBe(fromISO("2024-01-01T08:00:00Z"));
    });

    await it("a function whose property and method sites exceed the cache still runs", async () => {
        const probe = new Probe(3);
        expect(manyReads(probe)).toBe(96);
        let total = 0;
        for (let i = 0; i < 40; i++) {
            total = total + inlinedDates(1700000000000 + i * 86400000);
        }
        expect(total > 0).toBe(true);
        const holder: { x: int } = { x: 2 };
        expect(dynamicReads(holder)).toBe(600);
    });
});
