import { describe, it, expect } from "std:test";

interface Address {
    city: str
    zip?: int
}
interface Profile {
    name: str
    address?: Address
}

await describe("08 Null Safety", async () => {
    await it("optional chaining", () => {
        const p1: Profile? = { name: "Alice", address: { city: "NY" } };
        const p2: Profile? = { name: "Bob" };
        const p3: Profile? = null;
        expect(p1?.address?.city).toBe("NY");
        expect(p2?.address?.city).toBe(null);
        expect(p3?.name).toBe(null);
    });

    await it("nullish coalescing", () => {
        const p2: Profile? = { name: "Bob" };
        const p3: Profile? = null;
        expect(42 ?? 0).toBe(42);
        expect(null ?? 99).toBe(99);
        expect(p3?.name ?? "anon").toBe("anon");
        expect(p2?.address?.city ?? "dynamic").toBe("dynamic");
        expect(null ?? null ?? 7).toBe(7);
    });
});
