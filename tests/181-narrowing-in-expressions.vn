import { describe, it, expect } from "std:test";

class Step {
    next: Step? = null
    weight: int = 1
}

function sizeOf(m: Map<str, int>?): int { return m == null ? 0 : m.size }
function lengthOf(s: str?): int { return s != null ? s.length : 0 }
function lengthOrZero(s: str?): int { return s == null ? 0 : s.length }
function successor(x: int?): int { return x != null ? x + 1 : 0 }
function nonEmpty(s: str?): bool { return s != null && s.length > 0 }
function blank(s: str?): bool { return s == null || s.length == 0 }
function depth(step: Step?): int { return step == null ? 0 : 1 + depth(step.next) }
function widthOf(v: str | int[]): int { return v is str ? v.slice(0, 1).length : v.length }
function heavy(step: Step?): bool { return step != null && step.weight > 0 && step.next == null }

await describe("181 narrowing in expressions", async () => {
    await it("the conditional operator narrows each branch", () => {
        const m = new Map<str, int>()
        m.set("k", 1)
        expect(sizeOf(m)).toBe(1)
        expect(sizeOf(null)).toBe(0)
        expect(lengthOf("ab")).toBe(2)
        expect(lengthOf(null)).toBe(0)
        expect(lengthOrZero("abc")).toBe(3)
        expect(lengthOrZero(null)).toBe(0)
        expect(successor(1)).toBe(2)
        expect(successor(null)).toBe(0)
    })

    await it("an is test opens a conditional whose branch holds a call", () => {
        expect(widthOf("abc")).toBe(1)
        expect(widthOf([1, 2, 3])).toBe(3)
    })

    await it("&& narrows its right side when the left holds", () => {
        expect(nonEmpty("x")).toBe(true)
        expect(nonEmpty("")).toBe(false)
        expect(nonEmpty(null)).toBe(false)
        const chain = new Step()
        expect(heavy(chain)).toBe(true)
        chain.next = new Step()
        expect(heavy(chain)).toBe(false)
        expect(heavy(null)).toBe(false)
    })

    await it("|| narrows its right side when the left fails", () => {
        expect(blank(null)).toBe(true)
        expect(blank("")).toBe(true)
        expect(blank("x")).toBe(false)
    })

    await it("narrowing reaches a recursive call", () => {
        const root = new Step()
        root.next = new Step()
        expect(depth(root)).toBe(2)
        expect(depth(null)).toBe(0)
    })

    await it("holds in a hot loop", () => {
        let acc = 0
        for (let i = 0; i < 5000; i = i + 1) { acc = acc + lengthOf("ab") + lengthOrZero(null) + successor(i) }
        expect(acc).toBe(12512500)
    })
})
