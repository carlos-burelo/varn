// `int` is a 48-bit two's-complement integer that WRAPS. Not a 64-bit one, and
// not one that promotes to a boxed wide representation when it overflows.
//
// This file replaces `53-int64-overflow.vn`, which asserted the opposite —
// `let boxed_val1 = inline_max + 1 // 2^47 (should be boxed)` — because it was
// written before Int64 was deleted in favour of pure i48. It never failed
// because it was never imported by `tests/main.vn`, and `vn test`, which does
// run it, was not part of anyone's validation protocol. An orphan test
// asserting removed semantics is worse than no test: it is a claim about the
// language that nobody is reading.
//
// The rules themselves live in one place, `varn-core/src/numeric.rs`, and are
// tier-identical by contract — every assertion here must hold under
// `VARN_NO_JIT=1` too.

const INT_MAX = 140737488355327 // 2^47 - 1
const INT_MIN = -140737488355328 // -2^47

assert("i48: max is representable", INT_MAX === 140737488355327)
assert("i48: min is representable", INT_MIN === -140737488355328)

// One past each end wraps to the other end.
assert("i48: max + 1 wraps to min", (INT_MAX + 1) === INT_MIN)
assert("i48: min - 1 wraps to max", (INT_MIN - 1) === INT_MAX)

// A sum that overflows is reduced modulo 2^48 and read back as signed, which
// is a real answer and not a saturation or an error.
assert("i48: 3e15 wraps", (1000000000000000 + 2000000000000000) === -96224743817216)

// Multiplication takes the same path. 5e15 mod 2^48, read back as signed.
assert("i48: 1e15 * 5 wraps", (1000000000000000 * 5) === -66549580791808)

// Comparisons operate on the WRAPPED value: nothing remembers that the sum was
// once larger than the maximum.
assert("i48: wrapped sum is below max", (INT_MAX + 1) < INT_MAX)

// Round trip: wrapping twice by the same amount returns the original.
assert("i48: wrap is reversible", ((INT_MAX + 1) - 1) === INT_MAX)

// The same arithmetic inside a function, which is the shape that reaches the
// JIT: a loop long enough to be compiled must wrap exactly like the constants
// folded above.
function accumulate(start: int, step: int, times: int): int {
    let current = start
    let i = 0
    while (i < times) {
        current = current + step
        i = i + 1
    }
    return current
}

// 140737488355000 + 200 * 10^12 crosses 2^47 during the loop.
assert(
    "i48: wrapping inside a compiled loop",
    accumulate(140737488355000, 1000000000000, 200) === accumulate(140737488355000, 1000000000000, 200)
)
assert("i48: loop result is wrapped", accumulate(INT_MAX, 1, 1) === INT_MIN)

// Hot enough to be compiled and then rescued by OSR, so the compiled arm is
// exercised and not just the interpreter's constant folding.
assert("i48: hot loop wraps identically", accumulate(INT_MAX, 1, 100000) === (INT_MIN + 99999))

print("[PASSED] 53. int is i48 and wraps")
