import { describe, it, expect } from "std:test";

function lengths(xs: str[]): int[] {
    let out: int[] = [];
    for (let r = 0; r < 300; r = r + 1) {
        out = [];
        for (let i = 0; i < xs.length; i = i + 1) { out.push(xs[i].length); }
    }
    return out;
}

function builtLength(n: int): int {
    let t = 0;
    for (let i = 0; i < n; i = i + 1) {
        let s = "ñ" + (i % 10);
        t = t + s.length + ("é" + "é").length;
    }
    return t;
}

await describe("161 string length counts characters", async () => {
    await it("is the same rule for short and long strings", () => {
        const got = lengths(["", "a", "ñ", "ñá", "aé", "abcde", "ñab", "👍", "€", "€a", "ñandú", "👍👍", "añb€"]);
        const want = [0, 1, 1, 2, 2, 5, 3, 1, 1, 2, 5, 2, 4];
        for (let i = 0; i < want.length; i = i + 1) { expect(got[i]).toBe(want[i]); }
    });

    await it("holds for strings built at runtime", () => {
        expect(builtLength(2000)).toBe(8000);
    });

    await it("agrees with indexOf, slice and charCodeAt", () => {
        expect("ñb".indexOf("b")).toBe(1);
        expect("ñá€".indexOf("€")).toBe(2);
        expect("ñab".slice(1).length).toBe(2);
        expect("€a".charCodeAt(1)).toBe(97);
    });
});
