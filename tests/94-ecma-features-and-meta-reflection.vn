import { Reflect } from "std:reflect";
import { describe, it, expect } from "std:test";

// Test Suite 94: Reflection Operator (::), Logical Assignments, Do-While, and Destructuring Defaults

class SampleUser {
    name: str = "Alice";
    age: int = 30;
    role: str = "Admin";

    constructor(name: str, age: int, role: str) {
        this.name = name;
        this.age = age;
        this.role = role;
    }

    greet(): str {
        return "Hello, " + this.name;
    }

    save(): bool {
        return true;
    }
}

class ProductWithCollisions {
    name: str = "Laptop";
    type: str = "Hardware";
    class: str = "Premium";
    keys: str[] = ["serial", "sku"];
}

const prod = new ProductWithCollisions();
let nval: str? = null;
await describe("94 ecma features and meta reflection", async () => {
    await it("Type-level reflection via Class::name, / Instance reflection: instance::type an / Instan", async () => {
        const className = SampleUser::name;
        expect(className).toBe("SampleUser");
        const fields = SampleUser::fields;
        expect(fields.length).toBe(3);
        expect(fields[0]).toBe("name");
        expect(fields[1]).toBe("age");
        expect(fields[2]).toBe("role");
        const methods = SampleUser::methods;
        expect(methods.includes("greet")).toBe(true);
        expect(methods.includes("save")).toBe(true);
        

        const u = new SampleUser("Bob", 25, "User");
        expect(u::type).toBe("SampleUser");
        const cls = u::class;
        expect(cls !== null).toBe(true);
        expect(cls::name).toBe("SampleUser");
        

        const plainObj = { x: 10, y: 20, label: "Point" };
        expect(plainObj::type).toBe("Object");
        const keys = plainObj::keys();
        expect(keys.length).toBe(3);
        expect(keys[0]).toBe("x");
        expect(keys[1]).toBe("y");
        expect(keys[2]).toBe("label");
        const vals = plainObj::values();
        expect(vals.length).toBe(3);
        expect(vals[0]).toBe(10);
        expect(vals[1]).toBe(20);
        expect(vals[2]).toBe("Point");
        const entries = plainObj::entries();
        expect(entries.length).toBe(3);
        expect(entries[0][0]).toBe("x");
        expect(entries[0][1]).toBe(10);
        expect(plainObj::hasOwn("x")).toBe(true);
        expect(plainObj::hasOwn("z")).toBe(false);
        

        expect(prod.name).toBe("Laptop");
        expect(prod.type).toBe("Hardware");
        expect(prod.class).toBe("Premium");
        expect(prod.keys.length).toBe(2);
        expect(prod.keys[0]).toBe("serial");
    
    });

    await it("prod reflection metadata / Primitive and record type reflection / Reflect helper methods", async () => {
        expect(prod::type).toBe("ProductWithCollisions");
        const metaKeys = prod::keys();
        expect(metaKeys.length).toBe(4);
        expect(metaKeys.includes("name")).toBe(true);
        expect(metaKeys.includes("type")).toBe(true);
        expect(metaKeys.includes("class")).toBe(true);
        expect(metaKeys.includes("keys")).toBe(true);
        expect(prod::hasOwn("serial")).toBe(false);
        expect(prod::hasOwn("name")).toBe(true);
        

        const num = 42;
        expect(num::type).toBe("int");
        const strVal = "hello";
        expect(strVal::type).toBe("str");
        const boolVal = true;
        expect(boolVal::type).toBe("bool");
        const arrVal = [1, 2, 3];
        expect(arrVal::type).toBe("Array");
        

        const obj = { a: 100, b: "test" };
        expect(Reflect.typeOf(obj)).toBe("Object");
        const k = Reflect.keys(obj);
        expect(k.length).toBe(2);
        expect(k[0]).toBe("a");
        expect(k[1]).toBe("b");
        const v = Reflect.values(obj);
        expect(v[0]).toBe(100);
        expect(v[1]).toBe("test");
        expect(Reflect.hasOwn(obj, "a")).toBe(true);
        expect(Reflect.hasOwn(obj, "missing")).toBe(false);
        

        let count = 0;
        do {
        count = count + 1;
        } while (false);
        expect(count).toBe(1);
        
    });

    await it("Iterates while condition holds / Supports break and continue / Logical AND assignment (`", async () => {
        let sum = 0;
        let i = 1;
        do {
        sum = sum + i;
        i = i + 1;
        } while (i <= 5);
        expect(sum).toBe(15);
        

        let sum2 = 0;
        let j = 0;
        do {
        j = j + 1;
        if (j === 3) {
        continue;
        }
        if (j > 5) {
        break;
        }
        sum2 = sum2 + j;
        } while (j < 10);
                expect(sum2).toBe(1 + 2 + 4 + 5);; // 12
        

        let a = true;
        a &&= false;
        expect(a).toBe(false);
        let b = false;
        b &&= true;
        expect(b).toBe(false);
        

        let x = false;
        x ||= true;
        expect(x).toBe(true);
        let y = true;
        y ||= false;
        expect(y).toBe(true);
        
    });

    await it("Power assignment (`**=`) / Nullish coalescing assignment (`??=`) / Object destructuring ", async () => {
        let p = 2;
        p **= 8;
        expect(p).toBe(256);
        

        nval ??= "initialized";
        expect(nval).toBe("initialized");
        nval ??= "ignored";
        expect(nval).toBe("initialized");
    

        const config: dynamic = { host: "127.0.0.1" };
        const { host = "localhost", port = 8080 } = config;
        expect(host).toBe("127.0.0.1");
        expect(port).toBe(8080);
        

        const items = [100];
        const [first = 0, second = 200, third = 300] = items;
        expect(first).toBe(100);
        expect(second).toBe(200);
        expect(third).toBe(300);
        
    });

    await it("str.repeat(n) / str.padStart(len, pad) / str.padEnd(len, pad)", async () => {
        const s = "abc";
        expect(s.repeat(3)).toBe("abcabcabc");
        expect(s.repeat(0)).toBe("");
        

        const sPad = "42";
        expect(sPad.padStart(5, "0")).toBe("00042");
        expect(sPad.padStart(2, "0")).toBe("42");
        

        const sEnd = "42";
        expect(sEnd.padEnd(5, "!")).toBe("42!!!");
        
    });

        

});
