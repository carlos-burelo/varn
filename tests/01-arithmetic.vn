import { describe, it, expect } from "std:test";

await describe("01 Arithmetic", async () => {
    await it("int arithmetic", () => {
        expect(1 + 2).toBe(3);
        expect(3 - 5).toBe(-2);
        expect(42 * 0).toBe(0);
        expect(10 / 2).toBe(5);
        expect(17 % 5).toBe(2);
        expect(-7 % 3).toBe(-1);
        expect(2 ** 10).toBe(1024);
        expect(-9223372036854775808).toBe(0 - 9223372036854775807 - 1);
        expect(9223372036854775807).toBe(0 + 9223372036854775807);
    });

    await it("float arithmetic", () => {
        expect(0.1 + 0.2 > 0.29 && 0.1 + 0.2 < 0.31).toBeTruthy();
        expect(1.0 / 3.0 > 0.333 && 1.0 / 3.0 < 0.334).toBeTruthy();
    });

    await it("precedence and bitwise", () => {
        expect(-(5)).toBe(-5);
        expect(-(-3)).toBe(3);
        expect(2 + 3 * 4).toBe(14);
        expect((2 + 3) * 4).toBe(20);
        expect(12 & 10).toBe(8);
        expect(12 | 3).toBe(15);
        expect(12 ^ 10).toBe(6);
        expect(~0).toBe(-1);
        expect(1 << 4).toBe(16);
        expect(64 >> 2).toBe(16);
    });
});
