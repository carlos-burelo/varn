import { describe, it, expect } from "std:test";

function continueThenTry(a: int): int {
    let v0 = a;
    for (let i = 0; i < 4; i++) {
        if (4 < v0 + 1) {
            continue;
        }
    }
    try {
    } catch (e) {
    }
    return v0;
}

function continueCounting(n: int): int {
    let total = 0;
    for (let i = 0; i < n; i++) {
        if (i < 0) {
            continue;
        }
        total += i;
    }
    return total;
}

await describe("328 loop header with a redundant branch", async () => {
    await it("a loop whose back edge is a branch to one target is kept", async () => {
        expect(continueThenTry(3)).toBe(3);
        expect(continueThenTry(9)).toBe(9);
    });
    await it("a loop with a continue still accumulates", async () => {
        expect(continueCounting(5)).toBe(10);
    });
});
