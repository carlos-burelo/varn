import { describe, it, expect } from "std:test";

// Calls and storage classes in the JIT's lowering from typed SSA. Each
// function below runs well past the tiering threshold, so it executes
// compiled; every assertion compares against what the interpreter computes.
//
// Pinned here:
// - a call whose result is a heap value (a `str`) lands in its home, so a
//   later read of it sees the call's result;
// - a scalar that flows into a `dynamic` value is boxed, not stored raw;
// - heap values pass as call arguments and arrive as heap parameters;
// - a call whose result nobody reads still runs;
// - `length` of a value statically typed `str` is its own instruction;
// - a function whose parameters are heap values (`str`, a class, an array)
//   compiles and reads them from their homes;
// - a frame-aware function recursing on itself with heap arguments, under
//   enough allocation that collections run while its argument window is in
//   flight.

function sscLabel(n: int): str {
    return "label-long-enough-for-the-heap-" + n
}

// Heap result of a call, read after the call.
function sscDecorated(n: int): str {
    const s = sscLabel(n)
    const t = s + "!"
    return t
}

// An `int` entering a `dynamic`.
function sscBoxed(n: int): dynamic {
    const d: dynamic = n
    return d
}

// Heap arguments and heap parameters.
function sscJoin(a: str, b: str): str {
    return a + "|" + b
}
function sscJoinCaller(n: int): str {
    const left = sscLabel(n)
    return sscJoin(left, "right")
}

// A call whose result is discarded.
let sscHits = 0
function sscCount(n: int): int {
    sscHits = sscHits + n
    return sscHits
}
function sscIgnore(n: int): int {
    sscCount(n)
    return n
}

// Heap parameters of a compiled function, including one read after a call.
class SscPoint {
    x: int
    constructor(x: int) {
        this.x = x
    }
}
function sscHeapParams(label: str, p: SscPoint, xs: int[]): int {
    const n = sscLabel(p.x)
    return label.length + p.x + xs[1] + n.length
}

// Frame-aware self-recursion carrying heap values.
function sscChain(prefix: str, parts: str[], n: int): str {
    if (n == 0) {
        return prefix + parts.length
    }
    parts.push("part-long-enough-for-the-heap-" + n)
    return sscChain(prefix + n, parts, n - 1)
}

// `str.length` in a compiled body.
function sscLabelLength(n: int): int {
    const s = sscLabel(n)
    return s.length
}

let sscLastDecorated = ""
let sscBoxedSum = 0
let sscLastJoined = ""
let sscLengths = 0
let sscChainLast = ""
const sscPoint = new SscPoint(7)
const sscXs = [1, 2, 3]
let sscParamSum = 0

// 31 chars of prefix plus the digits of 0..2999: 10 + 90*2 + 900*3 + 2000*4.
for (let sscI = 0; sscI < 3000; sscI = sscI + 1) {
    sscLastDecorated = sscDecorated(sscI)
    sscBoxedSum = sscBoxedSum + (sscBoxed(sscI) as int)
    sscLastJoined = sscJoinCaller(sscI)
    sscIgnore(1)
    sscLengths = sscLengths + sscLabelLength(sscI)
}
for (let sscJ = 0; sscJ < 2000; sscJ = sscJ + 1) {
    const sscParts: str[] = []
    sscChainLast = sscChain("c", sscParts, 20)
}
for (let sscK = 0; sscK < 3000; sscK = sscK + 1) {
    sscParamSum = sscParamSum + sscHeapParams("abc", sscPoint, sscXs)
}
await describe("141 jit ssa calls", async () => {
    await it("group 1 part 1", async () => {
        expect(sscLastDecorated == "label-long-enough-for-the-heap-2999!").toBeTruthy();
        expect(sscBoxedSum).toBe(4498500);
        expect(sscLastJoined == "label-long-enough-for-the-heap-2999|right").toBeTruthy();
        expect(sscHits).toBe(3000);
    });

    await it("group 1 part 2", async () => {
        expect(sscChainLast == "c2019181716151413121110987654321" + "20").toBeTruthy();
        expect(sscParamSum).toBe(3000 * (3 + 7 + 2 + 32));
        expect(sscLengths).toBe(3000 * 31 + 10 + 180 + 2700 + 8000);
    });


});
