import { describe, it, expect } from "std:test";
import {
    UiWindow, UiFrame, Focus, Widget, Size, PaintContext,
    ui, Row, Column, Button, Spacer, Expanded, Label, Box, Divider,
    MainAxis, CrossAxis, Alignment, render
} from "std:ui";

function rects(win: UiWindow): float[][] {
    const out: float[][] = [];
    for (const cmd of win.commands()) {
        const parts = cmd.split(" ");
        if (parts[0] == "rect") {
            out.push([float.parse(parts[1]), float.parse(parts[2]), float.parse(parts[3]), float.parse(parts[4])]);
        }
    }
    return out;
}

function paintAt(tree: Widget, w: float, h: float): float[][] {
    using win = UiWindow.open("layout", 800, 600);
    render(win, new UiFrame(800, 600), new Focus(), tree, 0.0, 0.0, w, h);
    return rects(win);
}

await describe("232 ui layout", async () => {
    await it("a button is as wide as its label, not as its parent", () => {
        const drawn = paintAt(Column([Button("ok", onPress: () => {})]), 800.0, 600.0);
        expect(drawn.length).toBe(1);
        expect(drawn[0][0]).toBe(0.0);
        expect(drawn[0][2] < 120.0).toBe(true);
        expect(drawn[0][3]).toBe(40.0);
    });

    await it("a column stacks children by their own height", () => {
        const drawn = paintAt(Column([
            Box(h: 30.0, w: 100.0, color: 0xFFFFFFFF),
            Box(h: 50.0, w: 100.0, color: 0xFFFFFFFF)
        ], gap: 10.0), 800.0, 600.0);
        expect(drawn[0][1]).toBe(0.0);
        expect(drawn[1][1]).toBe(40.0);
        expect(drawn[1][3]).toBe(50.0);
    });

    await it("spaceBetween pushes the last child to the end", () => {
        const drawn = paintAt(Row([
            Box(w: 50.0, h: 20.0, color: 0xFFFFFFFF),
            Box(w: 50.0, h: 20.0, color: 0xFFFFFFFF)
        ], mainAxis: MainAxis.spaceBetween), 400.0, 100.0);
        expect(drawn[0][0]).toBe(0.0);
        expect(drawn[1][0]).toBe(350.0);
    });

    await it("an expanded child takes what the others leave", () => {
        const drawn = paintAt(Row([
            Box(w: 100.0, h: 20.0, color: 0xFFFFFFFF),
            Expanded(Box(h: 20.0, color: 0xFFFFFFFF)),
            Box(w: 100.0, h: 20.0, color: 0xFFFFFFFF)
        ], gap: 10.0), 500.0, 100.0);
        expect(drawn[1][0]).toBe(110.0);
        expect(drawn[1][2]).toBe(280.0);
        expect(drawn[2][0]).toBe(400.0);
    });

    await it("a spacer pushes siblings apart like an expanded gap", () => {
        const drawn = paintAt(Row([
            Box(w: 40.0, h: 20.0, color: 0xFFFFFFFF),
            Spacer(),
            Box(w: 40.0, h: 20.0, color: 0xFFFFFFFF)
        ]), 300.0, 100.0);
        expect(drawn[1][0]).toBe(260.0);
    });

    await it("cross axis centers or stretches", () => {
        const centered = paintAt(Column([Box(w: 100.0, h: 20.0, color: 0xFFFFFFFF)], crossAxis: CrossAxis.center), 300.0, 100.0);
        expect(centered[0][0]).toBe(100.0);
        const stretched = paintAt(Column([Box(h: 20.0, color: 0xFFFFFFFF)], crossAxis: CrossAxis.stretch), 300.0, 100.0);
        expect(stretched[0][2]).toBe(300.0);
    });

    await it("a card wraps its content and pads it", () => {
        const drawn = paintAt(ui.column(children: [
            ui.card(padding: 10.0, child: Box(w: 80.0, h: 30.0, color: 0xFFFFFFFF))
        ]), 800.0, 600.0);
        expect(drawn[0][2]).toBe(100.0);
        expect(drawn[0][3]).toBe(50.0);
        expect(drawn[1][0]).toBe(10.0);
        expect(drawn[1][1]).toBe(10.0);
    });

    await it("a stack aligns children inside its box", () => {
        const drawn = paintAt(ui.stack(alignment: Alignment.bottomRight, children: [
            Box(w: 200.0, h: 100.0, color: 0xFFFFFFFF),
            Box(w: 20.0, h: 20.0, color: 0xFF000000)
        ]), 200.0, 100.0);
        expect(drawn[1][0]).toBe(180.0);
        expect(drawn[1][1]).toBe(80.0);
    });

    await it("a divider fills the width", () => {
        const drawn = paintAt(Column([Divider()], crossAxis: CrossAxis.stretch), 640.0, 100.0);
        expect(drawn[0][2]).toBe(640.0);
        expect(drawn[0][3]).toBe(1.0);
    });
});
