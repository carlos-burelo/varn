import { describe, it, expect } from "std:test";



// 1. Narrowing con x !== null
function processOptional(val: str?): int {
    if (val !== null) {
        // 'val' se reduce a 'str' automáticamente; .length es válido sin error
        return val.length;
    }
    return 0;
}

// 2. Narrowing con null !== x
function processInverted(val: str?): int {
    if (null !== val) {
        return val.length;
    }
    return -1;
}

// 3. Narrowing con Truthiness: if (val)
function processTruthy(val: str?): bool {
    if (val) {
        return val.length > 0;
    }
    return false;
}

// 4. Narrowing con typeof
function processTypeof(val: dynamic): str {
    if (typeof val === "str") {
        return val.toUpperCase();
    } else if (typeof val === "int") {
        return "number:" + val;
    }
    return "other";
}

// 5. Narrowing con Instanceof
class Animal {
    name: str;
    constructor(name: str) {
        this.name = name;
    }
}

class Dog extends Animal {
    bark(): str {
        return "woof";
    }
}

function speak(a: Animal): str {
    if (a instanceof Dog) {
        return a.bark();
    }
    return a.name;
}
let a = new Animal("Generic");
await describe("79 control flow narrowing", async () => {
    await it("tests", async () => {
        
        expect(processOptional("hello")).toBe(5);
        expect(processOptional(null)).toBe(0);
        
        expect(processInverted("varn")).toBe(4);
        expect(processInverted(null)).toBe(-1);
        
        expect(processTruthy("active")).toBe(true);
        expect(processTruthy(null)).toBe(false);
        
        expect(processTypeof("abc")).toBe("ABC");
        expect(processTypeof(42)).toBe("number:42");
        
        let d = new Dog("Rex");
        
        expect(speak(d)).toBe("woof");
        expect(speak(a)).toBe("Generic");
        
        
    });
});
