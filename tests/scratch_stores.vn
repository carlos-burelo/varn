function greet(name: str, greeting: str = "Hello"): str {
  return greeting + ", " + name
}
function makeCounter(): () => int {
  let count = 0
  return () => {
    count = count + 1
    return count
  }
}
print(greet("World"))
print(greet("World", "Hi"))
const c = makeCounter()
print(c())
print(c())
print(c())
