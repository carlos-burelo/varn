
print("HELLO FROM TOP OF FILE")
// ── Generic with constraint via interface ─────────────────────────
interface Comparable<T> {
    compareTo(other: T): int
}

class SortedPair<T> {
    first: T
    second: T
    constructor(a: T, b: T) {
        this.first = a
        this.second = b
    }
    swap(): SortedPair<T> {
        return new SortedPair<T>(this.second, this.first)
    }
    map<U>(f: (T) => U): SortedPair<U> {
        return new SortedPair<U>(f(this.first), f(this.second))
    }
    toArray(): T[] {
        return [this.first, this.second]
    }
}

const p = new SortedPair<int>(1, 2)
assert("pair first",       p.first === 1)
assert("pair second",      p.second === 2)
const ps = p.swap()
assert("pair swap first",  ps.first === 2)
assert("pair swap second", ps.second === 1)
const pm = p.map((x) => x * 10)
assert("pair map first",   pm.first === 10)
assert("pair map second",  pm.second === 20)
const pa = p.toArray()
assert("pair toArray len", pa.length === 2)
assert("pair toArray[0]",  pa[0] === 1)

// ── Nested generics ──────────────────────────────────────────────
class Either<L, R> {
    private _left: L | null
    private _right: R | null
    private _isLeft: bool
    constructor(left: L | null, right: R | null, isLeft: bool) {
        this._left = left
        this._right = right
        this._isLeft = isLeft
    }
    static left<L, R>(v: L): Either<L, R> {
        return new Either<L, R>(v, null, true)
    }
    static right<L, R>(v: R): Either<L, R> {
        return new Either<L, R>(null, v, false)
    }
    isLeft(): bool { return this._isLeft }
    isRight(): bool { return !this._isLeft }
    getLeft(): L | null { return this._left }
    getRight(): R | null { return this._right }
    mapRight<T>(f: (R) => T): Either<L, T> {
        if (this._isLeft) return new Either<L, T>(this._left, null, true)
        return new Either<L, T>(null, f(this._right!), false)
    }
}

const left = Either.left<str, int>("error")
assert("either isLeft",      left.isLeft())
assert("either not isRight", !left.isRight())
assert("either getLeft",     left.getLeft() === "error")
assert("either getRight null", left.getRight() === null)

const right = Either.right<str, int>(42)
assert("either isRight",     right.isRight())
assert("either getRight",    right.getRight() === 42)

const mapped = right.mapRight((n) => n * 2)
assert("either mapRight",    mapped.getRight() === 84)

const leftMapped = left.mapRight((n) => n * 2)
assert("either mapRight left pass-through", leftMapped.isLeft())

// ── Generic recursive type (linked list) ─────────────────────────
class Cons<T> {
    head: T
    tail: Cons<T> | null
    constructor(h: T, t: Cons<T> | null) {
        this.head = h
        this.tail = t
    }
    length(): int {
        let n = 0
        let cur: Cons<T> | null = this
        while (cur !== null) {
            n = n + 1
            cur = cur.tail
        }
        return n
    }
    toArray(): T[] {
        const arr: T[] = []
        let cur: Cons<T> | null = this
        while (cur !== null) {
            arr.push(cur.head)
            cur = cur.tail
        }
        return arr
    }
}

const list = new Cons<int>(1, new Cons<int>(2, new Cons<int>(3, null)))
assert("cons length",       list.length() === 3)
const arr = list.toArray()
assert("cons toArray[0]",   arr[0] === 1)
assert("cons toArray[1]",   arr[1] === 2)
assert("cons toArray[2]",   arr[2] === 3)

// ── Generic HOF (higher-order functions) ─────────────────────────
function pipe<A, B, C>(f: (A) => B, g: (B) => C): (A) => C {
    return (x: A) => g(f(x))
}

function flip<A, B, C>(f: (A, B) => C): (B, A) => C {
    return (b: B, a: A) => f(a, b)
}

const toStr = (n: int) => `${n}`
const addBang = (s: str) => s + "!"
const numToExclaim = pipe(toStr, addBang)
assert("pipe result",       numToExclaim(42) === "42!")

const sub = (a: int, b: int) => a - b
const flippedSub = flip(sub)
assert("flip result",       flippedSub(3, 10) === 7)

// ── Generic memoize ──────────────────────────────────────────────
function memoize<T>(f: (a:int) => T): (int) => T {
    const cache: T[] = []
    const seen: bool[] = []
    return (n: int) => {
        if (n < seen.length && seen[n]) return cache[n]
        const result = f(n)
        while (cache.length <= n) { cache.push(result); seen.push(false) }
        cache[n] = result
        seen[n] = true
        return result
    }
}

let callCount = 0
const expensiveFib = memoize((n) => {
    callCount = callCount + 1
    if (n <= 1) return n
    return n
})
expensiveFib(5)
print("after 1:", callCount)
expensiveFib(5)
print("after 2:", callCount)
expensiveFib(5)
print("after 3:", callCount)
print("DEBUG callCount =", callCount)
assert("memoize called once", callCount === 1)

// ── Generic counter factory ───────────────────────────────────────
function makeAccumulator<T>(init: T, combine: (T, T) => T): (v: T) => T {
    let state = init
    return (v: T) => {
        state = combine(state, v)
        return state
    }
}

const sumAcc = makeAccumulator<int>(0, (a, b) => a + b)
sumAcc(5)
sumAcc(3)
const total = sumAcc(2)
assert("accumulator sum",    total === 10)

const strAcc = makeAccumulator<str>("", (a, b) => a + b)
strAcc("foo")
strAcc("bar")
const built = strAcc("!")
assert("accumulator str",    built === "foobar!")

print("[PASSED] 36. Advanced generics")