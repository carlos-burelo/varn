import { describe, it, expect } from "std:test";



interface Comparable<T> {
    compareTo(other: T): int
}

class SortedPair<T> {
    first: T
    second: T
    constructor(a: T, b: T) {
        this.first = a
        this.second = b
    }
    swap(): SortedPair<T> {
        return new SortedPair<T>(this.second, this.first)
    }
    map<U>(f: (T) => U): SortedPair<U> {
        return new SortedPair<U>(f(this.first), f(this.second))
    }
    toArray(): T[] {
        return [this.first, this.second]
    }
}

// ── Nested generics ──────────────────────────────────────────────
class Either<L, R> {
    private _left: L | null
    private _right: R | null
    private _isLeft: bool
    constructor(left: L | null, right: R | null, isLeft: bool) {
        this._left = left
        this._right = right
        this._isLeft = isLeft
    }
    static left<L, R>(v: L): Either<L, R> {
        return new Either<L, R>(v, null, true)
    }
    static right<L, R>(v: R): Either<L, R> {
        return new Either<L, R>(null, v, false)
    }
    isLeft(): bool { return this._isLeft }
    isRight(): bool { return !this._isLeft }
    getLeft(): L | null { return this._left }
    getRight(): R | null { return this._right }
    mapRight<T>(f: (R) => T): Either<L, T> {
        if (this._isLeft) return new Either<L, T>(this._left, null, true)
        return new Either<L, T>(null, f(this._right!), false)
    }
}

const left = Either.left<str, int>("error")

const right = Either.right<str, int>(42)

// ── Generic recursive type (linked list) ─────────────────────────
class Cons<T> {
    head: T
    tail: Cons<T> | null
    constructor(h: T, t: Cons<T> | null) {
        this.head = h
        this.tail = t
    }
    length(): int {
        let n = 0
        let cur: Cons<T> | null = this
        while (cur !== null) {
            n = n + 1
            cur = cur.tail
        }
        return n
    }
    toArray(): T[] {
        const arr: T[] = []
        let cur: Cons<T> | null = this
        while (cur !== null) {
            arr.push(cur.head)
            cur = cur.tail
        }
        return arr
    }
}

const list = new Cons<int>(1, new Cons<int>(2, new Cons<int>(3, null)))
const arr = list.toArray()

// ── Generic HOF (higher-order functions) ─────────────────────────
function pipe<A, B, C>(f: (A) => B, g: (B) => C): (A) => C {
    return (x: A) => g(f(x))
}

function flip<A, B, C>(f: (A, B) => C): (B, A) => C {
    return (b: B, a: A) => f(a, b)
}

// ── Generic memoize ──────────────────────────────────────────────
function memoize<T>(f: (a:int) => T): (int) => T {
    const cache: T[] = []
    const seen: bool[] = []
    return (n: int) => {
        if (n < seen.length && seen[n]) return cache[n]
        const result = f(n)
        while (cache.length <= n) { cache.push(result); seen.push(false) }
        cache[n] = result
        seen[n] = true
        return result
    }
}

// ── Generic counter factory ───────────────────────────────────────
function makeAccumulator<T>(init: T, combine: (T, T) => T): (v: T) => T {
    let state = init
    return (v: T) => {
        state = combine(state, v)
        return state
    }
}
await describe("36 advanced generics", async () => {
    await it("tests", async () => {
        
        const p = new SortedPair<int>(1, 2)
        expect(p.first).toBe(1)
        expect(p.second).toBe(2)
        const ps = p.swap()
        expect(ps.first).toBe(2)
        expect(ps.second).toBe(1)
        const pm = p.map((x) => x * 10)
        expect(pm.first).toBe(10)
        expect(pm.second).toBe(20)
        const pa = p.toArray()
        expect(pa.length).toBe(2)
        expect(pa[0]).toBe(1)
        expect(left.isLeft()).toBeTruthy()
        expect(!left.isRight()).toBeTruthy()
        expect(left.getLeft()).toBe("error")
        expect(left.getRight()).toBe(null)
        expect(right.isRight()).toBeTruthy()
        expect(right.getRight()).toBe(42)
        
        const mapped = right.mapRight((n) => n * 2)
        expect(mapped.getRight()).toBe(84)
        
        const leftMapped = left.mapRight((n) => n * 2)
        expect(leftMapped.isLeft()).toBeTruthy()
        expect(list.length()).toBe(3)
        expect(arr[0]).toBe(1)
        expect(arr[1]).toBe(2)
        expect(arr[2]).toBe(3)
        
        const toStr = (n: int) => `${n}`
        const addBang = (s: str) => s + "!"
        const numToExclaim = pipe(toStr, addBang)
        expect(numToExclaim(42)).toBe("42!")
        
        const sub = (a: int, b: int) => a - b
        const flippedSub = flip(sub)
        expect(flippedSub(3, 10)).toBe(7)
        
        let callCount = 0
        const expensiveFib = memoize((n) => {
            callCount = callCount + 1
            if (n <= 1) return n
            return n
        })
        expensiveFib(5)
        expensiveFib(5)
        expensiveFib(5)
        expect(callCount).toBe(1)
        
        const sumAcc = makeAccumulator<int>(0, (a, b) => a + b)
        sumAcc(5)
        sumAcc(3)
        const total = sumAcc(2)
        expect(total).toBe(10)
        
        const strAcc = makeAccumulator<str>("", (a, b) => a + b)
        strAcc("foo")
        strAcc("bar")
        const built = strAcc("!")
        expect(built).toBe("foobar!")
        
    });
});
