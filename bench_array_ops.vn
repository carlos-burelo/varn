let arr: Array<int> = [];
let size = 500000;
let i = 0;
while (i < size) {
    arr.push(i);
    i = i + 1;
}

let sum = 0;
let j = 0;
while (j < size) {
    sum = sum + arr[j];
    j = j + 1;
}
print("Array get sum: " + sum.toString());

let k = 0;
while (k < size) {
    arr[k] = k * 2;
    k = k + 1;
}
print("Array set complete");
