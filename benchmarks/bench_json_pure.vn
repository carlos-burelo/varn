import { parse, stringify } from "std:json";

let items = [];
for (let i = 0; i < 50000; i = i + 1) {
    items.push({
        id: i,
        name: "Item_" + i,
        active: (i % 2) === 0,
        score: (i % 100) * 1.25
    });
}

let jsonStr = stringify(items);

// Warmup and pure parse/stringify benchmark
let iterations = 20;
for (let k = 0; k < iterations; k = k + 1) {
    let parsed = parse(jsonStr) as dynamic[];
    let s = stringify(parsed);
}

print("Pure JSON loop finished");
