import { parse, stringify } from "std:json";

let items = [];
for (let i = 0; i < 50000; i = i + 1) {
    items.push({
        id: i,
        name: "Item_" + i,
        active: (i % 2) === 0,
        score: (i % 100) * 1.25
    });
}

let jsonStr = stringify(items);
print("Stringify done, len: " + jsonStr.length);

let parsed = parse(jsonStr) as dynamic[];
print("Parse done, len: " + parsed.length);
