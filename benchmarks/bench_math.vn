import { Math } from 'std:math'

function benchMath(iterations: int): float {
    let r: float = 1.0
    let i = 0
    while (i < iterations) {
        r = Math.abs(r - i as float)
        r = Math.sqrt(r + 1.0)
        r = Math.floor(r * 10.0) / 10.0
        i = i + 1
    }
    return r
}

let result = benchMath(500000)
print(result)
