# Build artifacts
target/
dist/
coverage/
*.profraw
*.profdata
*.gcda
*.gcno

# std bundle: lo produce crates/varn-cli/build.rs dentro de OUT_DIR y se
# embebe en `vn`. Esta entrada evita commitear copias sueltas.
std.vnb

# Varn caches y lockfiles
**/.vn/
**/*.bin
warp.lock

# Scratch de testing (los sources reales de builtins llamados test_*.vn se conservan)
test_*.vn
tmp*.vn
!crates/varn-builtins/src/modules/**/test_*.vn
# artefacto de tests/45-simple-file-test.vn (escribe en CWD)
temp_simple.txt

# Tooling de agentes / índices locales
.claude/
.codegraph/
.superpowers/
.agents/

# JS tooling
node_modules/

# Editor / OS
.idea/
.DS_Store
Thumbs.db
*.swp

# Env y temporales
.env
.env.*
*.log
*.tmp
*.bak
*.zip
*.rar

# Python bytecode from the benchmark twins
__pycache__/
*.pyc

# Pre-refactor originals kept alongside the code during the VM refactor, so a
# split can be diffed against what it came from. Deleted when the refactor
# closes; the same content is always reachable from the parent commit.
*.rs.back
