// std:net — host-backed network primitives and URL/query value types.

import {
    netIsIP,
    netIsIPv4,
    netIsIPv6,
    netParseUrl,
    netEncodeURIComponent,
    netDecodeURIComponent,
    ParsedUrl
} from "runtime:net";

function trimPrefixQ(s: str): str {
    if (s.startsWith("?")) {
        return s.slice(1);
    }
    return s;
}

export class Query {
    private values: { [key: str]: str[] } = {};

    static parse(s: str): Query {
        const query = new Query();
        const text = trimPrefixQ(s);
        if (text.length == 0) {
            return query;
        }

        const entries = text.split("&");
        for (const entry of entries) {
            if (entry.length == 0) {
                continue;
            }

            const eq = entry.indexOf("=");
            const rawKey = eq >= 0 ? entry.slice(0, eq) : entry;
            const rawValue = eq >= 0 ? entry.slice(eq + 1) : "";

            query.append(netDecodeURIComponent(rawKey), netDecodeURIComponent(rawValue));
        }

        return query;
    }

    static fromObject(q: { [key: str]: str | str[] }): Query {
        const query = new Query();
        for (const key in q) {
            const value = q[key];
            if (Array.isArray(value)) {
                for (const item of value) {
                    query.append(key, item);
                }
            } else {
                query.append(key, value);
            }
        }
        return query;
    }

    get(key: str): str? {
        const bucket = this.values[key];
        if (bucket == null || bucket.length == 0) {
            return null;
        }
        return bucket[0];
    }

    getAll(key: str): str[] {
        const bucket = this.values[key];
        if (bucket == null) {
            return [];
        }
        return bucket.slice();
    }

    set(key: str, value: str): void {
        this.values[key] = [value];
    }

    append(key: str, value: str): void {
        const bucket = this.values[key];
        if (bucket == null) {
            this.values[key] = [value];
        } else {
            bucket.push(value);
        }
    }

    toObject(): { [key: str]: str[] } {
        return this.values;
    }

    toString(): str {
        const parts: str[] = [];
        for (const key in this.values) {
            const encodedKey = netEncodeURIComponent(key);
            const bucket = this.values[key];
            for (const value of bucket) {
                parts.push(encodedKey + "=" + netEncodeURIComponent(value));
            }
        }
        return str.join(parts, "&");
    }
}

export class Url {
    protocol: str = "";
    host: str = "";
    port: int? = null;
    path: str = "";
    query: Query = new Query();
    fragment: str = "";

    static parse(url: str): Url {
        const parts = netParseUrl(url);
        const out = new Url();
        out.protocol = parts.protocol;
        out.host = parts.host;
        out.port = parts.port;
        out.path = parts.path;
        out.query = Query.parse(parts.query);
        out.fragment = parts.fragment;
        return out;
    }

    withQuery(query: Query): Url {
        const next = new Url();
        next.protocol = this.protocol;
        next.host = this.host;
        next.port = this.port;
        next.path = this.path;
        next.query = query;
        next.fragment = this.fragment;
        return next;
    }

    toString(): str {
        let out = this.protocol + "://" + this.host;
        if (this.port != null) {
            out = out + ":" + this.port.toString();
        }

        if (this.path.length == 0) {
            out = out + "/";
        } else {
            out = out + this.path;
        }

        const queryText = this.query.toString();
        if (queryText.length > 0) {
            out = out + "?" + queryText;
        }

        if (this.fragment.length > 0) {
            out = out + "#" + this.fragment;
        }

        return out;
    }
}

export namespace Net {
    export function isIP(s: str): bool {
        return netIsIP(s);
    }

    export function isIPv4(s: str): bool {
        return netIsIPv4(s);
    }

    export function isIPv6(s: str): bool {
        return netIsIPv6(s);
    }

    export function parseURL(url: str): Url {
        return Url.parse(url);
    }

    export function parseQuery(s: str): Query {
        return Query.parse(s);
    }

    export function buildQuery(q: { [key: str]: str | str[] }): str {
        return Query.fromObject(q).toString();
    }

    export function appendQuery(url: str, q: { [key: str]: str | str[] }): str {
        const query = buildQuery(q);
        if (query.length == 0) {
            return url;
        }

        const parsed = Url.parse(url);
        return parsed.withQuery(Query.parse(query)).toString();
    }
}
