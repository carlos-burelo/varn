// std:net — host-backed network primitives + Varn query utilities.

declare function __net_is_ip(s: str): bool;
declare function __net_is_ipv4(s: str): bool;
declare function __net_is_ipv6(s: str): bool;
declare function __net_parse_url(url: str): {
    protocol: str;
    host: str;
    port: int | null;
    path: str;
    query: str;
    fragment: str;
};
declare function __net_enc_uri_component(value: str): str;
declare function __net_dec_uri_component(value: str): str;

function trimPrefixQ(s: str): str {
    if (s.startsWith("?")) {
        return s.slice(1);
    }
    return s;
}

export namespace Net {
    export function isIP(s: str): bool {
        return __net_is_ip(s);
    }

    export function isIPv4(s: str): bool {
        return __net_is_ipv4(s);
    }

    export function isIPv6(s: str): bool {
        return __net_is_ipv6(s);
    }

    export function parseURL(url: str): {
        protocol: str;
        host: str;
        port: int | null;
        path: str;
        query: str;
        fragment: str;
    } {
        return __net_parse_url(url);
    }

    export function parseQuery(s: str): { [key: str]: str[] } {
        const query = trimPrefixQ(s);
        const out: { [key: str]: str[] } = {};
        if (query.length == 0) {
            return out;
        }

        const entries = query.split("&");
        for (const entry of entries) {
            if (entry.length == 0) {
                continue;
            }

            const eq = entry.indexOf("=");
            const rawKey = eq >= 0 ? entry.slice(0, eq) : entry;
            const rawValue = eq >= 0 ? entry.slice(eq + 1) : "";

            const key = __net_dec_uri_component(rawKey);
            const value = __net_dec_uri_component(rawValue);

            const bucket = out[key];
            if (bucket == null) {
                out[key] = [value];
            } else {
                bucket.push(value);
            }
        }

        return out;
    }

    export function buildQuery(q: { [key: str]: str | str[] }): str {
        const parts: str[] = [];

        for (const key in q) {
            const value = q[key];
            const encodedKey = __net_enc_uri_component(key);

            if (Array.isArray(value)) {
                for (const item of value) {
                    parts.push(encodedKey + "=" + __net_enc_uri_component(item));
                }
            } else {
                parts.push(encodedKey + "=" + __net_enc_uri_component(value));
            }
        }

        return str.join(parts, "&");
    }

    export function appendQuery(url: str, q: { [key: str]: str | str[] }): str {
        const query = buildQuery(q);
        if (query.length == 0) {
            return url;
        }

        const hashIdx = url.indexOf("#");
        const base = hashIdx >= 0 ? url.slice(0, hashIdx) : url;
        const fragment = hashIdx >= 0 ? url.slice(hashIdx) : "";

        const sep = base.indexOf("?") >= 0 ? "&" : "?";
        return base + sep + query + fragment;
    }
}
