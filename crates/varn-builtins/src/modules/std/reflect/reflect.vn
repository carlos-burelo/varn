// std:reflect — pure IDL facade over runtime reflection host operations.

export interface ClassRef {
    name: str;
}

export interface FunctionRef {
    name: str;
    length: int;
    apply(thisArg: dynamic, args?: dynamic[]): dynamic;
    call(thisArg: dynamic, ...args: dynamic[]): dynamic;
    bind(thisArg: dynamic, ...args: dynamic[]): FunctionRef;
}

export namespace Reflect {
    export declare function defineMetadata(metadataKey: dynamic, metadataValue: dynamic, target: dynamic): void;
    export declare function getMetadata(metadataKey: dynamic, target: dynamic): dynamic;
    export declare function hasMetadata(metadataKey: dynamic, target: dynamic): bool;
    export declare function getMetadataKeys(target: dynamic): dynamic[];
}

export declare class MetaKey<T = dynamic> {
    static create<R>(): MetaKey<R>;
    set(target: dynamic, value: T): void;
    get(target: dynamic): T | null;
    has(target: dynamic): bool;
    keys(target: dynamic): dynamic[];
}

export interface MethodContext {
    name: str;
    isStatic: bool;
    isPrivate: bool;
    kind: str;
}
