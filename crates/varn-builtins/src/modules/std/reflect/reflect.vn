// std:reflect — pure Varn facade over runtime reflection host operations.

import {
    reflectDefineMetadata,
    reflectGetMetadata,
    reflectHasMetadata,
    reflectCreateMetaKey,
    reflectSetMetaKey,
    reflectGetMetaKey,
    reflectHasMetaKey
} from "runtime:reflect";

export interface ClassRef {
    name: str;
}

export interface FunctionRef {
    name: str;
    length: int;
    apply(thisArg: dynamic, args?: dynamic[]): dynamic;
    call(thisArg: dynamic, ...args: dynamic[]): dynamic;
    bind(thisArg: dynamic, ...args: dynamic[]): FunctionRef;
}

export namespace Reflect {
    export function defineMetadata(metadataKey: dynamic, metadataValue: dynamic, target: dynamic): void {
        reflectDefineMetadata(metadataKey, metadataValue, target);
    }

    export function getMetadata(metadataKey: dynamic, target: dynamic): dynamic {
        return reflectGetMetadata(metadataKey, target);
    }

    export function hasMetadata(metadataKey: dynamic, target: dynamic): bool {
        return reflectHasMetadata(metadataKey, target);
    }

    export function getMetadataKeys(target: dynamic): dynamic[] {
        return [];
    }
}

export class MetaKey<T = dynamic> {
    private metaId: str;

    constructor(metaId: str) {
        this.metaId = metaId;
    }

    static create<R>(): MetaKey<R> {
        let id = reflectCreateMetaKey();
        return new MetaKey<R>(id);
    }

    set(target: dynamic, value: T): void {
        reflectSetMetaKey(this.metaId, target, value);
    }

    get(target: dynamic): T | null {
        let val = reflectGetMetaKey(this.metaId, target);
        return val as T;
    }

    has(target: dynamic): bool {
        return reflectHasMetaKey(this.metaId, target);
    }

    keys(target: dynamic): dynamic[] {
        return [];
    }
}

export interface MethodContext {
    name: str;
    isStatic: bool;
    isPrivate: bool;
    kind: str;
}
