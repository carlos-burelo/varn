// runtime:time — low-level host time operations.

export interface RuntimeTimeParts {
    year: int;
    month: int;
    day: int;
    hour: int;
    minute: int;
    second: int;
    millisecond: int;
}

export declare function timeNowMs(): int;
export declare function timeParseIsoDuration(s: str): int;
export declare function timeMsToParts(ms: int): RuntimeTimeParts;
export declare function timePartsToMs(parts: RuntimeTimeParts): int;