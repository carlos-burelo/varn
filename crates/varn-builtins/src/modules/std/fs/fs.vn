import {
    fsRead,
    fsWrite,
    fsExists,
    fsStat,
    fsMkdir,
    fsMkdirAll,
    fsReadDir,
    fsRemove,
    fsRemoveAll,
    fsRename,
    fsTempDir
} from "runtime:fs";

export class Stats {
    size: int;
    isDir: bool;
    isFile: bool;
    mtime: int;

    constructor(size: int, isDir: bool, isFile: bool, mtime: int) {
        this.size = size;
        this.isDir = isDir;
        this.isFile = isFile;
        this.mtime = mtime;
    }
}

export namespace fs {
    export function read(path: str): str {
        return fsRead(path);
    }

    export function write(path: str, content: str): void {
        fsWrite(path, content);
    }

    export function appendText(path: str, content: str): void {
        let existing = "";
        if (fsExists(path)) {
            existing = fsRead(path);
        }
        fsWrite(path, existing + content);
    }

    export function exists(path: str): bool {
        return fsExists(path);
    }

    export function stat(path: str): Stats {
        let raw = fsStat(path);
        return new Stats(
            raw["size"] as int,
            raw["isDir"] as bool,
            raw["isFile"] as bool,
            raw["mtime"] as int
        );
    }

    export function mkdir(path: str): void {
        fsMkdir(path);
    }

    export function mkdirAll(path: str): void {
        fsMkdirAll(path);
    }

    export function readDir(path: str): str[] {
        return fsReadDir(path) as str[];
    }

    export function remove(path: str): void {
        fsRemove(path);
    }

    export function removeAll(path: str): void {
        fsRemoveAll(path);
    }

    export function rename(from: str, to: str): void {
        fsRename(from, to);
    }

    export function copy(from: str, to: str): void {
        let content = fsRead(from);
        fsWrite(to, content);
    }

    export function tempDir(): str {
        return fsTempDir();
    }
}
