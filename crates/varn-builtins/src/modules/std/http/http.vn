// std:http — Pure Varn facade over runtime HTTP host operations.

import {
    httpFetch,
    httpCreateServer,
    httpAddRoute,
    httpListen,
    httpSendResponse
} from "runtime:http";

import { JSON } from "std:json";

export interface Response {
    status: int;
    statusText: str;
    ok: bool;
    body: str;
    headers: { [key: str]: str };
}

export interface Request {
    method: str;
    path: str;
    query: { [key: str]: str };
    params: { [key: str]: str };
    body: str;
    headers: { [key: str]: str };
}

export class ServerResponse {
    private isSent: bool = false;

    send(status: int, body: str, contentType: str = "text/plain", headers: { [key: str]: str } = {}): void {
        if (this.isSent) return;
        Http.sendResponse(status, body, contentType, headers);
        this.isSent = true;
    }

    json(data: dynamic, status: int = 200): void {
        this.send(status, JSON.stringify(data), "application/json");
    }

    html(html: str, status: int = 200): void {
        this.send(status, html, "text/html");
    }
}

export namespace Http {
    export async function fetch(
        url: str,
        method?: str,
        headers?: { [key: str]: str },
        body?: str,
        timeoutMs?: int
    ): Task<Response> {
        let response_body = await httpFetch(url, method, headers, body, timeoutMs);
        return {
            status: 200,
            statusText: "OK",
            ok: true,
            body: response_body as str,
            headers: {}
        };
    }

    export function createServer(): int {
        return httpCreateServer();
    }

    export function addRoute(
        serverId: int,
        method: str,
        pattern: str,
        callback: (req: Request, res: ServerResponse) => void
    ): void {
        httpAddRoute(serverId, method, pattern, callback);
    }

    export function listen(
        serverId: int,
        port: int,
        responseCtor: dynamic
    ): void {
        httpListen(serverId, port, responseCtor);
    }

    export function sendResponse(
        status: int,
        body: str,
        contentType: str,
        headers: { [key: str]: str }
    ): void {
        httpSendResponse(status, body, contentType, headers);
    }
}
