// std:crypto — pure IDL facade over runtime cryptographic host operations.

export namespace crypto {
    export declare function sha256(data: str): str;
    export declare function sha512(data: str): str;
    export declare function randomBytes(size: int): int[];
    export declare function randomHex(size: int): str;
    export declare function base64_enc(data: str): str;
    export declare function base64_dec(data: str): str;
    export declare function uuid(): str;
    export declare function hmac(algo: str, key: str, data: str): str;
}
