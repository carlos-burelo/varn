// std:task - pure Varn facade over runtime concurrency host operations.

import { taskSpawn, taskSleep, taskParallel, IsolatePort, spawnIsolate as nativeSpawnIsolate } from "runtime:task";

export declare class Generator<T> {
    next(value?: dynamic): { value: T; done: bool; };
    return(value?: T): { value: T; done: bool; };
}

export declare class AsyncGenerator<T> {
    next(value?: dynamic): Task<{ value: T; done: bool; }>;
    return(value?: T): Task<{ value: T; done: bool; }>;
}

export interface Iterator<T> {
    next(): { value: T; done: bool; };
}

export interface AsyncIterator<T> {
    next(): Task<{ value: T; done: bool; }>;
}

export interface TaskHandle<T = dynamic> {
    isCompleted(): bool;
    await(): T;
    cancel(): void;
}

export function parallel<T>(tasks: Array<Task<T>>): Task<Array<T>> {
    return taskParallel(tasks);
}

export function spawn<T>(target: Task<T> | ((...args: dynamic[]) => T), ...args: dynamic[]): TaskHandle<T> {
    return taskSpawn(target, ...args);
}

export function sleep(ms: int): TaskHandle<void> {
    return taskSleep(ms);
}


export function spawnIsolate(
    fn: dynamic,
    args: Array<dynamic>
): Task<IsolatePort> {
    return nativeSpawnIsolate(fn, args);
}

async function wrapTask<T>(task: Task<T>, group: TaskGroupImpl<T>): T {
    try {
        let res = await task;
        if (group.isCancelled) {
            throw new Error("TaskGroup cancelled");
        }
        return res;
    } catch (e) {
        if (group.isCancelled) {
            throw new Error("TaskGroup cancelled");
        }
        throw e;
    }
}

class TaskGroupImpl<T = dynamic> {
    tasks: Array<Task<T> >;
    isCancelled: bool;

    constructor() {
        this.tasks = [];
        this.isCancelled = false;
    }

    spawn(task: Task<T>): Task<T> {
        if (this.isCancelled) {
            throw new Error("TaskGroup is cancelled");
        }
        let wrapped = wrapTask(task, this);
        this.tasks.push(wrapped);
        return wrapped;
    }

    async join(): Array<T> {
        if (this.isCancelled) {
            throw new Error("TaskGroup is cancelled");
        }
        return await taskParallel(this.tasks);
    }

    dispose(): void {
        this.isCancelled = true;
    }

    cancel(): void {
        this.isCancelled = true;
    }

    async disposeAsync(): void {
        this.cancel();
    }
}

export type TaskGroup<T = dynamic> = TaskGroupImpl<T>;

export function TaskGroup<T = dynamic>(): TaskGroupImpl<T> {
    return new TaskGroupImpl<T>();
}

export function task_group<T>(): TaskGroupImpl<T> {
    return new TaskGroupImpl<T>();
}
