// runtime:task — low-level host task operations.

export declare function taskSpawn<T>(target: Task<T> | ((...args: dynamic[]) => T), ...args: dynamic[]): TaskHandle<T>;
export declare function taskSleep(ms: int): TaskHandle<void>;
export declare function taskParallel<T>(tasks: Array<Task<T> >): Task<Array<T> >;

export declare class IsolatePort {
    send(msg: dynamic): void;
    receive(): Task<dynamic>;
}

export declare function spawnIsolate(modulePath: str, exportName: str, args: Array<dynamic>): Task<IsolatePort>;