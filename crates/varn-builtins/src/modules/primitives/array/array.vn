export declare class Array<T> {
    readonly length: int;
    push(item: T): void;
    pop(): T;
    shift(): T;
    unshift(item: T): void;
    join(separator?: str): str;
    slice(start?: int, end?: int): T[];
    at(index: int): T?;
    concat(...items: T[][]): T[];
    fill(value: T, start?: int, end?: int): T[];
    @fallible filter(predicate: (item: T, index: int, array: T[]) => bool): T[];
    @fallible find(predicate: (item: T, index: int, array: T[]) => bool): T?;
    @fallible findIndex(predicate: (item: T, index: int, array: T[]) => bool): int;
    flat(depth?: int): dynamic[];
    @fallible flatMap<U>(callback: (item: T, index: int, array: T[]) => U[]): U[];
    @fallible forEach(callback: (item: T, index: int, array: T[]) => void): void;
    @fallible map<U>(callback: (item: T, index: int, array: T[]) => U): U[];
    @fallible reduce<U>(callback: (acc: U, item: T, index: int, array: T[]) => U, initial?: U): U;
    reverse(): T[];
    @fallible sort(compareFn?: (a: T, b: T) => int): T[];
    splice(start: int, deleteCount?: int, ...items: T[]): T[];
    @fallible every(predicate: (item: T, index: int, array: T[]) => bool): bool;
    @fallible some(predicate: (item: T, index: int, array: T[]) => bool): bool;
    includes(search: T): bool;
    indexOf(search: T): int;
    lastIndexOf(search: T): int;
    toString(): str;

    static isArray(obj: dynamic): obj is dynamic[];
    static from(value: dynamic): T[];
}
