export declare class Generator<T> {
    next(value?: dynamic): { value: T; done: bool; };
    return(value?: T): { value: T; done: bool; };
}

// No `AsyncGenerator`: `async function*` is rejected by the parser, so nothing
// can produce one. `AsyncIterator` below stays — it is implementable by hand,
// and `Symbol.asyncIterator` exists at runtime.

export interface Iterator<T> {
    next(): { value: T; done: bool; };
}

export interface AsyncIterator<T> {
    next(): Task<{ value: T; done: bool; }>;
}

export interface TaskHandle<T = dynamic> {
    isCompleted(): bool;
    await(): T;
    cancel(): void;
}
