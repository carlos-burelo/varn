export declare class Map<V> {
    constructor();
    get(key: str): V | null;
    set(key: str, value: V): void;
    has(key: str): bool;
    delete(key: str): bool;
    clear(): void;
    keys(): str[];
    values(): V[];
    readonly size: int;
}

export declare class Set<T> {
    constructor();
    add(value: T): void;
    has(value: T): bool;
    delete(value: T): bool;
    clear(): void;
    values(): T[];
    readonly size: int;
}

/// Record<K, V> — a map-like object type.
export declare class Record<K, V> {
    constructor();
    get(key: K): V | null;
    set(key: K, value: V): void;
    has(key: K): bool;
    delete(key: K): bool;
    keys(): K[];
    values(): V[];
    readonly size: int;
}
