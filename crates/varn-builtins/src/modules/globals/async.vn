export declare class Task<T> {
    then<R>(callback: (value: T) => R): Task<R>;
    map<R>(callback: (value: T) => R): Task<R>;
    catch(handler: (err: Error) => T): Task<T>;
    unwrap(): T;
    expect(msg: str): T;
    valueOr(fallback: T): T;
}

export declare function parallel<T>(tasks: Array<Task<T> >): Task<Array<T> >;

export declare interface TaskGroupValue<T> {
    spawn(task: Task<T>): Task<T>;
    join(): Task<Array<T> >;
    cancel(): void;
    dispose(): void;
    disposeAsync(): Task<void>;
}

export declare function TaskGroup<T>(): TaskGroupValue<T>;
