// runtime:time — low-level host time operations.

export interface RuntimeTimeParts {
    year: int;
    month: int;
    day: int;
    hour: int;
    minute: int;
    second: int;
    millisecond: int;
}

export declare function nowMs(): int;
export declare function parseIsoDuration(s: str): int;
export declare function msToParts(ms: int): RuntimeTimeParts;
export declare function partsToMs(parts: RuntimeTimeParts): int;