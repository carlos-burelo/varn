// runtime:net — low-level host network operations.

export interface ParsedUrl {
    protocol: str;
    host: str;
    port: int;
    path: str;
    query: str;
    fragment: str;
}

export declare function isIP(s: str): bool;
export declare function isIPv4(s: str): bool;
export declare function isIPv6(s: str): bool;
export declare function parseUrl(url: str): ParsedUrl;
export declare function encodeURIComponent(value: str): str;
export declare function decodeURIComponent(value: str): str;