// runtime:net — low-level host network operations.

export interface ParsedUrl {
    protocol: str;
    host: str;
    port: int;
    path: str;
    query: str;
    fragment: str;
}

export declare function netIsIP(s: str): bool;
export declare function netIsIPv4(s: str): bool;
export declare function netIsIPv6(s: str): bool;
export declare function netParseUrl(url: str): ParsedUrl;
export declare function netEncodeURIComponent(value: str): str;
export declare function netDecodeURIComponent(value: str): str;