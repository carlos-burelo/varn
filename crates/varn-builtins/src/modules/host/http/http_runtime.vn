// runtime:http — low-level host HTTP operations.

export declare function fetch(
    url: str,
    method?: str,
    headers?: { [key: str]: str },
    body?: str,
    timeoutMs?: int
): Task<str>;

export declare function createServer(): int;

export declare function addRoute(
    serverId: int,
    method: str,
    pattern: str,
    callback: (req: dynamic, res: dynamic) => void
): void;

export declare function listen(
    serverId: int,
    port: int,
    responseCtor: dynamic
): void;

export declare function sendResponse(
    status: int,
    body: str,
    contentType: str,
    headers: { [key: str]: str }
): void;

export declare function close(serverId: int): void;