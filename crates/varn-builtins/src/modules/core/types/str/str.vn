/**
 * Immutable UTF-8 text.
 */
export declare class str {
    static EMPTY: str;
    static fromCharCode(...codes: int[]): str;
    static join(arr: str[], sep?: str): str;

    readonly length: int;
    toString(): str;
    toStr(): str; // ALIAS
    valueOf(): str;
    toLowerCase(): str;
    toUpperCase(): str;
    trim(): str;
    trimStart(): str;
    trimEnd(): str;
    includes(search: str): bool;
    contains(search: str): bool; // ALIAS
    startsWith(search: str): bool;
    endsWith(search: str): bool;
    indexOf(search: str): int?;
    lastIndexOf(search: str): int?;
    @throws(RangeError) substring(start: int, end?: int): str;
    slice(start: int, end?: int): str;
    at(index: int): str?;
    replace(from: str, to: str): str;
    replaceAll(from: str, to: str): str;
    split(separator?: str): str[];
    chars(): char[];
    charCodeAt(pos: int): int;
    charCode(): int;
    codePointAt(pos: int): int;
    lines(): str[];
    words(): str[];
    @throws(RangeError) repeat(n: int): str;
    @throws(RangeError) padStart(target: int, pad?: str): str;
    @throws(RangeError) padEnd(target: int, pad?: str): str;
    concat(other: str): str;
    substr(start: int, length?: int): str;
    isEmpty(): bool;
    isBlank(): bool;
    isDigit(): bool;
    isLetter(): bool;
    isWhitespace(): bool;
    reverse(): str;
    capitalize(): str;
    toInt(): int;
    toFloat(): float;
}
