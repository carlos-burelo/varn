/**
 * Hash map from keys `K` to values `V`.
 */
export declare class Map<K, V> {
    constructor();
    @throws(TypeError) get(key: K): V?;
    @throws(TypeError) set(key: K, value: V): void;
    @throws(TypeError) has(key: K): bool;
    @throws(TypeError) delete(key: K): bool;
    clear(): void;
    keys(): K[];
    values(): V[];
    entries(): [K, V][];
    @throws(Error) forEach(callback: (value: V, key: K, map: Map<K, V>) => void): void;
    readonly size: int;
}