import { ReadonlyArray } from "core:types/array";
import { Hashable } from "core:types/hashable";

/**
 * Hash map from keys `K` to values `V`.
 */
export declare class Map<K extends Hashable, V> {
    constructor(entries?: (K, V)[]);
    @throws(TypeError) get(key: K): V?;
    @throws(TypeError) set(key: K, value: V): void;
    @throws(TypeError) has(key: K): bool;
    @throws(TypeError) delete(key: K): bool;
    clear(): void;
    keys(): K[];
    values(): V[];
    entries(): (K, V)[];
    @throws(Error) forEach(callback: (value: V, key: K, map: Map<K, V>) => void): void;
    readonly size: int;
}
/**
 * Read-only view of a `Map<K, V>`: invariant in `K`, covariant in `V`.
 */
export interface ReadonlyMap<K extends Hashable, out V> {
    size: int;
    get(key: K): V?;
    has(key: K): bool;
    keys(): ReadonlyArray<K>;
    values(): ReadonlyArray<V>;
    entries(): ReadonlyArray<(K, V)>;
    forEach(callback: (value: V, key: K, map: ReadonlyMap<K, V>) => void): void;
}
