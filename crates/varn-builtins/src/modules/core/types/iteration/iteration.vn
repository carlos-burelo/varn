import { Option } from "core:types/option";

/**
 * Lazy sequence produced by a `function*`: each `next()` resumes the body up
 * to its next `yield` and returns `Some(value)`, or `None` once it finishes.
 */
export declare class Generator<T> {
    @throws(Error) next(): Option<T>;
    close(): void;
}

/**
 * What `async function*` produces. `next()` returns a task: the body runs on
 * the scheduler until its next `yield`, and the caller awaits that result
 * without blocking whatever it waits on.
 */
export declare class AsyncGenerator<T> {
    next(): Task<Option<T>>;
    close(): void;
}

/**
 * A source of values pulled one at a time: `Some(value)` until it is
 * exhausted, then `None`.
 */
export interface Iterator<T> {
    next(): Option<T>;
}

/**
 * Something `for-of` can walk: it hands out a fresh `Iterator<T>`.
 */
export interface Iterable<T> {
    iter(): Iterator<T>;
}

/**
 * An `Iterator<T>` whose next value may take time to arrive.
 */
export interface AsyncIterator<T> {
    next(): Task<Option<T>>;
}

/**
 * Handle to a spawned task: poll it, await it or cancel it.
 */
export interface TaskHandle<T = dynamic> {
    isCompleted(): bool;
    await(): T;
    cancel(): void;
}

/**
 * An asynchronous computation that settles with a `T`; `await` suspends
 * until it does, without blocking the scheduler.
 */
export interface Task<T> {
}
