export declare class decimal {
    toString(): str;
    toFixed(digits?: int): str;
    abs(): decimal;
    sign(): int;
    negate(): decimal;
    ceil(): decimal;
    floor(): decimal;
    round(): decimal;
    trunc(): decimal;
    fract(): decimal;
    scale(): int;
    isZero(): bool;
    isPositive(): bool;
    isNegative(): bool;
    @fallible pow(exp: int): decimal;
    @fallible toInt(): int;
    toFloat(): float;

    @fallible static parse(s: str): decimal;
    static tryParse(s: str): decimal?;
}
