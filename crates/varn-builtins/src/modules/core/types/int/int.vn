/**
 * Native 64-bit two's-complement integer. Leaving the range raises
 * `integer overflow`; it never wraps, saturates or promotes to float.
 */
export declare class int {
    static MAX_VALUE: int;
    static MIN_VALUE: int;
    @throws(ParseError) static parse(s: str): int;
    static tryParse(s: str): int?;
    static isSafeInteger(val: int): bool;

    toString(): str;
    valueOf(): int;
    toLocaleString(): str;
    @throws(RangeError) toFixed(digits?: int): str;
    @throws(IntegerOverflow) abs(): int;
    sign(): int;
    @throws(IntegerOverflow) negate(): int;
    bitwiseNot(): int;
    min(other: int): int;
    max(other: int): int;
    @throws(RangeError) clamp(lo: int, hi: int): int;
    toHex(): str;
    toBinary(): str;
    toOctal(): str;
    toFloat(): float;
    @throws(RangeError, IntegerOverflow) pow(exponent: int): int;
    isEven(): bool;
    isOdd(): bool;

    wrappingAdd(other: int): int;
    wrappingSub(other: int): int;
    wrappingMul(other: int): int;
    saturatingAdd(other: int): int;
    saturatingSub(other: int): int;
    saturatingMul(other: int): int;
    checkedAdd(other: int): int?;
    checkedSub(other: int): int?;
    checkedMul(other: int): int?;
    @throws(DivisionByZero, IntegerOverflow) div(other: int): int;
    @throws(DivisionByZero, IntegerOverflow) floorDiv(other: int): int;
    @throws(DivisionByZero, IntegerOverflow) ceilDiv(other: int): int;
    @throws(DivisionByZero, IntegerOverflow) rem(other: int): int;
    @throws(DivisionByZero, IntegerOverflow) mod(other: int): int;
}
