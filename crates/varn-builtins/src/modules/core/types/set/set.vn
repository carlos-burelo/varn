import { ReadonlyArray } from "core:types/array";
import { Hashable } from "core:types/hashable";

/**
 * Hash set of distinct values `T`.
 */
export declare class Set<T extends Hashable> {
    constructor(items?: T[]);
    @throws(TypeError) add(value: T): void;
    @throws(TypeError) has(value: T): bool;
    @throws(TypeError) delete(value: T): bool;
    clear(): void;
    values(): T[];
    @throws(Error) forEach(callback: (value: T, value2: T, s: Set<T>) => void): void;
    readonly size: int;
}
/**
 * Read-only view of a `Set<T>`.
 */
export interface ReadonlySet<T extends Hashable> {
    size: int;
    has(value: T): bool;
    values(): ReadonlyArray<T>;
    forEach(callback: (value: T, value2: T, s: ReadonlySet<T>) => void): void;
}
