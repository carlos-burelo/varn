/**
 * Hash set of distinct values `T`.
 */
export declare class Set<T> {
    constructor();
    @throws(TypeError) add(value: T): void;
    @throws(TypeError) has(value: T): bool;
    @throws(TypeError) delete(value: T): bool;
    clear(): void;
    values(): T[];
    @throws(Error) forEach(callback: (value: T, value2: T, s: Set<T>) => void): void;
    readonly size: int;
}