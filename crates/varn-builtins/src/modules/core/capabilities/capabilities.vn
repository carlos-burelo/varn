export interface Disposable {
    dispose(): void;
}

export interface AsyncDisposable {
    disposeAsync(): void;
}


// Standard capabilities (spec §33). Structural: a type satisfies one by
// having the member, with no `implements` needed.

export interface Equatable<T> {
    equals(other: T): bool;
}

export interface Comparable<T> {
    compare(other: T): int;
}

export interface Hashable {
    hash(): int;
}

export interface Cloneable<T> {
    clone(): T;
}

// A class satisfies `Default<T>` through its static `default()`: the class
// value itself is the factory.
export interface Default<T> {
    default(): T;
}

export interface Display {
    toString(): str;
}

export interface Debug {
    debug(): str;
}

export interface Indexable<K, V> {
    get(key: K): V?;
}

export interface Add<T, R> {
    add(other: T): R;
}

export interface Sub<T, R> {
    sub(other: T): R;
}

export interface Mul<T, R> {
    mul(other: T): R;
}

export interface Div<T, R> {
    div(other: T): R;
}

export interface Rem<T, R> {
    rem(other: T): R;
}

export interface Pow<T, R> {
    pow(other: T): R;
}

export interface Neg<R> {
    neg(): R;
}
