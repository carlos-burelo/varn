// runtime:ui — headless window/event/draw backend (v1, no winit).
// Single event queue + command log per window. Real backend feeds the same
// queue and draws instead of logging. Same API, no dual paths.

export declare enum UiEventKind {
    Key,
    Mouse,
    Resize,
    Close,
    Wheel
}

export declare enum UiInjectKind {
    Key,
    Mouse,
    MouseDown,
    MouseUp,
    Resize,
    Close,
    Wheel
}

export interface UiEvent {
    kind: UiEventKind;
    key: int;
    pressed: bool;
    x: int;
    y: int;
    button: int;
    w: int;
    h: int;
}

@permission("ui")
export declare function open$(title: str, w: int, h: int): int;
@permission("ui")
export declare function close$(id: int): void;
@permission("ui")
export declare function shouldClose$(id: int): bool;
@permission("ui")
export declare function size$(id: int): int[];
@permission("ui")
export declare function inject$(id: int, kind: UiInjectKind, a: int, b: int, c: int): void;
@permission("ui")
export declare function poll$(id: int): UiEvent[];
@permission("ui")
export declare function rect$(id: int, x: float, y: float, w: float, h: float, color: int, radius: float): void;
@permission("ui")
export declare function text$(id: int, x: float, y: float, s: str, size: float, color: int): void;
@permission("ui")
export declare function clip$(id: int, x: float, y: float, w: float, h: float): void;
@permission("ui")
export declare function unclip$(id: int): void;
@permission("ui")
export declare function clear$(id: int, color: int): void;
@permission("ui")
export declare function present$(id: int): int;
@permission("ui")
export declare function commands$(id: int): str[];
@permission("ui")
export declare function real$(id: int): bool;
@permission("ui")
export declare function keyCode$(name: str): int;
