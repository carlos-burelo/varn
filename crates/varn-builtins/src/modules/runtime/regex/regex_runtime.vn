// runtime:regex — low-level host regular expression operations.

export interface RegexMatch {
    match: str;
    index: int;
    groups: (str?)[];
}

export declare function compile$(pattern: str, flags: str): int;
export declare function test$(handle: int, text: str): bool;
export declare function exec$(handle: int, text: str): RegexMatch?;
export declare function findAll$(handle: int, text: str): RegexMatch[];
export declare function replace$(handle: int, text: str, replacement: str): str;
export declare function split$(handle: int, text: str): str[];
