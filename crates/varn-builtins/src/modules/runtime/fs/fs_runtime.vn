export declare enum FileMode {
    Read,
    Write,
    Append
}

export declare enum SeekOrigin {
    Start,
    Current,
    End
}

export interface RawStats {
    size: int;
    isDir: bool;
    isFile: bool;
    mtime: int;
}

export declare function open$(path: str, mode: FileMode): int;
export declare function readFd$(fd: int, len: int): str;
export declare function readFdBytes$(fd: int, len: int): Bytes;
export declare function writeFd$(fd: int, data: str): int;
export declare function writeFdBytes$(fd: int, data: Bytes): int;
export declare function readFileBytes$(path: str): Bytes;
export declare function writeFileBytes$(path: str, data: Bytes): void;
export declare function readFileText$(path: str): str;
export declare function writeFileText$(path: str, data: str): void;
export declare function appendFileText$(path: str, data: str): void;
export declare function copyFile$(from: str, to: str): void;
export declare function readLines$(path: str): str[];
export declare function readFdAll$(fd: int): str;
export declare function readFdAllBytes$(fd: int): Bytes;
export declare function readFdBytesAsync$(fd: int, len: int): TaskHandle<Bytes>;
export declare function readFdAllBytesAsync$(fd: int): TaskHandle<Bytes>;
export declare function writeFdBytesAsync$(fd: int, data: Bytes): TaskHandle<int>;
export declare function seek$(fd: int, offset: int, origin: SeekOrigin): int;
export declare function close$(fd: int): void;
export declare function exists$(path: str): bool;
export declare function stat$(path: str): RawStats;
export declare function mkdir$(path: str): void;
export declare function mkdirAll$(path: str): void;
export declare function readDir$(path: str): str[];
export declare function remove$(path: str): void;
export declare function removeAll$(path: str): void;
export declare function rename$(from: str, to: str): void;
export declare function readFileTextAsync$(path: str): TaskHandle<str>;
export declare function readFileBytesAsync$(path: str): TaskHandle<Bytes>;
export declare function writeFileTextAsync$(path: str, data: str): TaskHandle<void>;
export declare function writeFileBytesAsync$(path: str, data: Bytes): TaskHandle<void>;
export declare function appendFileTextAsync$(path: str, data: str): TaskHandle<void>;
export declare function copyFileAsync$(from: str, to: str): TaskHandle<void>;
export declare function readLinesAsync$(path: str): TaskHandle<str[]>;
export declare function readDirAsync$(path: str): TaskHandle<str[]>;
export declare function removeAllAsync$(path: str): TaskHandle<void>;
export declare function tempDir$(): str;
