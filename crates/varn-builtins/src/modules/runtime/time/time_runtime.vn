// runtime:time — low-level host time operations.

export interface RuntimeTimeParts {
    year: int;
    month: int;
    day: int;
    hour: int;
    minute: int;
    second: int;
    millisecond: int;
}

export interface RuntimeCalendarParts {
    year: int;
    month: int;
    day: int;
    hour: int;
    minute: int;
    second: int;
    millisecond: int;
    weekday: int;
}

export declare function nowMs$(): int;
export declare function parseIsoDuration$(s: str): int;
export declare function msToParts$(ms: int): RuntimeCalendarParts;
export declare function partsToMs$(parts: RuntimeTimeParts): int;
export declare function parseIsoInstant$(s: str): int;