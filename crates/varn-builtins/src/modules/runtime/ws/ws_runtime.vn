export declare enum WsOpcode {
    Continuation = 0,
    Text = 1,
    Binary = 2,
    Close = 8,
    Ping = 9,
    Pong = 10
}

export interface WsFrame {
    opcode: WsOpcode;
    fin: bool;
    payload: Bytes;
    consumed: int;
}

export declare function wsKey$(): str;
export declare function wsAcceptResponse$(request: str): str;
export declare function wsValidateResponse$(head: str, key: str): void;
export declare function wsFrameBytes$(payload: Bytes, opcode: WsOpcode): Bytes;
export declare function wsParseFrame$(data: Bytes): WsFrame?;
