// runtime:net — low-level host network operations.

export declare enum HttpMethod {
    GET,
    HEAD,
    POST,
    PUT,
    DELETE,
    PATCH,
    OPTIONS,
    CONNECT,
    TRACE
}

export interface HttpRequestHead {
    method: HttpMethod?;
    path: str;
    headers: { [key: str]: str };
    body: str;
}

export declare function isIP$(s: str): bool;
export declare function isIPv4$(s: str): bool;
export declare function isIPv6$(s: str): bool;
export declare function encodeURIComponent$(value: str): str;
export declare function decodeURIComponent$(value: str): str;

export declare function tcpListen$(port: int): int;
export declare function tcpAccept$(listenerId: int): TaskHandle<int>;
export declare function tcpConnect$(host: str, port: int): TaskHandle<int>;
export declare function tcpConnectTls$(host: str, port: int, ca?: str): TaskHandle<int>;
export declare function tcpListenTls$(port: int, cert: str, key: str): int;
export declare function tcpRead$(connId: int, len: int): TaskHandle<Bytes?>;
export declare function tcpWrite$(connId: int, data: Bytes | str): TaskHandle<int>;
export declare function tcpClose$(connId: int): void;
export declare function tcpCloseListener$(listenerId: int): void;
export declare function parseHttpRequest$(raw: str): HttpRequestHead?;
export declare function httpMethodName$(method: HttpMethod): str;
export declare function sendHttpResponse$(connId: int, status: int, statusText: str, headers: { [key: str]: str }, body: str, cookies: str[]): TaskHandle<int>;

export declare function udpBind$(host: str, port: int): int;
export declare function udpSendTo$(socketId: int, host: str, port: int, data: Bytes | str): int;
export declare function udpRecvFrom$(socketId: int, maxLen: int): TaskHandle<[Bytes, str, int]?>;
export declare function udpClose$(socketId: int): void;