class Temperature {
    private _celsius: float

    constructor(c: float) {
        this._celsius = c
    }

    get celsius(): float {
        return this._celsius
    }

    set celsius(v: float) {
        this._celsius = v
    }

    get fahrenheit(): float {
        return this._celsius * 1.8 + 32.0
    }
}

const t = new Temperature(100.0)
assert("class getter", t.celsius === 100.0)
assert("class derived", t.fahrenheit === 212.0)
t.celsius = 0.0
assert("class setter", t.fahrenheit === 32.0)
print("class ok")
