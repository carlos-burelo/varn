function sum(nums: int[]): int {
    let total = 0
    for (const n of nums) {
        total = total + n
    }
    return total
}

function firstAbove(arr: int[], threshold: int): int {
    let i = 0
    let result = -1
    while (i < arr.length) {
        if (arr[i] > threshold) {
            result = arr[i]
            break
        }
        i = i + 1
    }
    return result
}

const nums = [3, 1, 4, 1, 5]
assert("loop sum", sum(nums) === 14)
assert("loop firstAbove", firstAbove(nums, 3) === 4)
print("loop ok")
