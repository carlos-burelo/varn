// runtime:text — font discovery + shaping (fontdb + egui fonts).
// Glyphs are chars; tests assert structure, never font-specific values.

export interface ShapedRun {
    glyphs: int[];
    advances: float[];
    clusters: int[];
    width: float;
    count: int;
}

export declare function fontCount$(): int;
export declare function fonts$(): str[];
export declare function shape$(text: str, size: float): ShapedRun;
export declare function ascent$(size: float): float;
export declare function descent$(size: float): float;
export declare function wrap$(text: str, size: float, max: float): str[];
