import { Flattened } from "core:types/aliases";

/**
 * Contiguous, indexable, growable sequence of `T`.
 */
export declare class Array<T> {
    constructor();
    @throws(RangeError) static filled<U>(length: int, value: U): U[];
    readonly length: int;
    @throws(RangeError) push(item: T): void;
    pop(): T?;
    shift(): T?;
    @throws(RangeError) unshift(item: T): void;
    join(separator?: str): str;
    entries(): (int, T)[];
    slice(start?: int, end?: int): T[];
    at(index: int): T?;
    @throws(RangeError) concat(...items: T[][]): T[];
    fill(value: T, start?: int, end?: int): this;
    @throws(Error) filter(predicate: (item: T, index: int, array: T[]) => bool): T[];
    @throws(Error) find(predicate: (item: T, index: int, array: T[]) => bool): T?;
    @throws(Error) findIndex(predicate: (item: T, index: int, array: T[]) => bool): int?;
    flat(): Flattened<T>[];
    @throws(Error) flatMap<U>(callback: (item: T, index: int, array: T[]) => U[]): U[];
    @throws(Error) forEach(callback: (item: T, index: int, array: T[]) => void): void;
    @throws(Error) map<U>(callback: (item: T, index: int, array: T[]) => U): U[];
    @throws(Error) reduce<U>(callback: (acc: U, item: T, index: int, array: T[]) => U, initial?: U): U;
    reverse(): this;
    @throws(Error) sort(compareFn?: (a: T, b: T) => int): this;
    splice(start: int, deleteCount?: int, ...items: T[]): T[];
    @throws(Error) every(predicate: (item: T, index: int, array: T[]) => bool): bool;
    @throws(Error) some(predicate: (item: T, index: int, array: T[]) => bool): bool;
    includes(search: T): bool;
    indexOf(search: T): int?;
    lastIndexOf(search: T): int?;
    toString(): str;

}

/**
 * The members of a view that receive a `T`, or return a type computed from `T`, cannot be
 * members of an `out T` interface. They forward to the array of the same name.
 */
export extension<T> on ReadonlyArray<T> {
    declare includes(search: T): bool;
    declare indexOf(search: T): int?;
    declare lastIndexOf(search: T): int?;
    declare flat(): ReadonlyArray<Flattened<T>>;
}

/**
 * Read-only view of an `Array<T>`, covariant in `T`. What it returns is also read-only.
 * `includes`, `indexOf` and `lastIndexOf` take a `T` and are extensions.
 */
export interface ReadonlyArray<out T> {
    length: int;
    join(separator?: str): str;
    entries(): ReadonlyArray<(int, T)>;
    slice(start?: int, end?: int): ReadonlyArray<T>;
    at(index: int): T?;
    filter(predicate: (item: T, index: int, array: ReadonlyArray<T>) => bool): ReadonlyArray<T>;
    find(predicate: (item: T, index: int, array: ReadonlyArray<T>) => bool): T?;
    findIndex(predicate: (item: T, index: int, array: ReadonlyArray<T>) => bool): int?;
    flatMap<U>(callback: (item: T, index: int, array: ReadonlyArray<T>) => U[]): U[];
    forEach(callback: (item: T, index: int, array: ReadonlyArray<T>) => void): void;
    map<U>(callback: (item: T, index: int, array: ReadonlyArray<T>) => U): U[];
    reduce<U>(callback: (acc: U, item: T, index: int, array: ReadonlyArray<T>) => U, initial?: U): U;
    every(predicate: (item: T, index: int, array: ReadonlyArray<T>) => bool): bool;
    some(predicate: (item: T, index: int, array: ReadonlyArray<T>) => bool): bool;
    toString(): str;
}
