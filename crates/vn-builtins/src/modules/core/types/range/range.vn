export declare class Range<T> {
    readonly start: T;
    readonly end: T;
    readonly inclusive: bool;
    @throws(IntegerOverflow) get length(): int;
    readonly stride: int;

    toString(): str;
    contains(val: T): bool;
    @throws(RangeError, IntegerOverflow) toArray(): T[];
    @throws(RangeError, IntegerOverflow) step(n: int): Range<T>;
    @throws(Error) forEach(callback: (val: T) => void): void;
    @throws(Error) map<U>(callback: (val: T) => U): U[];

    static from(start: int, end: int): Range<int>;
    static fromInclusive(start: int, end: int): Range<int>;
}
