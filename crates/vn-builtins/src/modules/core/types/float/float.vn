/**
 * IEEE 754 binary64 floating-point number.
 */
export declare class float {
    static MAX_VALUE: float;
    static LOWEST: float;
    static MIN_POSITIVE: float;
    static NAN: float;
    static INFINITY: float;
    static NEG_INFINITY: float;
    static EPSILON: float;
    @throws(ParseError) static parse(s: str): float;
    static tryParse(s: str): float?;
    isNaN(): bool;
    isFinite(): bool;
    isInfinite(): bool;

    toString(): str;
    valueOf(): float;
    @throws(RangeError) toFixed(digits?: int): str;
    abs(): float;
    sign(): float;
    negate(): float;
    min(other: float): float;
    max(other: float): float;
    @throws(RangeError) clamp(lo: float, hi: float): float;
    pow(exponent: float): float;
    isInteger(): bool;
    floor(): float;
    ceil(): float;
    round(): float;
    trunc(): float;
    @throws(IntegerOverflow) toInt(): int;
}
