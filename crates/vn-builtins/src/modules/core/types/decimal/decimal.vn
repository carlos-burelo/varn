/**
 * Arbitrary-precision decimal number, exact for money and other base-10
 * quantities.
 */
export declare class decimal {
    toString(): str;
    @throws(RangeError) toFixed(digits?: int): str;
    abs(): decimal;
    sign(): int;
    negate(): decimal;
    ceil(): decimal;
    floor(): decimal;
    round(): decimal;
    trunc(): decimal;
    fract(): decimal;
    scale(): int;
    isZero(): bool;
    isPositive(): bool;
    isNegative(): bool;
    @throws(RangeError, DivisionByZero) pow(exp: int): decimal;
    @throws(IntegerOverflow) toInt(): int;
    toFloat(): float;

    @throws(ParseError) static parse(s: str): decimal;
    static tryParse(s: str): decimal?;
}
