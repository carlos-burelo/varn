function makeAdder(n: int): (a: int) => int {
    return (x: int) => x + n
}

function makeCounter(): () => int {
    let c = 0
    return () => {
        c = c + 1
        return c
    }
}

const add5 = makeAdder(5)
if (add5(3) !== 8) throw new Error("closure add5")
const counter = makeCounter()
if (counter() !== 1) throw new Error("closure counter 1")
if (counter() !== 2) throw new Error("closure counter 2")
print("closure ok")
