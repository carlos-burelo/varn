function sum(nums: int[]): int {
    let total = 0
    for (const n of nums) {
        total = total + n
    }
    return total
}

function firstAbove(arr: int[], threshold: int): int {
    let i = 0
    let result = -1
    while (i < arr.length) {
        if (arr[i] > threshold) {
            result = arr[i]
            break
        }
        i = i + 1
    }
    return result
}

const nums = [3, 1, 4, 1, 5]
if (sum(nums) !== 14) throw new Error("loop sum")
if (firstAbove(nums, 3) !== 4) throw new Error("loop firstAbove")
print("loop ok")
