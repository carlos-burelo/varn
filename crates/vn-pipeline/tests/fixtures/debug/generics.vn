class Box<T> {
    value: T

    constructor(v: T) {
        this.value = v
    }

    get(): T {
        return this.value
    }

    map<U>(f: (T) => U): Box<U> {
        return new Box<U>(f(this.value))
    }
}

function identity<T>(v: T): T {
    return v
}

const intBox = new Box<int>(10)
if (intBox.get() !== 10) throw new Error("generics get")
if (identity<int>(42) !== 42) throw new Error("generics identity")
const strBox = intBox.map((n) => `value=${n}`)
if (strBox.get() !== "value=10") throw new Error("generics map")
print("generics ok")
