import { JSON } from "std:json";

class Route {
    method: str;
    segments: str[];
    handler: (req: ReqContext) => ResContext;

    constructor(method: str, pattern: str, handler: (req: ReqContext) => ResContext) {
        this.method = method;
        this.handler = handler;
        this.segments = [];

        let rawSegs = pattern.split("/");
        for (let i = 0; i < rawSegs.length; i = i + 1) {
            let s = rawSegs[i];
            if (s.length > 0) {
                this.segments.push(s);
            }
        }
    }

    match(method: str, pathSegments: str[]): { [key: str]: str }? {
        print("Route.match: start method=" + method);
        if (this.method !== "*" && this.method !== method) {
            return null;
        }
        if (this.segments.length !== pathSegments.length) {
            return null;
        }

        let params: { [key: str]: str } = {};
        for (let i = 0; i < this.segments.length; i = i + 1) {
            let seg = this.segments[i];
            let reqSeg = pathSegments[i];
            if (seg.startsWith(":")) {
                let pName = seg.slice(1);
                params[pName] = reqSeg;
            } else if (seg !== reqSeg) {
                return null;
            }
        }
        return params;
    }
}

class ReqContext {
    method: str;
    url: str;
    path: str;
    headers: { [key: str]: str };
    params: { [key: str]: str };
    query: { [key: str]: str };
    user: str?;

    constructor(method: str, url: str, headers: { [key: str]: str }) {
        this.method = method;
        this.url = url;
        this.headers = headers;
        this.params = {};
        this.query = {};
        this.user = null;

        let qIdx = url.indexOf("?");
        if (qIdx >= 0) {
            this.path = url.slice(0, qIdx);
            let qStr = url.slice(qIdx + 1);
            let pairs = qStr.split("&");
            for (let i = 0; i < pairs.length; i = i + 1) {
                let p = pairs[i];
                let eq = p.indexOf("=");
                if (eq > 0) {
                    this.query[p.slice(0, eq)] = p.slice(eq + 1);
                } else {
                    this.query[p] = "1";
                }
            }
        } else {
            this.path = url;
        }
    }
}

class ResContext {
    status: int;
    headers: { [key: str]: str };
    body: str;

    constructor(status: int, body: str, headers: { [key: str]: str }) {
        this.status = status;
        this.body = body;
        this.headers = headers;
    }
}

class Router {
    routes: Route[];

    constructor() {
        this.routes = [];
    }

    add(method: str, pattern: str, handler: (req: ReqContext) => ResContext): void {
        this.routes.push(new Route(method, pattern, handler));
    }

    dispatch(req: ReqContext): ResContext {
        print("dispatch: start this=" + typeof this + ", this.routes=" + typeof this.routes);
        let auth = req.headers["authorization"];
        print("D1: req=" + typeof req + ", method=" + req.method);
        if (auth == null || !auth.startsWith("Bearer ")) {
            return new ResContext(401, JSON.stringify({ error: "Unauthorized" }), { "Content-Type": "application/json" });
        }
        print("D2: req=" + typeof req + ", method=" + req.method);
        req.user = "user_" + (auth as str).slice(7, 12);
        print("D3: req=" + typeof req + ", method=" + req.method);

        let segs: str[] = [];
        print("D4: req=" + typeof req + ", method=" + req.method);
        let rawSegs = req.path.split("/");
        print("D5: req=" + typeof req + ", method=" + req.method);
        for (let i = 0; i < rawSegs.length; i = i + 1) {
            let s = rawSegs[i];
            if (s.length > 0) {
                segs.push(s);
            }
            print("D6." + i + ": req=" + typeof req + ", method=" + req.method);
        }
        print("D7: req=" + typeof req + ", method=" + req.method);

        for (let i = 0; i < this.routes.length; i = i + 1) {
            print("LOOP i=" + i + ", this.routes[i]=" + typeof this.routes[i] + ", req.method=" + req.method);
            let r = this.routes[i];
            let matchedParams = r.match(req.method, segs);
            if (matchedParams != null) {
                req.params = matchedParams;
                let h = r.handler;
                return h(req);
            }
        }

        return new ResContext(404, JSON.stringify({ error: "Not Found" }), { "Content-Type": "application/json" });
    }
}

let router = new Router();

function jsonRes(status: int, data: dynamic): ResContext {
    return new ResContext(status, JSON.stringify(data), {
        "Content-Type": "application/json",
        "X-Powered-By": "Varn-Native-Router"
    });
}

router.add("GET", "/api/v1/health", (req: ReqContext) => jsonRes(200, { status: "OK", uptime: 3600 }));
router.add("GET", "/api/v1/users", (req: ReqContext) => jsonRes(200, { users: ["Alice", "Bob"], page: req.query["page"] }));
router.add("POST", "/api/v1/users", (req: ReqContext) => jsonRes(201, { created: true, id: 999 }));
router.add("GET", "/api/v1/users/:id", (req: ReqContext) => jsonRes(200, { id: req.params["id"], name: "User_" + (req.params["id"] as str) }));
router.add("PUT", "/api/v1/users/:id", (req: ReqContext) => jsonRes(200, { updated: true, id: req.params["id"] }));
router.add("DELETE", "/api/v1/users/:id", (req: ReqContext) => jsonRes(204, { deleted: true }));
router.add("GET", "/api/v1/users/:id/orders", (req: ReqContext) => jsonRes(200, { userId: req.params["id"], count: 5 }));
router.add("POST", "/api/v1/users/:id/orders", (req: ReqContext) => jsonRes(201, { orderId: 888, userId: req.params["id"] }));
router.add("GET", "/api/v1/users/:id/orders/:orderId", (req: ReqContext) => jsonRes(200, { userId: req.params["id"], orderId: req.params["orderId"], status: "shipped" }));
router.add("GET", "/api/v1/products", (req: ReqContext) => jsonRes(200, { products: [1, 2, 3] }));
router.add("GET", "/api/v1/products/:id", (req: ReqContext) => jsonRes(200, { productId: req.params["id"], inStock: true }));
router.add("POST", "/api/v1/products", (req: ReqContext) => jsonRes(201, { created: true }));
router.add("GET", "/api/v1/categories", (req: ReqContext) => jsonRes(200, { categories: ["A", "B"] }));
router.add("GET", "/api/v1/categories/:id/products", (req: ReqContext) => jsonRes(200, { categoryId: req.params["id"], items: 10 }));
router.add("GET", "/api/v1/cart/:userId", (req: ReqContext) => jsonRes(200, { cart: req.params["userId"], items: 2 }));
router.add("POST", "/api/v1/cart/:userId/items", (req: ReqContext) => jsonRes(201, { added: true }));
router.add("DELETE", "/api/v1/cart/:userId/items/:itemId", (req: ReqContext) => jsonRes(200, { removed: req.params["itemId"] }));
router.add("POST", "/api/v1/checkout/:userId", (req: ReqContext) => jsonRes(200, { invoice: 12345, user: req.params["userId"] }));
router.add("GET", "/api/v1/analytics/overview", (req: ReqContext) => jsonRes(200, { activeUsers: 1500, sales: 45000 }));
router.add("GET", "/api/v1/system/metrics", (req: ReqContext) => jsonRes(200, { cpu: 12.5, memoryMb: 64 }));

let samplePaths = [
    "/api/v1/health",
    "/api/v1/users?page=2",
    "/api/v1/users/42",
    "/api/v1/users/42/orders",
    "/api/v1/users/42/orders/101",
    "/api/v1/products/505",
    "/api/v1/categories/12/products",
    "/api/v1/cart/88/items/99",
    "/api/v1/analytics/overview",
    "/api/v1/system/metrics"
];

let methods = ["GET", "GET", "GET", "GET", "GET", "GET", "GET", "DELETE", "GET", "GET"];

let reqs: ReqContext[] = [];
for (let i = 0; i < 5000; i = i + 1) {
    let idx = i % 10;
    let hdrs: { [key: str]: str } = {
        "authorization": "Bearer token_secret_" + (i % 1000),
        "content-type": "application/json",
        "user-agent": "VarnBench/1.0"
    };
    reqs.push(new ReqContext(methods[idx], samplePaths[idx], hdrs));
    if (i === 0 || i === 100 || i === 500 || i === 1000 || i === 2000 || i === 4999) {
        print("At i=" + i + ", reqs[0].method=" + reqs[0].method + ", reqs[0]=" + typeof reqs[0]);
    }
}

print("Routes before loop: " + router.routes.length);
print("Req 0 method: " + reqs[0].method);
print("Req 0 url: " + reqs[0].url);
print("Req 0 path: " + reqs[0].path);
print("Req 0 headers auth: " + reqs[0].headers["authorization"]);

let successCount = 0;
let totalBytes = 0;

for (let i = 0; i < reqs.length; i = i + 1) {
    if (i % 500 === 0) {
        print("Dispatching i = " + i);
    }
    let res = router.dispatch(reqs[i]);
    if (res.status === 200 || res.status === 201) {
        successCount = successCount + 1;
    }
    totalBytes = totalBytes + res.body.length;
}

print("Passed: " + reqs.length + " reqs, Success = " + successCount + ", Total Bytes = " + totalBytes);
