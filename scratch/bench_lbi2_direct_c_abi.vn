import { nowInstant } from "std:time"
import { abs } from "std:math"

const N = 10000000

function test_c_abi_fast_call(limit: int): float {
    let sum: float = 0.0
    for (let i: int = 0; i < limit; i = i + 1) {
        sum = sum + abs((i - 5000000) * 1.0)
    }
    return sum
}

// Warmup
test_c_abi_fast_call(100000)

print("--- LBI 2.0 DIRECT C-ABI NATIVE BUILTIN BENCHMARK (10,000,000 calls) ---")
let t1 = nowInstant().epochMilliseconds
let res = test_c_abi_fast_call(N)
let t2 = nowInstant().epochMilliseconds

print("10,000,000 LBI 2.0 Native Calls in: " + (t2 - t1) + " ms | Res: " + res)
