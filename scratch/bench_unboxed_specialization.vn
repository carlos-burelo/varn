import { nowInstant } from "std:time"

const N = 10000000

function calc_int(limit: int): int {
    let acc: int = 0
    for (let i: int = 0; i < limit; i = i + 1) {
        acc = acc + (i * 3) - (i >> 1)
    }
    return acc
}

function calc_float(limit: int): float {
    let acc: float = 0.0
    for (let i: int = 0; i < limit; i = i + 1) {
        acc = acc + (i * 0.5) - (i * 0.1)
    }
    return acc
}

// Warmup
calc_int(100000)
calc_float(100000)

print("--- UNBOXED SPECIALIZATION BENCHMARK (10,000,000 iterations) ---")
let t1 = nowInstant().epochMilliseconds
let res_i = calc_int(N)
let t2 = nowInstant().epochMilliseconds
print("Unboxed Int Math: " + (t2 - t1) + " ms | Res: " + res_i)

let t3 = nowInstant().epochMilliseconds
let res_f = calc_float(N)
let t4 = nowInstant().epochMilliseconds
print("Unboxed Float Math: " + (t4 - t3) + " ms | Res: " + res_f)
