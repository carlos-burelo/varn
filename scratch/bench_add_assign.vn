import { timeNowMs } from "runtime:time";

function runBench() {
    let start = timeNowMs();
    let sum = 0;
    let i = 0;
    while (i < 10000000) {
        sum += i;
        i = i + 1;
    }
    let end = timeNowMs();
    print("AddAssign Benchmark complete.");
    print("Sum: " + sum);
    print("Time taken: " + (end - start) + " ms");
}

runBench();
