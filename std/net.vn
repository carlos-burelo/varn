// std:net — host-backed network primitives and URL/query value types.

import {
    isIP as nativeIsIP,
    isIPv4 as nativeIsIPv4,
    isIPv6 as nativeIsIPv6,
    encodeURIComponent as nativeEncodeURIComponent,
    decodeURIComponent as nativeDecodeURIComponent
} from "runtime:net";

function trimPrefixQ(s: str): str {
    if (s.startsWith("?")) {
        return s.slice(1);
    }
    return s;
}

export class Query {
    private values: { [key: str]: str[] } = {};

    static parse(s: str): Query {
        const query = new Query();
        const text = trimPrefixQ(s);
        if (text.length == 0) {
            return query;
        }

        const entries = text.split("&");
        for (const entry of entries) {
            if (entry.length == 0) {
                continue;
            }

            const eq = entry.indexOf("=");
            const rawKey = eq >= 0 ? entry.slice(0, eq) : entry;
            const rawValue = eq >= 0 ? entry.slice(eq + 1) : "";

            query.append(nativeDecodeURIComponent(rawKey), nativeDecodeURIComponent(rawValue));
        }

        return query;
    }

    static fromObject(q: { [key: str]: str | str[] }): Query {
        const query = new Query();
        for (const key in q) {
            const value = q[key];
            if (Array.isArray(value)) {
                for (const item of value) {
                    query.append(key, item);
                }
            } else {
                query.append(key, value);
            }
        }
        return query;
    }

    get(key: str): str? {
        const bucket = this.values[key];
        if (bucket == null || bucket.length == 0) {
            return null;
        }
        return bucket[0];
    }

    getAll(key: str): str[] {
        const bucket = this.values[key];
        if (bucket == null) {
            return [];
        }
        return bucket.slice();
    }

    set(key: str, value: str): void {
        this.values[key] = [value];
    }

    append(key: str, value: str): void {
        const bucket = this.values[key];
        if (bucket == null) {
            this.values[key] = [value];
        } else {
            bucket.push(value);
        }
    }

    toObject(): { [key: str]: str[] } {
        return this.values;
    }

    toString(): str {
        const parts: str[] = [];
        for (const key in this.values) {
            const encodedKey = nativeEncodeURIComponent(key);
            const bucket = this.values[key];
            for (const value of bucket) {
                parts.push(encodedKey + "=" + nativeEncodeURIComponent(value));
            }
        }
        return str.join(parts, "&");
    }
}

export class Url {
    protocol: str = "";
    host: str = "";
    port: int? = null;
    path: str = "";
    query: Query = new Query();
    fragment: str = "";

    static parse(url: str): Url {
        const out = new Url();
        
        let rest = url;
        
        // 1. Extract protocol
        let protoIdx = rest.indexOf("://");
        if (protoIdx >= 0) {
            out.protocol = rest.slice(0, protoIdx);
            rest = rest.slice(protoIdx + 3);
        }
        
        // 2. Extract fragment
        let fragIdx = rest.indexOf("#");
        if (fragIdx >= 0) {
            out.fragment = rest.slice(fragIdx + 1);
            rest = rest.slice(0, fragIdx);
        }
        
        // 3. Extract query
        let queryIdx = rest.indexOf("?");
        let queryStr = "";
        if (queryIdx >= 0) {
            queryStr = rest.slice(queryIdx + 1);
            rest = rest.slice(0, queryIdx);
        }
        out.query = Query.parse(queryStr);
        
        // 4. Extract path and host/port
        let pathIdx = rest.indexOf("/");
        let hostAndPort = rest;
        if (pathIdx >= 0) {
            out.path = rest.slice(pathIdx);
            hostAndPort = rest.slice(0, pathIdx);
        } else {
            out.path = "/";
        }
        
        // 5. Extract host and port
        let portIdx = hostAndPort.indexOf(":");
        if (portIdx >= 0) {
            out.host = hostAndPort.slice(0, portIdx);
            let portStr = hostAndPort.slice(portIdx + 1);
            
            // Convert portStr to integer
            let portVal = 0;
            let keepParsing = true;
            for (let i = 0; i < portStr.length; i = i + 1) {
                if (keepParsing) {
                    let c = portStr[i];
                    let digit = -1;
                    if (c === "0") digit = 0;
                    else if (c === "1") digit = 1;
                    else if (c === "2") digit = 2;
                    else if (c === "3") digit = 3;
                    else if (c === "4") digit = 4;
                    else if (c === "5") digit = 5;
                    else if (c === "6") digit = 6;
                    else if (c === "7") digit = 7;
                    else if (c === "8") digit = 8;
                    else if (c === "9") digit = 9;
                    
                    if (digit >= 0) {
                        portVal = portVal * 10 + digit;
                    } else {
                        keepParsing = false;
                    }
                }
            }
            out.port = portVal;
        } else {
            out.host = hostAndPort;
            out.port = null;
        }
        
        return out;
    }

    withQuery(query: Query): Url {
        const next = new Url();
        next.protocol = this.protocol;
        next.host = this.host;
        next.port = this.port;
        next.path = this.path;
        next.query = query;
        next.fragment = this.fragment;
        return next;
    }

    toString(): str {
        let out = this.protocol + "://" + this.host;
        const port = this.port;
        if (port != null) {
            out = out + ":" + port.toString();
        }

        if (this.path.length == 0) {
            out = out + "/";
        } else {
            out = out + this.path;
        }

        const queryText = this.query.toString();
        if (queryText.length > 0) {
            out = out + "?" + queryText;
        }

        if (this.fragment.length > 0) {
            out = out + "#" + this.fragment;
        }

        return out;
    }
}

export function isIP(s: str): bool {
    return nativeIsIP(s);
}

export function isIPv4(s: str): bool {
    return nativeIsIPv4(s);
}

export function isIPv6(s: str): bool {
    return nativeIsIPv6(s);
}

export function parseURL(url: str): Url {
    return Url.parse(url);
}

export function parseQuery(s: str): Query {
    return Query.parse(s);
}

export function buildQuery(q: { [key: str]: str | str[] }): str {
    return Query.fromObject(q).toString();
}

export function appendQuery(url: str, q: { [key: str]: str | str[] }): str {
    let hasKeys = false;
    for (const key in q) {
        hasKeys = true;
        break;
    }
    if (!hasKeys) {
        return url;
    }

    const parsed = Url.parse(url);
    for (const key in q) {
        const value = q[key];
        if (Array.isArray(value)) {
            for (const item of value) {
                parsed.query.append(key, item);
            }
        } else {
            parsed.query.append(key, value);
        }
    }
    return parsed.toString();
}
