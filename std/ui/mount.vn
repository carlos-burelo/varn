import { ComponentScope, View } from "std:ui/state";
import { Widget } from "std:ui/widget/base";

const views = new Map<ComponentScope, View<Widget>>();

export function viewAt(scope: ComponentScope): View<Widget> {
    const existing = views.get(scope);
    if (existing !== null) {
        return existing;
    }
    const fresh = new View<Widget>(scope);
    views.set(scope, fresh);
    scope.onDispose(() => {
        fresh.dispose();
        views.delete(scope);
    });
    return fresh;
}
