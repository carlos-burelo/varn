import {
    open$,
    close$,
    shouldClose$,
    size$,
    inject$,
    poll$,
    rect$,
    text$,
    clear$,
    clip$,
    unclip$,
    present$,
    control$,
    activated$,
    commands$,
    real$,
    UiEvent,
    UiEventKind,
    UiInjectKind,
    UiControlKind
} from "runtime:ui";

export { UiEvent, UiEventKind, UiInjectKind, UiControlKind };

export class UiWindow {
    id: int;

    constructor(id: int) {
        this.id = id;
    }

    static open(title: str, w: int, h: int): UiWindow {
        return new UiWindow(open$(title, w, h));
    }

    close(): void {
        close$(this.id);
    }

    dispose(): void {
        close$(this.id);
    }

    shouldClose(): bool {
        return shouldClose$(this.id);
    }

    size(): int[] {
        return size$(this.id);
    }

    inject(kind: UiInjectKind, a: int, b: int, c: int): void {
        inject$(this.id, kind, a, b, c);
    }

    poll(): UiEvent[] {
        return poll$(this.id);
    }

    rect(x: float, y: float, w: float, h: float, color: int, radius: float = 0.0): void {
        rect$(this.id, x, y, w, h, color, radius);
    }

    text(x: float, y: float, s: str, size: float, color: int): void {
        text$(this.id, x, y, s, size, color);
    }

    clip(x: float, y: float, w: float, h: float): void {
        clip$(this.id, x, y, w, h);
    }

    unclip(): void {
        unclip$(this.id);
    }

    clear(color: int): void {
        clear$(this.id, color);
    }

    control(cid: int, kind: UiControlKind, x: float, y: float, w: float, h: float, color: int, flag: bool, value: float, low: float, high: float): void {
        control$(this.id, cid, kind, x, y, w, h, color, flag, value, low, high);
    }

    activated(): float[] {
        return activated$(this.id);
    }

    present(): int {
        return present$(this.id);
    }

    real(): bool {
        return real$(this.id);
    }

    commands(): str[] {
        return commands$(this.id);
    }
}
