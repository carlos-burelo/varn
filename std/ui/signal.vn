import { StateSlot, activeScope } from "std:ui/state";

export class Subscribers {
    list: Observer[] = [];
}

export abstract class Observer {
    deps: Subscribers[] = [];
    alive: bool = true;

    abstract fire(): void;
    abstract rerun(): void;

    deferred(): bool {
        return false;
    }
}

let _stack: Observer[] = [];
let _depth = 0;
let _pending: Observer[] = [];

function _top(): Observer? {
    if (_stack.length == 0) {
        return null;
    }
    return _stack[_stack.length - 1];
}

function _links(subs: Subscribers): void {
    const ob = _top();
    if (ob === null) {
        return;
    }
    if (!subs.list.includes(ob)) {
        subs.list.push(ob);
    }
    if (!ob.deps.includes(subs)) {
        ob.deps.push(subs);
    }
}

function _unlink(ob: Observer): void {
    for (let subs of ob.deps) {
        for (let j = subs.list.length - 1; j >= 0; j = j - 1) {
            if (subs.list[j] == ob) {
                subs.list.splice(j, 1);
            }
        }
    }
    ob.deps = [];
}

function _queue(ob: Observer): void {
    if (!_pending.includes(ob)) {
        _pending.push(ob);
    }
}

function _fire(subs: Subscribers): void {
    const snap = subs.list.slice(0, subs.list.length);
    for (let ob of snap) {
        if (!ob.alive) {
            continue;
        }
        if (_depth > 0 && ob.deferred()) {
            _queue(ob);
        } else {
            ob.fire();
        }
    }
}

export class Signal<T> {
    private _value: T;
    private _subs: Subscribers = new Subscribers();

    constructor(initial: T) {
        this._value = initial;
    }

    get value(): T {
        _links(this._subs);
        return this._value;
    }

    set value(next: T) {
        if (next == this._value) {
            return;
        }
        this._value = next;
        _fire(this._subs);
    }
}

export class Computed<T> extends Observer {
    private _derive: () => T;
    private _subs: Subscribers = new Subscribers();
    private _cached: T? = null;
    private _dirty: bool = true;

    constructor(derive: () => T) {
        super();
        this._derive = derive;
    }

    override fire(): void {
        if (!this.alive || this._dirty) {
            return;
        }
        this._dirty = true;
        _fire(this._subs);
    }

    override rerun(): void {
        this.recompute();
    }

    private evaluate(): T {
        _stack.push(this);
        try {
            return this._derive();
        } finally {
            _stack.pop();
        }
    }

    private recompute(): T {
        _unlink(this);
        const next = this.evaluate();
        const changed = next != this._cached;
        this._cached = next;
        this._dirty = false;
        _links(this._subs);
        if (changed) {
            _fire(this._subs);
        }
        return next;
    }

    get value(): T {
        if (this._dirty) {
            return this.recompute();
        }
        _links(this._subs);
        return this._cached as T;
    }
}

class Effect extends Observer {
    private _body: () => void;
    private _running: bool = false;

    constructor(body: () => void) {
        super();
        this._body = body;
    }

    override deferred(): bool {
        return true;
    }

    override fire(): void {
        if (!this.alive || this._running) {
            return;
        }
        if (_depth > 0) {
            _queue(this);
        } else {
            this.rerun();
        }
    }

    override rerun(): void {
        if (!this.alive || this._running) {
            return;
        }
        this._running = true;
        _unlink(this);
        _stack.push(this);
        try {
            this._body();
        } finally {
            _stack.pop();
            this._running = false;
        }
    }

    dispose(): void {
        this.alive = false;
        _unlink(this);
    }
}

class SignalSlot<T> extends StateSlot {
    signal: Signal<T>;

    constructor(signal: Signal<T>) {
        super();
        this.signal = signal;
    }
}

class ComputedSlot<T> extends StateSlot {
    computed: Computed<T>;

    constructor(computed: Computed<T>) {
        super();
        this.computed = computed;
    }

    override dispose(): void {
        this.computed.alive = false;
    }
}

class EffectSlot extends StateSlot {
    stop: () => void;

    constructor(stop: () => void) {
        super();
        this.stop = stop;
    }

    override dispose(): void {
        this.stop();
    }
}

export function signal<T>(initial: T): Signal<T> {
    const scope = activeScope();
    if (scope === null) {
        return new Signal<T>(initial);
    }
    const kept = scope.take();
    if (kept !== null) {
        return (kept as SignalSlot<T>).signal;
    }
    const created = new Signal<T>(initial);
    scope.keep(new SignalSlot<T>(created));
    return created;
}

export function computed<T>(derive: () => T): Computed<T> {
    const scope = activeScope();
    if (scope === null) {
        return new Computed<T>(derive);
    }
    const kept = scope.take();
    if (kept !== null) {
        return (kept as ComputedSlot<T>).computed;
    }
    const created = new Computed<T>(derive);
    scope.keep(new ComputedSlot<T>(created));
    return created;
}

export function effect(body: () => void): () => void {
    const scope = activeScope();
    if (scope !== null) {
        const kept = scope.take();
        if (kept !== null) {
            return (kept as EffectSlot).stop;
        }
    }
    const fx = new Effect(body);
    fx.rerun();
    const stop = () => fx.dispose();
    if (scope !== null) {
        scope.keep(new EffectSlot(stop));
    }
    return stop;
}

export function batch(body: () => void): void {
    _depth = _depth + 1;
    try {
        body();
    } finally {
        _depth = _depth - 1;
    }
    if (_depth == 0) {
        while (_pending.length > 0) {
            const queued = _pending.slice(0, _pending.length);
            _pending = [];
            for (let ob of queued) {
                if (ob.alive) {
                    ob.rerun();
                }
            }
        }
    }
}

export function untracked<T>(body: () => T): T {
    const saved = _stack;
    _stack = [];
    try {
        return body();
    } finally {
        _stack = saved;
    }
}
