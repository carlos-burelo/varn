import { UiWindow, UiEventKind } from "std:ui/window";
import { hit, MOUSE_LEFT } from "std:ui/keys";

export class UiFrame {
    mouseX: int;
    mouseY: int;
    left: bool;
    leftPressed: bool;
    leftReleased: bool;
    downX: int;
    downY: int;
    keys: int[];
    pressed: int[];
    repeated: int[];
    closed: bool;
    resized: bool;
    wheel: int;
    w: int;
    h: int;
    clips: float[][];
    modal: bool;
    overlayPass: bool;
    controlIds: int[];
    controlFns: (() => void)[];
    controlOverlay: bool[];

    constructor(w: int, h: int) {
        this.mouseX = 0;
        this.mouseY = 0;
        this.left = false;
        this.leftPressed = false;
        this.leftReleased = false;
        this.downX = -1;
        this.downY = -1;
        this.keys = [];
        this.pressed = [];
        this.repeated = [];
        this.closed = false;
        this.resized = false;
        this.wheel = 0;
        this.clips = [];
        this.modal = false;
        this.overlayPass = false;
        this.controlIds = [];
        this.controlFns = [];
        this.controlOverlay = [];
        this.w = w;
        this.h = h;
    }

    update(win: UiWindow): void {
        this.leftPressed = false;
        this.leftReleased = false;
        this.pressed = [];
        this.repeated = [];
        this.resized = false;
        this.wheel = 0;
        const evs = win.poll();
        for (let i = 0; i < evs.length; i = i + 1) {
            const e = evs[i];
            if (e.kind == UiEventKind.Mouse) {
                this.mouseX = e.x;
                this.mouseY = e.y;
                if (e.button == MOUSE_LEFT) {
                    if (e.pressed && !this.left) {
                        this.left = true;
                        this.leftPressed = true;
                        this.downX = e.x;
                        this.downY = e.y;
                    } else if (!e.pressed && this.left) {
                        this.left = false;
                        this.leftReleased = true;
                    }
                }
            } else if (e.kind == UiEventKind.Key) {
                if (e.pressed) {
                    if (!UiFrame.contains(this.keys, e.key)) {
                        this.keys.push(e.key);
                        this.pressed.push(e.key);
                    } else {
                        this.repeated.push(e.key);
                    }
                } else {
                    UiFrame.drop(this.keys, e.key);
                }
            } else if (e.kind == UiEventKind.Resize) {
                this.resized = true;
                this.w = e.w;
                this.h = e.h;
            } else if (e.kind == UiEventKind.Wheel) {
                this.wheel = this.wheel + e.y;
            } else if (e.kind == UiEventKind.Close) {
                this.closed = true;
            }
        }
    }

    held(key: int): bool {
        return UiFrame.contains(this.keys, key);
    }

    clearControls(): void {
        this.controlIds = [];
        this.controlFns = [];
        this.controlOverlay = [];
    }

    onActivate(id: int, fn: () => void): void {
        this.controlIds.push(id);
        this.controlFns.push(fn);
        this.controlOverlay.push(this.overlayPass);
    }

    fire(ids: int[]): void {
        for (let i = 0; i < ids.length; i = i + 1) {
            for (let j = 0; j < this.controlIds.length; j = j + 1) {
                if (this.controlIds[j] == ids[i] && (!this.modal || this.controlOverlay[j])) {
                    this.controlFns[j]();
                }
            }
        }
    }

    clicked(rx: float, ry: float, rw: float, rh: float): bool {
        if (this.modal && !this.overlayPass) {
            return false;
        }
        return this.leftReleased
            && this.visible(this.mouseX as float, this.mouseY as float)
            && this.visible(this.downX as float, this.downY as float)
            && hit(this.mouseX as float, this.mouseY as float, rx, ry, rw, rh)
            && hit(this.downX as float, this.downY as float, rx, ry, rw, rh);
    }

    pushClip(x: float, y: float, w: float, h: float): void {
        this.clips.push([x, y, w, h]);
    }

    popClip(): void {
        this.clips.pop();
    }

    visible(px: float, py: float): bool {
        for (let clip of this.clips) {
            if (!hit(px, py, clip[0], clip[1], clip[2], clip[3])) {
                return false;
            }
        }
        return true;
    }

    static contains(xs: int[], v: int): bool {
        for (let i = 0; i < xs.length; i = i + 1) {
            if (xs[i] == v) {
                return true;
            }
        }
        return false;
    }

    static drop(xs: int[], v: int): void {
        for (let i = 0; i < xs.length; i = i + 1) {
            if (xs[i] == v) {
                xs.splice(i, 1);
                return;
            }
        }
    }
}
