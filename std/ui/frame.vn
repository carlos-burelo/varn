import { UiWindow, UiEventKind, TypedText } from "std:ui/window";
import { TextEdit } from "std:ui/edit";
import { MOUSE_LEFT } from "std:ui/keys";

export class Handler {
    id: int;
    layer: int;
    onValue: ((value: float) => void)?;
    onText: ((text: str) => void)?;

    constructor(id: int, layer: int, onValue: ((value: float) => void)?, onText: ((text: str) => void)?) {
        this.id = id;
        this.layer = layer;
        this.onValue = onValue;
        this.onText = onText;
    }
}

export class UiFrame {
    mouseX: int;
    mouseY: int;
    left: bool;
    leftPressed: bool;
    leftReleased: bool;
    downX: int;
    downY: int;
    keys: int[];
    pressed: int[];
    repeated: int[];
    closed: bool;
    resized: bool;
    wheel: int;
    w: int;
    h: int;
    modal: bool;
    layer: int;
    modalFrom: int;
    handlers: Handler[];
    ids: Map<str, int>;
    lastId: int;
    edits: Map<int, TextEdit>;

    constructor(w: int, h: int) {
        this.mouseX = 0;
        this.mouseY = 0;
        this.left = false;
        this.leftPressed = false;
        this.leftReleased = false;
        this.downX = -1;
        this.downY = -1;
        this.keys = [];
        this.pressed = [];
        this.repeated = [];
        this.closed = false;
        this.resized = false;
        this.wheel = 0;
        this.modal = false;
        this.layer = 0;
        this.modalFrom = -1;
        this.handlers = [];
        this.ids = new Map<str, int>();
        this.lastId = 0;
        this.edits = new Map<int, TextEdit>();
        this.w = w;
        this.h = h;
    }

    update(win: UiWindow): void {
        this.leftPressed = false;
        this.leftReleased = false;
        this.pressed = [];
        this.repeated = [];
        this.resized = false;
        this.wheel = 0;
        const evs = win.poll();
        for (let i = 0; i < evs.length; i = i + 1) {
            const e = evs[i];
            if (e.kind == UiEventKind.Mouse) {
                this.mouseX = e.x;
                this.mouseY = e.y;
                if (e.button == MOUSE_LEFT) {
                    if (e.pressed && !this.left) {
                        this.left = true;
                        this.leftPressed = true;
                        this.downX = e.x;
                        this.downY = e.y;
                    } else if (!e.pressed && this.left) {
                        this.left = false;
                        this.leftReleased = true;
                    }
                }
            } else if (e.kind == UiEventKind.Key) {
                if (e.pressed) {
                    if (!UiFrame.contains(this.keys, e.key)) {
                        this.keys.push(e.key);
                        this.pressed.push(e.key);
                    } else {
                        this.repeated.push(e.key);
                    }
                } else {
                    UiFrame.drop(this.keys, e.key);
                }
            } else if (e.kind == UiEventKind.Resize) {
                this.resized = true;
                this.w = e.w;
                this.h = e.h;
            } else if (e.kind == UiEventKind.Wheel) {
                this.wheel = this.wheel + e.y;
            } else if (e.kind == UiEventKind.Close) {
                this.closed = true;
            }
        }
    }

    held(key: int): bool {
        return UiFrame.contains(this.keys, key);
    }

    clearControls(): void {
        this.handlers = [];
        this.layer = 0;
        this.modalFrom = -1;
        this.modal = false;
    }

    idOf(path: str): int {
        const known = this.ids.get(path);
        if (known !== null) {
            return known;
        }
        this.lastId = this.lastId + 1;
        this.ids.set(path, this.lastId);
        return this.lastId;
    }

    editFor(slot: int): TextEdit {
        const known = this.edits.get(slot);
        if (known !== null) {
            return known;
        }
        const fresh = new TextEdit();
        this.edits.set(slot, fresh);
        return fresh;
    }

    enterLayer(modal: bool): void {
        this.layer = this.layer + 1;
        if (modal) {
            this.modal = true;
            this.modalFrom = this.layer;
        }
    }

    onActivate(id: int, fn: (value: float) => void): void {
        this.handlers.push(new Handler(id, this.layer, fn, null));
    }

    onType(id: int, fn: (text: str) => void): void {
        this.handlers.push(new Handler(id, this.layer, null, fn));
    }

    reachable(h: Handler): bool {
        return h.layer >= this.modalFrom;
    }

    fireTyped(changes: TypedText[]): void {
        for (let change of changes) {
            for (let h of this.handlers) {
                const onText = h.onText;
                if (h.id == change.id && onText !== null && this.reachable(h)) {
                    onText(change.text);
                }
            }
        }
    }

    fire(pairs: float[]): void {
        for (let i = 0; i + 1 < pairs.length; i = i + 2) {
            const id = pairs[i] as int;
            for (let h of this.handlers) {
                const onValue = h.onValue;
                if (h.id == id && onValue !== null && this.reachable(h)) {
                    onValue(pairs[i + 1]);
                }
            }
        }
    }

    static contains(xs: int[], v: int): bool {
        for (let i = 0; i < xs.length; i = i + 1) {
            if (sameValue(xs[i], v)) {
                return true;
            }
        }
        return false;
    }

    static drop(xs: int[], v: int): void {
        for (let i = 0; i < xs.length; i = i + 1) {
            if (sameValue(xs[i], v)) {
                xs.splice(i, 1);
                return;
            }
        }
    }
}
