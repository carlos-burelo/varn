import { UiWindow } from "std:ui/window";
import { present$ } from "runtime:ui";
import { UiFrame } from "std:ui/frame";
import { Focus } from "std:ui/focus";
import { Widget, PaintContext, paintAt, nextLayoutEpoch } from "std:ui/widget/base";
import { KEY_ESCAPE } from "std:ui/keys";
import { beginFrame, endFrame } from "std:ui/state";
import { args } from "std:sys/args";
import { Theme } from "std:ui/style";
import { computed } from "std:signals";

export function present(win: UiWindow, fr: UiFrame): void {
    win.setDark(Theme.dark.peek());
    present$(win.id);
    fr.fireTyped(win.typed());
    fr.fire(win.activated());
}

export function render(win: UiWindow, fr: UiFrame, focus: Focus, root: Widget, x: float, y: float, w: float, h: float): void {
    nextLayoutEpoch();
    fr.clearControls();
    const cx = new PaintContext(win, fr, focus);
    paintAt(root, cx, x, y, w, h);
    for (let layer of cx.overlays) {
        fr.enterLayer(layer.modal);
        layer.paint(cx);
    }
}

const HEADLESS_FRAMES: int = 5;
const HEADLESS_FLAG: str = "--headless";

export function run(title: str, build: (fr: UiFrame, focus: Focus) => Widget, w: int = 800, h: int = 600, bg: int = -1, maxFrames: int = 0): void {
    const headless = args().indexOf(HEADLESS_FLAG) !== null;
    const limit = maxFrames > 0 ? maxFrames : (headless ? HEADLESS_FRAMES : 0);
    using win = UiWindow.open(title, w, h, headless);
    const fr = new UiFrame(w, h);
    const focus = new Focus();
    const root = computed((): Widget => build(fr, focus));
    let frames = 0;
    while (!fr.closed) {
        fr.update(win);
        if (fr.held(KEY_ESCAPE)) {
            break;
        }
        win.clear(bg >= 0 ? bg : Theme.colors.background);
        beginFrame();
        render(win, fr, focus, root.value, 0.0, 0.0, fr.w as float, fr.h as float);
        endFrame();
        present(win, fr);
        frames = frames + 1;
        if (limit > 0 && frames >= limit) {
            break;
        }
    }
}
