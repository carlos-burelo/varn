import { Widget, Size, PaintContext, Constraints, Placement, paintPlaced, layoutAt } from "std:ui/widget/base";
import { WindowClass, windowClassOf } from "std:ui/style";
import { Signal } from "std:signals";
import { newComponentDefinition, scopeAtMount } from "std:ui/state";
import { viewAt } from "std:ui/mount";

const RESPONSIVE = newComponentDefinition();

function classKey(cls: WindowClass): str {
    if (cls == WindowClass.compact) {
        return "compact";
    }
    if (cls == WindowClass.medium) {
        return "medium";
    }
    return "expanded";
}

export class AdaptiveValue<T> {
    compact: T;
    medium: T;
    expanded: T;

    constructor(compact: T, medium: T, expanded: T) {
        this.compact = compact;
        this.medium = medium;
        this.expanded = expanded;
    }
}

export function Adaptive<T>(values: { compact: T, medium: T, expanded: T }): AdaptiveValue<T> {
    return new AdaptiveValue<T>(values.compact, values.medium, values.expanded);
}

export function resolveFloat(value: float | AdaptiveValue<float>, cls: WindowClass): float {
    if (value is AdaptiveValue<float>) {
        const picked = value as AdaptiveValue<float>;
        if (cls == WindowClass.compact) {
            return picked.compact;
        }
        if (cls == WindowClass.medium) {
            return picked.medium;
        }
        return picked.expanded;
    }
    return value as float;
}

export class ResponsiveNode extends Widget {
    cls: Signal<WindowClass>;
    body: () => Widget;

    constructor(build: (cls: WindowClass) => Widget) {
        super();
        this.cls = new Signal<WindowClass>(WindowClass.compact, null);
        this.body = () => build(this.cls.value);
    }

    override computeLayout(c: Constraints): Placement {
        const cls = c.windowClass;
        this.cls.set(cls);
        const placed = layoutAt(viewAt(scopeAtMount(RESPONSIVE)).describe(this.body), classKey(cls), c);
        return new Placement(this, placed.size, [placed]);
    }

    override paint(cx: PaintContext, p: Placement, x: float, y: float): void {
        cx.keyed(classKey(this.cls.peek()), () => paintPlaced(cx, p.children[0], x, y));
    }
}

export function Responsive(build: (cls: WindowClass) => Widget): Widget {
    return new ResponsiveNode(build);
}
