import { UiWindow } from "std:ui/window";
import { UiFrame } from "std:ui/frame";
import { Focus } from "std:ui/focus";
import { TextEdit } from "std:ui/edit";
import { KEY_ESCAPE, KEY_ENTER } from "std:ui/keys";
import { row, col, textX, textY, ellipsize } from "std:ui/layout";
import { TextStyle, MainAxis, CrossAxis } from "std:ui/style";
import { measure, ascent, descent } from "std:text";
import { now } from "std:time";

export type Widget = dynamic;

export function Label(text: str, size: float = 20.0, color: int = 4294967295, align: str = "left", style: TextStyle = TextStyle.body, maxLines: int = 0): Widget {
    return { kind: "label", w: -1.0, h: -1.0, text: text, size: size, color: color, align: align, style: style, maxLines: maxLines };
}

export function Box(w: float = -1.0, h: float = -1.0, color: int = 4278190080, radius: float = 0.0, pad: float = 0.0, onClick: dynamic = null, child: Widget = null): Widget {
    return {
        kind: "box", w: w, h: h, color: color, radius: radius, pad: pad, onClick: onClick,
        child: child
    };
}

export function Column(children: Widget[], gap: float = 8.0, pad: float = 0.0, w: float = -1.0, h: float = -1.0, mainAxis: MainAxis = MainAxis.start, crossAxis: CrossAxis = CrossAxis.stretch): Widget {
    return {
        kind: "column", w: w, h: h,
        children: children, gap: gap, pad: pad, mainAxis: mainAxis, crossAxis: crossAxis
    };
}

export function Row(children: Widget[], gap: float = 8.0, pad: float = 0.0, w: float = -1.0, h: float = -1.0, mainAxis: MainAxis = MainAxis.start, crossAxis: CrossAxis = CrossAxis.stretch): Widget {
    return {
        kind: "row", w: w, h: h,
        children: children, gap: gap, pad: pad, mainAxis: mainAxis, crossAxis: crossAxis
    };
}

export function Button(label: str, onPress: () => void, w: float = -1.0, h: float = 44.0, color: int = 4278255360, fg: int = 4278190080, size: float = 20.0, radius: float = 10.0, enabled: bool = true): Widget {
    return {
        kind: "button", w: w, h: h, label: label,
        onPress: onPress, color: color, fg: fg, size: size, radius: radius, enabled: enabled
    };
}

export function Field(edit?: TextEdit, hint: str = "", h: float = 44.0, size: float = 20.0, onSubmit: dynamic = null): Widget {
    return {
        kind: "field", w: -1.0, h: h, edit: edit,
        hint: hint, size: size, onSubmit: onSubmit
    };
}

const fieldEdits = new Map<int, TextEdit>();

function flexW(n: Widget): float {
    if (n.w >= 0.0) {
        return 0.0 - n.w;
    }
    return 1.0;
}

function flexH(n: Widget): float {
    if (n.kind == "label") {
        return 0.0 - (ascent(n.size) + descent(n.size));
    }
    if (n.h >= 0.0) {
        return 0.0 - n.h;
    }
    return 1.0;
}

function drawLabel(win: UiWindow, x: float, y: float, w: float, h: float, n: Widget): void {
    const ty = textY(y, h, n.size);
    if (n.align == "center") {
        win.text(textX(x, w, n.text, n.size), ty, n.text, n.size, n.color);
    } else if (n.align == "right") {
        win.text(x + w - measure(n.text, n.size), ty, n.text, n.size, n.color);
    } else {
        win.text(x, ty, ellipsize(n.text, n.size, w), n.size, n.color);
    }
}

function drawBox(win: UiWindow, fr: UiFrame, focus: Focus, st: dynamic, x: float, y: float, w: float, h: float, n: Widget): void {
    win.rect(x, y, w, h, n.color, n.radius);
    if (n.onClick != null && fr.clicked(x, y, w, h)) {
        n.onClick();
    }
    if (n.child != null) {
        place(win, fr, focus, st, n.child, x + n.pad, y + n.pad, w - 2.0 * n.pad, h - 2.0 * n.pad);
    }
}

function pressShade(color: int): int {
    const a = (color / 16777216) % 256;
    const r = ((color / 65536) % 256) * 8 / 10;
    const g = ((color / 256) % 256) * 8 / 10;
    const b = (color % 256) * 8 / 10;
    return a * 16777216 + r * 65536 + g * 256 + b;
}

function drawButton(win: UiWindow, fr: UiFrame, x: float, y: float, w: float, h: float, n: Widget): void {
    const enabled = n.enabled ?? true;
    const held = enabled && fr.left && (fr.downX as float) >= x && (fr.downX as float) < x + w && (fr.downY as float) >= y && (fr.downY as float) < y + h;
    win.rect(x, y, w, h, enabled ? (held ? pressShade(n.color) : n.color) : 4287137928, n.radius);
    win.text(textX(x, w, n.label, n.size), textY(y, h, n.size), n.label, n.size, enabled ? n.fg : 4278190080);
    if (enabled && fr.clicked(x, y, w, h)) {
        n.onPress();
    }
}

function paintField(win: UiWindow, x: float, y: float, w: float, h: float, ed: TextEdit, hint: str, size: float): void {
    win.rect(x, y, w, h, ed.focused ? 4294967295 : 4287137928, 10.0);
    win.rect(x + 2.0, y + 2.0, w - 4.0, h - 4.0, 4278190080, 8.0);
    const line = ed.text.split("\n")[0];
    if (line == "" && !ed.focused) {
        win.text(x + 12.0, textY(y, h, size), hint, size, 4287137928);
    } else {
        win.text(x + 12.0, textY(y, h, size), line, size, 4294967295);
    }
    if (ed.focused && ((now() / 500) % 2 == 0)) {
        const upto = ed.cursor < line.length ? ed.cursor : line.length;
        const cx = x + 12.0 + measure(line.slice(0, upto), size);
        win.rect(cx, y + 8.0, 2.0, h - 16.0, 4294967295);
    }
}

function drawField(win: UiWindow, fr: UiFrame, focus: Focus, st: dynamic, x: float, y: float, w: float, h: float, n: Widget): void {
    st.n = st.n + 1;
    let ed: dynamic = n.edit;
    if (ed == null) {
        const owned = fieldEdits.get(st.n);
        if (owned == null) {
            const fresh = new TextEdit();
            fieldEdits.set(st.n, fresh);
            ed = fresh;
        } else {
            ed = owned;
        }
    }
    ed.update(fr, focus, st.n, x, y, w, h);
    if (ed.focused && n.onSubmit != null) {
        for (let i = 0; i < fr.pressed.length; i = i + 1) {
            if (fr.pressed[i] == KEY_ENTER) {
                n.onSubmit(ed.text.split("\n")[0]);
                ed.clear();
            }
        }
    }
    paintField(win, x, y, w, h, ed, n.hint, n.size);
}

function drawInput(win: UiWindow, fr: UiFrame, focus: Focus, st: dynamic, x: float, y: float, w: float, h: float, n: Widget): void {
    st.n = st.n + 1;
    let ed: TextEdit? = fieldEdits.get(st.n);
    if (ed == null) {
        const fresh = new TextEdit();
        fieldEdits.set(st.n, fresh);
        ed = fresh;
    }
    const owned = ed as TextEdit;
    if (owned.text != n.value) {
        owned.text = n.value;
        owned.cursor = n.value.length;
    }
    owned.update(fr, focus, st.n, x, y, w, h);
    if (owned.text != n.value) {
        n.onChange(owned.text);
    }
    paintField(win, x, y, w, h, owned, n.hint, n.size);
}

function mainShift(rs: float[][], total: float, horizontal: bool, main: MainAxis): float[][] {
    const count = rs.length;
    if (count == 0) {
        return rs;
    }
    let first = horizontal ? rs[0][0] : rs[0][1];
    let lastEnd = first;
    for (let i = 0; i < count; i = i + 1) {
        const s = horizontal ? rs[i][0] : rs[i][1];
        const len = horizontal ? rs[i][2] : rs[i][3];
        if (s < first) {
            first = s;
        }
        if (s + len > lastEnd) {
            lastEnd = s + len;
        }
    }
    const base = horizontal ? rs[0][0] : rs[0][1];
    const leftover = total - (lastEnd - first);
    if (leftover <= 0.0) {
        return rs;
    }
    const idx = horizontal ? 0 : 1;
    if (main == MainAxis.center) {
        const off = leftover / 2.0;
        for (let i = 0; i < count; i = i + 1) {
            rs[i][idx] = rs[i][idx] + off;
        }
    } else if (main == MainAxis.end) {
        for (let i = 0; i < count; i = i + 1) {
            rs[i][idx] = rs[i][idx] + leftover;
        }
    } else if (main == MainAxis.spaceBetween && count > 1) {
        const step = leftover / ((count - 1) as float);
        for (let i = 0; i < count; i = i + 1) {
            rs[i][idx] = rs[i][idx] + step * (i as float);
        }
    } else if (main == MainAxis.spaceAround) {
        const step = leftover / (count as float);
        for (let i = 0; i < count; i = i + 1) {
            rs[i][idx] = rs[i][idx] + step * ((i as float) + 0.5) - (base - first);
        }
    } else if (main == MainAxis.spaceEvenly) {
        const step = leftover / ((count + 1) as float);
        for (let i = 0; i < count; i = i + 1) {
            rs[i][idx] = rs[i][idx] + step * ((i + 1) as float);
        }
    }
    return rs;
}

function placeColumn(win: UiWindow, fr: UiFrame, focus: Focus, st: dynamic, n: Widget, x: float, y: float, w: float, h: float): void {
    const ix = x + n.pad;
    const iy = y + n.pad;
    const iw = w - 2.0 * n.pad;
    const ih = h - 2.0 * n.pad;
    const ws: float[] = [];
    for (let i = 0; i < n.children.length; i = i + 1) {
        ws.push(flexH(n.children[i]));
    }
    const rs = mainShift(col(ix, iy, iw, ih, ws, n.gap), ih, false, n.mainAxis ?? MainAxis.start);
    const cross: CrossAxis = n.crossAxis ?? CrossAxis.stretch;
    for (let i = 0; i < n.children.length; i = i + 1) {
        const c: Widget = n.children[i];
        let cx = rs[i][0];
        let cw = rs[i][2];
        if (cross != CrossAxis.stretch && c.w >= 0.0 && c.w < cw) {
            if (cross == CrossAxis.center) {
                cx = cx + (cw - c.w) / 2.0;
            } else if (cross == CrossAxis.end) {
                cx = cx + cw - c.w;
            }
            cw = c.w;
        }
        place(win, fr, focus, st, c, cx, rs[i][1], cw, rs[i][3]);
    }
}

function placeRow(win: UiWindow, fr: UiFrame, focus: Focus, st: dynamic, n: Widget, x: float, y: float, w: float, h: float): void {
    const ix = x + n.pad;
    const iy = y + n.pad;
    const iw = w - 2.0 * n.pad;
    const ih = h - 2.0 * n.pad;
    const ws: float[] = [];
    for (let i = 0; i < n.children.length; i = i + 1) {
        ws.push(flexW(n.children[i]));
    }
    const rs = mainShift(row(ix, iy, iw, ih, ws, n.gap), iw, true, n.mainAxis ?? MainAxis.start);
    const cross: CrossAxis = n.crossAxis ?? CrossAxis.stretch;
    for (let i = 0; i < n.children.length; i = i + 1) {
        const c: Widget = n.children[i];
        let cy = rs[i][1];
        let ch = rs[i][3];
        if (cross != CrossAxis.stretch && c.h >= 0.0 && c.h < ch) {
            if (cross == CrossAxis.center) {
                cy = cy + (ch - c.h) / 2.0;
            } else if (cross == CrossAxis.end) {
                cy = cy + ch - c.h;
            }
            ch = c.h;
        }
        place(win, fr, focus, st, c, rs[i][0], cy, rs[i][2], ch);
    }
}

function place(win: UiWindow, fr: UiFrame, focus: Focus, st: dynamic, n: Widget, x: float, y: float, w: float, h: float): void {
    if (n.kind == "label") {
        drawLabel(win, x, y, w, h, n);
    } else if (n.kind == "box") {
        drawBox(win, fr, focus, st, x, y, w, h, n);
    } else if (n.kind == "button") {
        drawButton(win, fr, x, y, w, h, n);
    } else if (n.kind == "field") {
        drawField(win, fr, focus, st, x, y, w, h, n);
    } else if (n.kind == "input") {
        drawInput(win, fr, focus, st, x, y, w, h, n);
    } else if (n.kind == "column") {
        placeColumn(win, fr, focus, st, n, x, y, w, h);
    } else if (n.kind == "row") {
        placeRow(win, fr, focus, st, n, x, y, w, h);
    } else if (n.kind == "stack") {
        for (let i = 0; i < n.children.length; i = i + 1) {
            place(win, fr, focus, st, n.children[i], x, y, w, h);
        }
    } else if (n.kind == "padding") {
        let l = n.left;
        if (l < 0.0) {
            l = n.all;
        }
        let t = n.top;
        if (t < 0.0) {
            t = n.all;
        }
        let r = n.right;
        if (r < 0.0) {
            r = n.all;
        }
        let b = n.bottom;
        if (b < 0.0) {
            b = n.all;
        }
        let cw = w - l - r;
        if (cw < 0.0) {
            cw = 0.0;
        }
        let ch = h - t - b;
        if (ch < 0.0) {
            ch = 0.0;
        }
        if (n.child != null) {
            place(win, fr, focus, st, n.child, x + l, y + t, cw, ch);
        }
    } else if (n.kind == "sizedBox") {
        if (n.child != null) {
            place(win, fr, focus, st, n.child, x, y, w, h);
        }
    } else if (n.kind == "animated") {
        if (n.child != null) {
            place(win, fr, focus, st, n.child, x, y, w, h);
        }
    } else if (n.kind == "image") {
        win.rect(x, y, w, h, n.bg, 8.0);
        place(win, fr, focus, st, Label(text: n.source, size: 14.0, color: n.fg, align: "center"), x + 8.0, y, w - 16.0, h);
    } else if (n.kind == "progress") {
        win.rect(x, y, w, h, n.track, h / 2.0);
        if (n.value < 0.0) {
            const t = (((now() / 300) % 10) as float) / 10.0;
            const pw = w * 0.4;
            win.rect(x + (w - pw) * t, y, pw, h, n.color, h / 2.0);
        } else {
            let frac = n.value;
            if (frac > 1.0) {
                frac = 1.0;
            }
            if (frac < 0.0) {
                frac = 0.0;
            }
            win.rect(x, y, w * frac, h, n.color, h / 2.0);
        }
    }
}

export function render(win: UiWindow, fr: UiFrame, focus: Focus, root: Widget, x: float, y: float, w: float, h: float): void {
    const st = { n: 1000 };
    place(win, fr, focus, st, root, x, y, w, h);
}

export function Spacer(): Widget {
    return Box();
}

export function Divider(color: int = 4287137928): Widget {
    return Box(h: 1.0, color: color);
}

export function Checkbox(checked: bool, onToggle: () => void, size: float = 30.0, color: int = 4278255360, check: int = 4278190080): Widget {
    return Box(
        w: size, h: size, color: checked ? color : 4287137928, radius: 8.0,
        child: checked ? Label("x", size: size * 0.66, color: check, align: "center") : null,
        onClick: onToggle
    );
}

export function List(items: dynamic[], build: (item: dynamic, index: int) => Widget[], rowH: float = 34.0, gap: float = 4.0): Widget {
    const rows: Widget[] = [];
    for (let i = 0; i < items.length; i = i + 1) {
        rows.push(Row(h: rowH, gap: 8.0, children: build(items[i], i)));
    }
    return Column(gap: gap, children: rows);
}

export function run(title: str, build: (fr: UiFrame, focus: Focus) => Widget, w: int = 800, h: int = 600, bg: int = 4278190080, maxFrames: int = 0): void {
    using win = UiWindow.open(title, w, h);
    const fr = new UiFrame(w, h);
    const focus = new Focus();
    let frames = 0;
    while (!fr.closed) {
        fr.update(win);
        if (fr.held(KEY_ESCAPE)) {
            break;
        }
        win.clear(bg);
        render(win, fr, focus, build(fr, focus), 0.0, 0.0, w as float, h as float);
        win.present();
        frames = frames + 1;
        if (maxFrames > 0 && frames >= maxFrames) {
            break;
        }
    }
}
