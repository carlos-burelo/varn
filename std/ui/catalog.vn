import { Widget } from "std:ui/widget/base";
import { Label, TextAlign } from "std:ui/widget/text";
import { Box, Spacer, Expanded, Divider, Checkbox, StackNode, PaddingNode, SizedBoxNode, AnimatedNode, ImageNode, ProgressNode } from "std:ui/widget/box";
import { Column, Row } from "std:ui/widget/flex";
import { Button, InputNode } from "std:ui/widget/controls";
import { TextStyle, MainAxis, CrossAxis, Alignment, BoxFit, Curve, Colors, Theme, textSizeFor, textColorFor } from "std:ui/style";

export namespace ui {
    export function column(children: Widget[] = [], gap: float = 8.0, padding: float = 0.0, mainAxis: MainAxis = MainAxis.start, crossAxis: CrossAxis = CrossAxis.start, w: float = -1.0, h: float = -1.0): Widget {
        return Column(children: children, gap: gap, pad: padding, w: w, h: h, mainAxis: mainAxis, crossAxis: crossAxis);
    }

    export function row(children: Widget[] = [], gap: float = 8.0, padding: float = 0.0, mainAxis: MainAxis = MainAxis.start, crossAxis: CrossAxis = CrossAxis.center, w: float = -1.0, h: float = -1.0): Widget {
        return Row(children: children, gap: gap, pad: padding, w: w, h: h, mainAxis: mainAxis, crossAxis: crossAxis);
    }

    export function stack(children: Widget[] = [], alignment: Alignment = Alignment.center): Widget {
        return new StackNode(children, alignment);
    }

    export function padding(child: Widget? = null, all: float = 0.0, left: float = -1.0, top: float = -1.0, right: float = -1.0, bottom: float = -1.0): Widget {
        return new PaddingNode(
            child,
            left < 0.0 ? all : left,
            top < 0.0 ? all : top,
            right < 0.0 ? all : right,
            bottom < 0.0 ? all : bottom
        );
    }

    export function sizedBox(child: Widget? = null, width: float = -1.0, height: float = -1.0): Widget {
        return new SizedBoxNode(child, width, height);
    }

    export function spacer(flex: float = 1.0): Widget {
        return Spacer(flex);
    }

    export function text(value: str, style: TextStyle = TextStyle.body, color: int = -1, size: float = 0.0, align: TextAlign = TextAlign.left, maxLines: int = 0): Widget {
        let s = size;
        if (s <= 0.0) {
            s = textSizeFor(style);
        }
        let c = color;
        if (c < 0) {
            c = textColorFor(style);
        }
        return Label(text: value, size: s, color: c, align: align, style: style, maxLines: maxLines);
    }

    export function button(text: str, onPress: () => void, enabled: bool = true, w: float = -1.0, h: float = 40.0, color: int = Theme.colors.primary, fg: int = Theme.colors.onPrimary, size: float = 17.0, radius: float = 8.0): Widget {
        return Button(label: text, onPress: onPress, w: w, h: h, color: color, fg: fg, size: size, radius: radius, enabled: enabled);
    }

    export function input(value: str, onChange: (v: str) => void, placeholder: str = "", h: float = 44.0, size: float = 18.0): Widget {
        return new InputNode(value, onChange, placeholder, h, size);
    }

    export function image(source: str, width: float = -1.0, height: float = -1.0, fit: BoxFit = BoxFit.cover): Widget {
        return new ImageNode(source, width, height, fit);
    }

    export function progressIndicator(value: float = -1.0, color: int = Theme.colors.primary, track: int = Theme.colors.outline, h: float = 8.0): Widget {
        return new ProgressNode(value, color, track, h);
    }

    export function container(child: Widget? = null, padding: float = 0.0, background: int = Colors.transparent, radius: float = 0.0, w: float = -1.0, h: float = -1.0): Widget {
        return Box(w: w, h: h, color: background, radius: radius, pad: padding, child: child);
    }

    export function card(child: Widget? = null, padding: float = 16.0, radius: float = 12.0, w: float = -1.0, h: float = -1.0): Widget {
        return Box(w: w, h: h, color: Theme.colors.surface, radius: radius, pad: padding, child: child);
    }

    export function expanded(child: Widget, flex: float = 1.0): Widget {
        return Expanded(child, flex);
    }

    export function divider(): Widget {
        return Divider();
    }

    export function checkbox(checked: bool, onToggle: () => void, size: float = 26.0): Widget {
        return Checkbox(checked, onToggle, size);
    }

    export function animated(child: Widget? = null, value: bool = false, duration: int = 200, curve: Curve = Curve.easeInOut): Widget {
        return new AnimatedNode(child, value, duration, curve);
    }

    export function when(condition: bool, then: () => Widget, otherwise: () => Widget): Widget {
        if (condition) {
            return then();
        }
        return otherwise();
    }

    export function each<T>(items: T[], key: (v: T) => str | int, render: (v: T) => Widget, gap: float = 4.0): Widget {
        const out: Widget[] = [];
        for (let i = 0; i < items.length; i = i + 1) {
            out.push(render(items[i]));
        }
        return Column(children: out, gap: gap);
    }
}
