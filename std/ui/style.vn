export enum TextStyle {
    body,
    title,
    headline,
    caption
}

export enum MainAxis {
    start,
    center,
    end,
    spaceBetween,
    spaceAround,
    spaceEvenly
}

export enum CrossAxis {
    start,
    center,
    end,
    stretch
}

export enum Alignment {
    topLeft,
    topCenter,
    topRight,
    centerLeft,
    center,
    centerRight,
    bottomLeft,
    bottomCenter,
    bottomRight
}

export enum BoxFit {
    contain,
    cover,
    fill,
    fitWidth,
    fitHeight,
    none
}

export enum Curve {
    linear,
    easeIn,
    easeOut,
    easeInOut
}

export const Colors = {
    black: 0xFF000000,
    white: 0xFFFFFFFF,
    red: 0xFFFF0000,
    green: 0xFF00FF00,
    blue: 0xFF2196F3,
    gray: 0xFF888888,
    transparent: 0x00000000
};

export const Theme = {
    colors: {
        background: 0xFF14161A,
        surface: 0xFF1E2128,
        outline: 0xFF343A46,
        primary: 0xFF4C8DFF,
        onPrimary: 0xFFFFFFFF,
        onSurface: 0xFFE8EAED,
        muted: 0xFF9AA0AA,
        danger: 0xFFFF5C5C,
        success: 0xFF3DDC84,
        disabled: 0xFF3A3F4A
    },
    text: {
        titleSize: 24.0,
        bodySize: 18.0,
        headlineSize: 30.0,
        captionSize: 14.0
    }
};

export function textSizeFor(style: TextStyle): float {
    if (style == TextStyle.title) {
        return Theme.text.titleSize;
    }
    if (style == TextStyle.headline) {
        return Theme.text.headlineSize;
    }
    if (style == TextStyle.caption) {
        return Theme.text.captionSize;
    }
    return Theme.text.bodySize;
}

export function textColorFor(style: TextStyle): int {
    if (style == TextStyle.caption) {
        return Theme.colors.muted;
    }
    return Theme.colors.onSurface;
}
