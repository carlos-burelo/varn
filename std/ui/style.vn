import { Signal } from "std:signals";

export enum TextStyle {
    body,
    title,
    headline,
    caption
}

export enum ButtonKind {
    primary,
    subtle,
    danger
}

export enum MainAxis {
    start,
    center,
    end,
    spaceBetween,
    spaceAround,
    spaceEvenly
}

export enum CrossAxis {
    start,
    center,
    end,
    stretch
}

export enum Alignment {
    topLeft,
    topCenter,
    topRight,
    centerLeft,
    center,
    centerRight,
    bottomLeft,
    bottomCenter,
    bottomRight
}

export enum BoxFit {
    contain,
    cover,
    fill,
    fitWidth,
    fitHeight,
    none
}

export enum Curve {
    linear,
    easeIn,
    easeOut,
    easeInOut
}

export const Colors = {
    black: 0xFF000000,
    white: 0xFFFFFFFF,
    red: 0xFFFF0000,
    green: 0xFF00FF00,
    blue: 0xFF2196F3,
    gray: 0xFF888888,
    transparent: 0x00000000
};

export class Palette {
    background: int;
    surface: int;
    outline: int;
    primary: int;
    onPrimary: int;
    onSurface: int;
    muted: int;
    danger: int;
    success: int;
    disabled: int;

    constructor(background: int, surface: int, outline: int, primary: int, onPrimary: int, onSurface: int, muted: int, danger: int, success: int, disabled: int) {
        this.background = background;
        this.surface = surface;
        this.outline = outline;
        this.primary = primary;
        this.onPrimary = onPrimary;
        this.onSurface = onSurface;
        this.muted = muted;
        this.danger = danger;
        this.success = success;
        this.disabled = disabled;
    }
}

const DARK = new Palette(0xFF14161A, 0xFF1E2128, 0xFF343A46, 0xFF4C8DFF, 0xFFFFFFFF, 0xFFE8EAED, 0xFF9AA0AA, 0xFFFF5C5C, 0xFF3DDC84, 0xFF3A3F4A);
const LIGHT = new Palette(0xFFF4F5F7, 0xFFFFFFFF, 0xFFD0D5DD, 0xFF2F6FE4, 0xFFFFFFFF, 0xFF1B1E24, 0xFF5D6470, 0xFFD93A3A, 0xFF1E9E5A, 0xFFD9DDE3);

export class TextSizes {
    titleSize: float;
    bodySize: float;
    headlineSize: float;
    captionSize: float;

    constructor(titleSize: float, bodySize: float, headlineSize: float, captionSize: float) {
        this.titleSize = titleSize;
        this.bodySize = bodySize;
        this.headlineSize = headlineSize;
        this.captionSize = captionSize;
    }
}

export class ThemeState {
    breakpoints: float[] = [600.0, 840.0];
    text: TextSizes = new TextSizes(24.0, 18.0, 30.0, 14.0);
    private _dark: Signal<bool> = new Signal<bool>(true, null);

    get colors(): Palette {
        return this._dark.value ? DARK : LIGHT;
    }

    get dark(): Signal<bool> {
        return this._dark;
    }
}

export const Theme = new ThemeState();

export function textSizeFor(style: TextStyle): float {
    if (style == TextStyle.title) {
        return Theme.text.titleSize;
    }
    if (style == TextStyle.headline) {
        return Theme.text.headlineSize;
    }
    if (style == TextStyle.caption) {
        return Theme.text.captionSize;
    }
    return Theme.text.bodySize;
}

export function textColorFor(style: TextStyle): int {
    if (style == TextStyle.caption) {
        return Theme.colors.muted;
    }
    return Theme.colors.onSurface;
}

export function buttonColorFor(kind: ButtonKind): int {
    if (kind == ButtonKind.subtle) {
        return Theme.colors.outline;
    }
    if (kind == ButtonKind.danger) {
        return Theme.colors.danger;
    }
    return Theme.colors.primary;
}

export function buttonTextColorFor(kind: ButtonKind): int {
    if (kind == ButtonKind.subtle) {
        return Theme.colors.onSurface;
    }
    return Theme.colors.onPrimary;
}

export enum WindowClass {
    compact,
    medium,
    expanded
}

export function windowClassOf(width: float): WindowClass {
    const breakpoints = Theme.breakpoints;
    if (width < breakpoints[0]) {
        return WindowClass.compact;
    }
    if (width < breakpoints[1]) {
        return WindowClass.medium;
    }
    return WindowClass.expanded;
}

function classKey(cls: WindowClass): str {
    if (cls == WindowClass.compact) {
        return "compact";
    }
    if (cls == WindowClass.medium) {
        return "medium";
    }
    return "expanded";
}
