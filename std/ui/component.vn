import { FunctionRef } from "std:reflect";
import { ComponentScope, View, newComponentDefinition, scopeAtMount } from "std:ui/state";
import { Widget, Constraints, Placement, PaintContext, paintPlaced, KeyedNode } from "std:ui/widget/base";

const views = new Map<ComponentScope, View<Widget>>();

function viewOf(scope: ComponentScope): View<Widget> {
    const existing = views.get(scope);
    if (existing !== null) {
        return existing;
    }
    const fresh = new View<Widget>(scope);
    views.set(scope, fresh);
    scope.onDispose(() => {
        fresh.dispose();
        views.delete(scope);
    });
    return fresh;
}

export class ComponentNode extends Widget {
    body: () => Widget;

    definition: int;

    constructor(definition: int, body: () => Widget) {
        super();
        this.definition = definition;
        this.body = body;
    }

    expand(): Widget {
        return viewOf(scopeAtMount(this.definition)).describe(this.body);
    }

    override computeLayout(c: Constraints): Placement {
        const placed = this.expand().layout(c);
        return new Placement(this, placed.size, [placed]);
    }

    override paint(cx: PaintContext, p: Placement, x: float, y: float): void {
        paintPlaced(cx, p.children[0], x, y);
    }
}

export function component(): (fn: FunctionRef) => (...args: int[]) => Widget {
    return (fn: FunctionRef) => {
        const definition = newComponentDefinition();
        return (...args: int[]) => new ComponentNode(definition, () => fn(...args) as Widget);
    };
}

export function expanded(w: Widget): Widget {
    if (w is ComponentNode) {
        return expanded((w as ComponentNode).expand());
    }
    if (w is KeyedNode) {
        return expanded((w as KeyedNode).child);
    }
    return w;
}
