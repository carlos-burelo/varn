import { FunctionRef } from "std:reflect";
import { newComponentId, enterComponent, leaveComponent } from "std:ui/state";

export function component(fn: FunctionRef): FunctionRef {
    const id = newComponentId();
    return (...args: int[]) => {
        const previous = enterComponent(id);
        try {
            return fn(...args);
        } finally {
            leaveComponent(previous);
        }
    };
}
