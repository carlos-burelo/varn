import { Widget, Size, PaintContext } from "std:ui/widget/base";
import { TextNode, TextAlign } from "std:ui/widget/text";
import { TextStyle, BoxFit, Theme } from "std:ui/style";
import { now } from "std:time";

export class ImageNode extends Widget {
    source: str;
    boxFit: BoxFit;

    constructor(source: str, width: float, height: float, boxFit: BoxFit) {
        super();
        this.source = source;
        this.w = width;
        this.h = height;
        this.boxFit = boxFit;
    }

    override measure(maxW: float, maxH: float): Size {
        return this.fit(new Size(maxW, 120.0));
    }

    override paint(cx: PaintContext, x: float, y: float, w: float, h: float): void {
        cx.win.rect(x, y, w, h, Theme.colors.outline, 8.0);
        new TextNode(this.source, 14.0, Theme.colors.muted, TextAlign.center, TextStyle.caption, 0).paint(cx, x + 8.0, y, w - 16.0, h);
    }
}

export class ProgressNode extends Widget {
    value: float;
    color: int;
    track: int;

    constructor(value: float, color: int, track: int, height: float) {
        super();
        this.value = value;
        this.color = color;
        this.track = track;
        this.h = height;
    }

    override measure(maxW: float, maxH: float): Size {
        return this.fit(new Size(maxW, this.h));
    }

    override paint(cx: PaintContext, x: float, y: float, w: float, h: float): void {
        cx.win.rect(x, y, w, h, this.track, h / 2.0);
        if (this.value < 0.0) {
            const t = (((now() / 300) % 10) as float) / 10.0;
            const pw = w * 0.4;
            cx.win.rect(x + (w - pw) * t, y, pw, h, this.color, h / 2.0);
        } else {
            const frac = this.value > 1.0 ? 1.0 : this.value;
            if (frac > 0.0) {
                cx.win.rect(x, y, w * frac, h, this.color, h / 2.0);
            }
        }
    }
}

export function Image(source: str, w: float = -1.0, h: float = -1.0, fit: BoxFit = BoxFit.cover): Widget {
    return new ImageNode(source, w, h, fit);
}

export function Progress(value: float = -1.0, color: int = Theme.colors.primary, track: int = Theme.colors.outline, h: float = 8.0): Widget {
    return new ProgressNode(value, color, track, h);
}
