import { Widget, Size, PaintContext } from "std:ui/widget/base";
import { TextStyle, textSizeFor, textColorFor } from "std:ui/style";
import { textX, textY, ellipsize } from "std:ui/layout";
import { measure, ascent, descent } from "std:ui/text";

export enum TextAlign {
    left,
    center,
    right
}

export class TextNode extends Widget {
    text: str;
    size: float;
    color: int;
    align: TextAlign;
    style: TextStyle;
    maxLines: int;

    constructor(text: str, size: float, color: int, align: TextAlign, style: TextStyle, maxLines: int) {
        super();
        this.text = text;
        this.size = size;
        this.color = color;
        this.align = align;
        this.style = style;
        this.maxLines = maxLines;
    }

    override measure(maxW: float, maxH: float): Size {
        const width = measure(this.text, this.size);
        return this.fit(new Size(width < maxW ? width : maxW, ascent(this.size) + descent(this.size)));
    }

    override paint(cx: PaintContext, x: float, y: float, w: float, h: float): void {
        const ty = textY(y, h, this.size);
        if (this.align == TextAlign.center) {
            cx.win.text(textX(x, w, this.text, this.size), ty, this.text, this.size, this.color);
        } else if (this.align == TextAlign.right) {
            cx.win.text(x + w - measure(this.text, this.size), ty, this.text, this.size, this.color);
        } else {
            cx.win.text(x, ty, ellipsize(this.text, this.size, w), this.size, this.color);
        }
    }
}

export function Text(value: str, style: TextStyle = TextStyle.body, color: int = -1, size: float = 0.0, align: TextAlign = TextAlign.left, maxLines: int = 0): Widget {
    return new TextNode(
        value,
        size > 0.0 ? size : textSizeFor(style),
        color >= 0 ? color : textColorFor(style),
        align,
        style,
        maxLines
    );
}

export function Title(value: str, color: int = -1, align: TextAlign = TextAlign.left): Widget {
    return Text(value, style: TextStyle.title, color: color, align: align);
}

export function Headline(value: str, color: int = -1, align: TextAlign = TextAlign.left): Widget {
    return Text(value, style: TextStyle.headline, color: color, align: align);
}

export function Caption(value: str, color: int = -1, align: TextAlign = TextAlign.left): Widget {
    return Text(value, style: TextStyle.caption, color: color, align: align);
}
