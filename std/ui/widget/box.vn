import { Widget, Size, PaintContext, alignedX, alignedY, Constraints, Placement, paintPlaced } from "std:ui/widget/base";
import { Column } from "std:ui/widget/flex";
import { Title } from "std:ui/widget/text";
import { Alignment, Colors, Theme } from "std:ui/style";
import { UiControlKind } from "std:ui/window";

export class BoxNode extends Widget {
    color: int;
    radius: float;
    pad: float;
    onClick: (() => void)?;
    child: Widget?;

    constructor(w: float, h: float, color: int, radius: float, pad: float, onClick: (() => void)?, child: Widget?) {
        super();
        this.w = w;
        this.h = h;
        this.color = color;
        this.radius = radius;
        this.pad = pad;
        this.onClick = onClick;
        this.child = child;
    }


    override computeLayout(c: Constraints): Placement {
        const pad = this.pad;
        const child = this.child;
        const measured = child === null ? null : child.layout(Constraints.loose(c.maxW - 2.0 * pad, c.maxH - 2.0 * pad));
        const inner = measured === null ? new Size(0.0, 0.0) : measured.size;
        const size = c.fit(this.fit(new Size(inner.w + 2.0 * pad, inner.h + 2.0 * pad)));
        const children: Placement[] = [];
        if (child !== null) {
            const wantW = size.w - 2.0 * pad;
            const wantH = size.h - 2.0 * pad;
            const placed = (measured !== null && measured.size.w == wantW && measured.size.h == wantH) ? measured : child.layout(Constraints.tight(wantW, wantH));
            placed.x = pad;
            placed.y = pad;
            children.push(placed);
        }
        return new Placement(this, size, children);
    }

    override paint(cx: PaintContext, p: Placement, x: float, y: float): void {
        const w = p.size.w;
        const h = p.size.h;
        if (this.color != Colors.transparent) {
            cx.win.rect(x, y, w, h, this.color, this.radius);
        }
        const click = this.onClick;
        if (click !== null) {
            cx.click(UiControlKind.Surface, x, y, w, h, 0, false, click);
        }
        for (const placed of p.children) {
            cx.keyed("child", () => paintPlaced(cx, placed, x, y));
        }
    }
}

export class StackNode extends Widget {
    children: Widget[];
    alignment: Alignment;

    constructor(children: Widget[], alignment: Alignment) {
        super();
        this.children = children;
        this.alignment = alignment;
    }


    override computeLayout(c: Constraints): Placement {
        let width = 0.0;
        let height = 0.0;
        for (let child of this.children) {
            const size = child.layout(c).size;
            width = size.w > width ? size.w : width;
            height = size.h > height ? size.h : height;
        }
        const size = c.fit(this.fit(new Size(width, height)));
        const children: Placement[] = [];
        for (let child of this.children) {
            const probe = child.layout(Constraints.loose(size.w, size.h));
            const cw = probe.size.w < size.w ? probe.size.w : size.w;
            const ch = probe.size.h < size.h ? probe.size.h : size.h;
            const placed = (probe.size.w == cw && probe.size.h == ch) ? probe : child.layout(Constraints.tight(cw, ch));
            placed.x = alignedX(this.alignment, size.w - cw);
            placed.y = alignedY(this.alignment, size.h - ch);
            children.push(placed);
        }
        return new Placement(this, size, children);
    }
    override paint(cx: PaintContext, p: Placement, x: float, y: float): void {
        for (let i = 0; i < p.children.length; i = i + 1) {
            const placed = p.children[i];
            cx.keyed(`${i}`, () => paintPlaced(cx, placed, x, y));
        }
    }
}

export class PaddingNode extends Widget {
    left: float;
    top: float;
    right: float;
    bottom: float;
    child: Widget?;

    constructor(child: Widget?, left: float, top: float, right: float, bottom: float) {
        super();
        this.child = child;
        this.left = left;
        this.top = top;
        this.right = right;
        this.bottom = bottom;
    }


    override computeLayout(c: Constraints): Placement {
        const horizontal = this.left + this.right;
        const vertical = this.top + this.bottom;
        const child = this.child;
        const measured = child === null ? null : child.layout(Constraints.loose(c.maxW - horizontal, c.maxH - vertical));
        const inner = measured === null ? new Size(0.0, 0.0) : measured.size;
        const size = c.fit(this.fit(new Size(inner.w + horizontal, inner.h + vertical)));
        const children: Placement[] = [];
        if (child !== null) {
            const wantW = size.w - horizontal < 0.0 ? 0.0 : size.w - horizontal;
            const wantH = size.h - vertical < 0.0 ? 0.0 : size.h - vertical;
            const placed = (measured !== null && measured.size.w == wantW && measured.size.h == wantH) ? measured : child.layout(Constraints.tight(wantW, wantH));
            placed.x = this.left;
            placed.y = this.top;
            children.push(placed);
        }
        return new Placement(this, size, children);
    }
    override paint(cx: PaintContext, p: Placement, x: float, y: float): void {
        const w = p.size.w;
        const h = p.size.h;
        for (const placed of p.children) {
            cx.keyed("child", () => paintPlaced(cx, placed, x, y));
        }
    }
}

export class SizedBoxNode extends Widget {
    child: Widget?;

    constructor(child: Widget?, width: float, height: float) {
        super();
        this.child = child;
        this.w = width;
        this.h = height;
    }


    override computeLayout(c: Constraints): Placement {
        const child = this.child;
        const measured = child === null ? null : child.layout(c);
        const inner = measured === null ? new Size(0.0, 0.0) : measured.size;
        const size = c.fit(this.fit(inner));
        const children: Placement[] = [];
        if (child !== null) {
            const placed = (measured !== null && measured.size.w == size.w && measured.size.h == size.h) ? measured : child.layout(Constraints.tight(size.w, size.h));
            children.push(placed);
        }
        return new Placement(this, size, children);
    }
    override paint(cx: PaintContext, p: Placement, x: float, y: float): void {
        const w = p.size.w;
        const h = p.size.h;
        for (const placed of p.children) {
            cx.keyed("child", () => paintPlaced(cx, placed, x, y));
        }
    }
}

export class ExpandedNode extends Widget {
    child: Widget;

    constructor(child: Widget, flex: float) {
        super();
        this.child = child;
        this.flex = flex;
    }

    override computeLayout(c: Constraints): Placement {
        const placed = this.child.layout(c);
        return new Placement(this, placed.size, [placed]);
    }


    override paint(cx: PaintContext, p: Placement, x: float, y: float): void {
        const w = p.size.w;
        const h = p.size.h;
        cx.keyed("child", () => paintPlaced(cx, p.children[0], x, y));
    }
}

export class SpacerNode extends Widget {
    constructor(flex: float) {
        super();
        this.flex = flex;
    }

    override measure(maxW: float, maxH: float): Size {
        return new Size(0.0, 0.0);
    }

    override paint(cx: PaintContext, p: Placement, x: float, y: float): void {}
}

export class DividerNode extends Widget {
    color: int;

    constructor(color: int) {
        super();
        this.color = color;
    }

    override measure(maxW: float, maxH: float): Size {
        return new Size(maxW, 1.0);
    }

    override paint(cx: PaintContext, p: Placement, x: float, y: float): void {
        const w = p.size.w;
        const h = p.size.h;
        cx.win.rect(x, y, w, 1.0, this.color);
    }
}

export function Box(child: Widget? = null, color: int = Colors.transparent, radius: float = 0.0, pad: float = 0.0, w: float = -1.0, h: float = -1.0, onClick: (() => void)? = null): Widget {
    return new BoxNode(w, h, color, radius, pad, onClick, child);
}

export function Card(children: Widget[], title: str = "", gap: float = 12.0, pad: float = 16.0, radius: float = 12.0, w: float = -1.0, h: float = -1.0): Widget {
    const body: Widget[] = [];
    if (title != "") {
        body.push(Title(title));
    }
    for (let child of children) {
        body.push(child);
    }
    const card = new BoxNode(w, h, Theme.colors.surface, radius, pad, null, Column(body, gap: gap));
    card.fills = true;
    return card;
}

export function Stack(children: Widget[], alignment: Alignment = Alignment.center): Widget {
    return new StackNode(children, alignment);
}

export function Padding(child: Widget? = null, all: float = 0.0, left: float = -1.0, top: float = -1.0, right: float = -1.0, bottom: float = -1.0): Widget {
    return new PaddingNode(
        child,
        left < 0.0 ? all : left,
        top < 0.0 ? all : top,
        right < 0.0 ? all : right,
        bottom < 0.0 ? all : bottom
    );
}

export function SizedBox(child: Widget? = null, w: float = -1.0, h: float = -1.0): Widget {
    return new SizedBoxNode(child, w, h);
}

export function Spacer(flex: float = 1.0): Widget {
    return new SpacerNode(flex);
}

export function Expanded(child: Widget, flex: float = 1.0): Widget {
    return new ExpandedNode(child, flex);
}

export function Divider(color: int = Theme.colors.outline): Widget {
    return new DividerNode(color);
}
