import { UiWindow, UiControlKind } from "std:ui/window";
import { UiFrame } from "std:ui/frame";
import { Focus } from "std:ui/focus";
import { Alignment } from "std:ui/style";

export class Overlay {
    paint: (cx: PaintContext) => void;
    modal: bool;

    constructor(paint: (cx: PaintContext) => void, modal: bool) {
        this.paint = paint;
        this.modal = modal;
    }
}

export class PaintContext {
    win: UiWindow;
    fr: UiFrame;
    focus: Focus;
    overlays: Overlay[] = [];
    private _slot: int = 1000;

    constructor(win: UiWindow, fr: UiFrame, focus: Focus) {
        this.win = win;
        this.fr = fr;
        this.focus = focus;
    }

    overlay(paint: (cx: PaintContext) => void, modal: bool = false): void {
        this.overlays.push(new Overlay(paint, modal));
    }

    clip(x: float, y: float, w: float, h: float): void {
        this.win.clip(x, y, w, h);
        this.fr.pushClip(x, y, w, h);
    }

    unclip(): void {
        this.win.unclip();
        this.fr.popClip();
    }

    click(kind: UiControlKind, x: float, y: float, w: float, h: float, color: int, flag: bool, onActivate: () => void): void {
        this.valued(kind, x, y, w, h, color, flag, 0.0, 0.0, 0.0, (value: float) => { onActivate(); });
    }

    valued(kind: UiControlKind, x: float, y: float, w: float, h: float, color: int, flag: bool, value: float, low: float, high: float, onChange: (value: float) => void): void {
        const id = this.nextSlot();
        this.win.control(id, kind, x, y, w, h, color, flag, value, low, high);
        this.fr.onActivate(id, onChange);
    }

    field(id: int, kind: UiControlKind, x: float, y: float, w: float, h: float, color: int, focused: bool, text: str, hint: str, size: float, onActivate: (value: float) => void, onType: (text: str) => void): void {
        this.win.field(id, kind, x, y, w, h, color, focused, text, hint, size);
        this.fr.onActivate(id, onActivate);
        this.fr.onType(id, onType);
    }

    nextSlot(): int {
        this._slot = this._slot + 1;
        return this._slot;
    }
}

export class Size {
    w: float;
    h: float;

    constructor(w: float, h: float) {
        this.w = w;
        this.h = h;
    }
}

export class Constraints {
    minW: float;
    maxW: float;
    minH: float;
    maxH: float;

    constructor(minW: float, maxW: float, minH: float, maxH: float) {
        this.minW = minW;
        this.maxW = maxW;
        this.minH = minH;
        this.maxH = maxH;
    }

    static loose(maxW: float, maxH: float): Constraints {
        return new Constraints(0.0, maxW, 0.0, maxH);
    }

    static tight(w: float, h: float): Constraints {
        return new Constraints(w, w, h, h);
    }

    deflate(pad: float): Constraints {
        const dw = 2.0 * pad;
        const minW = this.minW - dw > 0.0 ? this.minW - dw : 0.0;
        const minH = this.minH - dw > 0.0 ? this.minH - dw : 0.0;
        const maxW = this.maxW - dw > 0.0 ? this.maxW - dw : 0.0;
        const maxH = this.maxH - dw > 0.0 ? this.maxH - dw : 0.0;
        return new Constraints(minW, maxW, minH, maxH);
    }

    fit(s: Size): Size {
        const w = s.w < this.minW ? this.minW : (s.w > this.maxW ? this.maxW : s.w);
        const h = s.h < this.minH ? this.minH : (s.h > this.maxH ? this.maxH : s.h);
        return new Size(w, h);
    }
}

export class Placement {
    node: Widget;
    size: Size;
    x: float;
    y: float;
    children: Placement[];

    constructor(node: Widget, size: Size, children: Placement[]) {
        this.node = node;
        this.size = size;
        this.x = 0.0;
        this.y = 0.0;
        this.children = children;
    }
}

function sameKey(a: float[], b: float[]): bool {
    if (a.length != b.length) {
        return false;
    }
    for (let i = 0; i < a.length; i = i + 1) {
        if (a[i] != b[i]) {
            return false;
        }
    }
    return true;
}

export abstract class Widget {
    layoutKey: float[] = [];
    layoutValue: Placement? = null;
    w: float = -1.0;
    h: float = -1.0;
    flex: float = 0.0;
    fills: bool = false;

    abstract measure(maxW: float, maxH: float): Size;
    abstract paint(cx: PaintContext, x: float, y: float, w: float, h: float): void;

    fit(natural: Size): Size {
        return new Size(this.w >= 0.0 ? this.w : natural.w, this.h >= 0.0 ? this.h : natural.h);
    }

    layout(c: Constraints): Placement {
        const key = [c.minW, c.maxW, c.minH, c.maxH];
        const cached = this.layoutValue;
        if (cached !== null && sameKey(this.layoutKey, key)) {
            return cached;
        }
        const placed = this.computeLayout(c);
        this.layoutKey = key;
        this.layoutValue = placed;
        return placed;
    }

    computeLayout(c: Constraints): Placement {
        return new Placement(this, c.fit(this.measure(c.maxW, c.maxH)), []);
    }
}

export function paintChild(child: Widget?, cx: PaintContext, x: float, y: float, w: float, h: float): void {
    if (child !== null) {
        child.paint(cx, x, y, w, h);
    }
}

export function measureChild(child: Widget?, maxW: float, maxH: float): Size {
    if (child === null) {
        return new Size(0.0, 0.0);
    }
    return child.measure(maxW, maxH);
}

export function alignedX(alignment: Alignment, room: float): float {
    if (alignment == Alignment.topLeft || alignment == Alignment.centerLeft || alignment == Alignment.bottomLeft) {
        return 0.0;
    }
    if (alignment == Alignment.topRight || alignment == Alignment.centerRight || alignment == Alignment.bottomRight) {
        return room;
    }
    return room / 2.0;
}

export function alignedY(alignment: Alignment, room: float): float {
    if (alignment == Alignment.topLeft || alignment == Alignment.topCenter || alignment == Alignment.topRight) {
        return 0.0;
    }
    if (alignment == Alignment.bottomLeft || alignment == Alignment.bottomCenter || alignment == Alignment.bottomRight) {
        return room;
    }
    return room / 2.0;
}
