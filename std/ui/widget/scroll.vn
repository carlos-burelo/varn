import { Widget, Size, PaintContext, Constraints, Placement } from "std:ui/widget/base";
import { Signal, signal } from "std:signals";
import { UiControlKind } from "std:ui/window";

const CONTENT_UNBOUNDED = 1.0e9;
const BAR_WIDTH = 6.0;

export class ScrollNode extends Widget {
    child: Widget;
    offset: Signal<float>;

    constructor(child: Widget, offset: Signal<float>, h: float) {
        super();
        this.child = child;
        this.offset = offset;
        this.h = h;
    }

    override measure(maxW: float, maxH: float): Size {
        return this.fit(new Size(maxW, maxH));
    }

    override computeLayout(c: Constraints): Placement {
        const size = c.fit(this.measure(c.maxW, c.maxH));
        const child = this.child;
        const content = child.layout(Constraints.loose(size.w - BAR_WIDTH, CONTENT_UNBOUNDED)).size.h;
        const overflow = content > size.h ? content - size.h : 0.0;
        const at = this.offset.peek();
        const bounded = at < 0.0 ? 0.0 : (at > overflow ? overflow : at);
        const placed = child.layout(Constraints.tight(size.w - BAR_WIDTH, content));
        placed.x = 0.0;
        placed.y = 0.0 - bounded;
        return new Placement(this, size, [placed]);
    }

    override paint(cx: PaintContext, x: float, y: float, w: float, h: float): void {
        const content = this.child.measure(w - BAR_WIDTH, CONTENT_UNBOUNDED).h;
        const overflow = content > h ? content - h : 0.0;
        const at = this.offset.peek();
        const bounded = at < 0.0 ? 0.0 : (at > overflow ? overflow : at);
        cx.valued(UiControlKind.Scroll, x, y, w, h, 0, false, bounded, 0.0, content, (next: float) => {
            this.offset.set(next);
        });
        cx.clip(x, y, w, h);
        this.child.paint(cx, x, y - bounded, w - BAR_WIDTH, content);
        cx.unclip();
    }
}

export function Scroll(child: Widget, offset: Signal<float> = signal(0.0), h: float = -1.0): Widget {
    return new ScrollNode(child, offset, h);
}
