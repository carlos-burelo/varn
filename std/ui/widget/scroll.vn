import { Widget, Size, PaintContext, Constraints, Placement, paintPlaced, layoutAt, fixedSize } from "std:ui/widget/base";
import { Signal, signal } from "std:signals";
import { UiControlKind } from "std:ui/window";

const CONTENT_UNBOUNDED = 1.0e9;
const BAR_WIDTH = 6.0;

export class ScrollNode extends Widget {
    child: Widget;
    offset: Signal<float>;

    constructor(child: Widget, offset: Signal<float>, h: float) {
        super();
        this.child = child;
        this.offset = offset;
        this.h = h;
    }


    override computeLayout(c: Constraints): Placement {
        const size = fixedSize(this, c, new Size(c.maxW, c.maxH));
        const child = this.child;
        const content = layoutAt(child, "child", c.looseChild(size.w - BAR_WIDTH, CONTENT_UNBOUNDED)).size.h;
        const overflow = content > size.h ? content - size.h : 0.0;
        const at = this.offset.peek();
        const bounded = at < 0.0 ? 0.0 : (at > overflow ? overflow : at);
        const placed = layoutAt(child, "child", c.tightChild(size.w - BAR_WIDTH, content));
        placed.x = 0.0;
        placed.y = 0.0 - bounded;
        const out = new Placement(this, size, [placed]);
        out.data = [bounded, content];
        return out;
    }

    override paint(cx: PaintContext, p: Placement, x: float, y: float): void {
        const w = p.size.w;
        const h = p.size.h;
        const bounded = p.data[0];
        const content = p.data[1];
        cx.valued(UiControlKind.Scroll, x, y, w, h, 0, false, bounded, 0.0, content, (next: float) => {
            this.offset.set(next);
        });
        cx.clip(x, y, w, h);
        cx.keyed("child", () => paintPlaced(cx, p.children[0], x, y));
        cx.unclip();
    }
}

export function Scroll(child: Widget, offset: Signal<float> = signal(0.0), h: float = -1.0): Widget {
    return new ScrollNode(child, offset, h);
}
