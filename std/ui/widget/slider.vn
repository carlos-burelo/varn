import { Widget, Size, PaintContext, Placement } from "std:ui/widget/base";
import { current, writer } from "std:ui/widget/bound";
import { Theme } from "std:ui/style";
import { Signal } from "std:signals";
import { UiControlKind } from "std:ui/window";

export class SliderNode extends Widget {
    value: float;
    low: float;
    high: float;
    onChange: (next: float) => void;

    constructor(value: float, low: float, high: float, onChange: (next: float) => void, h: float) {
        super();
        this.value = value;
        this.low = low;
        this.high = high;
        this.onChange = onChange;
        this.h = h;
    }

    override measure(maxW: float, maxH: float): Size {
        return this.fit(new Size(maxW, this.h));
    }

    override paint(cx: PaintContext, p: Placement, x: float, y: float): void {
        const w = p.size.w;
        const h = p.size.h;
        cx.valued(UiControlKind.Slider, x, y, w, h, Theme.colors.primary, false, this.value, this.low, this.high, (next: float) => {
            if (next != this.value) {
                this.onChange(next);
            }
        });
    }
}

export function Slider(value: float | Signal<float>, onChange: ((next: float) => void)? = null, low: float = 0.0, high: float = 1.0, h: float = 24.0): Widget {
    return new SliderNode(current<float>(value), low, high, writer<float>(value, onChange), h);
}
