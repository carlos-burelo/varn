import { Widget, Size, PaintContext, Constraints, Placement, KeyedNode, paintSlot } from "std:ui/widget/base";
import { resolveFloat, AdaptiveValue } from "std:ui/responsive";
import { MainAxis, CrossAxis } from "std:ui/style";

export enum Axis {
    horizontal,
    vertical
}

export class FlexNode extends Widget {
    axis: Axis;
    children: Widget[];
    gap: float | AdaptiveValue<float>;
    pad: float | AdaptiveValue<float>;
    mainAxis: MainAxis;
    crossAxis: CrossAxis;

    constructor(axis: Axis, children: Widget[], gap: float | AdaptiveValue<float>, pad: float | AdaptiveValue<float>, w: float, h: float, mainAxis: MainAxis, crossAxis: CrossAxis) {
        super();
        this.axis = axis;
        this.children = children;
        this.gap = gap;
        this.pad = pad;
        this.w = w;
        this.h = h;
        this.mainAxis = mainAxis;
        this.crossAxis = crossAxis;
    }

    private mainOf(size: Size): float {
        return this.axis == Axis.horizontal ? size.w : size.h;
    }

    private crossOf(size: Size): float {
        return this.axis == Axis.horizontal ? size.h : size.w;
    }

    override measure(maxW: float, maxH: float): Size {
        const gap = resolveFloat(this.gap, maxW);
        const pad = resolveFloat(this.pad, maxW);
        const innerW = maxW - 2.0 * pad;
        const innerH = maxH - 2.0 * pad;
        let main = 0.0;
        let cross = 0.0;
        for (let child of this.children) {
            const size = child.measure(innerW, innerH);
            main = main + this.mainOf(size);
            const across = this.crossOf(size);
            cross = across > cross ? across : cross;
        }
        if (this.children.length > 1) {
            main = main + gap * ((this.children.length - 1) as float);
        }
        let flexible = false;
        for (let child of this.children) {
            if (child.flex > 0.0) {
                flexible = true;
            }
        }
        if (flexible || this.mainAxis != MainAxis.start) {
            const room = (this.axis == Axis.horizontal ? innerW : innerH);
            main = main > room ? main : room;
        }
        const natural = this.axis == Axis.horizontal
            ? new Size(main + 2.0 * pad, cross + 2.0 * pad)
            : new Size(cross + 2.0 * pad, main + 2.0 * pad);
        return this.fit(natural);
    }

    override computeLayout(c: Constraints): Placement {
        const gap = resolveFloat(this.gap, c.maxW);
        const pad = resolveFloat(this.pad, c.maxW);
        const horizontal = this.axis == Axis.horizontal;
        const inner = c.deflate(pad);
        const measured: Placement[] = [];
        let main = 0.0;
        let cross = 0.0;
        for (let child of this.children) {
            const placed = child.layout(Constraints.loose(inner.maxW, inner.maxH));
            measured.push(placed);
            main = main + this.mainOf(placed.size);
            const across = this.crossOf(placed.size);
            cross = across > cross ? across : cross;
        }
        if (this.children.length > 1) {
            main = main + gap * ((this.children.length - 1) as float);
        }
        let flexible = false;
        for (let child of this.children) {
            if (child.flex > 0.0) {
                flexible = true;
            }
        }
        if (flexible || this.mainAxis != MainAxis.start) {
            const room = horizontal ? inner.maxW : inner.maxH;
            main = main > room ? main : room;
        }
        const natural = horizontal
            ? new Size(main + 2.0 * pad, cross + 2.0 * pad)
            : new Size(cross + 2.0 * pad, main + 2.0 * pad);
        const size = c.fit(this.fit(natural));

        const innerW = size.w - 2.0 * pad;
        const innerH = size.h - 2.0 * pad;
        const room = horizontal ? innerW : innerH;
        const across = horizontal ? innerH : innerW;
        const count = this.children.length;

        let fixed = 0.0;
        let flexTotal = 0.0;
        for (let i = 0; i < count; i = i + 1) {
            const child = this.children[i];
            if (child.flex > 0.0) {
                flexTotal = flexTotal + child.flex;
            } else {
                fixed = fixed + this.mainOf(measured[i].size);
            }
        }
        const gaps = count > 1 ? gap * ((count - 1) as float) : 0.0;
        let leftover = room - fixed - gaps;
        if (leftover < 0.0) {
            leftover = 0.0;
        }

        let offset = 0.0;
        let spacing = gap;
        if (flexTotal == 0.0) {
            if (this.mainAxis == MainAxis.center) {
                offset = leftover / 2.0;
            } else if (this.mainAxis == MainAxis.end) {
                offset = leftover;
            } else if (this.mainAxis == MainAxis.spaceBetween && count > 1) {
                spacing = gap + leftover / ((count - 1) as float);
            } else if (this.mainAxis == MainAxis.spaceAround && count > 0) {
                const unit = leftover / (count as float);
                offset = unit / 2.0;
                spacing = gap + unit;
            } else if (this.mainAxis == MainAxis.spaceEvenly && count > 0) {
                const unit = leftover / ((count + 1) as float);
                offset = unit;
                spacing = gap + unit;
            }
        }

        const children: Placement[] = [];
        let cursor = offset;
        for (let i = 0; i < count; i = i + 1) {
            const child = this.children[i];
            const measuredChild = measured[i];
            let span = this.mainOf(measuredChild.size);
            if (child.flex > 0.0) {
                span = leftover * child.flex / flexTotal;
            }
            let thick = this.crossOf(measuredChild.size);
            let shift = 0.0;
            if (this.crossAxis == CrossAxis.stretch || child.fills) {
                thick = across;
            } else {
                thick = thick < across ? thick : across;
                if (this.crossAxis == CrossAxis.center) {
                    shift = (across - thick) / 2.0;
                } else if (this.crossAxis == CrossAxis.end) {
                    shift = across - thick;
                }
            }
            const wantW = horizontal ? span : thick;
            const wantH = horizontal ? thick : span;
            let placed = measuredChild;
            if (placed.size.w != wantW || placed.size.h != wantH) {
                placed = child.layout(Constraints.tight(wantW, wantH));
            }
            placed.x = pad + (horizontal ? cursor : shift);
            placed.y = pad + (horizontal ? shift : cursor);
            children.push(placed);
            cursor = cursor + span + spacing;
        }
        return new Placement(this, size, children);
    }

    override paint(cx: PaintContext, x: float, y: float, w: float, h: float): void {
        const gap = resolveFloat(this.gap, w);
        const pad = resolveFloat(this.pad, w);
        const horizontal = this.axis == Axis.horizontal;
        const innerX = x + pad;
        const innerY = y + pad;
        const innerW = w - 2.0 * pad;
        const innerH = h - 2.0 * pad;
        const room = horizontal ? innerW : innerH;
        const across = horizontal ? innerH : innerW;
        const count = this.children.length;

        const sizes: Size[] = [];
        let fixed = 0.0;
        let flexTotal = 0.0;
        for (let child of this.children) {
            const size = child.measure(innerW, innerH);
            sizes.push(size);
            if (child.flex > 0.0) {
                flexTotal = flexTotal + child.flex;
            } else {
                fixed = fixed + this.mainOf(size);
            }
        }
        const gaps = count > 1 ? gap * ((count - 1) as float) : 0.0;
        let leftover = room - fixed - gaps;
        if (leftover < 0.0) {
            leftover = 0.0;
        }

        let offset = 0.0;
        let spacing = gap;
        if (flexTotal == 0.0) {
            if (this.mainAxis == MainAxis.center) {
                offset = leftover / 2.0;
            } else if (this.mainAxis == MainAxis.end) {
                offset = leftover;
            } else if (this.mainAxis == MainAxis.spaceBetween && count > 1) {
                spacing = gap + leftover / ((count - 1) as float);
            } else if (this.mainAxis == MainAxis.spaceAround && count > 0) {
                const unit = leftover / (count as float);
                offset = unit / 2.0;
                spacing = gap + unit;
            } else if (this.mainAxis == MainAxis.spaceEvenly && count > 0) {
                const unit = leftover / ((count + 1) as float);
                offset = unit;
                spacing = gap + unit;
            }
        }

        let cursor = offset;
        for (let i = 0; i < count; i = i + 1) {
            const child = this.children[i];
            const size = sizes[i];
            let span = this.mainOf(size);
            if (child.flex > 0.0) {
                span = leftover * child.flex / flexTotal;
            }
            let thick = this.crossOf(size);
            let shift = 0.0;
            if (this.crossAxis == CrossAxis.stretch || child.fills) {
                thick = across;
            } else {
                thick = thick < across ? thick : across;
                if (this.crossAxis == CrossAxis.center) {
                    shift = (across - thick) / 2.0;
                } else if (this.crossAxis == CrossAxis.end) {
                    shift = across - thick;
                }
            }
            if (horizontal) {
                paintSlot(cx, child, `${i}`, () => child.paint(cx, innerX + cursor, innerY + shift, span, thick));
            } else {
                paintSlot(cx, child, `${i}`, () => child.paint(cx, innerX + shift, innerY + cursor, thick, span));
            }
            cursor = cursor + span + spacing;
        }
    }
}

export function Column(children: Widget[], gap: float | AdaptiveValue<float> = 8.0, pad: float | AdaptiveValue<float> = 0.0, w: float = -1.0, h: float = -1.0, mainAxis: MainAxis = MainAxis.start, crossAxis: CrossAxis = CrossAxis.start): Widget {
    return new FlexNode(Axis.vertical, children, gap, pad, w, h, mainAxis, crossAxis);
}

export function Row(children: Widget[], gap: float | AdaptiveValue<float> = 8.0, pad: float | AdaptiveValue<float> = 0.0, w: float = -1.0, h: float = -1.0, mainAxis: MainAxis = MainAxis.start, crossAxis: CrossAxis = CrossAxis.center): Widget {
    return new FlexNode(Axis.horizontal, children, gap, pad, w, h, mainAxis, crossAxis);
}
