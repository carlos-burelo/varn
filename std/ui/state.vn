import { Computed, Owner, Signal, SlotKind, computed, withOwner } from "std:signals";

class Held {
    kind: SlotKind;

    constructor(kind: SlotKind) {
        this.kind = kind;
    }
}

class Boxed<T> extends Held {
    value: T;

    constructor(kind: SlotKind, value: T) {
        super(kind);
        this.value = value;
    }
}

export class ComponentScope extends Owner {
    private _slots: Held[] = [];
    private _cleanups: (() => void)[] = [];
    private _cursor: int = 0;

    override adopt<T>(kind: SlotKind, make: () => T): T {
        if (this._cursor < this._slots.length) {
            const held = this._slots[this._cursor];
            if (held.kind != kind) {
                throw new Error("ui: a component created its state in a different order than on the previous frame");
            }
            this._cursor = this._cursor + 1;
            return (held as Boxed<T>).value;
        }
        const created = make();
        this._slots.push(new Boxed<T>(kind, created));
        this._cursor = this._cursor + 1;
        return created;
    }

    override onDispose(fn: () => void): void {
        this._cleanups.push(fn);
    }

    rewind(): void {
        this._cursor = 0;
    }

    dispose(): void {
        const pending = this._cleanups;
        this._cleanups = [];
        this._slots = [];
        for (let at = pending.length - 1; at >= 0; at = at - 1) {
            pending[at]();
        }
    }
}

const owners = new Map<str, ComponentScope>();
let touched = new Set<str>();
let mountPath: str = "";

export function beginFrame(): void {
    touched = new Set<str>();
}

export function endFrame(): void {
    const keys: str[] = [];
    for (let key of owners.keys()) {
        keys.push(key);
    }
    for (let key of keys) {
        if (!touched.has(key)) {
            const gone = owners.get(key);
            if (gone !== null) {
                gone.dispose();
            }
            owners.delete(key);
        }
    }
}

export function mountChild<T>(key: str, body: () => T): T {
    const saved = mountPath;
    mountPath = saved + "/" + key;
    const result = body();
    mountPath = saved;
    return result;
}

let definitions = 0;

export function newComponentDefinition(): int {
    definitions = definitions + 1;
    return definitions;
}

export function scopeAtMount(definition: int): ComponentScope {
    const key = `${mountPath}@${definition}`;
    touched.add(key);
    const existing = owners.get(key);
    if (existing !== null) {
        return existing;
    }
    const fresh = new ComponentScope();
    owners.set(key, fresh);
    return fresh;
}

export class View<T> {
    private _scope: ComponentScope?;
    private _body: Signal<(() => T)?>;
    private _cell: Computed<T>? = null;

    constructor(scope: ComponentScope?) {
        this._scope = scope;
        this._body = new Signal<(() => T)?>(null, null);
    }

    describe(body: () => T): T {
        this._body.set(body);
        const existing = this._cell;
        if (existing !== null) {
            return existing.value;
        }
        const fresh = computed((): T => this.produce());
        this._cell = fresh;
        return fresh.value;
    }

    dispose(): void {
        const cell = this._cell;
        if (cell !== null) {
            cell.dispose();
        }
    }

    private produce(): T {
        const body = this._body.value as () => T;
        const scope = this._scope;
        if (scope === null) {
            return body();
        }
        scope.rewind();
        return withOwner(scope, body);
    }
}
