import { Owner, SlotKind } from "std:signals";

class Held {
    kind: SlotKind;

    constructor(kind: SlotKind) {
        this.kind = kind;
    }
}

class Boxed<T> extends Held {
    value: T;

    constructor(kind: SlotKind, value: T) {
        super(kind);
        this.value = value;
    }
}

export class ComponentScope extends Owner {
    private _slots: Held[] = [];
    private _cleanups: (() => void)[] = [];
    private _cursor: int = 0;

    override adopt<T>(kind: SlotKind, make: () => T): T {
        if (this._cursor < this._slots.length) {
            const held = this._slots[this._cursor];
            if (held.kind != kind) {
                throw new Error("ui: a component created its state in a different order than on the previous frame");
            }
            this._cursor = this._cursor + 1;
            return (held as Boxed<T>).value;
        }
        const created = make();
        this._slots.push(new Boxed<T>(kind, created));
        this._cursor = this._cursor + 1;
        return created;
    }

    override onDispose(fn: () => void): void {
        this._cleanups.push(fn);
    }

    rewind(): void {
        this._cursor = 0;
    }

    dispose(): void {
        const pending = this._cleanups;
        this._cleanups = [];
        this._slots = [];
        for (let at = pending.length - 1; at >= 0; at = at - 1) {
            pending[at]();
        }
    }
}

const SCOPE_STRIDE = 65536;

const scopes = new Map<int, ComponentScope>();
let calls = new Map<int, int>();
let touched = new Set<int>();
let frameOpen = false;
let nextComponentId = 1;

export function newComponentId(): int {
    const id = nextComponentId;
    nextComponentId = nextComponentId + 1;
    return id;
}

export function beginFrame(): void {
    calls = new Map<int, int>();
    touched = new Set<int>();
    frameOpen = true;
}

export function endFrame(): void {
    frameOpen = false;
    const keys: int[] = [];
    for (let key of scopes.keys()) {
        keys.push(key);
    }
    for (let key of keys) {
        if (!touched.has(key)) {
            const gone = scopes.get(key);
            if (gone !== null) {
                gone.dispose();
            }
            scopes.delete(key);
        }
    }
}

export function scopeFor(id: int): ComponentScope {
    if (!frameOpen) {
        return new ComponentScope();
    }
    const seen = calls.get(id) ?? 0;
    calls.set(id, seen + 1);
    const key = id * SCOPE_STRIDE + seen;
    touched.add(key);
    const existing = scopes.get(key);
    const scope = existing ?? new ComponentScope();
    if (existing === null) {
        scopes.set(key, scope);
    }
    scope.rewind();
    return scope;
}
