import {
    defineMetadata$,
    getMetadata$,
    hasMetadata$,
    createMetaKey$,
    setMetaKey$,
    getMetaKey$,
    hasMetaKey$
} from "runtime:reflect";

export interface ClassRef {
    name: str;
}

export interface FunctionRef {
    name: str;
    length: int;
}

export function defineMetadata<K, V, T>(metadataKey: K, metadataValue: V, target: T): void {
    defineMetadata$(metadataKey, metadataValue, target);
}

export function getMetadata<K, V, T>(metadataKey: K, target: T): V? {
    return getMetadata$(metadataKey, target);
}

export function hasMetadata<K, T>(metadataKey: K, target: T): bool {
    return hasMetadata$(metadataKey, target);
}

export function createMetaKey(): str {
    return createMetaKey$();
}

export function setMetaKey<V, T>(metaId: str, target: T, value: V): void {
    setMetaKey$(metaId, target, value);
}

export function getMetaKey<V, T>(metaId: str, target: T): V? {
    return getMetaKey$(metaId, target);
}

export function hasMetaKey<T>(metaId: str, target: T): bool {
    return hasMetaKey$(metaId, target);
}

export function getMetadataKeys<T>(target: T): str[] {
    return [];
}

export class MetaKey<K extends Hashable, V> {
    private values: Map<K, V> = new Map<K, V>();

    static create<A extends Hashable, B>(): MetaKey<A, B> {
        return new MetaKey<A, B>();
    }

    set(target: K, value: V): void {
        this.values.set(target, value);
    }

    get(target: K): V? {
        return this.values.get(target);
    }

    has(target: K): bool {
        return this.values.has(target);
    }
}
