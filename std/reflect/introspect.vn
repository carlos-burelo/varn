export class Reflect {
    static keys<T>(target: T): str[] {
        return target::keys();
    }

    static hasOwn<T>(target: T, key: str): bool {
        return target::hasOwn(key);
    }

    static typeOf<T>(target: T): str {
        return target::type;
    }

    static classOf<T>(target: T): Class<T> {
        return target::class;
    }
}
