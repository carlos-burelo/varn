import {
    tcpListen$,
    tcpListenTls$,
    tcpAccept$,
    tcpConnect$,
    tcpConnectTls$,
    tcpRead$,
    tcpWrite$,
    tcpClose$,
    tcpCloseListener$
} from "runtime:net";

import { AsyncReader, AsyncWriter } from "std:io";
import { delay } from "std:task";

export class TcpStream implements AsyncReader, AsyncWriter {
    private _connId: int;
    private _remoteHost: str;
    private _remotePort: int;
    private _isOpen: bool = true;

    constructor(connId: int, remoteHost: str = "127.0.0.1", remotePort: int = 0) {
        this._connId = connId;
        this._remoteHost = remoteHost;
        this._remotePort = remotePort;
    }

    static async connect(host: str, port: int, attempts: int = 25, baseDelayMs: int = 50): Task<TcpStream> {
        return await TcpStream.open(host, port, false, null, attempts, baseDelayMs);
    }

    static async connectTls(host: str, port: int, ca?: str, attempts: int = 5, baseDelayMs: int = 50): Task<TcpStream> {
        return await TcpStream.open(host, port, true, ca, attempts, baseDelayMs);
    }

    private static async open(host: str, port: int, secure: bool, ca: str?, attempts: int, baseDelayMs: int): Task<TcpStream> {
        let attempt = 0;
        let cause = "no attempt was made";
        while (attempt < attempts) {
            try {
                let connId = secure ? await tcpConnectTls$(host, port, ca) : await tcpConnect$(host, port);
                return new TcpStream(connId, host, port);
            } catch (e) {
                cause = e.message;
            }
            attempt = attempt + 1;
            if (attempt < attempts) {
                await delay(baseDelayMs + attempt * 20);
            }
        }
        throw new Error("TcpConnectError: Could not connect to " + host + ":" + port.toString() + " (" + cause + ")");
    }

    get connId(): int {
        return this._connId;
    }

    get remoteHost(): str {
        return this._remoteHost;
    }

    get remotePort(): int {
        return this._remotePort;
    }

    get isOpen(): bool {
        return this._isOpen;
    }

    async read(size: int = 4096): Task<Bytes?> {
        if (!this._isOpen) {
            return null;
        }
        return await tcpRead$(this._connId, size);
    }

    async readText(size: int = 4096): Task<str> {
        let b = await this.read(size);
        if (b === null) {
            return "";
        }
        let valid = b as Bytes;
        return valid.toString();
    }

    async readAll(): Task<Bytes> {
        let chunks: Bytes[] = [];
        let totalLen = 0;
        while (this._isOpen) {
            let chunk = await this.read(4096);
            if (chunk === null) {
                break;
            }
            let valid = chunk as Bytes;
            if (valid.length === 0) {
                break;
            }
            chunks.push(valid);
            totalLen = totalLen + valid.length;
        }
        let merged = Bytes.alloc(totalLen);
        let offset = 0;
        for (let i = 0; i < chunks.length; i = i + 1) {
            let c = chunks[i];
            c.copy(merged, offset);
            offset = offset + c.length;
        }
        return merged;
    }

    async write(data: Bytes | str): Task<int> {
        if (!this._isOpen) {
            throw new Error("TcpWriteError: Socket is closed");
        }
        let b: Bytes = data is str ? Bytes.fromString(data) : data as Bytes;
        try {
            return await tcpWrite$(this._connId, b);
        } catch (e) {
            this.close();
            throw new Error("TcpWriteError: " + e.message);
        }
    }

    async writeAll(data: Bytes | str): Task<void> {
        let b: Bytes = data is str ? Bytes.fromString(data) : data as Bytes;
        let offset = 0;
        while (offset < b.length) {
            let chunk = b.slice(offset, b.length);
            let written = await this.write(chunk);
            if (written <= 0) {
                break;
            }
            offset = offset + written;
        }
    }

    async flush(): Task<void> {}

    close(): void {
        if (this._isOpen) {
            tcpClose$(this._connId);
            this._isOpen = false;
        }
    }
}

export class TcpListener {
    private _listenerId: int;
    private _port: int;
    private _host: str;
    private _isListening: bool;

    constructor(listenerId: int, port: int, host: str = "127.0.0.1") {
        this._listenerId = listenerId;
        this._port = port;
        this._host = host;
        this._isListening = listenerId >= 0;
    }

    static listenTls(port: int, cert: str, key: str, host: str = "127.0.0.1"): TcpListener {
        try {
            return new TcpListener(tcpListenTls$(port, host, cert, key), port, host);
        } catch (e) {
            throw new Error(`TcpListenError: Could not bind a TLS listener to port ${port} (${e.message})`);
        }
    }

    static listen(port: int, host: str = "127.0.0.1"): TcpListener {
        try {
            return new TcpListener(tcpListen$(port, host), port, host);
        } catch (e) {
            throw new Error(`TcpListenError: Could not bind listener to port ${port} (${e.message})`);
        }
    }

    get port(): int {
        return this._port;
    }

    get host(): str {
        return this._host;
    }

    get isListening(): bool {
        return this._isListening;
    }

    async accept(): Task<TcpStream> {
        if (!this._isListening) {
            throw new Error("TcpAcceptError: Listener is closed");
        }
        try {
            return new TcpStream(await tcpAccept$(this._listenerId), this._host, this._port);
        } catch (e) {
            throw new Error("TcpAcceptError: " + e.message);
        }
    }

    close(): void {
        if (this._isListening) {
            tcpCloseListener$(this._listenerId);
            this._isListening = false;
        }
    }
}

export async function connect(host: str, port: int): Task<TcpStream> {
    return await TcpStream.connect(host, port);
}

export function listen(port: int, host: str = "127.0.0.1"): TcpListener {
    return TcpListener.listen(port, host);
}
