import {
    encodeURIComponent$,
    decodeURIComponent$
} from "runtime:net";

function trimPrefixQ(s: str): str {
    if (s.startsWith("?")) {
        return s.slice(1);
    }
    return s;
}

export class Query {
    private buckets: Map<str, str[]> = new Map<str, str[]>();

    constructor(init?: str | Map<str, str | str[]>) {
        if (init is str) {
            this._parse(init);
        } else if (init != null) {
            for (const (key, value) of init as Map<str, str | str[]>) {
                if (value is str[]) {
                    for (const item of value) {
                        this.append(key, item);
                    }
                } else {
                    this.append(key, value as str);
                }
            }
        }
    }

    private _parse(s: str): void {
        const text = trimPrefixQ(s);
        if (text.length == 0) {
            return;
        }

        const entries = text.split("&");
        for (const entry of entries) {
            if (entry.length == 0) {
                continue;
            }

            const eq = entry.indexOf("=");
            const rawKey = eq != null ? entry.slice(0, eq) : entry;
            const rawValue = eq != null ? entry.slice(eq + 1) : "";

            this.append(decodeURIComponent$(rawKey), decodeURIComponent$(rawValue));
        }
    }

    static parse(s: str): Query {
        return new Query(s);
    }

    static fromMap(q: Map<str, str | str[]>): Query {
        return new Query(q);
    }

    get(key: str): str? {
        const bucket = this.buckets.get(key);
        if (bucket == null || bucket.length == 0) {
            return null;
        }
        return bucket[0];
    }

    getAll(key: str): str[] {
        const bucket = this.buckets.get(key);
        if (bucket == null) {
            return [];
        }
        return bucket.slice();
    }

    set(key: str, value: str): void {
        this.buckets.set(key, [value]);
    }

    append(key: str, value: str): void {
        const bucket = this.buckets.get(key);
        if (bucket == null) {
            this.buckets.set(key, [value]);
        } else {
            bucket.push(value);
        }
    }

    has(key: str): bool {
        return this.buckets.has(key);
    }

    delete(key: str): void {
        this.buckets.delete(key);
    }

    keys(): str[] {
        return this.buckets.keys();
    }

    values(): str[] {
        let res: str[] = [];
        for (const (key, bucket) of this.buckets) {
            for (const val of bucket) {
                res.push(val);
            }
        }
        return res;
    }

    entries(): (str, str)[] {
        let res: (str, str)[] = [];
        for (const (key, bucket) of this.buckets) {
            for (const val of bucket) {
                res.push((key, val));
            }
        }
        return res;
    }

    toMap(): Map<str, str[]> {
        return this.buckets;
    }

    toString(): str {
        const parts: str[] = [];
        for (const (key, bucket) of this.buckets) {
            const encodedKey = encodeURIComponent$(key);
            for (const value of bucket) {
                parts.push(encodedKey + "=" + encodeURIComponent$(value));
            }
        }
        return parts.join("&");
    }
}
