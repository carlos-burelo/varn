import { Query } from "std:net/query";
import { ParseError } from "std:error";

const MAX_PORT = 65535;

class Reference {
    scheme: str = "";
    hasAuthority: bool = false;
    userinfo: str = "";
    host: str = "";
    port: int? = null;
    path: str = "";
    hasQuery: bool = false;
    query: str = "";
    fragment: str = "";
}

function isSchemeChar(code: int, first: bool): bool {
    const alpha = (code >= 65 && code <= 90) || (code >= 97 && code <= 122);
    if (first) {
        return alpha;
    }
    return alpha || (code >= 48 && code <= 57) || code == 43 || code == 45 || code == 46;
}

function schemeEnd(text: str): int {
    for (let i = 0; i < text.length; i = i + 1) {
        const code = text.charCodeAt(i) as int;
        if (code == 58) {
            return i > 0 ? i : -1;
        }
        if (!isSchemeChar(code, i == 0)) {
            return -1;
        }
    }
    return -1;
}

function parsePort(text: str, source: str): int? {
    if (text.length == 0) {
        return null;
    }
    let value = 0;
    for (let i = 0; i < text.length; i = i + 1) {
        const code = text.charCodeAt(i) as int;
        if (code < 48 || code > 57) {
            throw new ParseError(`invalid port in '${source}'`);
        }
        value = value * 10 + (code - 48);
        if (value > MAX_PORT) {
            throw new ParseError(`port out of range in '${source}'`);
        }
    }
    return value;
}

function requireHostChars(host: str, bracketed: bool, source: str): void {
    for (let i = 0; i < host.length; i = i + 1) {
        const code = host.charCodeAt(i) as int;
        const forbidden = code <= 32 || code == 127 || code == 47 || code == 92 || code == 63 || code == 35 || code == 64 || code == 91 || code == 93 || (!bracketed && code == 58);
        if (forbidden) {
            throw new ParseError(`invalid host in '${source}'`);
        }
    }
}

function parseAuthority(authority: str, ref: Reference, source: str): void {
    const at = authority.lastIndexOf("@");
    let hostPort = authority;
    if (at != null) {
        ref.userinfo = authority.slice(0, at);
        hostPort = authority.slice(at + 1);
    }
    if (hostPort.startsWith("[")) {
        const close = hostPort.indexOf("]");
        if (close == null) {
            throw new ParseError(`unterminated IPv6 host in '${source}'`);
        }
        const inside = hostPort.slice(1, close);
        requireHostChars(inside, true, source);
        ref.host = inside.toLowerCase();
        const after = hostPort.slice(close + 1);
        if (after.length > 0) {
            if (!after.startsWith(":")) {
                throw new ParseError(`invalid host in '${source}'`);
            }
            ref.port = parsePort(after.slice(1), source);
        }
        return;
    }
    const colon = hostPort.lastIndexOf(":");
    let hostText = hostPort;
    if (colon != null) {
        hostText = hostPort.slice(0, colon);
        ref.port = parsePort(hostPort.slice(colon + 1), source);
    }
    requireHostChars(hostText, false, source);
    ref.host = hostText.toLowerCase();
}

function splitReference(text: str): Reference {
    for (let i = 0; i < text.length; i = i + 1) {
        const code = text.charCodeAt(i) as int;
        if (code <= 32 || code == 127) {
            throw new ParseError(`a URL cannot hold spaces or control characters: '${text}'`);
        }
    }
    const ref = new Reference();
    let rest = text;
    const hash = rest.indexOf("#");
    if (hash != null) {
        ref.fragment = rest.slice(hash + 1);
        rest = rest.slice(0, hash);
    }
    const question = rest.indexOf("?");
    if (question != null) {
        ref.hasQuery = true;
        ref.query = rest.slice(question + 1);
        rest = rest.slice(0, question);
    }
    const colon = schemeEnd(rest);
    if (colon >= 0) {
        ref.scheme = rest.slice(0, colon).toLowerCase();
        rest = rest.slice(colon + 1);
    }
    if (rest.startsWith("//")) {
        const body = rest.slice(2);
        const slash = body.indexOf("/");
        ref.hasAuthority = true;
        ref.path = slash == null ? "" : body.slice(slash);
        parseAuthority(slash == null ? body : body.slice(0, slash), ref, text);
    } else {
        ref.path = rest;
    }
    return ref;
}

function dropLastSegment(output: str): str {
    const at = output.lastIndexOf("/");
    return at == null ? "" : output.slice(0, at);
}

function removeDotSegments(path: str): str {
    let input = path;
    let output = "";
    while (input.length > 0) {
        if (input.startsWith("../")) {
            input = input.slice(3);
        } else if (input.startsWith("./")) {
            input = input.slice(2);
        } else if (input.startsWith("/./")) {
            input = input.slice(2);
        } else if (input == "/.") {
            input = "/";
        } else if (input.startsWith("/../")) {
            input = input.slice(3);
            output = dropLastSegment(output);
        } else if (input == "/..") {
            input = "/";
            output = dropLastSegment(output);
        } else if (input == "." || input == "..") {
            input = "";
        } else {
            const start = input.startsWith("/") ? 1 : 0;
            const cut = input.slice(start).indexOf("/");
            const segment = cut == null ? input : input.slice(0, start + cut);
            output = output + segment;
            input = input.slice(segment.length);
        }
    }
    return output;
}

function mergePaths(base: Url, relative: str): str {
    if (base.host.length > 0 && base.path.length == 0) {
        return "/" + relative;
    }
    const slash = base.path.lastIndexOf("/");
    return slash == null ? relative : base.path.slice(0, slash + 1) + relative;
}

export class Url {
    protocol: str = "";
    userinfo: str = "";
    host: str = "";
    port: int? = null;
    path: str = "";
    query: Query = new Query();
    fragment: str = "";
    private _sourceQuery: str = "";
    private _sourceNormalized: str = "";

    static parse(url: str): Url {
        const ref = splitReference(url);
        if (ref.scheme.length == 0) {
            throw new ParseError(`'${url}' is not an absolute URL: it has no scheme`);
        }
        const out = new Url();
        out.protocol = ref.scheme;
        out.userinfo = ref.userinfo;
        out.host = ref.host;
        out.port = ref.port;
        out.path = ref.hasAuthority && ref.path.length == 0 ? "/" : ref.path;
        out.keepQuery(ref.query);
        out.fragment = ref.fragment;
        return out;
    }

    private keepQuery(text: str): void {
        this.query = Query.parse(text);
        this._sourceQuery = text;
        this._sourceNormalized = this.query.toString();
    }

    static resolve(base: str | Url, relative: str): Url {
        const origin: Url = base is str ? Url.parse(base) : base as Url;
        const ref = splitReference(relative);
        const out = new Url();
        out.fragment = ref.fragment;
        if (ref.scheme.length > 0 || ref.hasAuthority) {
            out.protocol = ref.scheme.length > 0 ? ref.scheme : origin.protocol;
            out.userinfo = ref.userinfo;
            out.host = ref.host;
            out.port = ref.port;
            const path = removeDotSegments(ref.path);
            out.path = ref.hasAuthority && path.length == 0 ? "/" : path;
            out.keepQuery(ref.query);
            return out;
        }
        out.protocol = origin.protocol;
        out.userinfo = origin.userinfo;
        out.host = origin.host;
        out.port = origin.port;
        if (ref.path.length == 0) {
            out.path = origin.path;
            if (ref.hasQuery) {
                out.keepQuery(ref.query);
            } else {
                out.keepQuery(origin.queryText());
            }
            return out;
        }
        out.path = removeDotSegments(ref.path.startsWith("/") ? ref.path : mergePaths(origin, ref.path));
        out.keepQuery(ref.query);
        return out;
    }

    queryText(): str {
        const current = this.query.toString();
        return current == this._sourceNormalized ? this._sourceQuery : current;
    }

    authority(): str {
        const shown = this.host.indexOf(":") == null ? this.host : "[" + this.host + "]";
        const port = this.port;
        return port == null ? shown : `${shown}:${port}`;
    }

    withQuery(query: Query): Url {
        const next = new Url();
        next.protocol = this.protocol;
        next.userinfo = this.userinfo;
        next.host = this.host;
        next.port = this.port;
        next.path = this.path;
        next.query = query;
        next.fragment = this.fragment;
        return next;
    }

    toString(): str {
        let out = this.protocol.length > 0 ? this.protocol + ":" : "";
        if (this.host.length > 0) {
            out = out + "//" + (this.userinfo.length > 0 ? this.userinfo + "@" : "") + this.authority();
            out = out + (this.path.length == 0 ? "/" : this.path);
        } else {
            out = out + this.path;
        }
        const queryText = this.queryText();
        if (queryText.length > 0) {
            out = out + "?" + queryText;
        }
        if (this.fragment.length > 0) {
            out = out + "#" + this.fragment;
        }
        return out;
    }
}

export function parseUrl(url: str): Url {
    return Url.parse(url);
}

export function appendQuery(url: str, q: { [key: str]: str | str[] }): str {
    let hasKeys = false;
    for (const key in q) {
        if (q[key] != null) {
            hasKeys = true;
            break;
        }
    }
    if (!hasKeys) {
        return url;
    }

    const parsed = Url.parse(url);
    for (const key in q) {
        const value = q[key];
        if (value == null) {
            continue;
        }
        if (value is str[]) {
            for (const item of value) {
                parsed.query.append(key, item);
            }
        } else {
            parsed.query.append(key, value);
        }
    }
    return parsed.toString();
}
