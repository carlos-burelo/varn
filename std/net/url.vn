import { Query } from "std:net/query";

export class Url {
    protocol: str = "";
    host: str = "";
    port: int? = null;
    path: str = "";
    query: Query = new Query();
    fragment: str = "";

    static parse(url: str): Url {
        const out = new Url();
        
        let rest = url;
        
        // 1. Extract protocol
        let protoIdx = rest.indexOf("://");
        if (protoIdx >= 0) {
            out.protocol = rest.slice(0, protoIdx);
            rest = rest.slice(protoIdx + 3);
        }
        
        // 2. Extract fragment
        let fragIdx = rest.indexOf("#");
        if (fragIdx >= 0) {
            out.fragment = rest.slice(fragIdx + 1);
            rest = rest.slice(0, fragIdx);
        }
        
        // 3. Extract query
        let queryIdx = rest.indexOf("?");
        let queryStr = "";
        if (queryIdx >= 0) {
            queryStr = rest.slice(queryIdx + 1);
            rest = rest.slice(0, queryIdx);
        }
        out.query = Query.parse(queryStr);
        
        // 4. Extract path and host/port
        let pathIdx = rest.indexOf("/");
        let hostAndPort = rest;
        if (pathIdx >= 0) {
            out.path = rest.slice(pathIdx);
            hostAndPort = rest.slice(0, pathIdx);
        } else {
            out.path = "/";
        }
        
        // 5. Extract host and port
        let portIdx = hostAndPort.indexOf(":");
        if (portIdx >= 0) {
            out.host = hostAndPort.slice(0, portIdx);
            let portStr = hostAndPort.slice(portIdx + 1);
            
            // Convert portStr to integer
            let portVal = 0;
            let keepParsing = true;
            for (let i = 0; i < portStr.length; i = i + 1) {
                if (keepParsing) {
                    let c = portStr[i];
                    let digit = -1;
                    if (c === "0") digit = 0;
                    else if (c === "1") digit = 1;
                    else if (c === "2") digit = 2;
                    else if (c === "3") digit = 3;
                    else if (c === "4") digit = 4;
                    else if (c === "5") digit = 5;
                    else if (c === "6") digit = 6;
                    else if (c === "7") digit = 7;
                    else if (c === "8") digit = 8;
                    else if (c === "9") digit = 9;
                    
                    if (digit >= 0) {
                        portVal = portVal * 10 + digit;
                    } else {
                        keepParsing = false;
                    }
                }
            }
            out.port = portVal;
        } else {
            out.host = hostAndPort;
            out.port = null;
        }
        
        return out;
    }

    static resolve(base: str | Url, relative: str): Url {
        let baseObj: Url = typeof base === "str" ? Url.parse(base as str) : (base as Url);
        if (relative.includes("://")) {
            return Url.parse(relative);
        }
        let next = new Url();
        next.protocol = baseObj.protocol;
        next.host = baseObj.host;
        next.port = baseObj.port;
        
        let pathPart = relative;
        let queryPart = "";
        let fragPart = "";
        
        let hashIdx = pathPart.indexOf("#");
        if (hashIdx >= 0) {
            fragPart = pathPart.slice(hashIdx + 1);
            pathPart = pathPart.slice(0, hashIdx);
        }
        let qIdx = pathPart.indexOf("?");
        if (qIdx >= 0) {
            queryPart = pathPart.slice(qIdx + 1);
            pathPart = pathPart.slice(0, qIdx);
        }
        
        if (pathPart.startsWith("/")) {
            next.path = pathPart;
        } else {
            let baseDir = baseObj.path;
            let lastSlash = baseDir.lastIndexOf("/");
            if (lastSlash >= 0) {
                baseDir = baseDir.slice(0, lastSlash + 1);
            } else {
                baseDir = "/";
            }
            next.path = baseDir + pathPart;
        }
        next.query = Query.parse(queryPart);
        next.fragment = fragPart;
        return next;
    }

    withQuery(query: Query): Url {
        const next = new Url();
        next.protocol = this.protocol;
        next.host = this.host;
        next.port = this.port;
        next.path = this.path;
        next.query = query;
        next.fragment = this.fragment;
        return next;
    }

    toString(): str {
        let out = this.protocol + "://" + this.host;
        const port = this.port;
        if (port != null) {
            out = out + ":" + port.toString();
        }

        if (this.path.length == 0) {
            out = out + "/";
        } else {
            out = out + this.path;
        }

        const queryText = this.query.toString();
        if (queryText.length > 0) {
            out = out + "?" + queryText;
        }

        if (this.fragment.length > 0) {
            out = out + "#" + this.fragment;
        }

        return out;
    }
}

export function parseURL(url: str): Url {
    return Url.parse(url);
}

export function appendQuery(url: str, q: { [key: str]: str | str[] }): str {
    if (q == null) {
        return url;
    }
    let hasKeys = false;
    for (const key in q) {
        if (q[key] != null) {
            hasKeys = true;
            break;
        }
    }
    if (!hasKeys) {
        return url;
    }

    const parsed = Url.parse(url);
    for (const key in q) {
        const value = q[key];
        if (value == null) {
            continue;
        }
        if (Array.isArray(value)) {
            for (const item of value) {
                parsed.query.append(key, item);
            }
        } else {
            parsed.query.append(key, value);
        }
    }
    return parsed.toString();
}
