import { tcpConnect$, tcpConnectTls$, tcpWrite$, tcpClose$, httpMethodName$, HttpMethod } from "runtime:net";
import { Url } from "std:net";
import { Response, RawResponse, RequestInit, readHttpResponse } from "std:http/core";
import { isRedirect, sameOrigin, resolveLocation, redirectedMethod, redirectedHeaders } from "std:http/redirect";

async function doFetch(connId: int, parsedUrl: Url, method: HttpMethod, headers: { [key: str]: str }, body: str): Task<Response> {
    let requestStr = httpMethodName$(method) + " " + parsedUrl.path;
    const queryStr = parsedUrl.query.toString();
    if (queryStr.length > 0) {
        requestStr = requestStr + "?" + queryStr;
    }
    requestStr = requestStr + " HTTP/1.1\r\n";

    let hasHost = false;
    let hasConnection = false;
    for (let key in headers) {
        const lower = key.toLowerCase();
        if (lower === "host") {
            hasHost = true;
        }
        if (lower === "connection") {
            hasConnection = true;
        }
    }
    if (!hasHost) {
        const explicitPort = parsedUrl.port;
        const authority = explicitPort === null ? parsedUrl.host : `${parsedUrl.host}:${explicitPort}`;
        requestStr = requestStr + "Host: " + authority + "\r\n";
    }
    if (!hasConnection) {
        requestStr = requestStr + "Connection: close\r\n";
    }

    if (body.length > 0) {
        requestStr = requestStr + "Content-Length: " + Bytes.fromString(body).length.toString() + "\r\n";
    }

    for (let key in headers) {
        requestStr = `${requestStr}${key}: ${headers[key]}\r\n`;
    }

    requestStr = requestStr + "\r\n";

    if (body.length > 0) {
        requestStr = requestStr + body;
    }

    let writeFailure: str? = null;
    try {
        await tcpWrite$(connId, requestStr);
    } catch (e) {
        writeFailure = e.message;
    }
    if (writeFailure !== null) {
        tcpClose$(connId);
        throw new Error(`NetworkError: Failed to write request to ${parsedUrl.host}:${parsedUrl.port} (${writeFailure})`);
    }

    let rawResp: RawResponse? = null;
    try {
        rawResp = await readHttpResponse(connId, method === HttpMethod.HEAD);
    } catch (e) {
        tcpClose$(connId);
        throw new Error(`NetworkError: Failed to read the response from ${parsedUrl.host}:${parsedUrl.port} (${e.message})`);
    }
    tcpClose$(connId);

    if (rawResp === null) {
        throw new Error(`NetworkError: Empty response from ${parsedUrl.host}:${parsedUrl.port}`);
    }

    const raw = rawResp as RawResponse;
    const response = new Response(raw.payload.toString(), raw.status, raw.headers);
    if (raw.statusText.length > 0) {
        response.statusText = raw.statusText;
    }
    response.cookies = raw.cookies;
    response.payload = raw.payload;
    return response;
}

async function fetchOnce(url: str, method: HttpMethod, headers: { [key: str]: str }, body: str, ca: str?): Task<Response> {
    const parsedUrl = Url.parse(url);
    const host = parsedUrl.host;

    const secure = parsedUrl.protocol === "https";
    if (!secure && parsedUrl.protocol !== "http") {
        throw new Error(`NetworkError: Unsupported protocol '${parsedUrl.protocol}' in ${url}`);
    }

    let port = secure ? 443 : 80;
    const parsedPort = parsedUrl.port;
    if (parsedPort !== null) {
        port = parsedPort;
    }

    let connId = -1;
    let connectFailure = "";
    try {
        connId = secure ? await tcpConnectTls$(host, port, ca) : await tcpConnect$(host, port);
    } catch (e) {
        connectFailure = e.message;
    }
    if (connId === -1) {
        throw new Error(`NetworkError: Could not connect to ${host}:${port} (${connectFailure})`);
    }

    return await doFetch(connId, parsedUrl, method, headers, body);
}

export async function fetch(url: str, init: RequestInit = {}): Task<Response> {
    const follow = init.followRedirects ?? true;
    const limit = init.maxRedirects ?? 20;
    let current = url;
    let method = init.method ?? HttpMethod.GET;
    let body = init.body ?? "";
    let headers = init.headers ?? {};
    let hops = 0;
    while (true) {
        const response = await fetchOnce(current, method, headers, body, init.ca);
        response.url = current;
        const location = response.headers.get("location");
        if (!follow || location === null || !isRedirect(response.status)) {
            return response;
        }
        if (hops >= limit) {
            throw new Error(`NetworkError: More than ${limit} redirects starting at ${url}`);
        }
        hops = hops + 1;
        const from = Url.parse(current);
        const next = resolveLocation(from, location as str);
        const nextMethod = redirectedMethod(response.status, method);
        const dropBody = nextMethod !== method;
        headers = redirectedHeaders(headers, dropBody, !sameOrigin(from, Url.parse(next)));
        if (dropBody) {
            body = "";
        }
        method = nextMethod;
        current = next;
    }
}

export async function get(url: str, headers: { [key: str]: str } = {}): Task<Response> {
    return await fetch(url, { method: HttpMethod.GET, headers: headers });
}

export async function post(url: str, body: str = "", headers: { [key: str]: str } = {}): Task<Response> {
    return await fetch(url, { method: HttpMethod.POST, headers: headers, body: body });
}

export async function put(url: str, body: str = "", headers: { [key: str]: str } = {}): Task<Response> {
    return await fetch(url, { method: HttpMethod.PUT, headers: headers, body: body });
}

export async function patch(url: str, body: str = "", headers: { [key: str]: str } = {}): Task<Response> {
    return await fetch(url, { method: HttpMethod.PATCH, headers: headers, body: body });
}

export async function del(url: str, headers: { [key: str]: str } = {}): Task<Response> {
    return await fetch(url, { method: HttpMethod.DELETE, headers: headers });
}
