import { HttpMethod } from "runtime:net";
import { Url } from "std:net";

const BODY_HEADERS: str[] = [
    "content-type",
    "content-length",
    "content-encoding",
    "content-language",
    "content-location",
    "transfer-encoding"
];

const CREDENTIAL_HEADERS: str[] = ["authorization", "cookie", "proxy-authorization"];

export function isRedirect(status: int): bool {
    return status == 301 || status == 302 || status == 303 || status == 307 || status == 308;
}

function effectivePort(url: Url): int {
    const explicit = url.port;
    if (explicit != null) {
        return explicit as int;
    }
    return url.protocol == "https" ? 443 : 80;
}

export function sameOrigin(a: Url, b: Url): bool {
    return a.protocol == b.protocol && a.host == b.host && effectivePort(a) == effectivePort(b);
}

export function resolveLocation(base: Url, location: str): str {
    return Url.resolve(base, location).toString();
}

export function redirectedMethod(status: int, method: HttpMethod): HttpMethod {
    if (status == 303 && method != HttpMethod.HEAD) {
        return HttpMethod.GET;
    }
    if ((status == 301 || status == 302) && method == HttpMethod.POST) {
        return HttpMethod.GET;
    }
    return method;
}

export function redirectedHeaders(
    headers: Map<str, str>,
    dropBody: bool,
    crossOrigin: bool
): Map<str, str> {
    const out = new Map<str, str>();
    for (const (key, value) of headers) {
        const lower = key.toLowerCase();
        if (lower == "host") {
            continue;
        }
        if (dropBody && BODY_HEADERS.includes(lower)) {
            continue;
        }
        if (crossOrigin && CREDENTIAL_HEADERS.includes(lower)) {
            continue;
        }
        out.set(key, value);
    }
    return out;
}
