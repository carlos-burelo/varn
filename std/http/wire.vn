import { tcpRead$ } from "runtime:net";
import { ProtocolError } from "std:error";

const READ_SIZE = 16384;

export class LineTooLongError extends ProtocolError {
    constructor(limit: int) {
        super(`line exceeds ${limit} bytes`);
        this.name = "LineTooLongError";
    }
}

export class BodyTooLargeError extends ProtocolError {
    constructor(limit: int) {
        super(`body exceeds ${limit} bytes`);
        this.name = "BodyTooLargeError";
    }
}

export class ByteBuilder {
    private data: Bytes;
    private used: int = 0;

    constructor(capacity: int = 4096) {
        this.data = Bytes.alloc(capacity);
    }

    get length(): int {
        return this.used;
    }

    append(source: Bytes, start: int, end: int): void {
        const count = end - start;
        if (count <= 0) {
            return;
        }
        if (this.used + count > this.data.length) {
            let capacity = this.data.length * 2;
            while (capacity < this.used + count) {
                capacity = capacity * 2;
            }
            const grown = Bytes.alloc(capacity);
            this.data.copy(grown, 0, 0, this.used);
            this.data = grown;
        }
        source.copy(this.data, this.used, start, end);
        this.used = this.used + count;
    }

    byteAt(index: int): int {
        return this.data.getByte(index);
    }

    slice(start: int, end: int): Bytes {
        const out = Bytes.alloc(end - start);
        this.data.copy(out, 0, start, end);
        return out;
    }
}

export class WireReader {
    private conn: int;
    private buffer: ByteBuilder = new ByteBuilder(READ_SIZE);
    private cursor: int = 0;
    private ended: bool = false;

    constructor(conn: int) {
        this.conn = conn;
    }

    get connId(): int {
        return this.conn;
    }

    private get buffered(): int {
        return this.buffer.length - this.cursor;
    }

    async pull(): Task<bool> {
        if (this.ended) {
            return false;
        }
        const chunk = await tcpRead$(this.conn, READ_SIZE);
        if (chunk === null) {
            this.ended = true;
            return false;
        }
        const bytes = chunk as Bytes;
        this.buffer.append(bytes, 0, bytes.length);
        return true;
    }

    async line(limit: int = 65536): Task<str?> {
        let scanned = this.cursor;
        while (true) {
            const end = this.buffer.length;
            for (let i = scanned; i + 1 < end; i = i + 1) {
                if (this.buffer.byteAt(i) === 13 && this.buffer.byteAt(i + 1) === 10) {
                    if (i - this.cursor > limit) {
                        throw new LineTooLongError(limit);
                    }
                    const text = this.buffer.slice(this.cursor, i).toString();
                    this.cursor = i + 2;
                    return text;
                }
            }
            if (end - this.cursor > limit) {
                throw new LineTooLongError(limit);
            }
            scanned = end - 1 > this.cursor ? end - 1 : this.cursor;
            if (!(await this.pull())) {
                return null;
            }
        }
    }

    async take(count: int): Task<Bytes?> {
        while (this.buffered < count) {
            if (!(await this.pull())) {
                return null;
            }
        }
        const out = this.buffer.slice(this.cursor, this.cursor + count);
        this.cursor = this.cursor + count;
        return out;
    }

    async rest(): Task<Bytes> {
        while (true) {
            if (!(await this.pull())) {
                break;
            }
        }
        const out = this.buffer.slice(this.cursor, this.buffer.length);
        this.cursor = this.buffer.length;
        return out;
    }
}

function hexDigit(code: int): int {
    if (code >= 48 && code <= 57) return code - 48;
    if (code >= 97 && code <= 102) return code - 87;
    if (code >= 65 && code <= 70) return code - 55;
    return -1;
}

function parseChunkSize(line: str): int {
    const extension = line.indexOf(";");
    const digits = (extension === null ? line : line.slice(0, extension)).trim();
    if (digits.length === 0 || digits.length > 15) {
        throw new ProtocolError("malformed chunk size line");
    }
    let size = 0;
    for (let i = 0; i < digits.length; i = i + 1) {
        const digit = hexDigit(digits.charCodeAt(i) as int);
        if (digit < 0) {
            throw new ProtocolError(`malformed chunk size '${digits}'`);
        }
        size = size * 16 + digit;
    }
    return size;
}

export async function readChunkedBody(wire: WireReader, maxBytes: int): Task<Bytes> {
    const body = new ByteBuilder();
    while (true) {
        const sizeLine = await wire.line();
        if (sizeLine === null) {
            throw new ProtocolError("connection closed inside a chunked body");
        }
        const size = parseChunkSize(sizeLine as str);
        if (size === 0) {
            while (true) {
                const trailer = await wire.line();
                if (trailer === null || (trailer as str).length === 0) {
                    break;
                }
            }
            break;
        }
        if (body.length + size > maxBytes) {
            throw new BodyTooLargeError(maxBytes);
        }
        const data = await wire.take(size);
        if (data === null) {
            throw new ProtocolError("connection closed inside a chunk");
        }
        const bytes = data as Bytes;
        body.append(bytes, 0, bytes.length);
        const terminator = await wire.line();
        if (terminator === null || (terminator as str).length !== 0) {
            throw new ProtocolError("a chunk is not followed by CRLF");
        }
    }
    return body.slice(0, body.length);
}
