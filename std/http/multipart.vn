import { ParseError } from "std:error";

export type FormPart = {
    name: str;
    filename: str?;
    contentType?: str;
    headers: { [key: str]: str };
    body: str;
    data: Bytes
};

const CRLF = Bytes.fromString("\r\n");
const HEAD_END = Bytes.fromString("\r\n\r\n");

function matchesAt(hay: Bytes, needle: Bytes, at: int): bool {
    if (at < 0 || at + needle.length > hay.length) {
        return false;
    }
    for (let i = 0; i < needle.length; i = i + 1) {
        if (hay.getByte(at + i) != needle.getByte(i)) {
            return false;
        }
    }
    return true;
}

function find(hay: Bytes, needle: Bytes, from: int): int {
    const last = hay.length - needle.length;
    for (let at = from; at <= last; at = at + 1) {
        if (matchesAt(hay, needle, at)) {
            return at;
        }
    }
    return -1;
}

function parameters(value: str): { [key: str]: str } {
    const out: { [key: str]: str } = {};
    let i = 0;
    const length = value.length;
    while (i < length) {
        while (i < length && (value.charCodeAt(i) == 32 || value.charCodeAt(i) == 9 || value.charCodeAt(i) == 59)) {
            i = i + 1;
        }
        let keyEnd = i;
        while (keyEnd < length && value.charCodeAt(keyEnd) != 61 && value.charCodeAt(keyEnd) != 59) {
            keyEnd = keyEnd + 1;
        }
        const key = value.slice(i, keyEnd).trim().toLowerCase();
        i = keyEnd;
        if (i >= length || value.charCodeAt(i) == 59) {
            continue;
        }
        i = i + 1;
        let text = "";
        if (i < length && value.charCodeAt(i) == 34) {
            i = i + 1;
            while (i < length && value.charCodeAt(i) != 34) {
                if (value.charCodeAt(i) == 92 && i + 1 < length) {
                    i = i + 1;
                }
                text = text + value.slice(i, i + 1);
                i = i + 1;
            }
            i = i + 1;
        } else {
            let end = i;
            while (end < length && value.charCodeAt(end) != 59) {
                end = end + 1;
            }
            text = value.slice(i, end).trim();
            i = end;
        }
        if (key.length > 0 && out[key] == null) {
            out[key] = text;
        }
    }
    return out;
}

function parsePartHeaders(block: str): { [key: str]: str } {
    const out: { [key: str]: str } = {};
    for (const line of block.split("\r\n")) {
        const colon = line.indexOf(":");
        if (colon != null && colon > 0) {
            const name = line.slice(0, colon).trim().toLowerCase();
            if (out[name] == null) {
                out[name] = line.slice(colon + 1).trim();
            }
        }
    }
    return out;
}

export namespace Multipart {
    export function parse(input: str | Bytes, boundary: str): FormPart[] {
        if (boundary.length == 0 || boundary.length > 70) {
            throw new ParseError("a multipart boundary has 1 to 70 characters");
        }
        const data: Bytes = input is str ? Bytes.fromString(input) : input as Bytes;
        const delimiter = Bytes.fromString("--" + boundary);
        const lineDelimiter = Bytes.fromString("\r\n--" + boundary);
        const parts: FormPart[] = [];
        let pos = find(data, delimiter, 0);
        if (pos < 0) {
            return parts;
        }
        while (true) {
            pos = pos + delimiter.length;
            if (matchesAt(data, Bytes.fromString("--"), pos)) {
                break;
            }
            while (pos < data.length && (data.getByte(pos) == 32 || data.getByte(pos) == 9)) {
                pos = pos + 1;
            }
            if (!matchesAt(data, CRLF, pos)) {
                throw new ParseError("a multipart delimiter is not followed by a line break");
            }
            pos = pos + 2;
            let headerText = "";
            let bodyStart = pos;
            if (matchesAt(data, CRLF, pos)) {
                bodyStart = pos + 2;
            } else {
                const headEnd = find(data, HEAD_END, pos);
                if (headEnd < 0) {
                    throw new ParseError("a multipart part has no end of headers");
                }
                headerText = data.slice(pos, headEnd).toString();
                bodyStart = headEnd + 4;
            }
            const next = find(data, lineDelimiter, bodyStart);
            if (next < 0) {
                throw new ParseError("a multipart body is not closed by its boundary");
            }
            const headers = parsePartHeaders(headerText);
            const disposition = headers["content-disposition"];
            const attributes = disposition == null ? {} : parameters(disposition);
            const content = data.slice(bodyStart, next);
            parts.push({
                name: attributes["name"] ?? "",
                filename: attributes["filename"],
                contentType: headers["content-type"],
                headers: headers,
                body: content.toString(),
                data: content
            });
            pos = next + 2;
        }
        return parts;
    }

    export function boundaryOf(contentType: str): str? {
        const semicolon = contentType.indexOf(";");
        if (semicolon == null) {
            return null;
        }
        const value = parameters(contentType.slice(semicolon + 1))["boundary"];
        if (value == null || value.length == 0) {
            return null;
        }
        return value;
    }
}
