import { ProtocolError } from "std:error";
import { WireReader, readChunkedBody } from "std:http/wire";
import { Headers } from "std:http/headers";
import { Json, JsonValue } from "std:encoding";
import { AsyncReader } from "std:io";

const MAX_BODY = 1073741824;

export class RawResponse {
    status: int = 200;
    statusText: str = "";
    headers: { [key: str]: str } = {};
    cookies: str[] = [];
    payload: Bytes = Bytes.alloc(0);
}

function addHeader(resp: RawResponse, line: str): void {
    const colon = line.indexOf(":");
    if (colon === null || colon <= 0) {
        throw new ProtocolError(`malformed header line '${line}'`);
    }
    const key = line.slice(0, colon).trim().toLowerCase();
    const value = line.slice(colon + 1).trim();
    if (key === "set-cookie") {
        resp.cookies.push(value);
        return;
    }
    const previous = resp.headers[key];
    resp.headers[key] = previous === null ? value : `${previous}, ${value}`;
}

export async function readHttpResponse(connId: int, headOnly: bool = false): Task<RawResponse?> {
    const wire = new WireReader(connId);
    const statusLine = await wire.line();
    if (statusLine === null) {
        return null;
    }
    const resp = new RawResponse();
    const status = statusLine as str;
    const afterVersion = status.indexOf(" ");
    if (afterVersion === null) {
        throw new ProtocolError(`malformed status line '${status}'`);
    }
    const remainder = status.slice(afterVersion + 1);
    const afterCode = remainder.indexOf(" ");
    resp.status = int.parse(afterCode === null ? remainder : remainder.slice(0, afterCode));
    resp.statusText = afterCode === null ? "" : remainder.slice(afterCode + 1);

    while (true) {
        const headerLine = await wire.line();
        if (headerLine === null) {
            throw new ProtocolError("connection closed inside the response headers");
        }
        if ((headerLine as str).length === 0) {
            break;
        }
        addHeader(resp, headerLine as str);
    }

    if (headOnly || resp.status < 200 || resp.status === 204 || resp.status === 304) {
        return resp;
    }
    const coding = resp.headers["transfer-encoding"];
    if (coding !== null && coding.toLowerCase().indexOf("chunked") !== null) {
        resp.payload = await readChunkedBody(wire, MAX_BODY);
        return resp;
    }
    const lengthText = resp.headers["content-length"];
    if (lengthText !== null) {
        const expected = int.parse(lengthText);
        if (expected < 0 || expected > MAX_BODY) {
            throw new ProtocolError(`unacceptable Content-Length ${expected}`);
        }
        const data = await wire.take(expected);
        if (data === null) {
            throw new ProtocolError(`connection closed before the ${expected} byte body arrived`);
        }
        resp.payload = data as Bytes;
        return resp;
    }
    resp.payload = await wire.rest();
    return resp;
}

function getHttpStatusText(status: int): str {
    if (status === 200) return "OK";
    if (status === 201) return "Created";
    if (status === 204) return "No Content";
    if (status === 301) return "Moved Permanently";
    if (status === 302) return "Found";
    if (status === 304) return "Not Modified";
    if (status === 400) return "Bad Request";
    if (status === 401) return "Unauthorized";
    if (status === 403) return "Forbidden";
    if (status === 404) return "Not Found";
    if (status === 405) return "Method Not Allowed";
    if (status === 409) return "Conflict";
    if (status === 429) return "Too Many Requests";
    if (status === 500) return "Internal Server Error";
    if (status === 502) return "Bad Gateway";
    if (status === 503) return "Service Unavailable";
    return "Status";
}

export class Response {
    status: int = 200;
    statusText: str = "OK";
    ok: bool = true;
    body: str = "";
    headers: Headers = new Headers({});
    cookies: str[] = [];
    bodyStream: AsyncReader? = null;
    payload: Bytes? = null;
    url: str = "";

    constructor(body: str = "", status: int = 200, headers: { [key: str]: str } = {}) {
        this.body = body;
        this.status = status;
        this.statusText = getHttpStatusText(status);
        this.ok = status >= 200 && status < 300;
        this.headers = new Headers(headers);
        this.cookies = [];
        this.bodyStream = null;
    }

    text(): str {
        return this.body;
    }

    bytes(): Bytes {
        return this.payload ?? Bytes.fromString(this.body);
    }

    json(): JsonValue {
        return Json.parse(this.body);
    }

    setCookie(name: str, value: str, options?: { maxAge?: int, path?: str, secure?: bool, httpOnly?: bool, sameSite?: str }): Response {
        let cookieStr = name + "=" + value;
        if (options !== null) {
            if (options.maxAge !== null) {
                cookieStr = `${cookieStr}; Max-Age=${options.maxAge}`;
            }
            if (options.path !== null) {
                cookieStr = `${cookieStr}; Path=${options.path}`;
            } else {
                cookieStr = cookieStr + "; Path=/";
            }
            if (options.httpOnly) {
                cookieStr = cookieStr + "; HttpOnly";
            }
            if (options.secure) {
                cookieStr = cookieStr + "; Secure";
            }
            if (options.sameSite !== null) {
                cookieStr = `${cookieStr}; SameSite=${options.sameSite}`;
            }
        }
        this.cookies.push(cookieStr);
        return this;
    }

    stream(reader: AsyncReader): Response {
        this.bodyStream = reader;
        return this;
    }
}

export function json(data: JsonValue, status: int = 200, headers: { [key: str]: str } = {}): Response {
    let body = Json.stringify(data);
    let h = new Headers(headers);
    if (!h.has("content-type")) {
        h.set("Content-Type", "application/json");
    }
    return new Response(body, status, h.toObject());
}

export function redirect(url: str, status: int = 302): Response {
    return new Response("", status, { "Location": url });
}

export function error(status: int = 500, message: str = "Internal Server Error"): Response {
    return new Response(message, status, { "Content-Type": "text/plain" });
}
