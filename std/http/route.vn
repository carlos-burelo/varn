import { HttpMethod } from "runtime:net";
import { Request } from "std:http/request";
import { Response } from "std:http/response";

export type Handler = (req: Request) => Task<Response>;
export type Next = () => Task<Response?>;
export type Middleware = (req: Request, next: Next) => Task<Response?>;

export class Route {
    method: HttpMethod?;
    segments: str[];
    paramNames: { [key: int]: str };
    isWildcard: bool;
    isStatic: bool;
    handler: Handler;

    constructor(method: HttpMethod?, pattern: str, handler: Handler) {
        this.method = method;
        this.handler = handler;
        this.isWildcard = pattern === "*";
        this.isStatic = !this.isWildcard && pattern.indexOf(":") < 0;
        this.segments = [];
        this.paramNames = {};

        if (!this.isWildcard) {
            let segs = pattern.split("/");
            for (let i = 0; i < segs.length; i = i + 1) {
                let s = segs[i];
                if (s.startsWith(":")) {
                    this.segments.push(":");
                    this.paramNames[i] = s.slice(1);
                } else {
                    this.segments.push(s);
                }
            }
        }
    }

    accepts(method: HttpMethod): bool {
        return this.method === null || this.method === method;
    }

    match(method: HttpMethod, pathSegments: str[]): { [key: str]: str }? {
        if (!this.accepts(method)) {
            return null;
        }

        if (this.isWildcard) {
            return {};
        }

        if (this.segments.length !== pathSegments.length) {
            return null;
        }

        let params: { [key: str]: str } = {};
        for (let i = 0; i < this.segments.length; i = i + 1) {
            let seg = this.segments[i];
            let reqSeg = pathSegments[i];
            if (seg === ":") {
                let paramName = this.paramNames[i];
                if (paramName !== null) {
                    params[paramName] = reqSeg;
                }
            } else if (seg !== reqSeg) {
                return null;
            }
        }

        return params;
    }
}
