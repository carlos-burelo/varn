export class Headers {
    private _map: Map<str, str> = new Map<str, str>();

    constructor(init: Map<str, str> = new Map<str, str>()) {
        for (const (name, value) of init) {
            this.set(name, value);
        }
    }

    get(name: str): str? {
        return this._map.get(name.toLowerCase());
    }

    set(name: str, value: str): void {
        this._map.set(name.toLowerCase(), value);
    }

    has(name: str): bool {
        return this._map.has(name.toLowerCase());
    }

    delete(name: str): void {
        this._map.delete(name.toLowerCase());
    }

    append(name: str, value: str): void {
        const key = name.toLowerCase();
        const existing = this._map.get(key);
        if (existing != null) {
            this._map.set(key, existing + ", " + value);
        } else {
            this._map.set(key, value);
        }
    }

    toMap(): Map<str, str> {
        return new Map<str, str>(this._map.entries());
    }
}
