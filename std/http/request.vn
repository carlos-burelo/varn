import { tcpRead$, parseHttpRequest$, HttpMethod } from "runtime:net";
import { Headers } from "std:http/headers";
import { Json, JsonValue } from "std:encoding";

export interface RequestInit {
    method?: HttpMethod;
    headers?: { [key: str]: str };
    body?: str;
    ca?: str;
}

export class RawRequest {
    method: HttpMethod? = null;
    path: str = "";
    headers: { [key: str]: str } = {};
    body: str = "";
}

export function parseRawRequest(raw: str): RawRequest? {
    let parsed = parseHttpRequest$(raw);
    if (parsed === null) return null;

    let req = new RawRequest();
    req.method = parsed.method;
    req.path = parsed.path;
    req.headers = parsed.headers;
    req.body = parsed.body;
    return req;
}

export async function readHttpRequest(connId: int, maxContentLength: int = 10485760): Task<RawRequest?> {
    let raw = "";
    let req: RawRequest? = null;
    let keepReading = true;
    while (keepReading) {
        let chunk = await tcpRead$(connId, 4096);
        if (chunk === null) {
            keepReading = false;
        } else {
            let b = chunk as Bytes;
            if (b.length > 0) {
                raw = raw + b.toString();
                if (raw.length > maxContentLength + 65536) {
                    throw new Error("413 Payload Too Large");
                }
                req = parseRawRequest(raw);
                if (req !== null) {
                    let contentLenStr = req.headers["content-length"];
                    if (contentLenStr !== null) {
                        let contentLen = int.parse(contentLenStr);
                        if (contentLen > maxContentLength) {
                            throw new Error("413 Payload Too Large");
                        }
                        if (req.body.length >= contentLen) {
                            req.body = req.body.slice(0, contentLen);
                            keepReading = false;
                        }
                    } else {
                        keepReading = false;
                    }
                }
            } else {
                keepReading = false;
            }
        }
    }
    return req;
}

export class Request {
    url: str = "";
    method: HttpMethod = HttpMethod.GET;
    headers: Headers = new Headers({});
    body: str = "";
    path: str = "";
    query: { [key: str]: str } = {};
    params: { [key: str]: str } = {};
    cookies: { [key: str]: str } = {};

    constructor(url: str = "", init: RequestInit = {}) {
        this.url = url;
        this.path = url;
        this.query = {};
        this.params = {};
        this.cookies = {};
        this.method = init.method ?? HttpMethod.GET;
        this.headers = new Headers(init.headers ?? {});
        this.body = init.body ?? "";

        let cookieHdr = this.headers.get("cookie");
        if (cookieHdr !== null) {
            if (cookieHdr.length > 0) {
                let pairs = cookieHdr.split(";");
                for (let p of pairs) {
                    let eq = p.indexOf("=");
                    if (eq !== null && eq > 0) {
                        let k = p.slice(0, eq).trim();
                        let v = p.slice(eq + 1).trim();
                        this.cookies[k] = v;
                    }
                }
            }
        }
    }

    text(): str {
        return this.body;
    }

    json(): JsonValue {
        if (this.body.length === 0) return null;
        return Json.parse(this.body);
    }

    formData(): { [key: str]: str } {
        let res: { [key: str]: str } = {};
        if (this.body.length === 0) return res;
        let pairs = this.body.split("&");
        for (let p of pairs) {
            let eq = p.indexOf("=");
            if (eq !== null && eq > 0) {
                let k = p.slice(0, eq);
                let v = p.slice(eq + 1);
                res[k] = v;
            }
        }
        return res;
    }
}
