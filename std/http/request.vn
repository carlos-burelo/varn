import { tcpWrite$, parseHttpRequest$, HttpMethod } from "runtime:net";
import { ProtocolError } from "std:error";
import { WireReader, readChunkedBody, LineTooLongError, BodyTooLargeError } from "std:http/wire";
import { Headers } from "std:http/headers";
import { Json, JsonValue } from "std:encoding";

export interface RequestInit {
    method?: HttpMethod;
    headers?: { [key: str]: str };
    body?: str;
    ca?: str;
    followRedirects?: bool;
    maxRedirects?: int;
}

const MAX_LINE = 8192;
const MAX_HEAD = 65536;

export class RawRequest {
    method: HttpMethod? = null;
    path: str = "";
    headers: { [key: str]: str } = {};
    body: str = "";
    payload: Bytes = Bytes.alloc(0);
}

export class HttpRejection extends ProtocolError {
    status: int;
    reason: str;

    constructor(status: int, reason: str) {
        super(`${status} ${reason}`);
        this.name = "HttpRejection";
        this.status = status;
        this.reason = reason;
    }
}

async function readHead(wire: WireReader): Task<str?> {
    let first: str? = null;
    while (first === null || (first as str).length === 0) {
        first = await wire.line(MAX_LINE);
        if (first === null) {
            return null;
        }
    }
    let head = (first as str) + "\r\n";
    while (true) {
        const line = await wire.line(MAX_LINE);
        if (line === null) {
            throw new HttpRejection(400, "Bad Request");
        }
        if (head.length + (line as str).length > MAX_HEAD) {
            throw new HttpRejection(431, "Request Header Fields Too Large");
        }
        if ((line as str).length === 0) {
            break;
        }
        head = head + (line as str) + "\r\n";
    }
    return head + "\r\n";
}

async function readBody(wire: WireReader, req: RawRequest, maxContentLength: int): Task<Bytes> {
    const expect = req.headers["expect"];
    const coding = req.headers["transfer-encoding"];
    const lengthText = req.headers["content-length"];
    const chunked = coding !== null && coding.toLowerCase().indexOf("chunked") !== null;
    if (!chunked && lengthText === null) {
        return Bytes.alloc(0);
    }
    if (expect !== null && expect.toLowerCase() === "100-continue") {
        await tcpWrite$(wire.connId, "HTTP/1.1 100 Continue\r\n\r\n");
    }
    if (chunked) {
        try {
            return await readChunkedBody(wire, maxContentLength);
        } catch (err: BodyTooLargeError) {
            throw new HttpRejection(413, "Payload Too Large");
        } catch (err: ProtocolError) {
            throw new HttpRejection(400, "Bad Request");
        }
    }
    let declared = -1;
    try {
        declared = int.parse(lengthText as str);
    } catch (err) {
        throw new HttpRejection(400, "Bad Request");
    }
    if (declared < 0) {
        throw new HttpRejection(400, "Bad Request");
    }
    if (declared > maxContentLength) {
        throw new HttpRejection(413, "Payload Too Large");
    }
    const data = await wire.take(declared);
    if (data === null) {
        throw new HttpRejection(400, "Bad Request");
    }
    return data as Bytes;
}

export async function readHttpRequest(wire: WireReader, maxContentLength: int = 10485760): Task<RawRequest?> {
    let head: str? = null;
    try {
        head = await readHead(wire);
    } catch (err: LineTooLongError) {
        throw new HttpRejection(431, "Request Header Fields Too Large");
    }
    if (head === null) {
        return null;
    }
    const parsed = parseHttpRequest$(head as str);
    if (parsed === null) {
        throw new HttpRejection(400, "Bad Request");
    }
    const req = new RawRequest();
    req.method = parsed.method;
    req.path = parsed.path;
    req.headers = parsed.headers;
    req.payload = await readBody(wire, req, maxContentLength);
    req.body = req.payload.toString();
    return req;
}

export class Request {
    url: str = "";
    method: HttpMethod = HttpMethod.GET;
    headers: Headers = new Headers({});
    body: str = "";
    payload: Bytes? = null;
    path: str = "";
    query: { [key: str]: str } = {};
    params: { [key: str]: str } = {};
    cookies: { [key: str]: str } = {};

    constructor(url: str = "", init: RequestInit = {}) {
        this.url = url;
        this.path = url;
        this.query = {};
        this.params = {};
        this.cookies = {};
        this.method = init.method ?? HttpMethod.GET;
        this.headers = new Headers(init.headers ?? {});
        this.body = init.body ?? "";

        let cookieHdr = this.headers.get("cookie");
        if (cookieHdr !== null) {
            if (cookieHdr.length > 0) {
                let pairs = cookieHdr.split(";");
                for (let p of pairs) {
                    let eq = p.indexOf("=");
                    if (eq !== null && eq > 0) {
                        let k = p.slice(0, eq).trim();
                        let v = p.slice(eq + 1).trim();
                        this.cookies[k] = v;
                    }
                }
            }
        }
    }

    text(): str {
        return this.body;
    }

    bytes(): Bytes {
        return this.payload ?? Bytes.fromString(this.body);
    }

    json(): JsonValue {
        if (this.body.length === 0) return null;
        return Json.parse(this.body);
    }

    formData(): { [key: str]: str } {
        let res: { [key: str]: str } = {};
        if (this.body.length === 0) return res;
        let pairs = this.body.split("&");
        for (let p of pairs) {
            let eq = p.indexOf("=");
            if (eq !== null && eq > 0) {
                let k = p.slice(0, eq);
                let v = p.slice(eq + 1);
                res[k] = v;
            }
        }
        return res;
    }
}
