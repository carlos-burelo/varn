import { tcpListen$, tcpAccept$, tcpWrite$, tcpClose$, tcpCloseListener$, sendHttpResponse$, httpMethodName$, HttpMethod } from "runtime:net";
import { spawn } from "std:task";

import { Request, Response, RawRequest, readHttpRequest, Route, Handler, Middleware } from "std:http/core";
import { AsyncReader } from "std:io";

const ALL_METHODS: HttpMethod[] = [
    HttpMethod.GET,
    HttpMethod.HEAD,
    HttpMethod.POST,
    HttpMethod.PUT,
    HttpMethod.DELETE,
    HttpMethod.PATCH,
    HttpMethod.OPTIONS,
    HttpMethod.CONNECT,
    HttpMethod.TRACE
];

type Matched = { handler: Handler, params: { [key: str]: str } };

export class HttpServer {
    private _port: int = 0;
    private _listenerId: int = -1;
    private _isListening: bool = false;
    private _staticRoutes: { [key: str]: Route[] } = {};
    private _dynamicRoutes: Route[] = [];
    private _middlewares: Middleware[] = [];
    private _fetchHandler: Handler? = null;
    private _maxContentLength: int = 10485760;

    constructor(fetchHandler?: Handler) {
        this._staticRoutes = {};
        this._dynamicRoutes = [];
        this._middlewares = [];
        this._maxContentLength = 10485760;
        this._fetchHandler = fetchHandler;
    }

    use(middleware: Middleware): HttpServer {
        this._middlewares.push(middleware);
        return this;
    }

    maxContentLength(limitBytes: int): HttpServer {
        this._maxContentLength = limitBytes;
        return this;
    }

    route(method: HttpMethod?, pattern: str, handler: Handler): HttpServer {
        let route = new Route(method, pattern, handler);
        if (route.isStatic) {
            let bucket = this._staticRoutes[pattern];
            if (bucket === null) {
                this._staticRoutes[pattern] = [route];
            } else {
                bucket.push(route);
            }
        } else {
            this._dynamicRoutes.push(route);
        }
        return this;
    }

    get(pattern: str, handler: Handler): HttpServer {
        return this.route(HttpMethod.GET, pattern, handler);
    }

    post(pattern: str, handler: Handler): HttpServer {
        return this.route(HttpMethod.POST, pattern, handler);
    }

    put(pattern: str, handler: Handler): HttpServer {
        return this.route(HttpMethod.PUT, pattern, handler);
    }

    delete(pattern: str, handler: Handler): HttpServer {
        return this.route(HttpMethod.DELETE, pattern, handler);
    }

    patch(pattern: str, handler: Handler): HttpServer {
        return this.route(HttpMethod.PATCH, pattern, handler);
    }

    options(pattern: str, handler: Handler): HttpServer {
        return this.route(HttpMethod.OPTIONS, pattern, handler);
    }

    all(pattern: str, handler: Handler): HttpServer {
        return this.route(null, pattern, handler);
    }

    cors(origin: str = "*", methods: HttpMethod[] = ALL_METHODS, headers: str = "*"): HttpServer {
        let allowed = methods.map((m: HttpMethod): str => httpMethodName$(m)).join(",");
        this.use(async (req: Request, next: () => Task<Response?>): Task<Response?> => {
            if (req.method === HttpMethod.OPTIONS) {
                let res = new Response("", 204);
                res.headers.set("Access-Control-Allow-Origin", origin);
                res.headers.set("Access-Control-Allow-Methods", allowed);
                res.headers.set("Access-Control-Allow-Headers", headers);
                return res;
            }
            let res = await next();
            if (res !== null) {
                res.headers.set("Access-Control-Allow-Origin", origin);
                res.headers.set("Access-Control-Allow-Methods", allowed);
                res.headers.set("Access-Control-Allow-Headers", headers);
            }
            return res;
        });
        return this;
    }

    get port(): int {
        return this._port;
    }

    get isListening(): bool {
        return this._isListening;
    }

    listen(port: int): void {
        if (this._isListening) return;
        this._port = port;
        this._listenerId = tcpListen$(port);
        this._isListening = true;

        spawn(this._acceptLoop());
    }

    close(): void {
        if (!this._isListening) return;
        this._isListening = false;
        if (this._listenerId !== -1) {
            tcpCloseListener$(this._listenerId);
            this._listenerId = -1;
        }
    }

    private async _acceptLoop(): Task<void> {
        while (this._isListening) {
            await this._acceptNext();
        }
    }

    private async _acceptNext(): Task<void> {
        let connId = await tcpAccept$(this._listenerId);
        if (connId !== -1) {
            spawn(this._handleConnection(connId));
        } else {
            this._isListening = false;
        }
    }

    private async _sendWebResponse(connId: int, responseObj: Response): Task<void> {
        let stream = responseObj.bodyStream;
        if (stream !== null) {
            await this._sendChunked(connId, responseObj, stream);
            return;
        }
        let hdrs = responseObj.headers.toObject();
        await sendHttpResponse$(connId, responseObj.status, responseObj.statusText, hdrs, responseObj.body, responseObj.cookies);
    }

    private async _sendChunked(connId: int, responseObj: Response, reader: AsyncReader): Task<void> {
        let head = "HTTP/1.1 " + responseObj.status.toString() + " " + responseObj.statusText + "\r\n";
        let hdrs = responseObj.headers.toObject();
        for (let name in hdrs) {
            head = `${head}${name}: ${hdrs[name]}\r\n`;
        }
        for (let c of responseObj.cookies) {
            head = head + "Set-Cookie: " + c + "\r\n";
        }
        head = head + "Transfer-Encoding: chunked\r\n\r\n";
        await tcpWrite$(connId, head);
        let reading = true;
        while (reading) {
            let chunk = await reader.read(8192);
            if (chunk === null) {
                reading = false;
            } else if (chunk.length === 0) {
                reading = false;
            } else {
                let hexLen = chunk.length.toHex();
                await tcpWrite$(connId, hexLen + "\r\n");
                await tcpWrite$(connId, chunk);
                await tcpWrite$(connId, "\r\n");
            }
        }
        await tcpWrite$(connId, "0\r\n\r\n");
    }

    private _match(method: HttpMethod, pathOnly: str): Matched? {
        let bucket = this._staticRoutes[pathOnly];
        if (bucket !== null) {
            for (let route of bucket) {
                if (route.accepts(method)) {
                    return { handler: route.handler, params: {} };
                }
            }
        }
        if (this._dynamicRoutes.length > 0) {
            let pathSegments = pathOnly.split("/");
            for (let route of this._dynamicRoutes) {
                let params = route.match(method, pathSegments);
                if (params !== null) {
                    return { handler: route.handler, params: params };
                }
            }
        }
        let fallback = this._fetchHandler;
        if (fallback !== null) {
            return { handler: fallback, params: {} };
        }
        return null;
    }

    private async _respond(connId: int, rawReq: RawRequest, method: HttpMethod): Task<void> {
        let pathOnly = rawReq.path;
        let queryStr = "";
        let qIdx = rawReq.path.indexOf("?");
        if (qIdx !== null) {
            pathOnly = rawReq.path.slice(0, qIdx);
            queryStr = rawReq.path.slice(qIdx + 1);
        }

        let matched = this._match(method, pathOnly);

        let reqObj = new Request(rawReq.path, { method: method, headers: rawReq.headers, body: rawReq.body });
        reqObj.path = pathOnly;

        let queryObj: { [key: str]: str } = {};
        if (queryStr.length > 0) {
            let pairs = queryStr.split("&");
            for (let i = 0; i < pairs.length; i = i + 1) {
                let pair = pairs[i];
                let eqIdx = pair.indexOf("=");
                if (eqIdx !== null && eqIdx > 0) {
                    queryObj[pair.slice(0, eqIdx)] = pair.slice(eqIdx + 1);
                } else {
                    queryObj[pair] = "true";
                }
            }
        }
        reqObj.query = queryObj;
        if (matched !== null) {
            reqObj.params = matched.params;
        }

        let self = this;
        let runPipeline = async (idx: int): Task<Response?> => {
            if (idx < self._middlewares.length) {
                let mw = self._middlewares[idx];
                let next = async (): Task<Response?> => {
                    return await runPipeline(idx + 1);
                };
                return await mw(reqObj, next);
            }
            if (matched !== null) {
                return await matched.handler(reqObj);
            }
            return null;
        };

        let finalResp = await runPipeline(0);
        if (finalResp !== null) {
            await self._sendWebResponse(connId, finalResp);
        } else {
            let notFoundHeaders: { [key: str]: str } = { "Content-Type": "text/plain" };
            await sendHttpResponse$(connId, 404, "Not Found", notFoundHeaders, "Not Found", []);
        }
    }

    private async _handleConnection(connId: int): Task<void> {
        let keepAlive = true;
        while (keepAlive) {
            let rawReq: RawRequest? = null;
            try {
                rawReq = await readHttpRequest(connId, this._maxContentLength);
            } catch (err) {
                let errHeaders: { [key: str]: str } = { "Content-Type": "text/plain", "Connection": "close" };
                await sendHttpResponse$(connId, 413, "Payload Too Large", errHeaders, "Payload Too Large", []);
                break;
            }
            if (rawReq === null) {
                break;
            }
            let connHdr = rawReq.headers["connection"];
            if (connHdr !== null && connHdr.toLowerCase() === "close") {
                keepAlive = false;
            }
            let method = rawReq.method;
            if (method === null) {
                let errHeaders: { [key: str]: str } = { "Content-Type": "text/plain", "Connection": "close" };
                await sendHttpResponse$(connId, 501, "Not Implemented", errHeaders, "Not Implemented", []);
                break;
            }
            await this._respond(connId, rawReq, method);
        }
        tcpClose$(connId);
    }
}

export function serve(handler?: Handler, port: int = 3000): HttpServer {
    let server = new HttpServer();
    if (handler !== null) {
        server.all("*", handler);
        server.listen(port);
    }
    return server;
}
