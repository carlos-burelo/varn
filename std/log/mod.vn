import { LogLevel } from "std:log/level";
import { Logger } from "std:log/logger";

export { LogLevel } from "std:log/level";
export { Logger } from "std:log/logger";

export const logger: Logger = new Logger("root", LogLevel.Info);

export function getLogger(name: str = "app", level: LogLevel = LogLevel.Info): Logger {
    return new Logger(name, level);
}

export function trace<T = null>(message: str, meta?: T): void {
    logger.trace(message, meta);
}

export function debug<T = null>(message: str, meta?: T): void {
    logger.debug(message, meta);
}

export function info<T = null>(message: str, meta?: T): void {
    logger.info(message, meta);
}

export function warn<T = null>(message: str, meta?: T): void {
    logger.warn(message, meta);
}

export function error<T = null>(message: str, meta?: T): void {
    logger.error(message, meta);
}
