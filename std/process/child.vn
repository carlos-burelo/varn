import {
    exec$,
    execAsync$,
    execResult$,
    waitProcessAsync$,
    currentExe$,
    spawnProcess$,
    waitProcess$,
    killProcess$,
    ProcessOutput,
    ProcessStatus
} from "runtime:process";

import { Task } from "std:task";

export type ProcessResult = ProcessOutput;

export class ChildProcess {
    pid: int;

    constructor(pid: int) {
        this.pid = pid;
    }

    wait(): ProcessStatus {
        return waitProcess$(this.pid);
    }

    async waitAsync(): Task<ProcessStatus> {
        let exitCode = await waitProcessAsync$(this.pid);
        return { exitCode: exitCode, success: exitCode == 0 };
    }

    kill(): bool {
        return killProcess$(this.pid);
    }
}

export namespace Process {
    export function currentExe(): str {
        return currentExe$();
    }

    export function exec(command: str): ProcessResult {
        return exec$(command);
    }

    export async function execAsync(command: str): Task<ProcessResult> {
        let id = await execAsync$(command);
        return execResult$(id);
    }

    export function spawn(command: str, args: str[] = []): ChildProcess {
        let pid = spawnProcess$(command, args);
        return new ChildProcess(pid);
    }
}
