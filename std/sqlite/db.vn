import {
    open$,
    close$,
    script$,
    execute$,
    executeAsync$,
    query$,
    queryAsync$,
    SqlParam,
    SqlRow
} from "runtime:sqlite";
import { ClosedError } from "std:error";

export { SqlParam, SqlRow, SqlValue } from "runtime:sqlite";

const ALL_ROWS = -1;

function placeholders(strings: str[], values: SqlParam[]): str {
    let query = "";
    for (let i = 0; i < strings.length; i = i + 1) {
        query = query + strings[i];
        if (i < values.length) {
            query = query + "?";
        }
    }
    return query;
}

export class Database {
    private _id: int = -1;
    private _isOpen: bool = false;

    constructor(path: str = ":memory:") {
        this._id = open$(path);
        this._isOpen = true;
    }

    get isOpen(): bool {
        return this._isOpen;
    }

    private live(): int {
        if (!this._isOpen) {
            throw new ClosedError("sqlite: the database is closed");
        }
        return this._id;
    }

    exec(sql: str, ...params: SqlParam[]): int {
        return execute$(this.live(), sql, params);
    }

    async execAsync(sql: str, ...params: SqlParam[]): Task<int> {
        return await executeAsync$(this.live(), sql, params);
    }

    script(sql: str): void {
        script$(this.live(), sql);
    }

    all(sql: str, ...params: SqlParam[]): SqlRow[] {
        return query$(this.live(), sql, params, ALL_ROWS);
    }

    async allAsync(sql: str, ...params: SqlParam[]): Task<SqlRow[]> {
        return await queryAsync$(this.live(), sql, params, ALL_ROWS);
    }

    get(sql: str, ...params: SqlParam[]): SqlRow? {
        const rows = query$(this.live(), sql, params, 1);
        return rows.length === 0 ? null : rows[0];
    }

    async getAsync(sql: str, ...params: SqlParam[]): Task<SqlRow?> {
        const rows = await queryAsync$(this.live(), sql, params, 1);
        return rows.length === 0 ? null : rows[0];
    }

    sql(strings: str[], ...values: SqlParam[]): SqlRow[] {
        return query$(this.live(), placeholders(strings, values), values, ALL_ROWS);
    }

    sqlOne(strings: str[], ...values: SqlParam[]): SqlRow? {
        const rows = query$(this.live(), placeholders(strings, values), values, 1);
        return rows.length === 0 ? null : rows[0];
    }

    transaction<T>(body: () => T): T {
        const id = this.live();
        script$(id, "BEGIN");
        try {
            const result = body();
            script$(id, "COMMIT");
            return result;
        } catch (err) {
            script$(id, "ROLLBACK");
            throw err;
        }
    }

    async transactionAsync<T>(body: () => Task<T>): Task<T> {
        const id = this.live();
        script$(id, "BEGIN");
        try {
            const result = await body();
            script$(id, "COMMIT");
            return result;
        } catch (err) {
            script$(id, "ROLLBACK");
            throw err;
        }
    }

    close(): void {
        if (this._isOpen) {
            close$(this._id);
            this._isOpen = false;
            this._id = -1;
        }
    }
}
