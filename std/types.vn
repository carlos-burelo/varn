// std:types — Utility types implemented via mapped types and keyof

/**
 * Makes all properties of T optional.
 */
export type Partial<T> = { [K in keyof T]?: T[K] }

/**
 * Makes all properties of T required (removes optionality).
 */
export type Required<T> = { [K in keyof T]: T[K] }

/**
 * Makes all properties of T readonly.
 */
export type Readonly<T> = { readonly [K in keyof T]: T[K] }

/**
 * Removes readonly from all properties of T.
 */
export type Mutable<T> = { [K in keyof T]: T[K] }

/**
 * Constructs an object type with keys K and values of type T.
 */
export type Record<K extends str, T> = { [P in K]: T }

/**
 * Constructs a type by picking a set of properties K from T.
 */
export type Pick<T, K extends keyof T> = { [P in K]: T[P] }

/**
 * Excludes from T all types that are assignable to U (distributive).
 */
export type Exclude<T, U> = T extends U ? never : T

/**
 * Extracts from T all types that are assignable to U (distributive).
 */
export type Extract<T, U> = T extends U ? T : never

/**
 * Removes null from T.
 */
export type NonNullable<T> = T extends null ? never : T

/**
 * Obtains the return type of a function type T.
 */
export type ReturnType<T> = T extends (...args: dynamic[]) => infer R ? R : never

/**
 * Awaited unwraps Task<T> to T.
 */
export type Awaited<T> = T extends Task<infer U> ? U : T

/**
 * Constructs a type by removing keys K from T. Uses Exclude<keyof T, K>.
 */
export type Omit<T, K extends keyof T> = { [P in Exclude<keyof T, K>]: T[P] }

// `Option<T>` and `Result<T, E>` are NOT here. They live in `std:result`, as
// the enums `Option<T> { Some(val), None }` and `Result<T, E> { Ok(val),
// Err(err) }`.
//
// This module used to declare a SECOND, incompatible pair — `type Option<T> =
// T?` and `type Result<T, E> = | Ok(value: T) | Err(error: E)` — with helpers
// (`some`, `none`, `option`, `isSome`, `isNone`, `unwrap`, `unwrapOr`, `ok`,
// `err`, `tryRun`) that shadowed `std:result`'s under different names.
//
// Two declarations of one name across two stdlib modules is not an API, it is
// a collision, and which one a program got depended on which resolution path
// filled the checker's export cache first — which differs by stdlib
// PROVENANCE. `const o: Option<str> = Some("varn")` checked clean against the
// `std/` tree and failed against the embedded bundle with "declared as
// 'Option<str>' but initialised with 'str?'": same source, same compiler,
// different answer. It stayed invisible because the diagnostics of imported
// modules were being discarded.
//
// The nullable form this offered is already in the language: write `T?`. The
// ADT, with `Some(x)` as a constructor and variants you can `match` on, is the
// one worth having, and there is now exactly one of it.
//
// `tryRun` went with the block; `std:result` has no equivalent yet. Adding one
// there is the right home for it.
