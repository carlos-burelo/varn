import { spawn$, sleep$, parallel$, channel$,
         Sender, Receiver, Channel, ChannelClosed,
         IsolateHandle, spawnIsolate$ } from "runtime:task";

import { Generator, AsyncGenerator, Iterator, AsyncIterator, TaskHandle } from "core:intrinsics";

export function channel<T = dynamic>(capacity: int): Channel<T> {
    return channel$<T>(capacity);
}

export { Sender, Receiver, Channel, ChannelClosed, IsolateHandle, Generator, AsyncGenerator, Iterator, AsyncIterator, TaskHandle };

export function parallel<T>(tasks: Array<Task<T>>): Task<Array<T>> {
    return parallel$(tasks);
}

export function spawn<T>(target: Task<T> | ((...args: dynamic[]) => T), ...args: dynamic[]): TaskHandle<T> {
    return spawn$(target, ...args);
}

export function sleep(ms: int): TaskHandle<void> {
    return sleep$(ms);
}

export function spawnIsolate(
    fn: dynamic,
    args: Array<dynamic>
): Task<IsolateHandle> {
    return spawnIsolate$(fn, args);
}

async function wrapTask<T>(task: Task<T>, group: TaskGroupImpl<T>): T {
    try {
        let res = await task;
        if (group.isCancelled) {
            throw new Error("TaskGroup cancelled");
        }
        return res;
    } catch (e) {
        if (group.isCancelled) {
            throw new Error("TaskGroup cancelled");
        }
        throw e;
    }
}

class TaskGroupImpl<T = dynamic> {
    tasks: Array<Task<T> >;
    isCancelled: bool;

    constructor() {
        this.tasks = [];
        this.isCancelled = false;
    }

    spawn(task: Task<T>): Task<T> {
        if (this.isCancelled) {
            throw new Error("TaskGroup is cancelled");
        }
        let wrapped = wrapTask(task, this);
        this.tasks.push(wrapped);
        return wrapped;
    }

    async join(): Array<T> {
        if (this.isCancelled) {
            throw new Error("TaskGroup is cancelled");
        }
        return await parallel$(this.tasks);
    }

    dispose(): void {
        this.isCancelled = true;
    }

    cancel(): void {
        this.isCancelled = true;
    }

    async disposeAsync(): void {
        this.cancel();
    }
}

export type TaskGroup<T = dynamic> = TaskGroupImpl<T>;

export function TaskGroup<T = dynamic>(): TaskGroupImpl<T> {
    return new TaskGroupImpl<T>();
}

export function task_group<T>(): TaskGroupImpl<T> {
    return new TaskGroupImpl<T>();
}
