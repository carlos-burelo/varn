
export {
    MarkdownOptions,
    MarkdownHeading,
    MarkdownLink,
    MarkdownNode
} from "std:markdown/ast";

export {
    escapeHtmlStr,
    isWhitespaceChar,
    findFrom,
    startsWithAt,
    slugify
} from "std:markdown/utils";

export {
    isThematicBreak,
    isHeadingLine,
    isListItemLine,
    isTableSeparator,
    parseTableAlignments,
    splitTableRow,
    parseInlineTokens,
    isParagraphEnd
} from "std:markdown/parser";

export {
    renderAst,
    toPlainText,
    extractHeadings,
    extractLinks
} from "std:markdown/renderer";

import { MarkdownOptions, MarkdownNode, MarkdownHeading, MarkdownLink } from "std:markdown/ast";
import { escapeHtmlStr, isWhitespaceChar, slugify as slugifyUtil } from "std:markdown/utils";
import { isThematicBreak, isHeadingLine, isListItemLine, isTableSeparator, parseTableAlignments, splitTableRow, parseInlineTokens, isParagraphEnd } from "std:markdown/parser";
import { renderAst as renderAstImpl, toPlainText as toPlainTextImpl, extractHeadings as extractHeadingsImpl, extractLinks as extractLinksImpl } from "std:markdown/renderer";

export namespace Markdown {
    export function slugify(text: str): str {
        return slugifyUtil(text);
    }

    export function parse(source: str, options?: MarkdownOptions): MarkdownNode {
        let optGfm = options?.gfm ?? true;
        let optEscape = options?.escapeHtml ?? true;

        let root = new MarkdownNode("root");
        let rawLines = source.split("\n");
        let lines: str[] = [];
        for (let l of rawLines) {
            if (l.endsWith("\r")) {
                lines.push(l.slice(0, l.length - 1));
            } else {
                lines.push(l);
            }
        }

        let idx = 0;
        let total = lines.length;

        while (idx < total) {
            let line = lines[idx];
            let trimmed = line.trim();

            if (trimmed.length === 0) {
                idx = idx + 1;
                continue;
            }

            if (trimmed.startsWith("```") || trimmed.startsWith("~~~")) {
                let fenceChar = trimmed.slice(0, 3);
                let lang = trimmed.slice(3).trim();
                idx = idx + 1;
                let codeLines: str[] = [];
                while (idx < total) {
                    let curLine = lines[idx];
                    if (curLine.trim().startsWith(fenceChar)) {
                        idx = idx + 1;
                        break;
                    }
                    codeLines.push(curLine);
                    idx = idx + 1;
                }
                let codeNode = new MarkdownNode("code_block", codeLines.join("\n"));
                codeNode.lang = lang;
                root.addChild(codeNode);
                continue;
            }

            if (line.startsWith("    ") || line.startsWith("\t")) {
                let codeLines: str[] = [];
                while (idx < total) {
                    let curLine = lines[idx];
                    if (curLine.trim().length === 0) {
                        codeLines.push("");
                        idx = idx + 1;
                        continue;
                    }
                    if (curLine.startsWith("    ")) {
                        codeLines.push(curLine.slice(4));
                        idx = idx + 1;
                    } else if (curLine.startsWith("\t")) {
                        codeLines.push(curLine.slice(1));
                        idx = idx + 1;
                    } else {
                        break;
                    }
                }
                let codeNode = new MarkdownNode("code_block", codeLines.join("\n"));
                root.addChild(codeNode);
                continue;
            }

            let headingLevel = isHeadingLine(line);
            if (headingLevel > 0) {
                let trimmedStart = line.trimStart();
                let headingText = trimmedStart.slice(headingLevel).trim();
                if (headingText.endsWith("#")) {
                    let endIdx = headingText.length - 1;
                    while (endIdx >= 0 && headingText[endIdx] === "#") {
                        endIdx = endIdx - 1;
                    }
                    headingText = headingText.slice(0, endIdx + 1).trim();
                }
                let headingNode = new MarkdownNode("heading", headingText);
                headingNode.level = headingLevel;
                let inlines = parseInlineTokens(headingText, optEscape);
                for (let c of inlines) {
                    headingNode.addChild(c);
                }
                root.addChild(headingNode);
                idx = idx + 1;
                continue;
            }

            if (isThematicBreak(line)) {
                root.addChild(new MarkdownNode("thematic_break"));
                idx = idx + 1;
                continue;
            }

            if (trimmed.startsWith(">")) {
                let quoteLines: str[] = [];
                while (idx < total) {
                    let cur = lines[idx];
                    let curTrim = cur.trim();
                    if (curTrim.length === 0) {
                        break;
                    }
                    if (curTrim.startsWith(">")) {
                        let content = curTrim.slice(1).trimStart();
                        quoteLines.push(content);
                    } else {
                        quoteLines.push(cur);
                    }
                    idx = idx + 1;
                }
                let quoteContent = quoteLines.join("\n");
                let blockNode = new MarkdownNode("blockquote");
                let innerAst = parse(quoteContent, options);
                for (let c of innerAst.children) {
                    blockNode.addChild(c);
                }
                root.addChild(blockNode);
                continue;
            }

            if (optGfm && idx + 1 < total && isTableSeparator(lines[idx + 1])) {
                let headerRow = splitTableRow(lines[idx]);
                let alignments = parseTableAlignments(lines[idx + 1]);
                let tableNode = new MarkdownNode("table");
                tableNode.align = alignments;

                let headRowNode = new MarkdownNode("table_row");
                for (let cell of headerRow) {
                    let cellNode = new MarkdownNode("table_cell", cell);
                    let inlines = parseInlineTokens(cell, optEscape);
                    for (let c of inlines) {
                        cellNode.addChild(c);
                    }
                    headRowNode.addChild(cellNode);
                }
                tableNode.addChild(headRowNode);
                idx = idx + 2;

                while (idx < total) {
                    let cur = lines[idx];
                    if (cur.trim().length === 0 || !cur.includes("|")) {
                        break;
                    }
                    let rowCells = splitTableRow(cur);
                    let rowNode = new MarkdownNode("table_row");
                    for (let cell of rowCells) {
                        let cellNode = new MarkdownNode("table_cell", cell);
                        let inlines = parseInlineTokens(cell, optEscape);
                        for (let c of inlines) {
                            cellNode.addChild(c);
                        }
                        rowNode.addChild(cellNode);
                    }
                    tableNode.addChild(rowNode);
                    idx = idx + 1;
                }

                root.addChild(tableNode);
                continue;
            }

            if (isListItemLine(line)) {
                let isOrdered = false;
                let listStart = 1;
                let firstTrimmed = line.trimStart();
                if (!firstTrimmed.startsWith("- ") && !firstTrimmed.startsWith("* ") && !firstTrimmed.startsWith("+ ")) {
                    isOrdered = true;
                    let dotIdx = firstTrimmed.indexOf(".");
                    if (dotIdx === -1) dotIdx = firstTrimmed.indexOf(")");
                    if (dotIdx > 0) {
                        listStart = firstTrimmed.slice(0, dotIdx).toInt();
                    }
                }

                let listNode = new MarkdownNode("list");
                listNode.ordered = isOrdered;
                listNode.start = listStart;

                while (idx < total) {
                    let cur = lines[idx];
                    if (cur.trim().length === 0) {
                        idx = idx + 1;
                        let shouldCont = false;
                        if (idx < total) {
                            if (isListItemLine(lines[idx])) {
                                shouldCont = true;
                            }
                        }
                        if (shouldCont) {
                            continue;
                        }
                        break;
                    }
                    if (!isListItemLine(cur)) {
                        break;
                    }

                    let curTrimmed = cur.trimStart();
                    let content = "";
                    if (curTrimmed.startsWith("- ") || curTrimmed.startsWith("* ") || curTrimmed.startsWith("+ ")) {
                        content = curTrimmed.slice(2);
                    } else {
                        let spaceIdx = curTrimmed.indexOf(" ");
                        if (spaceIdx > 0) {
                            content = curTrimmed.slice(spaceIdx + 1);
                        } else {
                            content = curTrimmed;
                        }
                    }

                    let itemNode = new MarkdownNode("list_item");
                    if (optGfm && (content.startsWith("[ ] ") || content.startsWith("[x] ") || content.startsWith("[X] "))) {
                        let isChecked = content.startsWith("[x] ") || content.startsWith("[X] ");
                        itemNode.checked = isChecked;
                        content = content.slice(4);
                    }

                    itemNode.text = content;
                    let inlines = parseInlineTokens(content, optEscape);
                    for (let c of inlines) {
                        itemNode.addChild(c);
                    }
                    listNode.addChild(itemNode);
                    idx = idx + 1;
                }

                root.addChild(listNode);
                continue;
            }

            let pLines: str[] = [];
            while (idx < total) {
                let cur = lines[idx];
                let curTrim = cur.trim();
                if (curTrim.length === 0) {
                    break;
                }
                if (isParagraphEnd(cur, curTrim)) {
                    break;
                }
                pLines.push(cur);
                idx = idx + 1;
            }

            let pText = pLines.join("\n");
            let pNode = new MarkdownNode("paragraph", pText);
            let inlines = parseInlineTokens(pText, optEscape);
            for (let c of inlines) {
                pNode.addChild(c);
            }
            root.addChild(pNode);
        }

        return root;
    }

    export function renderAst(node: MarkdownNode, options?: MarkdownOptions): str {
        return renderAstImpl(node, options);
    }

    export function render(source: str, options?: MarkdownOptions): str {
        let ast = parse(source, options);
        return renderAstImpl(ast, options);
    }

    export function toPlainText(source: str): str {
        let ast = parse(source, { escapeHtml: false });
        return toPlainTextImpl(ast);
    }

    export function extractHeadings(source: str): MarkdownHeading[] {
        let ast = parse(source);
        return extractHeadingsImpl(ast);
    }

    export function extractLinks(source: str): MarkdownLink[] {
        let ast = parse(source);
        return extractLinksImpl(ast);
    }
}
