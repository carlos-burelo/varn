// std:markdown — High-performance CommonMark & GFM Markdown Parser and HTML Renderer for Varn

export {
    MarkdownOptions,
    MarkdownHeading,
    MarkdownLink,
    MarkdownNode
} from "std:markdown/ast";

export {
    escapeHtmlStr,
    isWhitespaceChar,
    findFrom,
    startsWithAt,
    slugify
} from "std:markdown/utils";

export {
    isThematicBreak,
    isHeadingLine,
    isListItemLine,
    isTableSeparator,
    parseTableAlignments,
    splitTableRow,
    parseInlineTokens,
    isParagraphEnd
} from "std:markdown/parser";

import { MarkdownOptions, MarkdownNode, MarkdownHeading, MarkdownLink } from "std:markdown/ast";
import { escapeHtmlStr, isWhitespaceChar, slugify as slugifyUtil } from "std:markdown/utils";
import { isThematicBreak, isHeadingLine, isListItemLine, isTableSeparator, parseTableAlignments, splitTableRow, parseInlineTokens, isParagraphEnd } from "std:markdown/parser";

export namespace Markdown {
    export function slugify(text: str): str {
        return slugifyUtil(text);
    }

    export function parse(source: str, options?: MarkdownOptions): MarkdownNode {
        let optGfm = options?.gfm ?? true;
        let optEscape = options?.escapeHtml ?? true;

        let root = new MarkdownNode("root");
        let rawLines = source.split("\n");
        let lines: str[] = [];
        for (let l of rawLines) {
            if (l.endsWith("\r")) {
                lines.push(l.slice(0, l.length - 1));
            } else {
                lines.push(l);
            }
        }

        let idx = 0;
        let total = lines.length;

        while (idx < total) {
            let line = lines[idx];
            let trimmed = line.trim();

            // 1. Blank line
            if (trimmed.length === 0) {
                idx = idx + 1;
                continue;
            }

            // 2. Fenced Code Block: ``` or ~~~
            if (trimmed.startsWith("```") || trimmed.startsWith("~~~")) {
                let fenceChar = trimmed.slice(0, 3);
                let lang = trimmed.slice(3).trim();
                idx = idx + 1;
                let codeLines: str[] = [];
                while (idx < total) {
                    let curLine = lines[idx];
                    if (curLine.trim().startsWith(fenceChar)) {
                        idx = idx + 1;
                        break;
                    }
                    codeLines.push(curLine);
                    idx = idx + 1;
                }
                let codeNode = new MarkdownNode("code_block", codeLines.join("\n"));
                codeNode.lang = lang;
                root.addChild(codeNode);
                continue;
            }

            // 3. Indented Code Block (4 spaces or 1 tab)
            if (line.startsWith("    ") || line.startsWith("\t")) {
                let codeLines: str[] = [];
                while (idx < total) {
                    let curLine = lines[idx];
                    if (curLine.trim().length === 0) {
                        codeLines.push("");
                        idx = idx + 1;
                        continue;
                    }
                    if (curLine.startsWith("    ")) {
                        codeLines.push(curLine.slice(4));
                        idx = idx + 1;
                    } else if (curLine.startsWith("\t")) {
                        codeLines.push(curLine.slice(1));
                        idx = idx + 1;
                    } else {
                        break;
                    }
                }
                let codeNode = new MarkdownNode("code_block", codeLines.join("\n"));
                root.addChild(codeNode);
                continue;
            }

            // 4. ATX Headings (# Heading)
            let headingLevel = isHeadingLine(line);
            if (headingLevel > 0) {
                let trimmedStart = line.trimStart();
                let headingText = trimmedStart.slice(headingLevel).trim();
                if (headingText.endsWith("#")) {
                    let endIdx = headingText.length - 1;
                    while (endIdx >= 0 && headingText[endIdx] === "#") {
                        endIdx = endIdx - 1;
                    }
                    headingText = headingText.slice(0, endIdx + 1).trim();
                }
                let headingNode = new MarkdownNode("heading", headingText);
                headingNode.level = headingLevel;
                let inlines = parseInlineTokens(headingText, optEscape);
                for (let c of inlines) {
                    headingNode.addChild(c);
                }
                root.addChild(headingNode);
                idx = idx + 1;
                continue;
            }

            // 5. Thematic Break (Horizontal Rule)
            if (isThematicBreak(line)) {
                root.addChild(new MarkdownNode("thematic_break"));
                idx = idx + 1;
                continue;
            }

            // 6. Blockquote (> quote)
            if (trimmed.startsWith(">")) {
                let quoteLines: str[] = [];
                while (idx < total) {
                    let cur = lines[idx];
                    let curTrim = cur.trim();
                    if (curTrim.length === 0) {
                        break;
                    }
                    if (curTrim.startsWith(">")) {
                        let content = curTrim.slice(1).trimStart();
                        quoteLines.push(content);
                    } else {
                        quoteLines.push(cur);
                    }
                    idx = idx + 1;
                }
                let quoteContent = quoteLines.join("\n");
                let blockNode = new MarkdownNode("blockquote");
                let innerAst = parse(quoteContent, options);
                for (let c of innerAst.children) {
                    blockNode.addChild(c);
                }
                root.addChild(blockNode);
                continue;
            }

            // 7. GFM Table
            if (optGfm && idx + 1 < total && isTableSeparator(lines[idx + 1])) {
                let headerRow = splitTableRow(lines[idx]);
                let alignments = parseTableAlignments(lines[idx + 1]);
                let tableNode = new MarkdownNode("table");
                tableNode.align = alignments;

                let headRowNode = new MarkdownNode("table_row");
                for (let cell of headerRow) {
                    let cellNode = new MarkdownNode("table_cell", cell);
                    let inlines = parseInlineTokens(cell, optEscape);
                    for (let c of inlines) {
                        cellNode.addChild(c);
                    }
                    headRowNode.addChild(cellNode);
                }
                tableNode.addChild(headRowNode);
                idx = idx + 2;

                while (idx < total) {
                    let cur = lines[idx];
                    if (cur.trim().length === 0 || !cur.includes("|")) {
                        break;
                    }
                    let rowCells = splitTableRow(cur);
                    let rowNode = new MarkdownNode("table_row");
                    for (let cell of rowCells) {
                        let cellNode = new MarkdownNode("table_cell", cell);
                        let inlines = parseInlineTokens(cell, optEscape);
                        for (let c of inlines) {
                            cellNode.addChild(c);
                        }
                        rowNode.addChild(cellNode);
                    }
                    tableNode.addChild(rowNode);
                    idx = idx + 1;
                }

                root.addChild(tableNode);
                continue;
            }

            // 8. Lists (Ordered and Unordered)
            if (isListItemLine(line)) {
                let isOrdered = false;
                let listStart = 1;
                let firstTrimmed = line.trimStart();
                if (!firstTrimmed.startsWith("- ") && !firstTrimmed.startsWith("* ") && !firstTrimmed.startsWith("+ ")) {
                    isOrdered = true;
                    let dotIdx = firstTrimmed.indexOf(".");
                    if (dotIdx === -1) dotIdx = firstTrimmed.indexOf(")");
                    if (dotIdx > 0) {
                        listStart = firstTrimmed.slice(0, dotIdx).toInt();
                    }
                }

                let listNode = new MarkdownNode("list");
                listNode.ordered = isOrdered;
                listNode.start = listStart;

                while (idx < total) {
                    let cur = lines[idx];
                    if (cur.trim().length === 0) {
                        idx = idx + 1;
                        let shouldCont = false;
                        if (idx < total) {
                            if (isListItemLine(lines[idx])) {
                                shouldCont = true;
                            }
                        }
                        if (shouldCont) {
                            continue;
                        }
                        break;
                    }
                    if (!isListItemLine(cur)) {
                        break;
                    }

                    let curTrimmed = cur.trimStart();
                    let content = "";
                    if (curTrimmed.startsWith("- ") || curTrimmed.startsWith("* ") || curTrimmed.startsWith("+ ")) {
                        content = curTrimmed.slice(2);
                    } else {
                        let spaceIdx = curTrimmed.indexOf(" ");
                        if (spaceIdx > 0) {
                            content = curTrimmed.slice(spaceIdx + 1);
                        } else {
                            content = curTrimmed;
                        }
                    }

                    let itemNode = new MarkdownNode("list_item");
                    if (optGfm && (content.startsWith("[ ] ") || content.startsWith("[x] ") || content.startsWith("[X] "))) {
                        let isChecked = content.startsWith("[x] ") || content.startsWith("[X] ");
                        itemNode.checked = isChecked;
                        content = content.slice(4);
                    }

                    itemNode.text = content;
                    let inlines = parseInlineTokens(content, optEscape);
                    for (let c of inlines) {
                        itemNode.addChild(c);
                    }
                    listNode.addChild(itemNode);
                    idx = idx + 1;
                }

                root.addChild(listNode);
                continue;
            }

            // 9. Paragraph
            let pLines: str[] = [];
            while (idx < total) {
                let cur = lines[idx];
                let curTrim = cur.trim();
                if (curTrim.length === 0) {
                    break;
                }
                if (isParagraphEnd(cur, curTrim)) {
                    break;
                }
                pLines.push(cur);
                idx = idx + 1;
            }

            let pText = pLines.join("\n");
            let pNode = new MarkdownNode("paragraph", pText);
            let inlines = parseInlineTokens(pText, optEscape);
            for (let c of inlines) {
                pNode.addChild(c);
            }
            root.addChild(pNode);
        }

        return root;
    }

    export function renderAst(node: MarkdownNode, options?: MarkdownOptions): str {
        let optXhtml = options?.xhtml ?? false;
        let optEscape = options?.escapeHtml ?? true;
        let optBreaks = options?.breaks ?? false;

        let brTag = optXhtml ? "<br />" : "<br>";
        let hrTag = optXhtml ? "<hr />\n" : "<hr>\n";

        if (node.type === "root") {
            let out = "";
            for (let child of node.children) {
                out = out + renderAst(child, options);
            }
            return out;
        }

        if (node.type === "heading") {
            let tag = "h" + node.level;
            let inner = "";
            for (let c of node.children) {
                inner = inner + renderAst(c, options);
            }
            return "<" + tag + ">" + inner + "</" + tag + ">\n";
        }

        if (node.type === "paragraph") {
            let inner = "";
            for (let c of node.children) {
                inner = inner + renderAst(c, options);
            }
            if (optBreaks) {
                inner = inner.replaceAll("\n", brTag + "\n");
            }
            return "<p>" + inner + "</p>\n";
        }

        if (node.type === "code_block") {
            let code = optEscape ? escapeHtmlStr(node.text) : node.text;
            if (node.lang.length > 0) {
                return "<pre><code class=\"language-" + escapeHtmlStr(node.lang) + "\">" + code + "\n</code></pre>\n";
            }
            return "<pre><code>" + code + "\n</code></pre>\n";
        }

        if (node.type === "blockquote") {
            let inner = "";
            for (let c of node.children) {
                inner = inner + renderAst(c, options);
            }
            return "<blockquote>\n" + inner + "</blockquote>\n";
        }

        if (node.type === "list") {
            let tag = node.ordered ? "ol" : "ul";
            let startAttr = (node.ordered && node.start !== 1) ? (" start=\"" + node.start + "\"") : "";
            let inner = "";
            for (let c of node.children) {
                inner = inner + renderAst(c, options);
            }
            return "<" + tag + startAttr + ">\n" + inner + "</" + tag + ">\n";
        }

        if (node.type === "list_item") {
            let inner = "";
            if (node.checked != null) {
                let chk = node.checked ? " checked=\"\"" : "";
                let inputTag = optXhtml ? ("<input type=\"checkbox\"" + chk + " disabled=\"\" /> ") : ("<input type=\"checkbox\"" + chk + " disabled> ");
                inner = inputTag;
            }
            for (let c of node.children) {
                inner = inner + renderAst(c, options);
            }
            return "<li>" + inner + "</li>\n";
        }

        if (node.type === "table") {
            let headRow = node.children.length > 0 ? node.children[0] : null;
            let thead = "";
            if (headRow != null) {
                let ths = "";
                for (let i = 0; i < headRow.children.length; i = i + 1) {
                    let cell = headRow.children[i];
                    let alignAttr = "";
                    if (i < node.align.length && node.align[i] !== "none") {
                        alignAttr = " align=\"" + node.align[i] + "\"";
                    }
                    let cellContent = "";
                    for (let c of cell.children) cellContent = cellContent + renderAst(c, options);
                    ths = ths + "<th" + alignAttr + ">" + cellContent + "</th>";
                }
                thead = "<thead>\n<tr>" + ths + "</tr>\n</thead>\n";
            }

            let tbodyRows = "";
            for (let r = 1; r < node.children.length; r = r + 1) {
                let row = node.children[r];
                let tds = "";
                for (let i = 0; i < row.children.length; i = i + 1) {
                    let cell = row.children[i];
                    let alignAttr = "";
                    if (i < node.align.length && node.align[i] !== "none") {
                        alignAttr = " align=\"" + node.align[i] + "\"";
                    }
                    let cellContent = "";
                    for (let c of cell.children) cellContent = cellContent + renderAst(c, options);
                    tds = tds + "<td" + alignAttr + ">" + cellContent + "</td>";
                }
                tbodyRows = tbodyRows + "<tr>" + tds + "</tr>\n";
            }
            let tbody = tbodyRows.length > 0 ? ("<tbody>\n" + tbodyRows + "</tbody>\n") : "";

            return "<table>\n" + thead + tbody + "</table>\n";
        }

        if (node.type === "thematic_break") {
            return hrTag;
        }

        if (node.type === "text") {
            return optEscape ? escapeHtmlStr(node.text) : node.text;
        }

        if (node.type === "inline_code") {
            let code = optEscape ? escapeHtmlStr(node.text) : node.text;
            return "<code>" + code + "</code>";
        }

        if (node.type === "bold") {
            let inner = "";
            for (let c of node.children) inner = inner + renderAst(c, options);
            return "<strong>" + inner + "</strong>";
        }

        if (node.type === "italic") {
            let inner = "";
            for (let c of node.children) inner = inner + renderAst(c, options);
            return "<em>" + inner + "</em>";
        }

        if (node.type === "strikethrough") {
            let inner = "";
            for (let c of node.children) inner = inner + renderAst(c, options);
            return "<del>" + inner + "</del>";
        }

        if (node.type === "link") {
            let inner = "";
            for (let c of node.children) inner = inner + renderAst(c, options);
            let titleAttr = node.title.length > 0 ? (" title=\"" + escapeHtmlStr(node.title) + "\"") : "";
            return "<a href=\"" + escapeHtmlStr(node.url) + "\"" + titleAttr + ">" + inner + "</a>";
        }

        if (node.type === "image") {
            let titleAttr = node.title.length > 0 ? (" title=\"" + escapeHtmlStr(node.title) + "\"") : "";
            let altAttr = " alt=\"" + escapeHtmlStr(node.text) + "\"";
            let srcAttr = " src=\"" + escapeHtmlStr(node.url) + "\"";
            if (optXhtml) {
                return "<img" + srcAttr + altAttr + titleAttr + " />";
            }
            return "<img" + srcAttr + altAttr + titleAttr + ">";
        }

        return "";
    }

    export function render(source: str, options?: MarkdownOptions): str {
        let ast = parse(source, options);
        return renderAst(ast, options);
    }

    export function toPlainText(source: str): str {
        let ast = parse(source, { escapeHtml: false });
        let out: str[] = [];

        function walk(n: MarkdownNode): void {
            if (n.type === "text" || n.type === "inline_code") {
                out.push(n.text);
            } else if (n.type === "code_block") {
                out.push(n.text + "\n");
            } else {
                for (let c of n.children) {
                    walk(c);
                }
                if (n.type === "paragraph" || n.type === "heading" || n.type === "list_item" || n.type === "thematic_break") {
                    out.push("\n");
                }
            }
        }

        walk(ast);
        return out.join("").trim();
    }

    export function extractHeadings(source: str): MarkdownHeading[] {
        let ast = parse(source);
        let list: MarkdownHeading[] = [];

        function walk(n: MarkdownNode): void {
            if (n.type === "heading") {
                list.push({
                    level: n.level,
                    text: n.text,
                    id: slugifyUtil(n.text)
                });
            }
            for (let c of n.children) {
                walk(c);
            }
        }

        walk(ast);
        return list;
    }

    export function extractLinks(source: str): MarkdownLink[] {
        let ast = parse(source);
        let links: MarkdownLink[] = [];

        function walk(n: MarkdownNode): void {
            if (n.type === "link") {
                links.push({
                    text: n.text,
                    url: n.url,
                    title: n.title,
                    isImage: false
                });
            } else if (n.type === "image") {
                links.push({
                    text: n.text,
                    url: n.url,
                    title: n.title,
                    isImage: true
                });
            }
            for (let c of n.children) {
                walk(c);
            }
        }

        walk(ast);
        return links;
    }
}
