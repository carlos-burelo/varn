export enum MarkdownNodeKind {
    Root,
    Heading,
    Paragraph,
    CodeBlock,
    Blockquote,
    List,
    ListItem,
    Table,
    TableRow,
    TableCell,
    ThematicBreak,
    Text,
    InlineCode,
    Bold,
    Italic,
    Strikethrough,
    Link,
    Image
}

export enum TableAlign {
    None,
    Left,
    Center,
    Right
}

export interface MarkdownOptions {
    gfm?: bool;
    xhtml?: bool;
    escapeHtml?: bool;
    breaks?: bool;
}

export interface MarkdownHeading {
    level: int;
    text: str;
    id: str;
}

export interface MarkdownLink {
    text: str;
    url: str;
    title: str;
    isImage: bool;
}

export class MarkdownNode {
    kind: MarkdownNodeKind;
    text: str;
    level: int;
    lang: str;
    ordered: bool;
    start: int;
    checked: bool?;
    url: str;
    title: str;
    align: TableAlign[];
    children: MarkdownNode[];

    constructor(kind: MarkdownNodeKind, text: str = "") {
        this.kind = kind;
        this.text = text;
        this.level = 0;
        this.lang = "";
        this.ordered = false;
        this.start = 1;
        this.checked = null;
        this.url = "";
        this.title = "";
        this.align = [];
        this.children = [];
    }

    addChild(child: MarkdownNode): void {
        this.children.push(child);
    }
}
