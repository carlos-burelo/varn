// std:sys — Pure Varn facade over runtime process host operations.

import {
    processPlatform,
    processCwd,
    processArgs,
    processExit,
    processEnv,
    processSetEnv,
    processNow
} from "runtime:process";

export function now(): float {
    return processNow();
}

export namespace sys {
    export function platform(): str {
        return processPlatform();
    }

    export function cwd(): str {
        return processCwd();
    }

    export function args(): str[] {
        return processArgs();
    }

    export function exit(code?: int): void {
        processExit(code);
    }

    export function env(key: str): str {
        return processEnv(key);
    }

    export function setEnv(key: str, val: str): void {
        processSetEnv(key, val);
    }

    export function now(): float {
        return processNow();
    }
}
