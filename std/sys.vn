// std:sys — Pure Varn facade over runtime sys host operations.

import {
    platform as nativePlatform,
    cwd as nativeCwd,
    args as nativeArgs,
    exit as nativeExit,
    env as nativeEnv,
    setEnv as nativeSetEnv,
    now as nativeNow
} from "runtime:sys";

export function platform(): str {
    return nativePlatform();
}

export function cwd(): str {
    return nativeCwd();
}

export function args(): str[] {
    return nativeArgs();
}

export function exit(code?: int): void {
    nativeExit(code);
}

export function env(key: str): str {
    return nativeEnv(key);
}

export function setEnv(key: str, val: str): void {
    nativeSetEnv(key, val);
}

export function now(): float {
    return nativeNow();
}
