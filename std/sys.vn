import {
    platform$,
    cwd$,
    args$,
    exit$,
    env$,
    setEnv$,
    now$
} from "runtime:sys";

export function platform(): str {
    return platform$();
}

export function cwd(): str {
    return cwd$();
}

export function args(): str[] {
    return args$();
}

export function exit(code?: int): void {
    exit$(code);
}

export function env(key: str): str {
    return env$(key);
}

export function setEnv(key: str, val: str): void {
    setEnv$(key, val);
}

export function now(): float {
    return now$();
}

export type SystemInfoRecord = { platform: str, cwd: str, args: str[], now: float };

export function getSystemInfo(): SystemInfoRecord {
    return #{
        platform: platform$(),
        cwd: cwd$(),
        args: args$(),
        now: now$()
    };
}

export function parseDotEnv(content: str): { [key: str]: str } {
    let result: { [key: str]: str } = {};
    let lines = content.split("\n");
    for (let line of lines) {
        let trimmed = line.trim();
        if (trimmed.length > 0 && !trimmed.startsWith("#")) {
            let eqIdx = trimmed.indexOf("=");
            if (eqIdx > 0) {
                let key = trimmed.slice(0, eqIdx).trim();
                let val = trimmed.slice(eqIdx + 1).trim();
                if ((val.startsWith("\"") && val.endsWith("\"")) || (val.startsWith("'") && val.endsWith("'"))) {
                    val = val.slice(1, val.length - 1);
                }
                result[key] = val;
            }
        }
    }
    return result;
}

export function parseArgs(rawArgs?: str[]): { flags: { [key: str]: str }, positionals: str[] } {
    let input = rawArgs !== null ? rawArgs : args$();
    let flags: { [key: str]: str } = {};
    let positionals: str[] = [];

    for (let i = 0; i < input.length; i = i + 1) {
        let arg = input[i];
        if (arg.startsWith("--")) {
            let body = arg.slice(2);
            let eqIdx = body.indexOf("=");
            if (eqIdx > 0) {
                let k = body.slice(0, eqIdx);
                let v = body.slice(eqIdx + 1);
                flags[k] = v;
            } else {
                flags[body] = "true";
            }
        } else if (arg.startsWith("-")) {
            let flag = arg.slice(1);
            flags[flag] = "true";
        } else {
            positionals.push(arg);
        }
    }

    return #{
        flags: flags,
        positionals: positionals
    };
}
