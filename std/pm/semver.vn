export type SemVer = {
    major: int,
    minor: int,
    patch: int,
    pre: str[],
    build: str
};

function parsePre(text: str): str[] {
    if (text.length === 0) {
        return [];
    }
    return text.split(".");
}

function cmpPre(a: str[], b: str[]): int {
    if (a.length === 0 && b.length === 0) {
        return 0;
    }
    if (a.length === 0) {
        return 1;
    }
    if (b.length === 0) {
        return -1;
    }
    let n = a.length < b.length ? a.length : b.length;
    for (let i = 0; i < n; i = i + 1) {
        let x = a[i];
        let y = b[i];
        if (x === y) {
            continue;
        }
        let xn = isNumIdent(x);
        let yn = isNumIdent(y);
        if (xn && yn) {
            return int.parse(x) < int.parse(y) ? -1 : 1;
        }
        if (xn) {
            return -1;
        }
        if (yn) {
            return 1;
        }
        return x < y ? -1 : 1;
    }
    if (a.length === b.length) {
        return 0;
    }
    return a.length < b.length ? -1 : 1;
}

function isNumIdent(s: str): bool {
    if (s.length === 0) {
        return false;
    }
    for (let i = 0; i < s.length; i = i + 1) {
        let c = s.charCodeAt(i);
        if (c < 48 || c > 57) {
            return false;
        }
    }
    return true;
}

export namespace Semver {
    export function parse(text: str): SemVer {
        let v = text.trim();
        if (v.startsWith("v") || v.startsWith("=")) {
            v = v.slice(1);
        }
        let build = "";
        let plus = v.indexOf("+");
        if (plus >= 0) {
            build = v.slice(plus + 1);
            v = v.slice(0, plus);
        }
        let pre: str[] = [];
        let dash = v.indexOf("-");
        if (dash >= 0) {
            pre = parsePre(v.slice(dash + 1));
            v = v.slice(0, dash);
        }
        let nums = v.split(".");
        if (nums.length !== 3) {
            throw new Error("Semver: expected major.minor.patch, got '" + text + "'");
        }
        return #{
            major: int.parse(nums[0]),
            minor: int.parse(nums[1]),
            patch: int.parse(nums[2]),
            pre: pre,
            build: build
        };
    }

    export function toString(v: SemVer): str {
        let out = v.major.toString() + "." + v.minor.toString() + "." + v.patch.toString();
        if (v.pre.length > 0) {
            out = out + "-" + v.pre.join(".");
        }
        if (v.build.length > 0) {
            out = out + "+" + v.build;
        }
        return out;
    }

    export function compare(a: SemVer, b: SemVer): int {
        if (a.major !== b.major) {
            return a.major < b.major ? -1 : 1;
        }
        if (a.minor !== b.minor) {
            return a.minor < b.minor ? -1 : 1;
        }
        if (a.patch !== b.patch) {
            return a.patch < b.patch ? -1 : 1;
        }
        return cmpPre(a.pre, b.pre);
    }

    function testOp(v: SemVer, op: str, ref: SemVer): bool {
        let c = compare(v, ref);
        if (op === "=" || op === "") {
            return c === 0;
        }
        if (op === ">") {
            return c > 0;
        }
        if (op === ">=") {
            return c >= 0;
        }
        if (op === "<") {
            return c < 0;
        }
        if (op === "<=") {
            return c <= 0;
        }
        if (op === "^") {
            if (c < 0) {
                return false;
            }
            if (ref.major > 0) {
                return v.major === ref.major;
            }
            if (ref.minor > 0) {
                return v.minor === ref.minor;
            }
            return v.patch === ref.patch;
        }
        if (op === "~") {
            if (c < 0) {
                return false;
            }
            return v.major === ref.major && v.minor === ref.minor;
        }
        throw new Error("Semver: bad operator '" + op + "'");
    }

    function satisfiesAnd(v: SemVer, group: str): bool {
        let parts = group.split(" ");
        for (let part of parts) {
            if (part.length === 0) {
                continue;
            }
            let op = "";
            let rest = part;
            if (part.startsWith(">=") || part.startsWith("<=")) {
                op = part.slice(0, 2);
                rest = part.slice(2);
            } else if (part.startsWith(">") || part.startsWith("<") || part.startsWith("=") || part.startsWith("^") || part.startsWith("~")) {
                op = part.slice(0, 1);
                rest = part.slice(1);
            }
            if (!testOp(v, op, parse(rest))) {
                return false;
            }
        }
        return true;
    }

    export function satisfies(v: SemVer, range: str): bool {
        let groups = range.split("||");
        for (let g of groups) {
            if (satisfiesAnd(v, g.trim())) {
                return true;
            }
        }
        return false;
    }

    export function satisfiesText(version: str, range: str): bool {
        return satisfies(parse(version), range);
    }
}
