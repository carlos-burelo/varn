import { ioWrite, ioWriteln, ioFlush, ioReadLine } from "runtime:io";

export interface Writer {
    write(content: str): void
}

export interface Reader {
    read(size?: int): str
    readAll(): str
    pipeTo(dst: Writer): void
}

export namespace io {
    // Direct native aliases: calling these dispatches straight to the host
    // native (arg slice) instead of a VM forwarder that bundles a rest array
    // and re-spreads it (`WrapSpread`/`CallSpread`) — one fewer heap alloc per
    // call.
    export const write = ioWrite;
    export const writeln = ioWriteln;
    export const print = ioWriteln;

    export function flush(): void {
        ioFlush();
    }

    export function readLine(prompt?: str): str {
        if (prompt === null) {
            return ioReadLine("");
        }
        return ioReadLine(prompt);
    }

    export function readAll(): str {
        return "";
    }
}
