import { write as nativeWrite, writeln as nativeWriteln, flush as nativeFlush, readLine as nativeReadLine } from "runtime:io";

export interface Writer {
    write(content: str): void
}

export interface Reader {
    read(size?: int): str
    readAll(): str
    pipeTo(dst: Writer): void
}

export const write = nativeWrite;
export const writeln = nativeWriteln;
export const print = nativeWriteln;

export function flush(): void {
    nativeFlush();
}

export function readLine(prompt?: str): str {
    if (prompt === null) {
        return nativeReadLine("");
    }
    return nativeReadLine(prompt);
}

export function readAll(): str {
    return "";
}
