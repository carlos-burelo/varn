export class List<T> {
    private items: T[];

    constructor(initial?: T[]) {
        this.items = initial ?? [];
    }

    get length(): int { return this.items.length; }

    add(item: T): void { this.items.push(item); }
    push(item: T): void { this.items.push(item); }
    pop(): T? { return this.items.pop(); }

    get(index: int): T { return this.items[index]; }
    set(index: int, val: T): void { this.items[index] = val; }

    clear(): void { this.items = []; }
    contains(item: T): bool { return this.items.indexOf(item) !== -1; }

    toArray(): T[] { return this.items.slice(); }
}

export class Stack<S> {
    private items: S[] = [];
    push(item: S): void { this.items.push(item); }
    pop(): S? { return this.items.pop(); }
    peek(): S? { return this.items[this.items.length - 1]; }
    get size(): int { return this.items.length; }
    get isEmpty(): bool { return this.items.length === 0; }
}

export class Queue<Q> {
    private inbox: Q[] = [];
    private outbox: Q[] = [];

    enqueue(item: Q): void {
        this.inbox.push(item);
    }

    dequeue(): Q? {
        if (this.outbox.length === 0) {
            while (this.inbox.length > 0) {
                this.outbox.push(this.inbox.pop() as Q);
            }
        }
        return this.outbox.pop();
    }

    peek(): Q? {
        if (this.outbox.length === 0) {
            while (this.inbox.length > 0) {
                this.outbox.push(this.inbox.pop() as Q);
            }
        }
        if (this.outbox.length === 0) {
            return null;
        }
        return this.outbox[this.outbox.length - 1];
    }

    get size(): int {
        return this.inbox.length + this.outbox.length;
    }

    get isEmpty(): bool {
        return this.inbox.length === 0 && this.outbox.length === 0;
    }
}

export class Record<K, V> {
    private entries: Map<V>;

    constructor() {
        this.entries = new Map<V>();
    }

    get(key: K): V? {
        return this.entries.get(key as str);
    }

    set(key: K, value: V): void {
        this.entries.set(key as str, value);
    }

    has(key: K): bool {
        return this.entries.has(key as str);
    }

    delete(key: K): bool {
        return this.entries.delete(key as str);
    }

    keys(): K[] {
        return this.entries.keys() as K[];
    }

    values(): V[] {
        return this.entries.values();
    }

    get size(): int {
        return this.entries.size;
    }
}
