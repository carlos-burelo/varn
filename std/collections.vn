// std:collections — High-performance data structures for Varn

export class List<T> {
    private items: T[];

    constructor(initial?: T[]) {
        this.items = initial ?? [];
    }

    add(item: T): void {
        this.items.push(item);
    }

    get(index: int): T? {
        if (index < 0 || index >= this.items.length) {
            return null;
        }
        return this.items[index];
    }

    get length(): int {
        return this.items.length;
    }

    toArray(): T[] {
        return this.items.slice();
    }
}

export class Stack<S> {
    private items: S[];

    constructor(initial?: S[]) {
        this.items = initial ?? [];
    }

    push(item: S): void {
        this.items.push(item);
    }

    pop(): S? {
        return this.items.pop();
    }

    peek(): S? {
        if (this.items.length === 0) {
            return null;
        }
        return this.items[this.items.length - 1];
    }

    get size(): int {
        return this.items.length;
    }

    get isEmpty(): bool {
        return this.items.length === 0;
    }
}

export class Queue<Q> {
    private inbox: Q[];
    private outbox: Q[];

    constructor() {
        this.inbox = [];
        this.outbox = [];
    }

    enqueue(item: Q): void {
        this.inbox.push(item);
    }

    dequeue(): Q? {
        if (this.outbox.length === 0) {
            while (this.inbox.length > 0) {
                this.outbox.push(this.inbox.pop() as Q);
            }
        }
        return this.outbox.pop();
    }

    peek(): Q? {
        if (this.outbox.length === 0) {
            while (this.inbox.length > 0) {
                this.outbox.push(this.inbox.pop() as Q);
            }
        }
        if (this.outbox.length === 0) {
            return null;
        }
        return this.outbox[this.outbox.length - 1];
    }

    get size(): int {
        return this.inbox.length + this.outbox.length;
    }

    get isEmpty(): bool {
        return this.inbox.length === 0 && this.outbox.length === 0;
    }
}

export class Record<K, V> {
    private entries: Map<V>;

    constructor() {
        this.entries = new Map<V>();
    }

    get(key: K): V? {
        return this.entries.get(key as str);
    }

    set(key: K, value: V): void {
        this.entries.set(key as str, value);
    }

    has(key: K): bool {
        return this.entries.has(key as str);
    }

    delete(key: K): bool {
        return this.entries.delete(key as str);
    }
}
