import {
    wsKey$,
    wsValidateResponse$,
    wsFrameBytes$,
    wsParseFrame$,
    wsDecodeText$,
    WsOpcode,
    WsFrame
} from "runtime:ws";

import {
    tcpConnect$,
    tcpConnectTls$,
    tcpRead$,
    tcpWrite$,
    tcpClose$
} from "runtime:net";

import { Url } from "std:net";
import { AsyncReader, AsyncWriter } from "std:io";
import { ProtocolError, ClosedError } from "std:error";

export enum WebSocketReadyState {
    Connecting = 0,
    Open = 1,
    Closing = 2,
    Closed = 3
}

export function bytesConcat(a: Bytes, b: Bytes): Bytes {
    if (a.length === 0) {
        return b;
    }
    if (b.length === 0) {
        return a;
    }
    let out = Bytes.alloc(a.length + b.length);
    a.copy(out, 0, 0, a.length);
    b.copy(out, a.length, 0, b.length);
    return out;
}

const MAX_HANDSHAKE = 16384;
const DEFAULT_MAX_MESSAGE = 16777216;

export async function readHttpHead(connId: int): Task<#{ head: str, rest: Bytes }> {
    let buf = Bytes.alloc(0);
    while (true) {
        let end = findHeadEnd(buf);
        if (end >= 0) {
            return #{ head: buf.slice(0, end).toString(), rest: buf.slice(end) };
        }
        if (buf.length > MAX_HANDSHAKE) {
            throw new ProtocolError("the WebSocket handshake is too large");
        }
        let chunk = await tcpRead$(connId, 4096);
        if (chunk === null) {
            throw new ProtocolError("connection closed during handshake");
        }
        buf = bytesConcat(buf, chunk as Bytes);
    }
}

function findHeadEnd(buf: Bytes): int {
    let i = 0;
    while (i + 3 < buf.length) {
        if (buf.getByte(i) === 13 && buf.getByte(i + 1) === 10 && buf.getByte(i + 2) === 13 && buf.getByte(i + 3) === 10) {
            return i + 4;
        }
        i = i + 1;
    }
    return -1;
}

export class WebSocket implements AsyncReader, AsyncWriter {
    private _conn: int = -1;
    private _url: str;
    private _readyState: WebSocketReadyState = WebSocketReadyState.Connecting;
    private _recvBuf: Bytes = Bytes.alloc(0);
    private _fragBuf: Bytes? = null;
    private _fragOp: WsOpcode? = null;
    private _server: bool = false;
    private _maxMessage: int = DEFAULT_MAX_MESSAGE;
    private _onOpenListeners: Array<() => void> = [];
    private _onMessageListeners: Array<(data: str) => void> = [];
    private _onBytesListeners: Array<(data: Bytes) => void> = [];
    private _onErrorListeners: Array<(err: str) => void> = [];
    private _onCloseListeners: Array<() => void> = [];

    constructor(connId: int, url: str, server: bool = false) {
        this._conn = connId;
        this._url = url;
        this._server = server;
        this._readyState = WebSocketReadyState.Open;
    }

    static async connect(url: str): Task<WebSocket> {
        let parsed = Url.parse(url);
        const secure = parsed.protocol === "wss";
        if (!secure && parsed.protocol !== "ws") {
            throw new TypeError("only ws:// and wss:// URLs are supported");
        }
        let port = parsed.port ?? (secure ? 443 : 80);
        const conn = secure ? await tcpConnectTls$(parsed.host, port) : await tcpConnect$(parsed.host, port);
        try {
            let key = wsKey$();
            let target = parsed.path;
            let qs = parsed.query.toString();
            if (qs.length > 0) {
                target = target + "?" + qs;
            }
            if (target.length === 0) {
                target = "/";
            }
            let req = "GET " + target + " HTTP/1.1\r\nHost: " + parsed.authority() + "\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: " + key + "\r\nSec-WebSocket-Version: 13\r\n\r\n";
            await tcpWrite$(conn, req);
            let head = await readHttpHead(conn);
            wsValidateResponse$(head.head, key);
            let ws = new WebSocket(conn, url);
            ws.absorb(head.rest);
            return ws;
        } catch (e) {
            tcpClose$(conn);
            throw e;
        }
    }

    maxMessageBytes(limit: int): WebSocket {
        if (limit < 1) {
            throw new RangeError("the message limit must be positive");
        }
        this._maxMessage = limit;
        return this;
    }

    get readyState(): WebSocketReadyState {
        return this._readyState;
    }

    get isOpen(): bool {
        return this._readyState === WebSocketReadyState.Open;
    }

    get url(): str {
        return this._url;
    }

    onOpen(handler: () => void): WebSocket {
        this._onOpenListeners.push(handler);
        if (this.isOpen) {
            handler();
        }
        return this;
    }

    onMessage(handler: (data: str) => void): WebSocket {
        this._onMessageListeners.push(handler);
        return this;
    }

    onBytes(handler: (data: Bytes) => void): WebSocket {
        this._onBytesListeners.push(handler);
        return this;
    }

    onError(handler: (err: str) => void): WebSocket {
        this._onErrorListeners.push(handler);
        return this;
    }

    onClose(handler: () => void): WebSocket {
        this._onCloseListeners.push(handler);
        return this;
    }

    absorb(data: Bytes): void {
        this._recvBuf = bytesConcat(this._recvBuf, data);
    }

    private _notifyError(msg: str): void {
        for (let i = 0; i < this._onErrorListeners.length; i = i + 1) {
            this._onErrorListeners[i](msg);
        }
    }

    private _dispatchText(text: str): void {
        for (let i = 0; i < this._onMessageListeners.length; i = i + 1) {
            this._onMessageListeners[i](text);
        }
    }

    private _dispatchBytes(data: Bytes): void {
        for (let i = 0; i < this._onBytesListeners.length; i = i + 1) {
            this._onBytesListeners[i](data);
        }
    }

    async send(message: str | Bytes): Task<int> {
        if (!this.isOpen) {
            throw new ClosedError("WebSocket is closed");
        }
        try {
            let data: Bytes;
            let opcode: WsOpcode;
            if (message is str) {
                data = Bytes.fromString(message);
                opcode = WsOpcode.Text;
            } else {
                data = message as Bytes;
                opcode = WsOpcode.Binary;
            }
            await tcpWrite$(this._conn, wsFrameBytes$(data, opcode, !this._server));
            return data.length;
        } catch (e) {
            this._notifyError(e.message);
            throw e;
        }
    }

    private async _fail(code: int): Task<void> {
        try {
            const body = Bytes.alloc(2);
            body.setByte(0, code / 256);
            body.setByte(1, code % 256);
            await tcpWrite$(this._conn, wsFrameBytes$(body, WsOpcode.Close, !this._server));
        } catch (e) {}
        this.close();
    }

    private async _reject(code: int, message: str): Task<void> {
        await this._fail(code);
        this._notifyError(message);
        throw new ProtocolError(message);
    }

    private async _pumpControl(opcode: WsOpcode, payload: Bytes): Task<void> {
        if (opcode == WsOpcode.Ping) {
            await tcpWrite$(this._conn, wsFrameBytes$(payload, WsOpcode.Pong, !this._server));
            return;
        }
        if (payload.length === 1) {
            await this._reject(1002, "a close frame carries one byte");
        }
        if (payload.length >= 2) {
            const code = payload.getByte(0) * 256 + payload.getByte(1);
            const valid = (code >= 1000 && code <= 1003) || (code >= 1007 && code <= 1011) || (code >= 3000 && code <= 4999);
            if (!valid) {
                await this._reject(1002, `a close frame carries the invalid code ${code}`);
            }
            try {
                wsDecodeText$(payload.slice(2));
            } catch (e) {
                await this._reject(1007, "the close reason is not valid UTF-8");
            }
        }
        try {
            await tcpWrite$(this._conn, wsFrameBytes$(payload.slice(0, payload.length >= 2 ? 2 : 0), WsOpcode.Close, !this._server));
        } catch (e) {}
        this.close();
    }

    async read(size?: int): Task<Bytes?> {
        while (true) {
            let frame: WsFrame? = null;
            try {
                frame = wsParseFrame$(this._recvBuf, this._server, this._maxMessage);
            } catch (e) {
                await this._reject(e.message.indexOf("exceeds the limit") !== null ? 1009 : 1002, e.message);
            }
            if (frame === null) {
                if (!this.isOpen) {
                    return null;
                }
                let chunk: Bytes?;
                try {
                    chunk = await tcpRead$(this._conn, 8192);
                } catch (e) {
                    this._notifyError(e.message);
                    throw e;
                }
                if (chunk === null) {
                    this.close();
                    return null;
                }
                this._recvBuf = bytesConcat(this._recvBuf, chunk as Bytes);
                continue;
            }
            this._recvBuf = this._recvBuf.slice(frame.consumed);
            let opcode = frame.opcode;
            let payload = frame.payload;
            if (opcode == WsOpcode.Ping || opcode == WsOpcode.Close) {
                try {
                    await this._pumpControl(opcode, payload);
                } catch (e) {
                    this._notifyError(e.message);
                    throw e;
                }
                if (!this.isOpen) {
                    return null;
                }
                continue;
            }
            if (opcode == WsOpcode.Pong) {
                continue;
            }
            if (opcode == WsOpcode.Continuation) {
                if (this._fragBuf === null) {
                    await this._reject(1002, "a continuation frame has nothing to continue");
                }
                const joined = bytesConcat(this._fragBuf as Bytes, payload);
                if (joined.length > this._maxMessage) {
                    await this._reject(1009, "the message exceeds the limit");
                }
                this._fragBuf = joined;
                if (frame.fin) {
                    let done = this._fragBuf as Bytes;
                    let op = this._fragOp as WsOpcode;
                    this._fragBuf = null;
                    this._fragOp = null;
                    return await this._deliver(op, done);
                }
                continue;
            }
            if (this._fragBuf !== null) {
                await this._reject(1002, "a new message starts inside a fragmented one");
            }
            if (frame.fin) {
                return await this._deliver(opcode, payload);
            }
            this._fragBuf = payload;
            this._fragOp = opcode;
        }
    }

    private async _deliver(opcode: WsOpcode, payload: Bytes): Task<Bytes> {
        if (opcode == WsOpcode.Text) {
            let text = "";
            try {
                text = wsDecodeText$(payload);
            } catch (e) {
                await this._reject(1007, "a text message is not valid UTF-8");
            }
            this._dispatchText(text);
        } else {
            this._dispatchBytes(payload);
        }
        return payload;
    }

    async write(data: Bytes): Task<int> {
        return await this.send(data);
    }

    async flush(): Task<void> {}

    async listen(): Task<void> {
        while (this.isOpen) {
            await this.read();
        }
    }

    close(): void {
        if (this._readyState !== WebSocketReadyState.Closed) {
            this._readyState = WebSocketReadyState.Closing;
            if (this._conn >= 0) {
                try {
                    tcpClose$(this._conn);
                } catch (e) {}
            }
            this._readyState = WebSocketReadyState.Closed;
            this._conn = -1;
            for (let i = 0; i < this._onCloseListeners.length; i = i + 1) {
                this._onCloseListeners[i]();
            }
        }
    }

    async closeGracefully(): Task<void> {
        if (this._readyState !== WebSocketReadyState.Closed) {
            try {
                await tcpWrite$(this._conn, wsFrameBytes$(Bytes.alloc(0), WsOpcode.Close, !this._server));
            } catch (e) {}
            this.close();
        }
    }
}
