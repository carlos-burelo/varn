// std:extensions — Fluent extension methods for Varn primitive types (str, int).

import { sha256$, sha512$, base64Enc$, base64Dec$ } from "runtime:crypto";
import { isIP$, isIPv4$, isIPv6$ } from "runtime:net";

export extension StringExtensions on str {
    sha256(): str {
        return sha256$(this);
    }

    sha512(): str {
        return sha512$(this);
    }

    toBase64(): str {
        return base64Enc$(this);
    }

    fromBase64(): str {
        return base64Dec$(this);
    }

    isIP(): bool {
        return isIP$(this);
    }

    isIPv4(): bool {
        return isIPv4$(this);
    }

    isIPv6(): bool {
        return isIPv6$(this);
    }
}

export extension IntExtensions on int {
    ms(): int {
        return this;
    }

    seconds(): int {
        return this * 1000;
    }

    minutes(): int {
        return this * 60000;
    }

    hours(): int {
        return this * 3600000;
    }
}
