// Elevated std:math module - High-performance math intrinsics.
import {
    abs$,
    sqrt$,
    sin$,
    cos$,
    tan$,
    floor$,
    ceil$,
    round$,
    random$,
    acos$,
    asin$,
    atan$,
    atan2$
} from "runtime:math";

export const E: float = 2.718281828459045;
export const LN10: float = 2.302585092994046;
export const LN2: float = 0.6931471805599453;
export const LOG10E: float = 0.4342944819032518;
export const LOG2E: float = 1.4426950408889634;
export const PI: float = 3.141592653589793;
export const SQRT1_2: float = 0.7071067811865476;
export const SQRT2: float = 1.4142135623730951;

export class Math {
    static const E: float = 2.718281828459045;
    static const PI: float = 3.141592653589793;

    static abs(x: float): float { return abs$(x); }
    static sqrt(x: float): float { return sqrt$(x); }
    static sin(x: float): float { return sin$(x); }
    static cos(x: float): float { return cos$(x); }
    static tan(x: float): float { return tan$(x); }
    static floor(x: float): float { return floor$(x); }
    static ceil(x: float): float { return ceil$(x); }
    static round(x: float): float { return round$(x); }
    static random(): float { return random$(); }
    static acos(x: float): float { return acos$(x); }
    static asin(x: float): float { return asin$(x); }
    static atan(x: float): float { return atan$(x); }
    static atan2(y: float, x: float): float { return atan2$(y, x); }
}

export function abs(x: float): float {
    return abs$(x);
}

export function sqrt(x: float): float {
    return sqrt$(x);
}

export function sin(x: float): float {
    return sin$(x);
}

export function cos(x: float): float {
    return cos$(x);
}

export function tan(x: float): float {
    return tan$(x);
}

export function floor(x: float): float {
    return floor$(x);
}

export function ceil(x: float): float {
    return ceil$(x);
}

export function round(x: float): float {
    return round$(x);
}

export function random(): float {
    return random$();
}

export function acos(x: float): float {
    return acos$(x);
}
export function asin(x: float): float {
    return asin$(x);
}
export function atan(x: float): float {
    return atan$(x);
}
export function atan2(y: float, x: float): float {
    return atan2$(y, x);
}
export function exp(x: float): float {
    return 0.0;
}
export function log(x: float): float {
    return 0.0;
}
export function max(...args: float[]): float {
    if (args.length === 0) {
        throw new Error("max() requires at least one argument");
    }
    let current = args[0];
    for (let i = 1; i < args.length; i = i + 1) {
        let v = args[i];
        if (v > current) {
            current = v;
        }
    }
    return current;
}
export function min(...args: float[]): float {
    if (args.length === 0) {
        throw new Error("min() requires at least one argument");
    }
    let current = args[0];
    for (let i = 1; i < args.length; i = i + 1) {
        let v = args[i];
        if (v < current) {
            current = v;
        }
    }
    return current;
}
export function pow(x: float, y: float): float {
    return 0.0;
}
export function sign(x: float): float {
    if (x > 0.0) return 1.0;
    if (x < 0.0) return -1.0;
    return 0.0;
}
export function trunc(x: float): float {
    if (x >= 0.0) {
        return floor$(x);
    }
    return ceil$(x);
}
