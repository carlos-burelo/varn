import { pbkdf2$, timingSafeEqual$, randomBytesBuffer$ } from "runtime:crypto";

export function pbkdf2(password: str, salt: Bytes | str, iterations: int, keyLen: int): Bytes {
    return pbkdf2$(password, salt, iterations, keyLen);
}

export function timingSafeEqual(a: Bytes | str, b: Bytes | str): bool {
    return timingSafeEqual$(a, b);
}

export function hashPassword(password: str, iterations: int = 100000): str {
    let salt = randomBytesBuffer$(16);
    let saltHex = salt.toHex();
    let key = pbkdf2$(password, salt, iterations, 32);
    let keyHex = key.toHex();
    return "$pbkdf2-sha256$i=" + iterations.toString() + "$" + saltHex + "$" + keyHex;
}

function hexNibble(code: int): int {
    if (code >= 48 && code <= 57) return code - 48;
    if (code >= 97 && code <= 102) return code - 87;
    if (code >= 65 && code <= 70) return code - 55;
    return 0;
}

export function verifyPassword(password: str, hash: str): bool {
    let parts = hash.split("$");
    if (parts.length < 5) return false;
    if (parts[1] !== "pbkdf2-sha256") return false;
    let iterPart = parts[2];
    let eqIdx = iterPart.indexOf("=");
    if (eqIdx < 0) return false;
    let iterStr = iterPart.slice(eqIdx + 1);
    let iterations = int.parse(iterStr);
    let saltHex = parts[3];
    let expectedHex = parts[4];

    let saltLen = saltHex.length >> 1;
    let salt = Bytes.alloc(saltLen);
    for (let i = 0; i < saltHex.length; i = i + 2) {
        let hi = hexNibble(saltHex.charCodeAt(i));
        let lo = hexNibble(saltHex.charCodeAt(i + 1));
        salt.setByte(i >> 1, (hi << 4) | lo);
    }

    let key = pbkdf2$(password, salt, iterations, 32);
    let derivedHex = key.toHex();
    return timingSafeEqual$(derivedHex, expectedHex);
}
