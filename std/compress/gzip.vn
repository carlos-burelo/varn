import {
    gzip$,
    gunzip$,
    deflate$,
    inflate$
} from "runtime:compress";

export namespace Compress {
    export function gzip(data: Bytes | str): Bytes {
        return gzip$(data);
    }

    export function gunzip(bytes: Bytes): Bytes {
        return gunzip$(bytes);
    }

    export function deflate(data: Bytes | str): Bytes {
        return deflate$(data);
    }

    export function inflate(bytes: Bytes): Bytes {
        return inflate$(bytes);
    }
}
