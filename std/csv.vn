import { parse$, stringify$ } from "runtime:csv";

export interface CsvOptions {
    delimiter?: str;
    hasHeader?: bool;
    trim?: bool;
}

export namespace CSV {
    export function parse(text: str, options?: CsvOptions): dynamic[] {
        let delim = ",";
        let hasHeader = true;
        let trim = true;

        if (options != null) {
            if (options.delimiter != null) {
                delim = options.delimiter;
            }
            if (options.hasHeader != null) {
                hasHeader = options.hasHeader;
            }
            if (options.trim != null) {
                trim = options.trim;
            }
        }

        return parse$(text, delim, hasHeader, trim);
    }

    export function stringify(rows: dynamic[], options?: CsvOptions): str {
        let delim = ",";

        if (options != null) {
            if (options.delimiter != null) {
                delim = options.delimiter;
            }
        }

        return stringify$(rows, delim);
    }
}
