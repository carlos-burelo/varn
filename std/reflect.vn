import {
    defineMetadata$,
    getMetadata$,
    hasMetadata$,
    createMetaKey$,
    setMetaKey$,
    getMetaKey$,
    hasMetaKey$
} from "runtime:reflect";

export interface ClassRef {
    name: str;
}

export interface FunctionRef {
    name: str;
    length: int;
    apply(thisArg: dynamic, args?: dynamic[]): dynamic;
    call(thisArg: dynamic, ...args: dynamic[]): dynamic;
    bind(thisArg: dynamic, ...args: dynamic[]): FunctionRef;
}

export function defineMetadata(metadataKey: dynamic, metadataValue: dynamic, target: dynamic): void {
    defineMetadata$(metadataKey, metadataValue, target);
}

export function getMetadata(metadataKey: dynamic, target: dynamic): dynamic {
    return getMetadata$(metadataKey, target);
}

export function hasMetadata(metadataKey: dynamic, target: dynamic): bool {
    return hasMetadata$(metadataKey, target);
}

export function createMetaKey(): str {
    return createMetaKey$();
}

export function setMetaKey(metaId: str, target: dynamic, value: dynamic): void {
    setMetaKey$(metaId, target, value);
}

export function getMetaKey(metaId: str, target: dynamic): dynamic {
    return getMetaKey$(metaId, target);
}

export function hasMetaKey(metaId: str, target: dynamic): bool {
    return hasMetaKey$(metaId, target);
}

export function getMetadataKeys(target: dynamic): dynamic[] {
    return [];
}

export class MetaKey<T = dynamic> {
    private metaId: str;

    constructor(metaId: str) {
        this.metaId = metaId;
    }

    static create<R>(): MetaKey<R> {
        let id = createMetaKey();
        return new MetaKey<R>(id);
    }

    set(target: dynamic, value: T): void {
        setMetaKey(this.metaId, target, value);
    }

    get(target: dynamic): T? {
        let val = getMetaKey(this.metaId, target);
        return val as T;
    }

    has(target: dynamic): bool {
        return hasMetaKey(this.metaId, target);
    }

    keys(target: dynamic): dynamic[] {
        return [];
    }
}

export interface MethodContext {
    name: str;
    isStatic: bool;
    isPrivate: bool;
    kind: str;
}

export class Reflect {
    static keys(target: dynamic): str[] {
        if (target === null) return [];
        return target::keys();
    }

    static values(target: dynamic): dynamic[] {
        if (target === null) return [];
        return target::values();
    }

    static entries(target: dynamic): dynamic[] {
        if (target === null) return [];
        return target::entries();
    }

    static hasOwn(target: dynamic, key: str): bool {
        if (target === null) return false;
        return target::hasOwn(key);
    }

    static typeOf(target: dynamic): str {
        if (target === null) return "null";
        return target::type;
    }

    static classOf(target: dynamic): dynamic {
        if (target === null) return null;
        return target::class;
    }
}

