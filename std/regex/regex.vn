import {
    compile$,
    test$,
    exec$,
    findAll$,
    replace$,
    split$,
    RegexMatch
} from "runtime:regex";

export { RegexMatch };

export class Regex {
    private handle: int;
    pattern: str;
    flags: str;

    constructor(pattern: str, flags: str = "") {
        this.pattern = pattern;
        this.flags = flags;
        this.handle = compile$(pattern, flags);
    }

    static compile(pattern: str, flags: str = ""): Regex {
        return new Regex(pattern, flags);
    }

    test(text: str): bool {
        return test$(this.handle, text);
    }

    exec(text: str): RegexMatch? {
        return exec$(this.handle, text);
    }

    findAll(text: str): RegexMatch[] {
        return findAll$(this.handle, text);
    }

    replace(text: str, replacement: str): str {
        return replace$(this.handle, text, replacement);
    }

    split(text: str): str[] {
        return split$(this.handle, text);
    }
}
