import {
    alloc$,
    fromBytes$,
    fromString$,
    len$,
    getByte$,
    setByte$,
    slice$,
    toString$
} from "runtime:buffer";

class Buffer {
    let _inner: dynamic;

    constructor(inner: dynamic) {
        this._inner = inner;
    }

    static alloc(size: int): Buffer {
        return new Buffer(alloc$(size));
    }

    static from(data: dynamic): Buffer {
        if (typeof data == "str") {
            return new Buffer(fromString$(data as str));
        }
        return new Buffer(fromBytes$(data as int[]));
    }

    get length(): int {
        return len$(this._inner);
    }

    getByte(index: int): int {
        return getByte$(this._inner, index);
    }

    setByte(index: int, value: int): void {
        setByte$(this._inner, index, value);
    }

    slice(start: int, end: int): Buffer {
        return new Buffer(slice$(this._inner, start, end));
    }

    toString(): str {
        return toString$(this._inner);
    }
}

export { Buffer };
