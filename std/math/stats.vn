import { sqrt, abs, min as lesser, max as greater } from "std:math/intrinsics";

function sortedCopy(values: float[]): float[] {
    return values.slice().sort((a: float, b: float): int => a < b ? -1 : a > b ? 1 : 0);
}

export namespace Stats {
    export function sum(values: float[]): float {
        let total = 0.0;
        let lost = 0.0;
        for (let v of values) {
            const next = total + v;
            if (abs(total) >= abs(v)) {
                lost = lost + ((total - next) + v);
            } else {
                lost = lost + ((v - next) + total);
            }
            total = next;
        }
        if (total - total !== 0.0) {
            return total;
        }
        return total + lost;
    }

    export function mean(values: float[]): float {
        if (values.length === 0) {
            throw new RangeError("Stats.mean requires at least one value");
        }
        return sum(values) / (values.length as float);
    }

    export function min(values: float[]): float {
        if (values.length === 0) {
            throw new RangeError("Stats.min requires at least one value");
        }
        let best = values[0];
        for (let v of values) {
            best = lesser(best, v);
        }
        return best;
    }

    export function max(values: float[]): float {
        if (values.length === 0) {
            throw new RangeError("Stats.max requires at least one value");
        }
        let best = values[0];
        for (let v of values) {
            best = greater(best, v);
        }
        return best;
    }

    export function variance(values: float[]): float {
        if (values.length === 0) {
            throw new RangeError("Stats.variance requires at least one value");
        }
        let avg = mean(values);
        let total = 0.0;
        for (let v of values) {
            let d = v - avg;
            total = total + d * d;
        }
        return total / (values.length as float);
    }

    export function stddev(values: float[]): float {
        return sqrt(variance(values));
    }

    export function median(values: float[]): float {
        if (values.length === 0) {
            throw new RangeError("Stats.median requires at least one value");
        }
        for (let v of values) {
            if (v !== v) {
                return v;
            }
        }
        let ordered = sortedCopy(values);
        let mid = ordered.length >> 1;
        if (ordered.length % 2 === 1) {
            return ordered[mid];
        }
        return (ordered[mid - 1] + ordered[mid]) / 2.0;
    }
}
