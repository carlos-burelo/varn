import { env$, setEnv$ } from "runtime:sys";

export namespace Env {
    export function get(key: str, defaultVal: str = ""): str {
        let v = env$(key);
        if (v.length === 0) {
            return defaultVal;
        }
        return v;
    }

    export function set(key: str, val: str): void {
        setEnv$(key, val);
    }

    export function has(key: str): bool {
        let v = env$(key);
        return v.length > 0;
    }

    export function getInt(key: str, defaultVal: int = 0): int {
        let v = env$(key);
        if (v.length === 0) return defaultVal;
        return int.parse(v);
    }

    export function getBool(key: str, defaultVal: bool = false): bool {
        let v = env$(key);
        if (v === "true" || v === "1") return true;
        if (v === "false" || v === "0") return false;
        return defaultVal;
    }

    export function parse(content: str): { [key: str]: str } {
        let result: { [key: str]: str } = {};
        let lines = content.split("\n");
        for (let line of lines) {
            let trimmed = line.trim();
            if (trimmed.length > 0 && !trimmed.startsWith("#")) {
                let eqIdx = trimmed.indexOf("=");
                if (eqIdx > 0) {
                    let key = trimmed.slice(0, eqIdx).trim();
                    let val = trimmed.slice(eqIdx + 1).trim();
                    if ((val.startsWith("\"") && val.endsWith("\"")) || (val.startsWith("'") && val.endsWith("'"))) {
                        val = val.slice(1, val.length - 1);
                    }
                    result[key] = val;
                }
            }
        }
        return result;
    }
}
