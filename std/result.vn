// std:result — Core Algebraic Data Types (Result<T, E> and Option<T>) for Varn.

export enum Result<T, E> {
    Ok(val: T),
    Err(err: E)
}

export enum Option<T> {
    Some(val: T),
    None
}

export function Ok<T, E>(val: T): Result<T, E> {
    return Result.Ok(val);
}

export function Err<T, E>(err: E): Result<T, E> {
    return Result.Err(err);
}

export function Some<T>(val: T): Option<T> {
    return Option.Some(val);
}

export const None = Option.None;

export function isOk<T, E>(res: Result<T, E>): bool {
    return match (res) {
        Ok(_) => true,
        _ => false
    };
}

export function isErr<T, E>(res: Result<T, E>): bool {
    return match (res) {
        Err(_) => true,
        _ => false
    };
}

export function unwrap<T, E>(res: Result<T, E>): T {
    return match (res) {
        Ok(v) => v,
        Err(e) => {
            throw new Error("Called unwrap on Result.Err: " + e);
        }
    };
}

export function unwrapOr<T, E>(res: Result<T, E>, defaultVal: T): T {
    return match (res) {
        Ok(v) => v,
        _ => defaultVal
    };
}

export function isSome<T>(opt: Option<T>): bool {
    return match (opt) {
        Some(_) => true,
        _ => false
    };
}

export function isNone<T>(opt: Option<T>): bool {
    return match (opt) {
        None => true,
        _ => false
    };
}

export function unwrapOpt<T>(opt: Option<T>): T {
    return match (opt) {
        Some(v) => v,
        None => {
            throw new Error("Called unwrap on Option.None");
        }
    };
}

export function unwrapOptOr<T>(opt: Option<T>, defaultVal: T): T {
    return match (opt) {
        Some(v) => v,
        _ => defaultVal
    };
}

/**
 * Runs `fn` and captures a thrown error as `Err` instead of propagating it.
 *
 * Moved here from `std:types`, which used to carry a second, incompatible
 * `Result` type. This is the one place the type is declared, so it is the one
 * place a function returning it belongs.
 */
export function tryRun<T>(fn: () => T): Result<T, Error> {
    try {
        return Ok<T, Error>(fn());
    } catch (e) {
        if (e instanceof Error) return Err<T, Error>(e);
        return Err<T, Error>(new Error("" + e.toString()));
    }
}
