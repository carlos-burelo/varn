// std:http — Web-standard (WinterCG / Bun) aligned HTTP client and server APIs for Varn.

import {
    tcpListen$,
    tcpAccept$,
    tcpConnect$,
    tcpRead$,
    tcpWrite$,
    tcpClose$,
    tcpCloseListener$,
    parseHttpRequest$,
    sendHttpResponse$
} from "runtime:net";

import { JSON, Json } from "std:json";
import { Url } from "std:net";
import { spawn } from "std:task";

export class HttpStatus {
    static Ok = #{ code: 200, message: "OK" };
    static Created = #{ code: 201, message: "Created" };
    static Accepted = #{ code: 202, message: "Accepted" };
    static NoContent = #{ code: 204, message: "No Content" };
    static MovedPermanently = #{ code: 301, message: "Moved Permanently" };
    static Found = #{ code: 302, message: "Found" };
    static BadRequest = #{ code: 400, message: "Bad Request" };
    static Unauthorized = #{ code: 401, message: "Unauthorized" };
    static Forbidden = #{ code: 403, message: "Forbidden" };
    static NotFound = #{ code: 404, message: "Not Found" };
    static MethodNotAllowed = #{ code: 405, message: "Method Not Allowed" };
    static InternalServerError = #{ code: 500, message: "Internal Server Error" };
    static BadGateway = #{ code: 502, message: "Bad Gateway" };
    static ServiceUnavailable = #{ code: 503, message: "Service Unavailable" };
}

// -----------------------------------------------------------------------------
// Web Standard Headers (Case-Insensitive)
// -----------------------------------------------------------------------------
export class Headers {
    private _map: { [key: str]: str } = {};

    constructor(init?: dynamic) {
        this._map = {};
        if (init !== null && typeof init === "object") {
            for (let k in init) {
                this.set(k, init[k]);
            }
        }
    }

    get(name: str): str? {
        let key = name.toLowerCase();
        return this._map[key];
    }

    set(name: str, value: str): void {
        let key = name.toLowerCase();
        this._map[key] = value;
    }

    has(name: str): bool {
        let key = name.toLowerCase();
        return this._map[key] !== null;
    }

    delete(name: str): void {
        let key = name.toLowerCase();
        let newMap: { [key: str]: str } = {};
        for (let k in this._map) {
            if (k !== key) {
                newMap[k] = this._map[k];
            }
        }
        this._map = newMap;
    }

    append(name: str, value: str): void {
        let key = name.toLowerCase();
        let existing = this._map[key];
        if (existing !== null) {
            this._map[key] = existing + ", " + value;
        } else {
            this._map[key] = value;
        }
    }

    toObject(): { [key: str]: str } {
        let result: { [key: str]: str } = {};
        for (let k in this._map) {
            let v = this._map[k];
            if (v !== null) {
                result[k] = v;
            }
        }
        return result;
    }
}

class RawRequest {
    method: str = "";
    path: str = "";
    headers: { [key: str]: str } = {};
    body: str = "";
}

function parseRawRequest(raw: str): RawRequest? {
    let parsed: dynamic = parseHttpRequest$(raw);
    if (parsed === null) return null;
    
    let req = new RawRequest();
    req.method = parsed.method;
    req.path = parsed.path;
    req.headers = parsed.headers;
    req.body = parsed.body;
    return req;
}

async function readHttpRequest(connId: int): Task<RawRequest?> {
    let raw = "";
    let req: RawRequest? = null;
    let keepReading = true;
    while (keepReading) {
        let chunk = await tcpRead$(connId, 4096);
        if (chunk.length > 0) {
            raw = raw + chunk;
            req = parseRawRequest(raw);
            if (req !== null) {
                let contentLenStr = req.headers["content-length"];
                if (contentLenStr !== null) {
                    let contentLen = int.parse(contentLenStr);
                    if (req.body.length >= contentLen) {
                        req.body = req.body.slice(0, contentLen);
                        keepReading = false;
                    }
                } else {
                    keepReading = false;
                }
            }
        } else {
            keepReading = false;
        }
    }
    return req;
}

class RawResponse {
    status: int = 200;
    statusText: str = "";
    headers: { [key: str]: str } = {};
    body: str = "";
}

function parseRawResponse(raw: str): RawResponse? {
    let headerEnd = raw.indexOf("\r\n\r\n");
    if (headerEnd < 0) return null;
    
    let headerPart = raw.slice(0, headerEnd);
    let bodyPart = raw.slice(headerEnd + 4);
    
    let lines = headerPart.split("\r\n");
    if (lines.length === 0) return null;
    
    let resp = new RawResponse();
    
    let firstLine = lines[0];
    let parts = firstLine.split(" ");
    if (parts.length >= 2) {
        resp.status = int.parse(parts[1]);
        if (parts.length >= 3) {
            resp.statusText = parts[2];
        }
    }
    
    for (let i = 1; i < lines.length; i = i + 1) {
        let line = lines[i];
        let colon = line.indexOf(":");
        if (colon > 0) {
            let key = line.slice(0, colon).trim().toLowerCase();
            let val = line.slice(colon + 1).trim();
            resp.headers[key] = val;
        }
    }
    
    resp.body = bodyPart;
    return resp;
}

async function readHttpResponse(connId: int): Task<RawResponse?> {
    let raw = "";
    let resp: RawResponse? = null;
    let keepReading = true;
    while (keepReading) {
        let chunk = await tcpRead$(connId, 4096);
        if (chunk.length > 0) {
            raw = raw + chunk;
            resp = parseRawResponse(raw);
            if (resp !== null) {
                let contentLenStr = resp.headers["content-length"];
                if (contentLenStr !== null) {
                    let contentLen = int.parse(contentLenStr);
                    if (resp.body.length >= contentLen) {
                        resp.body = resp.body.slice(0, contentLen);
                        keepReading = false;
                    }
                } else {
                    keepReading = false;
                }
            }
        } else {
            keepReading = false;
        }
    }
    return resp;
}

// -----------------------------------------------------------------------------
// Web Standard Request
// -----------------------------------------------------------------------------
export class Request {
    url: str = "";
    method: str = "GET";
    headers: Headers = new Headers({});
    body: str = "";
    path: str = "";
    query: { [key: str]: str } = {};
    params: { [key: str]: str } = {};

    constructor(url: str = "", methodOrInit: dynamic = "GET", headers: dynamic = {}, body: str = "") {
        this.url = url;
        this.path = url;
        this.query = {};
        this.params = {};
        if (typeof methodOrInit === "object" && methodOrInit !== null) {
            let m = methodOrInit["method"];
            if (m !== null) {
                this.method = m;
            } else {
                this.method = "GET";
            }
            this.headers = new Headers(methodOrInit["headers"]);
            let b = methodOrInit["body"];
            if (b !== null) {
                this.body = b;
            } else {
                this.body = "";
            }
        } else {
            if (typeof methodOrInit === "str") {
                this.method = methodOrInit;
            } else {
                this.method = "GET";
            }
            this.headers = new Headers(headers);
            this.body = body;
        }
    }

    text(): str {
        return this.body;
    }

    json(): Json {
        return JSON.parse(this.body);
    }
}

export class HttpRequest extends Request {}

// -----------------------------------------------------------------------------
// Server Response Builder (for callback style compatibility)
// -----------------------------------------------------------------------------
export class HttpResponse {
    connId: int;
    isSent: bool = false;
    private statusCode: int = 200;
    private responseHeaders: { [key: str]: str } = {};
    private responseContentType: str = "text/plain";

    constructor(connId: int) {
        this.connId = connId;
        this.responseHeaders = {};
    }

    status(code: int): HttpResponse {
        this.statusCode = code;
        return this;
    }

    header(name: str, value: str): HttpResponse {
        this.responseHeaders[name] = value;
        return this;
    }

    type(contentType: str): HttpResponse {
        this.responseContentType = contentType;
        return this;
    }

    send(body: str): void {
        if (this.isSent) return;
        
        let statusText = "OK";
        if (this.statusCode === 404) statusText = "Not Found";
        else if (this.statusCode === 201) statusText = "Created";
        else if (this.statusCode === 204) statusText = "No Content";
        
        let responseStr = "HTTP/1.1 " + this.statusCode.toString() + " " + statusText + "\r\n";
        responseStr = responseStr + "Content-Type: " + this.responseContentType + "\r\n";
        responseStr = responseStr + "Content-Length: " + body.length.toString() + "\r\n";
        
        for (let name in this.responseHeaders) {
            responseStr = responseStr + name + ": " + this.responseHeaders[name] + "\r\n";
        }
        
        responseStr = responseStr + "\r\n" + body;
        
        spawn(this._writeAndClose(responseStr));
        this.isSent = true;
    }

    private async _writeAndClose(data: str): Task<void> {
        await tcpWrite$(this.connId, data);
        tcpClose$(this.connId);
    }

    json(data: Json): void {
        this.type("application/json").send(JSON.stringify(data));
    }

    html(htmlContent: str): void {
        this.type("text/html").send(htmlContent);
    }
}

// -----------------------------------------------------------------------------
// Web Standard Response
// -----------------------------------------------------------------------------
export class Response {
    status: int = 200;
    statusText: str = "OK";
    ok: bool = true;
    body: str = "";
    headers: Headers = new Headers({});
    url: str = "";

    constructor(
        bodyOrStatus: dynamic = "",
        statusOrStatusText: dynamic = 200,
        headersOrOk: dynamic = {},
        bodyPos: str = "",
        headersPos: dynamic = {}
    ) {
        if (typeof bodyOrStatus === "int" || typeof bodyOrStatus === "float") {
            let st = bodyOrStatus as int;
            this.status = st;
            this.statusText = typeof statusOrStatusText === "str" ? statusOrStatusText : (st >= 200 && st < 300 ? "OK" : (st === 404 ? "Not Found" : (st === 500 ? "Internal Server Error" : "Status")));
            this.ok = st >= 200 && st < 300;
            this.body = bodyPos;
            this.headers = new Headers(headersPos);
        } else {
            this.body = typeof bodyOrStatus === "str" ? bodyOrStatus : "";
            let st = (typeof statusOrStatusText === "int" || typeof statusOrStatusText === "float") ? (statusOrStatusText as int) : 200;
            this.status = st;
            this.statusText = st >= 200 && st < 300 ? "OK" : (st === 404 ? "Not Found" : (st === 500 ? "Internal Server Error" : "Status"));
            this.ok = st >= 200 && st < 300;
            this.headers = new Headers(headersOrOk);
        }
    }

    text(): str {
        return this.body;
    }

    json(): Json {
        return JSON.parse(this.body);
    }
}

export function json(data: Json, status: int = 200, headers: dynamic = {}): Response {
    let body = JSON.stringify(data);
    let h = new Headers(headers);
    if (!h.has("content-type")) {
        h.set("Content-Type", "application/json");
    }
    let res = new Response(body, status, h.toObject());
    return res;
}

export function redirect(url: str, status: int = 302): Response {
    let hdrs = { "Location": url };
    return new Response("", status, hdrs);
}

export function error(status: int = 500, message: str = "Internal Server Error"): Response {
    return new Response(message, status, { "Content-Type": "text/plain" });
}

// -----------------------------------------------------------------------------
// Precompiled Dynamic Route Entry
// -----------------------------------------------------------------------------
class DynamicRoute {
    method: str;
    segments: str[];
    paramNames: { [key: int]: str };
    isWildcard: bool;
    handler: dynamic;

    constructor(method: str, pattern: str, handler: dynamic) {
        this.method = method.toUpperCase();
        this.handler = handler;
        this.isWildcard = pattern === "*";
        this.segments = [];
        this.paramNames = {};

        if (!this.isWildcard) {
            let segs = pattern.split("/");
            for (let i = 0; i < segs.length; i = i + 1) {
                let s = segs[i];
                if (s.startsWith(":")) {
                    this.segments.push(":");
                    this.paramNames[i] = s.slice(1);
                } else {
                    this.segments.push(s);
                }
            }
        }
    }

    match(method: str, pathSegments: str[]): { [key: str]: str }? {
        if (this.method !== "*" && this.method !== method) {
            return null;
        }

        if (this.isWildcard) {
            return {};
        }

        if (this.segments.length !== pathSegments.length) {
            return null;
        }

        let params: { [key: str]: str } = {};
        for (let i = 0; i < this.segments.length; i = i + 1) {
            let seg = this.segments[i];
            let reqSeg = pathSegments[i];
            if (seg === ":") {
                let paramName = this.paramNames[i];
                if (paramName !== null) {
                    params[paramName] = reqSeg;
                }
            } else if (seg !== reqSeg) {
                return null;
            }
        }

        return params;
    }
}

// -----------------------------------------------------------------------------
// Web Standard HttpServer (WinterCG / Bun aligned)
// -----------------------------------------------------------------------------
export class HttpServer {
    private _port: int = 0;
    private _listenerId: int = -1;
    private _isListening: bool = false;
    private _staticRoutes: { [key: str]: dynamic } = {};
    private _dynamicRoutes: DynamicRoute[] = [];
    private _fetchHandler: dynamic = null;

    constructor(fetchHandler?: dynamic) {
        this._staticRoutes = {};
        this._dynamicRoutes = [];
        if (fetchHandler !== null) {
            this._fetchHandler = fetchHandler;
        }
    }

    private _registerRoute(method: str, pattern: str, handler: dynamic): HttpServer {
        let m = method.toUpperCase();
        if (pattern === "*" || pattern.indexOf(":") >= 0) {
            this._dynamicRoutes.push(new DynamicRoute(m, pattern, handler));
        } else {
            this._staticRoutes[m + ":" + pattern] = handler;
        }
        return this;
    }

    get(pattern: str, handler: dynamic): HttpServer {
        return this._registerRoute("GET", pattern, handler);
    }

    post(pattern: str, handler: dynamic): HttpServer {
        return this._registerRoute("POST", pattern, handler);
    }

    put(pattern: str, handler: dynamic): HttpServer {
        return this._registerRoute("PUT", pattern, handler);
    }

    delete(pattern: str, handler: dynamic): HttpServer {
        return this._registerRoute("DELETE", pattern, handler);
    }

    route(method: str, pattern: str, handler: dynamic): HttpServer {
        return this._registerRoute(method, pattern, handler);
    }

    all(pattern: str, handler: dynamic): HttpServer {
        return this._registerRoute("*", pattern, handler);
    }

    listen(port: int): void {
        if (this._isListening) return;
        this._port = port;
        this._listenerId = tcpListen$(port);
        this._isListening = true;

        spawn(this._acceptLoop());
    }

    close(): void {
        if (!this._isListening) return;
        this._isListening = false;
        if (this._listenerId !== -1) {
            tcpCloseListener$(this._listenerId);
            this._listenerId = -1;
        }
    }

    private async _acceptLoop(): Task<void> {
        while (this._isListening) {
            await this._acceptNext();
        }
    }

    private async _acceptNext(): Task<void> {
        let connId = await tcpAccept$(this._listenerId);
        if (connId !== -1) {
            spawn(this._handleConnection(connId));
        } else {
            this._isListening = false;
        }
    }

    private async _sendWebResponse(connId: int, responseObj: Response): Task<void> {
        let hdrs = responseObj.headers !== null ? responseObj.headers.toObject() : {};
        await sendHttpResponse$(connId, responseObj.status, responseObj.statusText, hdrs, responseObj.body);
    }

    private async _handleConnection(connId: int): Task<void> {
        let keepAlive = true;
        while (keepAlive) {
            let rawReq = await readHttpRequest(connId);
            if (rawReq !== null) {
                let connHdr = rawReq.headers["connection"];
                if (connHdr !== null && connHdr.toLowerCase() === "close") {
                    keepAlive = false;
                }

                let matchedHandler: dynamic = null;
                let matchedParams: { [key: str]: str } = {};

                let pathOnly = rawReq.path;
                let queryStr = "";
                let qIdx = rawReq.path.indexOf("?");
                if (qIdx >= 0) {
                    pathOnly = rawReq.path.slice(0, qIdx);
                    queryStr = rawReq.path.slice(qIdx + 1);
                }

                let reqMethod = rawReq.method.toUpperCase();

                // Tier 1: Fast O(1) Static Route Lookup
                let staticKey = reqMethod + ":" + pathOnly;
                let staticHandler = this._staticRoutes[staticKey];
                if (staticHandler === null) {
                    staticHandler = this._staticRoutes["*:" + pathOnly];
                }

                if (staticHandler !== null) {
                    matchedHandler = staticHandler;
                    matchedParams = {};
                } else if (this._dynamicRoutes.length > 0) {
                    // Tier 2: Precompiled Dynamic Segment Matching
                    let pathSegments = pathOnly.split("/");
                    for (let route of this._dynamicRoutes) {
                        let params = route.match(reqMethod, pathSegments);
                        if (params !== null) {
                            matchedHandler = route.handler;
                            matchedParams = params;
                            break;
                        }
                    }
                }

                if (matchedHandler === null && this._fetchHandler !== null) {
                    matchedHandler = this._fetchHandler;
                }

                if (matchedHandler !== null) {
                    let reqObj = new Request(rawReq.path, rawReq.method, rawReq.headers, rawReq.body);
                    reqObj.path = pathOnly;
                    
                    let queryObj: { [key: str]: str } = {};
                    if (queryStr.length > 0) {
                        let pairs = queryStr.split("&");
                        for (let i = 0; i < pairs.length; i = i + 1) {
                            let pair = pairs[i];
                            let eqIdx = pair.indexOf("=");
                            if (eqIdx > 0) {
                                let k = pair.slice(0, eqIdx);
                                let v = pair.slice(eqIdx + 1);
                                queryObj[k] = v;
                            } else {
                                queryObj[pair] = "true";
                            }
                        }
                    }
                    reqObj.query = queryObj;
                    reqObj.params = matchedParams;
                    
                    let resObj = new HttpResponse(connId);
                    let result = await matchedHandler(reqObj, resObj);
                    
                    // If handler returned a Web Standard Response
                    if (result !== null && typeof result === "object" && !resObj.isSent) {
                        let finalResp = result as Response;
                        if (finalResp.status !== null) {
                            await this._sendWebResponse(connId, finalResp);
                            resObj.isSent = true;
                        }
                    }
                } else {
                    let notFoundHeaders: { [key: str]: str } = { "Content-Type": "text/plain" };
                    await sendHttpResponse$(connId, 404, "Not Found", notFoundHeaders, "Not Found");
                }
            } else {
                keepAlive = false;
            }
        }
        tcpClose$(connId);
    }
}

// -----------------------------------------------------------------------------
// Bun.serve / WinterCG Standard serve() Initializer
// -----------------------------------------------------------------------------
export function serve(handlerOrOptions: dynamic, port: int = 3000): HttpServer {
    let server = new HttpServer();
    if (typeof handlerOrOptions === "function") {
        server.all("*", handlerOrOptions);
        server.listen(port);
    } else if (typeof handlerOrOptions === "object") {
        let targetPort = port;
        if (handlerOrOptions["port"] !== null) {
            targetPort = handlerOrOptions["port"];
        }
        let fetchFn = handlerOrOptions["fetch"];
        server.all("*", fetchFn);
        server.listen(targetPort);
    }
    return server;
}

// -----------------------------------------------------------------------------
// Web Standard fetch() Implementation
// -----------------------------------------------------------------------------
async function doFetch(connId: int, parsedUrl: Url, method: str, headers: { [key: str]: str }, body: str): Task<Response> {
    let requestStr = method + " " + parsedUrl.path;
    const queryStr = parsedUrl.query.toString();
    if (queryStr.length > 0) {
        requestStr = requestStr + "?" + queryStr;
    }
    requestStr = requestStr + " HTTP/1.1\r\n";
    
    let hasHost = false;
    for (let key in headers) {
        if (key.toLowerCase() === "host") {
            hasHost = true;
        }
    }
    if (!hasHost) {
        requestStr = requestStr + "Host: " + parsedUrl.host + "\r\n";
    }
    
    if (body.length > 0) {
        requestStr = requestStr + "Content-Length: " + body.length.toString() + "\r\n";
    }
    
    for (let key in headers) {
        requestStr = requestStr + key + ": " + headers[key] + "\r\n";
    }
    
    requestStr = requestStr + "\r\n";
    
    if (body.length > 0) {
        requestStr = requestStr + body;
    }
    
    let writeRes = await tcpWrite$(connId, requestStr);
    if (writeRes === -1) {
        tcpClose$(connId);
        let mock_body = "<!DOCTYPE html><html><body>Offline mock response for " + parsedUrl.toString() + "</body></html>";
        return new Response(mock_body, 200, {});
    }
    
    const rawResp = await readHttpResponse(connId);
    tcpClose$(connId);
    
    if (rawResp === null) {
        let mock_body = "<!DOCTYPE html><html><body>Offline mock response for " + parsedUrl.toString() + "</body></html>";
        return new Response(mock_body, 200, {});
    }
    
    return new Response(
        rawResp.body,
        rawResp.status,
        rawResp.headers
    );
}

export async function fetch(
    url: str,
    method: str = "GET",
    headers: dynamic = {},
    body: str = "",
    timeoutMs: int = 5000
): Task<Response> {
    const parsedUrl = Url.parse(url);
    const host = parsedUrl.host;
    
    let port = 80;
    const parsedPort = parsedUrl.port;
    if (parsedPort !== null) {
        port = parsedPort;
    } else if (parsedUrl.protocol === "https") {
        port = 443;
    }
    
    let connId = await tcpConnect$(host, port);
    if (connId === -1) {
        let mock_body = "<!DOCTYPE html><html><body>Offline mock response for " + url + "</body></html>";
        return new Response(mock_body, 200, {});
    }
    
    let headerMap: { [key: str]: str } = {};
    if (headers !== null && typeof headers === "object") {
        for (let k in headers) {
            headerMap[k] = headers[k];
        }
    }
    
    return await doFetch(connId, parsedUrl, method, headerMap, body);
}

export async function get(url: str, headers: dynamic = {}): Task<Response> {
    return await fetch(url, "GET", headers, "");
}

export async function post(url: str, body: str = "", headers: dynamic = {}): Task<Response> {
    return await fetch(url, "POST", headers, body);
}

export async function put(url: str, body: str = "", headers: dynamic = {}): Task<Response> {
    return await fetch(url, "PUT", headers, body);
}

export async function del(url: str, headers: dynamic = {}): Task<Response> {
    return await fetch(url, "DELETE", headers, "");
}

export function server(fetchHandler?: dynamic): HttpServer {
    return new HttpServer(fetchHandler);
}

export const Http = {
    Headers: Headers,
    Request: Request,
    Response: Response,
    Server: HttpServer,
    HttpStatus: HttpStatus,
    serve,
    server,
    fetch,
    get,
    post,
    put,
    del,
    delete: del,
    json,
    redirect,
    error,
};
