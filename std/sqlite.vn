import {
    open$,
    close$,
    exec$,
    queryAll$,
    queryOne$
} from "runtime:sqlite";

export class Database {
    private _id: int = -1;
    private _isOpen: bool = false;

    constructor(path: str = ":memory:") {
        this._id = open$(path);
        this._isOpen = this._id >= 0;
    }

    exec(sql: str): int {
        if (!this._isOpen) return 0;
        return exec$(this._id, sql);
    }

    all(sql: str, ...params: dynamic[]): dynamic[] {
        if (!this._isOpen) return [];
        return queryAll$(this._id, sql, params);
    }

    get(sql: str, ...params: dynamic[]): dynamic? {
        if (!this._isOpen) return null;
        return queryOne$(this._id, sql, params);
    }

    sql(strings: str[], ...values: dynamic[]): dynamic[] {
        if (!this._isOpen) return [];
        let query = "";
        for (let i = 0; i < strings.length; i = i + 1) {
            query = query + strings[i];
            if (i < values.length) {
                query = query + "?";
            }
        }
        return queryAll$(this._id, query, values);
    }

    sqlOne(strings: str[], ...values: dynamic[]): dynamic? {
        if (!this._isOpen) return null;
        let query = "";
        for (let i = 0; i < strings.length; i = i + 1) {
            query = query + strings[i];
            if (i < values.length) {
                query = query + "?";
            }
        }
        return queryOne$(this._id, query, values);
    }

    run(sql: str, ...params: dynamic[]): int {
        if (!this._isOpen) return 0;
        let res = queryAll$(this._id, sql, params);
        return 1;
    }

    close(): void {
        if (this._isOpen) {
            close$(this._id);
            this._isOpen = false;
            this._id = -1;
        }
    }
}
