import {
    gzip$,
    gunzip$,
    deflate$,
    inflate$,
    tarCreate$,
    tarExtract$,
    zipCreate$,
    zipExtract$
} from "runtime:compress";

export namespace Compress {
    export function gzip(data: str): int[] {
        return gzip$(data);
    }

    export function gunzip(bytes: int[]): str {
        return gunzip$(bytes);
    }

    export function deflate(data: str): int[] {
        return deflate$(data);
    }

    export function inflate(bytes: int[]): str {
        return inflate$(bytes);
    }
}

export namespace Tar {
    export function create(sourceDir: str, tarPath: str): bool {
        return tarCreate$(sourceDir, tarPath);
    }

    export function extract(tarPath: str, destDir: str): bool {
        return tarExtract$(tarPath, destDir);
    }
}

export namespace Zip {
    export function create(sourceDir: str, zipPath: str): bool {
        return zipCreate$(sourceDir, zipPath);
    }

    export function extract(zipPath: str, destDir: str): bool {
        return zipExtract$(zipPath, destDir);
    }
}
