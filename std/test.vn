import { assert as nativeAssert, assertEqual as nativeAssertEqual, summary as nativeSummary } from "runtime:testing";

export function assert(label: str, condition: bool): void {
    nativeAssert(label, condition);
}

export function assertEqual<T>(actual: T, expected: T, message?: str): void {
    nativeAssertEqual(actual, expected, message);
}

export function assertTrue(cond: bool, message?: str): void {
    nativeAssert(message ?? "assertTrue", cond);
}

export function summary(): void {
    nativeSummary();
}

const testImpl = {
    assert: assert,
    assertEqual: assertEqual,
    assertTrue: assertTrue,
    summary: summary
};

export const test = testImpl;

// Top-level convenience exports
export const fail = (msg?: str) => assert(msg ?? "fail", false);
