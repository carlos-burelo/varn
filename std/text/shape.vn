import {
    fontCount$,
    fonts$,
    shape$,
    rasterGlyph$,
    glyphCacheSize$,
    ascent$,
    descent$,
    wrap$
} from "runtime:text";

export function fontCount(): int {
    return fontCount$();
}

export function fonts(): str[] {
    return fonts$();
}

export type ShapedRun = {
    glyphs: int[],
    advances: float[],
    clusters: int[],
    width: float,
    count: int
};

export function shape(text: str, size: float): ShapedRun {
    return shape$(text, size);
}

export function measure(text: str, size: float): float {
    return shape$(text, size).width;
}

export type RasterGlyph = {
    w: int,
    h: int,
    bx: int,
    by: int,
    advance: float,
    bitmap: Bytes
};

export function rasterGlyph(ch: str, size: float): RasterGlyph {
    return rasterGlyph$(ch, size);
}

export function glyphCacheSize(): int {
    return glyphCacheSize$();
}

export function ascent(size: float): float {
    return ascent$(size);
}

export function descent(size: float): float {
    return descent$(size);
}

export function wrap(text: str, size: float, max: float): str[] {
    return wrap$(text, size, max);
}
