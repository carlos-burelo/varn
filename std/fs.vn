import {
    read as nativeRead,
    write as nativeWrite,
    exists as nativeExists,
    stat as nativeStat,
    mkdir as nativeMkdir,
    mkdirAll as nativeMkdirAll,
    readDir as nativeReadDir,
    remove as nativeRemove,
    removeAll as nativeRemoveAll,
    rename as nativeRename,
    tempDir as nativeTempDir,
    RawStats
} from "runtime:fs";

import { Writer } from "std:io";

export class Stats {
    size: int;
    isDir: bool;
    isFile: bool;
    mtime: int;

    constructor(size: int, isDir: bool, isFile: bool, mtime: int) {
        this.size = size;
        this.isDir = isDir;
        this.isFile = isFile;
        this.mtime = mtime;
    }
}

export function read(path: str): str {
    return nativeRead(path);
}

export function write(path: str, content: str): void {
    nativeWrite(path, content);
}

export function appendText(path: str, content: str): void {
    let existing = "";
    if (nativeExists(path)) {
        existing = nativeRead(path);
    }
    nativeWrite(path, existing + content);
}

export function exists(path: str): bool {
    return nativeExists(path);
}

export function stat(path: str): Stats {
    let raw = nativeStat(path);
    return new Stats(
        raw.size,
        raw.isDir,
        raw.isFile,
        raw.mtime
    );
}

export function mkdir(path: str): void {
    nativeMkdir(path);
}

export function mkdirAll(path: str): void {
    nativeMkdirAll(path);
}

export function readDir(path: str): str[] {
    return nativeReadDir(path) as str[];
}

export function remove(path: str): void {
    nativeRemove(path);
}

export function removeAll(path: str): void {
    nativeRemoveAll(path);
}

export function rename(from: str, to: str): void {
    nativeRename(from, to);
}

export function copy(from: str, to: str): void {
    let content = nativeRead(from);
    nativeWrite(to, content);
}

export function tempDir(): str {
    return nativeTempDir();
}

export class File {
    private _path: str;
    private _mode: str;

    constructor(path: str, mode: str) {
        this._path = path;
        this._mode = mode;
    }

    static open(path: str, mode: str): File {
        return new File(path, mode);
    }

    write(content: str): void {
        if (this._mode === "a") {
            const existing = nativeExists(this._path) ? nativeRead(this._path) : "";
            nativeWrite(this._path, existing + content);
        } else {
            nativeWrite(this._path, content);
        }
    }

    read(size?: int): str {
        return nativeRead(this._path);
    }

    readAll(): str {
        return nativeRead(this._path);
    }

    pipeTo(dst: Writer): void {
        const content = this.readAll();
        dst.write(content);
    }

    dispose(): void {}
}
