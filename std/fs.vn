import {
    open as nativeOpen,
    readFd as nativeReadFd,
    writeFd as nativeWriteFd,
    seek as nativeSeek,
    close as nativeClose,
    exists as nativeExists,
    stat as nativeStat,
    mkdir as nativeMkdir,
    mkdirAll as nativeMkdirAll,
    readDir as nativeReadDir,
    remove as nativeRemove,
    removeAll as nativeRemoveAll,
    rename as nativeRename,
    tempDir as nativeTempDir,
    RawStats
} from "runtime:fs";

import { Writer } from "std:io";

export class Stats {
    size: int;
    isDir: bool;
    isFile: bool;
    mtime: int;

    constructor(size: int, isDir: bool, isFile: bool, mtime: int) {
        this.size = size;
        this.isDir = isDir;
        this.isFile = isFile;
        this.mtime = mtime;
    }
}

export function read(path: str): str {
    let file = File.open(path, "r");
    let content = file.readAll();
    file.close();
    return content;
}

export function write(path: str, content: str): void {
    let file = File.open(path, "w");
    file.write(content);
    file.close();
}

export function appendText(path: str, content: str): void {
    let file = File.open(path, "a");
    file.write(content);
    file.close();
}

export function exists(path: str): bool {
    return nativeExists(path);
}

export function stat(path: str): Stats {
    let raw = nativeStat(path);
    return new Stats(
        raw.size,
        raw.isDir,
        raw.isFile,
        raw.mtime
    );
}

export function mkdir(path: str): void {
    nativeMkdir(path);
}

export function mkdirAll(path: str): void {
    nativeMkdirAll(path);
}

export function readDir(path: str): str[] {
    return nativeReadDir(path) as str[];
}

export function remove(path: str): void {
    nativeRemove(path);
}

export function removeAll(path: str): void {
    nativeRemoveAll(path);
}

export function rename(from: str, to: str): void {
    nativeRename(from, to);
}

export function copy(from: str, to: str): void {
    let src = File.open(from, "r");
    let dst = File.open(to, "w");
    let keepCopying = true;
    while (keepCopying) {
        let chunk = src.read(8192);
        if (chunk.length > 0) {
            dst.write(chunk);
        } else {
            keepCopying = false;
        }
    }
    src.close();
    dst.close();
}

export function tempDir(): str {
    return nativeTempDir();
}

export class File {
    private _fd: int;
    private _path: str;
    private _mode: str;

    constructor(fd: int, path: str, mode: str) {
        this._fd = fd;
        this._path = path;
        this._mode = mode;
    }

    static open(path: str, mode: str): File {
        let fd = nativeOpen(path, mode);
        return new File(fd, path, mode);
    }

    write(content: str): int {
        return nativeWriteFd(this._fd, content);
    }

    read(size?: int): str {
        let readSize = size ?? 4096;
        return nativeReadFd(this._fd, readSize);
    }

    readAll(): str {
        let out = "";
        let keepReading = true;
        while (keepReading) {
            let chunk = nativeReadFd(this._fd, 8192);
            if (chunk.length > 0) {
                out = out + chunk;
            } else {
                keepReading = false;
            }
        }
        return out;
    }

    seek(offset: int, whence: int): int {
        return nativeSeek(this._fd, offset, whence);
    }

    close(): void {
        nativeClose(this._fd);
    }

    pipeTo(dst: Writer): void {
        let keepReading = true;
        while (keepReading) {
            let chunk = nativeReadFd(this._fd, 8192);
            if (chunk.length > 0) {
                dst.write(chunk);
            } else {
                keepReading = false;
            }
        }
    }

    dispose(): void {
        this.close();
    }
}
