import {
    open$,
    readFd$,
    writeFd$,
    seek$,
    close$,
    exists$,
    stat$,
    mkdir$,
    mkdirAll$,
    readDir$,
    remove$,
    removeAll$,
    rename$,
    tempDir$,
    RawStats
} from "runtime:fs";

import { Writer } from "std:io";

export class Stats {
    size: int;
    isDir: bool;
    isFile: bool;
    mtime: int;

    constructor(size: int, isDir: bool, isFile: bool, mtime: int) {
        this.size = size;
        this.isDir = isDir;
        this.isFile = isFile;
        this.mtime = mtime;
    }
}

export function read(path: str): str {
    let file = File.open(path, "r");
    let content = file.readAll();
    file.close();
    return content;
}

export function write(path: str, content: str): void {
    let file = File.open(path, "w");
    file.write(content);
    file.close();
}

export function appendText(path: str, content: str): void {
    let file = File.open(path, "a");
    file.write(content);
    file.close();
}

export function exists(path: str): bool {
    return exists$(path);
}

export function stat(path: str): Stats {
    let raw = stat$(path);
    return new Stats(
        raw.size,
        raw.isDir,
        raw.isFile,
        raw.mtime
    );
}

export function mkdir(path: str): void {
    mkdir$(path);
}

export function mkdirAll(path: str): void {
    mkdirAll$(path);
}

export function readDir(path: str): str[] {
    return readDir$(path) as str[];
}

export function remove(path: str): void {
    remove$(path);
}

export function removeAll(path: str): void {
    removeAll$(path);
}

export function rename(from: str, to: str): void {
    rename$(from, to);
}

export function copy(from: str, to: str): void {
    let src = File.open(from, "r");
    let dst = File.open(to, "w");
    let keepCopying = true;
    while (keepCopying) {
        let chunk = src.read(8192);
        if (chunk.length > 0) {
            dst.write(chunk);
        } else {
            keepCopying = false;
        }
    }
    src.close();
    dst.close();
}

export function tempDir(): str {
    return tempDir$();
}

export class File {
    private _fd: int;
    private _path: str;
    private _mode: str;

    constructor(fd: int, path: str, mode: str) {
        this._fd = fd;
        this._path = path;
        this._mode = mode;
    }

    static open(path: str, mode: str): File {
        let fd = open$(path, mode);
        return new File(fd, path, mode);
    }

    write(content: str): int {
        return writeFd$(this._fd, content);
    }

    read(size?: int): str {
        let readSize = size ?? 4096;
        return readFd$(this._fd, readSize);
    }

    readAll(): str {
        let out = "";
        let keepReading = true;
        while (keepReading) {
            let chunk = readFd$(this._fd, 8192);
            if (chunk.length > 0) {
                out = out + chunk;
            } else {
                keepReading = false;
            }
        }
        return out;
    }

    seek(offset: int, whence: int): int {
        return seek$(this._fd, offset, whence);
    }

    close(): void {
        close$(this._fd);
    }

    pipeTo(dst: Writer): void {
        let keepReading = true;
        while (keepReading) {
            let chunk = readFd$(this._fd, 8192);
            if (chunk.length > 0) {
                dst.write(chunk);
            } else {
                keepReading = false;
            }
        }
    }

    dispose(): void {
        this.close();
    }
}

export function readLines(path: str): str[] {
    let content = read(path);
    let lines = content.split("\n");
    let result: str[] = [];
    for (let line of lines) {
        if (line.endsWith("\r")) {
            result.push(line.slice(0, line.length - 1));
        } else {
            result.push(line);
        }
    }
    return result;
}
