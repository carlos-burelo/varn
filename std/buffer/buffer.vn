export class Buffer {
    let _inner: Bytes;

    constructor(inner: Bytes) {
        this._inner = inner;
    }

    static alloc(size: int): Buffer {
        return new Buffer(Bytes.alloc(size));
    }

    static from(data: dynamic): Buffer {
        return new Buffer(Bytes.from(data));
    }

    get length(): int {
        return this._inner.length;
    }

    getByte(index: int): int {
        return this._inner.getByte(index);
    }

    setByte(index: int, value: int): void {
        this._inner.setByte(index, value);
    }

    slice(start: int, end: int): Buffer {
        return new Buffer(this._inner.slice(start, end));
    }

    toString(): str {
        return this._inner.toString();
    }
}
