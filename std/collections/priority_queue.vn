export class PriorityQueue<T> {
    private _heap: T[];
    private _comparator: (a: T, b: T) => int;

    constructor(comparator?: (a: T, b: T) => int) {
        this._heap = [];
        this._comparator = comparator ?? ((first: T, second: T): int => {
            if (first < second) {
                return -1;
            }
            if (first > second) {
                return 1;
            }
            return 0;
        });
    }

    push(item: T): void {
        this._heap.push(item);
        this._siftUp(this._heap.length - 1);
    }

    pop(): T? {
        if (this._heap.length === 0) {
            return null;
        }
        let top = this._heap[0];
        let last = this._heap.pop();
        if (this._heap.length > 0 && last !== null) {
            this._heap[0] = last;
            this._siftDown(0);
        }
        return top;
    }

    peek(): T? {
        if (this._heap.length === 0) {
            return null;
        }
        return this._heap[0];
    }

    get size(): int {
        return this._heap.length;
    }

    get isEmpty(): bool {
        return this._heap.length === 0;
    }

    clear(): void {
        this._heap = [];
    }

    toArray(): T[] {
        return this._heap.slice();
    }

    private _siftUp(index: int): void {
        let current = index;
        while (current > 0) {
            let parent: int = ((current - 1) / 2) as int;
            if (this._comparator(this._heap[current], this._heap[parent]) < 0) {
                let temp = this._heap[current];
                this._heap[current] = this._heap[parent];
                this._heap[parent] = temp;
                current = parent;
            } else {
                break;
            }
        }
    }

    private _siftDown(index: int): void {
        let length = this._heap.length;
        let current = index;

        while (true) {
            let left = 2 * current + 1;
            let right = 2 * current + 2;
            let smallest = current;

            if (left < length && this._comparator(this._heap[left], this._heap[smallest]) < 0) {
                smallest = left;
            }
            if (right < length && this._comparator(this._heap[right], this._heap[smallest]) < 0) {
                smallest = right;
            }

            if (smallest !== current) {
                let temp = this._heap[current];
                this._heap[current] = this._heap[smallest];
                this._heap[smallest] = temp;
                current = smallest;
            } else {
                break;
            }
        }
    }
}
