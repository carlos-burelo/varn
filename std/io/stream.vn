import { write$, writeln$, flush$, readLine$ } from "runtime:io";
import { Task } from "std:task";

export interface Writer {
    write(content: str): void;
}

export interface Reader {
    read(size?: int): str;
    readAll(): str;
    pipeTo(dst: Writer): void;
}

export interface AsyncReader {
    read(size?: int): Task<Bytes?>;
}

export interface AsyncWriter {
    write(data: Bytes): Task<int>;
    flush(): Task<void>;
    close(): void;
}

export class Stream {
    static async pipe(reader: AsyncReader, writer: AsyncWriter, bufferSize: int = 8192): Task<int> {
        let total = 0;
        while (true) {
            let chunk = await reader.read(bufferSize);
            if (chunk === null) {
                break;
            }
            let b = chunk as Bytes;
            if (b.length === 0) {
                break;
            }
            let written = await writer.write(b);
            total = total + written;
        }
        await writer.flush();
        return total;
    }
}

export function write(...args: str[]): void {
    write$(...args);
}

export function writeln(...args: str[]): void {
    writeln$(...args);
}

export function print(...args: str[]): void {
    writeln$(...args);
}

export function flush(): void {
    flush$();
}

export function readLine(prompt: str = ""): str {
    return readLine$(prompt);
}

export function readAll(): str {
    return "";
}
