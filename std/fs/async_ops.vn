import {
    appendFileTextAsync$,
    copyFileAsync$,
    readDirAsync$,
    readFileBytesAsync$,
    readFileTextAsync$,
    readLinesAsync$,
    removeAllAsync$,
    writeFileBytesAsync$,
    writeFileTextAsync$
} from "runtime:fs";

import { Task } from "std:task";

export async function readBytesAsync(path: str): Task<Bytes> {
    return await readFileBytesAsync$(path);
}

export async function writeBytesAsync(path: str, data: Bytes): Task<void> {
    await writeFileBytesAsync$(path, data);
}

export async function readTextAsync(path: str): Task<str> {
    return await readFileTextAsync$(path);
}

export async function writeTextAsync(path: str, content: str): Task<void> {
    await writeFileTextAsync$(path, content);
}

export async function appendTextAsync(path: str, content: str): Task<void> {
    await appendFileTextAsync$(path, content);
}

export async function readDirAsync(path: str): Task<str[]> {
    return await readDirAsync$(path);
}

export async function removeAllAsync(path: str): Task<void> {
    await removeAllAsync$(path);
}

export async function copyAsync(from: str, to: str): Task<void> {
    await copyFileAsync$(from, to);
}

export async function readLinesAsync(path: str): Task<str[]> {
    return await readLinesAsync$(path);
}
