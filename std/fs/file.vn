import {
    open$,
    readFd$,
    readFdBytes$,
    readFdAll$,
    readFdAllBytes$,
    readFdBytesAsync$,
    readFdAllBytesAsync$,
    writeFdBytesAsync$,
    writeFd$,
    writeFdBytes$,
    seek$,
    close$,
    FileMode,
    SeekOrigin
} from "runtime:fs";

import { Writer, AsyncReader, AsyncWriter } from "std:io";

export class File {
    private _fd: int = -1;
    private _path: str;
    private _mode: FileMode;

    constructor(path: str, mode: FileMode = FileMode.Read) {
        this._path = path;
        this._mode = mode;
        this._fd = open$(path, mode);
    }

    static open(path: str, mode: FileMode): File {
        return new File(path, mode);
    }

    write(content: str): int {
        return writeFd$(this._fd, content);
    }

    writeBytes(data: Bytes): int {
        return writeFdBytes$(this._fd, data);
    }

    append(content: str): int {
        let fd = open$(this._path, FileMode.Append);
        let written = writeFd$(fd, content);
        close$(fd);
        return written;
    }

    appendBytes(data: Bytes): int {
        let fd = open$(this._path, FileMode.Append);
        let written = writeFdBytes$(fd, data);
        close$(fd);
        return written;
    }

    read(size?: int): str {
        let readSize = size ?? 4096;
        return readFd$(this._fd, readSize);
    }

    readBytes(size?: int): Bytes {
        let readSize = size ?? 4096;
        return readFdBytes$(this._fd, readSize);
    }

    readAll(): str {
        return readFdAll$(this._fd);
    }

    readAllBytes(): Bytes {
        return readFdAllBytes$(this._fd);
    }

    seek(offset: int, origin: SeekOrigin): int {
        return seek$(this._fd, offset, origin);
    }

    close(): void {
        close$(this._fd);
    }

    pipeTo(dst: Writer): void {
        dst.write(readFdAll$(this._fd));
    }

    dispose(): void {
        this.close();
    }

    stream(): FileStream {
        return new FileStream(this._path, this._mode);
    }
}

export class FileStream implements AsyncReader, AsyncWriter {
    private _fd: int = -1;
    private _path: str;
    private _mode: FileMode;

    constructor(path: str, mode: FileMode = FileMode.Read) {
        this._path = path;
        this._mode = mode;
        this._fd = open$(path, mode);
    }

    static open(path: str, mode: FileMode): FileStream {
        return new FileStream(path, mode);
    }

    async read(size?: int): Task<Bytes?> {
        let readSize = size ?? 8192;
        let b = await readFdBytesAsync$(this._fd, readSize);
        if (b.length === 0) {
            return null;
        }
        return b;
    }

    async write(data: Bytes): Task<int> {
        return await writeFdBytesAsync$(this._fd, data);
    }

    async readAll(): Task<Bytes> {
        return await readFdAllBytesAsync$(this._fd);
    }

    async pumpTo(writer: AsyncWriter): Task<int> {
        let data = await readFdAllBytesAsync$(this._fd);
        if (data.length === 0) {
            await writer.flush();
            return 0;
        }
        let written = await writer.write(data);
        await writer.flush();
        return written;
    }

    async flush(): Task<void> {}

    close(): void {
        close$(this._fd);
    }
}
