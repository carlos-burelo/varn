import {
    open$,
    readFd$,
    readFdBytes$,
    readFdAll$,
    readFdAllBytes$,
    writeFd$,
    writeFdBytes$,
    seek$,
    close$
} from "runtime:fs";

import { Writer, AsyncReader, AsyncWriter, BulkPump } from "std:io";
import { toStdError, E_FS_IO } from "std:error";

export class File {
    private _fd: int = -1;
    private _path: str;
    private _mode: str;

    constructor(path: str, mode: str = "r") {
        this._path = path;
        this._mode = mode;
        try {
            this._fd = open$(path, mode);
        } catch (e) {
            throw toStdError(e as Error, E_FS_IO);
        }
    }

    static open(path: str, mode: str): File {
        return new File(path, mode);
    }

    write(content: str): int {
        try {
            return writeFd$(this._fd, content);
        } catch (e) {
            throw toStdError(e as Error, E_FS_IO);
        }
    }

    writeBytes(data: Bytes): int {
        try {
            return writeFdBytes$(this._fd, data);
        } catch (e) {
            throw toStdError(e as Error, E_FS_IO);
        }
    }

    append(content: str): int {
        try {
            let fd = open$(this._path, "a");
            let written = writeFd$(fd, content);
            close$(fd);
            return written;
        } catch (e) {
            throw toStdError(e as Error, E_FS_IO);
        }
    }

    appendBytes(data: Bytes): int {
        try {
            let fd = open$(this._path, "a");
            let written = writeFdBytes$(fd, data);
            close$(fd);
            return written;
        } catch (e) {
            throw toStdError(e as Error, E_FS_IO);
        }
    }

    read(size?: int): str {
        try {
            let readSize = size ?? 4096;
            return readFd$(this._fd, readSize);
        } catch (e) {
            throw toStdError(e as Error, E_FS_IO);
        }
    }

    readBytes(size?: int): Bytes {
        try {
            let readSize = size ?? 4096;
            return readFdBytes$(this._fd, readSize);
        } catch (e) {
            throw toStdError(e as Error, E_FS_IO);
        }
    }

    readAll(): str {
        try {
            return readFdAll$(this._fd);
        } catch (e) {
            throw toStdError(e as Error, E_FS_IO);
        }
    }

    readAllBytes(): Bytes {
        try {
            return readFdAllBytes$(this._fd);
        } catch (e) {
            throw toStdError(e as Error, E_FS_IO);
        }
    }

    seek(offset: int, whence: int): int {
        try {
            return seek$(this._fd, offset, whence);
        } catch (e) {
            throw toStdError(e as Error, E_FS_IO);
        }
    }

    close(): void {
        try {
            close$(this._fd);
        } catch (e) {
            throw toStdError(e as Error, E_FS_IO);
        }
    }

    pipeTo(dst: Writer): void {
        try {
            dst.write(readFdAll$(this._fd));
        } catch (e) {
            throw toStdError(e as Error, E_FS_IO);
        }
    }

    dispose(): void {
        this.close();
    }

    stream(): FileStream {
        return new FileStream(this._path, this._mode);
    }
}

export class FileStream implements AsyncReader, AsyncWriter, BulkPump {
    private _fd: int = -1;
    private _path: str;
    private _mode: str;

    constructor(path: str, mode: str = "r") {
        this._path = path;
        this._mode = mode;
        try {
            this._fd = open$(path, mode);
        } catch (e) {
            throw toStdError(e as Error, E_FS_IO);
        }
    }

    static open(path: str, mode: str): FileStream {
        return new FileStream(path, mode);
    }

    async read(size?: int): Task<Bytes?> {
        try {
            let readSize = size ?? 8192;
            let b = readFdBytes$(this._fd, readSize);
            if (b.length === 0) {
                return null;
            }
            return b;
        } catch (e) {
            throw toStdError(e as Error, E_FS_IO);
        }
    }

    async write(data: Bytes): Task<int> {
        try {
            return writeFdBytes$(this._fd, data);
        } catch (e) {
            throw toStdError(e as Error, E_FS_IO);
        }
    }

    async readAll(): Task<Bytes> {
        try {
            return readFdAllBytes$(this._fd);
        } catch (e) {
            throw toStdError(e as Error, E_FS_IO);
        }
    }

    async pumpTo(writer: AsyncWriter): Task<int> {
        try {
            let data = readFdAllBytes$(this._fd);
            if (data.length === 0) {
                await writer.flush();
                return 0;
            }
            let written = await writer.write(data);
            await writer.flush();
            return written;
        } catch (e) {
            throw toStdError(e as Error, E_FS_IO);
        }
    }

    async flush(): Task<void> {}

    close(): void {
        try {
            close$(this._fd);
        } catch (e) {
            throw toStdError(e as Error, E_FS_IO);
        }
    }
}
