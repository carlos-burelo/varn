import {
    exists$,
    stat$,
    mkdir$,
    mkdirAll$,
    readDir$,
    remove$,
    removeAll$,
    rename$,
    tempDir$
} from "runtime:fs";

import { File } from "std:fs/file";
import { Stats } from "std:fs/stats";

export function read(path: str): str {
    let file = File.open(path, "r");
    let content = file.readAll();
    file.close();
    return content;
}

export function readText(path: str): str {
    return read(path);
}

export function write(path: str, content: str): void {
    let file = File.open(path, "w");
    file.write(content);
    file.close();
}

export function writeText(path: str, content: str): void {
    write(path, content);
}

export function appendText(path: str, content: str): void {
    let file = File.open(path, "a");
    file.write(content);
    file.close();
}

export function exists(path: str): bool {
    return exists$(path);
}

export function stat(path: str): Stats {
    let raw = stat$(path);
    return new Stats(
        raw.size,
        raw.isDir,
        raw.isFile,
        raw.mtime
    );
}

export function mkdir(path: str): void {
    mkdir$(path);
}

export function mkdirAll(path: str): void {
    mkdirAll$(path);
}

export function readDir(path: str): str[] {
    return readDir$(path) as str[];
}

export function remove(path: str): void {
    remove$(path);
}

export function removeAll(path: str): void {
    removeAll$(path);
}

export function rename(from: str, to: str): void {
    rename$(from, to);
}

export function copy(from: str, to: str): void {
    let src = File.open(from, "r");
    let dst = File.open(to, "w");
    let keepCopying = true;
    while (keepCopying) {
        let chunk = src.read(8192);
        if (chunk.length > 0) {
            dst.write(chunk);
        } else {
            keepCopying = false;
        }
    }
    src.close();
    dst.close();
}

export function tempDir(): str {
    return tempDir$();
}

export function readLines(path: str): str[] {
    let content = read(path);
    let lines = content.split("\n");
    let result: str[] = [];
    for (let line of lines) {
        if (line.endsWith("\r")) {
            result.push(line.slice(0, line.length - 1));
        } else {
            result.push(line);
        }
    }
    return result;
}
