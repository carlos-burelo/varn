import {
    platform$,
    cwd$,
    args$,
    exit$,
    now$
} from "runtime:sys";

export function platform(): str {
    return platform$();
}

export function cwd(): str {
    return cwd$();
}

export function args(): str[] {
    return args$();
}

export function exit(code?: int): void {
    exit$(code);
}

export type SystemInfoRecord = { platform: str, cwd: str, args: str[], now: float };

export function getSystemInfo(): SystemInfoRecord {
    return #{
        platform: platform$(),
        cwd: cwd$(),
        args: args$(),
        now: now$()
    };
}
