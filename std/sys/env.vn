import {
    env$,
    setEnv$,
    now$
} from "runtime:sys";
import { Env } from "std:env";

export function env(key: str): str {
    return env$(key);
}

export function setEnv(key: str, val: str): void {
    setEnv$(key, val);
}

export function now(): float {
    return now$();
}

export function parseDotEnv(content: str): { [key: str]: str } {
    return Env.parse(content);
}
