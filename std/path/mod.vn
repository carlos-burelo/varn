export {
    SEP,
    DELIMITER,
    normalize,
    dirname,
    basename,
    extname,
    isAbsolute,
    join,
    resolve
} from "std:path/utils";

import {
    SEP as SEPFn,
    DELIMITER as DELIMITERFn,
    normalize as normalizeFn,
    dirname as dirnameFn,
    basename as basenameFn,
    extname as extnameFn,
    isAbsolute as isAbsoluteFn,
    join as joinFn,
    resolve as resolveFn
} from "std:path/utils";

export namespace Path {
    export const SEP = SEPFn;
    export const DELIMITER = DELIMITERFn;
    export const normalize = normalizeFn;
    export const dirname = dirnameFn;
    export const basename = basenameFn;
    export const extname = extnameFn;
    export const isAbsolute = isAbsoluteFn;
    export const join = joinFn;
    export const resolve = resolveFn;
}
