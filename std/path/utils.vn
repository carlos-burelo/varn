import {
    sep$,
    delimiter$,
    normalize$,
    dirname$,
    basename$,
    extname$,
    isAbsolute$,
    join$,
    resolve$
} from "runtime:path";

export const SEP: str = sep$();
export const DELIMITER: str = delimiter$();

export function normalize(p: str): str {
    return normalize$(p);
}

export function dirname(p: str): str {
    return dirname$(p);
}

export function basename(p: str, ext?: str): str {
    return basename$(p, ext);
}

export function extname(p: str): str {
    return extname$(p);
}

export function isAbsolute(p: str): bool {
    return isAbsolute$(p);
}

export function join(...segments: str[]): str {
    return join$(segments);
}

export function resolve(...segments: str[]): str {
    return resolve$(segments);
}
