import { deepEq$ } from "runtime:testing";

let passedCount = 0;
let failedCount = 0;

export function getPassedCount(): int {
    return passedCount;
}

export function getFailedCount(): int {
    return failedCount;
}

export function incPassed(): void {
    passedCount = passedCount + 1;
}

export function incFailed(): void {
    failedCount = failedCount + 1;
}

export function isEq<T>(a: T, b: T): bool {
    if (a === b || a == b) {
        return true;
    }
    if (a is str && b is str) {
        if (a.length != b.length) {
            return false;
        }
        for (let i = 0; i < a.length; i = i + 1) {
            if (a.slice(i, i + 1) !== b.slice(i, i + 1)) {
                return false;
            }
        }
        return true;
    }
    return false;
}

export function deepEq<T>(a: T, b: T): bool {
    return deepEq$(a, b);
}

function messageOf(e: Error | str | int | float | bool | null): str {
    if (e is Error) {
        return e.message;
    }
    return `${e}`;
}

export class Expectation<T> {
    private actual: T;

    constructor(actual: T) {
        this.actual = actual;
    }

    toBe(expected: T): void {
        if (!isEq(this.actual, expected)) {
            failedCount = failedCount + 1;
            throw new Error(`Expected ${expected} but received ${this.actual}`);
        }
        passedCount = passedCount + 1;
    }

    toEqual(expected: T): void {
        if (!deepEq(this.actual, expected)) {
            failedCount = failedCount + 1;
            throw new Error(`Expected equal ${expected} but received ${this.actual}`);
        }
        passedCount = passedCount + 1;
    }

    toBeTruthy(): void {
        if (!this.actual) {
            failedCount = failedCount + 1;
            throw new Error(`Expected truthy value but received ${this.actual}`);
        }
        passedCount = passedCount + 1;
    }

    toBeFalsy(): void {
        if (this.actual) {
            failedCount = failedCount + 1;
            throw new Error(`Expected falsy value but received ${this.actual}`);
        }
        passedCount = passedCount + 1;
    }

    toBeNull(): void {
        if (this.actual !== null) {
            failedCount = failedCount + 1;
            throw new Error(`Expected null but received ${this.actual}`);
        }
        passedCount = passedCount + 1;
    }

    toBeNotNull(): void {
        if (this.actual === null) {
            failedCount = failedCount + 1;
            throw new Error("Expected non-null value");
        }
        passedCount = passedCount + 1;
    }

    toBeCloseTo(expected: float, epsilon: float = 0.00001): void {
        let a = this.actual as float;
        let diff = a - expected;
        if (diff < 0.0) diff = -diff;
        if (diff > epsilon) {
            failedCount = failedCount + 1;
            throw new Error(`Expected ${a} to be close to ${expected} within ${epsilon}`);
        }
        passedCount = passedCount + 1;
    }

    toContain<E>(item: E): void {
        let found = false;
        let actual = this.actual;
        if (actual is str) {
            found = item is str && actual.includes(item);
        } else {
            for (let elem of actual as E[]) {
                if (isEq(elem, item)) {
                    found = true;
                    break;
                }
            }
        }
        if (!found) {
            failedCount = failedCount + 1;
            throw new Error("Expected container to contain item");
        }
        passedCount = passedCount + 1;
    }

    toThrow(expectedErr: str = ""): void {
        let threw = false;
        let errMessage = "";
        try {
            (this.actual as () => void)();
        } catch (e) {
            threw = true;
            errMessage = messageOf(e);
        }
        if (!threw) {
            failedCount = failedCount + 1;
            throw new Error("Expected function to throw");
        }
        if (expectedErr.length > 0) {
            if (!errMessage.includes(expectedErr)) {
                failedCount = failedCount + 1;
                throw new Error("Expected error containing '" + expectedErr + "', got '" + errMessage + "'");
            }
        }
        passedCount = passedCount + 1;
    }
}

export function expect<T>(val: T): Expectation<T> {
    return new Expectation<T>(val);
}

export function assertEqual<T>(actual: T, expected: T, label: str = "assertEqual"): void {
    if (!isEq(actual, expected)) {
        failedCount = failedCount + 1;
        throw new Error("ASSERT FAIL: " + label + " (expected " + expected + " but got " + actual + ")");
    }
    passedCount = passedCount + 1;
}

export function assertTrue(cond: bool, label: str = "assertTrue"): void {
    if (!cond) {
        failedCount = failedCount + 1;
        throw new Error("ASSERT FAIL: " + label);
    }
    passedCount = passedCount + 1;
}

export function assertFalse(cond: bool, label: str = "assertFalse"): void {
    if (cond) {
        failedCount = failedCount + 1;
        throw new Error("ASSERT FAIL: " + label + " (expected false but got true)");
    }
    passedCount = passedCount + 1;
}

export function assertNull<T>(val: T?, msg: str = "assertNull"): void {
    if (val !== null) {
        failedCount = failedCount + 1;
        throw new Error("ASSERT FAIL: " + msg + " (expected null, got " + val + ")");
    }
    passedCount = passedCount + 1;
}

export function assertNotNull<T>(val: T?, msg: str = "assertNotNull"): void {
    if (val === null) {
        failedCount = failedCount + 1;
        throw new Error("ASSERT FAIL: " + msg + " (expected non-null value)");
    }
    passedCount = passedCount + 1;
}

export function assertNotEqual<T>(a: T, b: T, msg: str = "assertNotEqual"): void {
    if (isEq(a, b)) {
        failedCount = failedCount + 1;
        throw new Error("ASSERT FAIL: " + msg + " (expected values to differ, got " + a + ")");
    }
    passedCount = passedCount + 1;
}

export function assertContainsItem<T>(container: T[], item: T, msg: str = "assertContainsItem"): void {
    let found = false;
    for (let elem of container) {
        if (isEq(elem, item)) {
            found = true;
            break;
        }
    }
    if (!found) {
        failedCount = failedCount + 1;
        throw new Error("ASSERT FAIL: " + msg + " (array does not contain item)");
    }
    passedCount = passedCount + 1;
}

export function assertCloseTo(a: float, b: float, epsilon: float = 0.00001, msg: str = "assertCloseTo"): void {
    let diff = a - b;
    if (diff < 0.0) diff = -diff;
    if (diff > epsilon) {
        failedCount = failedCount + 1;
        throw new Error(`ASSERT FAIL: ${msg} (${a} is not close to ${b} within ${epsilon})`);
    }
    passedCount = passedCount + 1;
}

export function assertThrows(fn: () => void, expectedErr: str = "", msg: str = "assertThrows"): void {
    let threw = false;
    let errMessage = "";
    try {
        fn();
    } catch (e) {
        threw = true;
        errMessage = messageOf(e);
    }
    if (!threw) {
        failedCount = failedCount + 1;
        throw new Error("ASSERT FAIL: " + msg + " (function did not throw)");
    }
    if (expectedErr.length > 0) {
        if (!errMessage.includes(expectedErr)) {
            failedCount = failedCount + 1;
            throw new Error("ASSERT FAIL: " + msg + " (expected error containing '" + expectedErr + "', got '" + errMessage + "')");
        }
    }
    passedCount = passedCount + 1;
}

export function fail(msg: str = "fail"): void {
    failedCount = failedCount + 1;
    throw new Error("ASSERT FAIL: " + msg);
}

export function summary(): void {
    print("\n════════════════════════════════════════");
    print(`PASSED: ${passedCount}`);
    print(`FAILED: ${failedCount}`);
    if (failedCount === 0) {
        print("ALL TESTS PASSED");
    } else {
        print("SOME TESTS FAILED");
    }
}
