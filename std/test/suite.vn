import { write$ } from "runtime:io";

function logLine(msg: str): void {
    write$(msg + "\n");
}

let beforeAllFns: Array<() => dynamic> = [];
let afterAllFns: Array<() => dynamic> = [];
let beforeEachFns: Array<() => dynamic> = [];
let afterEachFns: Array<() => dynamic> = [];

export function beforeAll(fn: () => dynamic): void {
    beforeAllFns.push(fn);
}

export function afterAll(fn: () => dynamic): void {
    afterAllFns.push(fn);
}

export function beforeEach(fn: () => dynamic): void {
    beforeEachFns.push(fn);
}

export function afterEach(fn: () => dynamic): void {
    afterEachFns.push(fn);
}

export async function describe(suiteName: str, body: () => dynamic): Task<void> {
    logLine("=== Suite: " + suiteName + " ===");
    let prevBeforeAll = beforeAllFns;
    let prevAfterAll = afterAllFns;
    let prevBeforeEach = beforeEachFns;
    let prevAfterEach = afterEachFns;

    beforeAllFns = [];
    afterAllFns = [];
    beforeEachFns = [];
    afterEachFns = [];

    try {
        for (let fn of beforeAllFns) await fn();
        await body();
        for (let fn of afterAllFns) await fn();
    } finally {
        beforeAllFns = prevBeforeAll;
        afterAllFns = prevAfterAll;
        beforeEachFns = prevBeforeEach;
        afterEachFns = prevAfterEach;
    }
}

export async function suite(suiteName: str, body: () => dynamic): Task<void> {
    await describe(suiteName, body);
}

export async function test(testName: str, body: () => dynamic): Task<void> {
    try {
        for (let fn of beforeEachFns) await fn();
        await body();
        for (let fn of afterEachFns) await fn();
        logLine("  ✔ " + testName);
    } catch (err) {
        logLine("  ✖ " + testName + ": " + err);
        throw err;
    }
}

export async function it(testName: str, body: () => dynamic): Task<void> {
    await test(testName, body);
}
