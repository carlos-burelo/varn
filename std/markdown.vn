// std:markdown — High-performance CommonMark & GFM Markdown Parser and HTML Renderer for Varn

export interface MarkdownOptions {
    gfm?: bool;
    xhtml?: bool;
    escapeHtml?: bool;
    breaks?: bool;
}

export interface MarkdownHeading {
    level: int;
    text: str;
    id: str;
}

export interface MarkdownLink {
    text: str;
    url: str;
    title: str;
    isImage: bool;
}

export class MarkdownNode {
    type: str;
    text: str;
    level: int;
    lang: str;
    ordered: bool;
    start: int;
    checked: bool?;
    url: str;
    title: str;
    align: str[];
    children: MarkdownNode[];

    constructor(type: str, text: str = "") {
        this.type = type;
        this.text = text;
        this.level = 0;
        this.lang = "";
        this.ordered = false;
        this.start = 1;
        this.checked = null;
        this.url = "";
        this.title = "";
        this.align = [];
        this.children = [];
    }

    addChild(child: MarkdownNode): void {
        this.children.push(child);
    }
}

function escapeHtmlStr(s: str): str {
    let res = s.replaceAll("&", "&amp;");
    res = res.replaceAll("<", "&lt;");
    res = res.replaceAll(">", "&gt;");
    res = res.replaceAll("\"", "&quot;");
    return res;
}

function isWhitespaceChar(c: str): bool {
    return c === " " || c === "\t" || c === "\r" || c === "\n";
}

function findFrom(s: str, search: str, fromIdx: int): int {
    if (fromIdx >= s.length) return -1;
    let sub = s.slice(fromIdx);
    let idx = sub.indexOf(search);
    if (idx === -1) return -1;
    return fromIdx + idx;
}

function startsWithAt(s: str, prefix: str, pos: int): bool {
    if (pos + prefix.length > s.length) return false;
    return s.slice(pos, pos + prefix.length) === prefix;
}

function isThematicBreak(line: str): bool {
    let trimmed = line.trim();
    if (trimmed.length < 3) return false;
    let ch = trimmed[0];
    if (ch !== "-" && ch !== "*" && ch !== "_") return false;
    let count = 0;
    for (let i = 0; i < trimmed.length; i = i + 1) {
        let c = trimmed[i];
        if (c === ch) {
            count = count + 1;
        } else if (c !== " " && c !== "\t") {
            return false;
        }
    }
    return count >= 3;
}

function isHeadingLine(line: str): int {
    let trimmed = line.trimStart();
    if (!trimmed.startsWith("#")) return 0;
    let level = 0;
    for (let i = 0; i < trimmed.length; i = i + 1) {
        if (trimmed[i] === "#") {
            level = level + 1;
        } else {
            break;
        }
    }
    if (level >= 1 && level <= 6) {
        if (trimmed.length > level && isWhitespaceChar(trimmed[level])) {
            return level;
        }
    }
    return 0;
}

function isListItemLine(line: str): bool {
    let trimmed = line.trimStart();
    if (trimmed.startsWith("- ") || trimmed.startsWith("* ") || trimmed.startsWith("+ ")) {
        return true;
    }
    let i = 0;
    while (i < trimmed.length) {
        let code = trimmed.charCodeAt(i);
        if (code >= 48 && code <= 57) {
            i = i + 1;
        } else {
            break;
        }
    }
    if (i > 0 && i < trimmed.length) {
        let ch = trimmed[i];
        if (ch === "." || ch === ")") {
            if (i + 1 < trimmed.length && trimmed[i + 1] === " ") {
                return true;
            }
        }
    }
    return false;
}

function isTableSeparator(line: str): bool {
    let trimmed = line.trim();
    if (!trimmed.includes("-")) return false;
    let parts = trimmed.split("|");
    let validCols = 0;
    for (let p of parts) {
        let col = p.trim();
        if (col.length === 0) continue;
        let isSep = true;
        let dashes = 0;
        for (let i = 0; i < col.length; i = i + 1) {
            let c = col[i];
            if (c === "-") {
                dashes = dashes + 1;
            } else if (c !== ":") {
                isSep = false;
                break;
            }
        }
        if (!isSep || dashes === 0) return false;
        validCols = validCols + 1;
    }
    return validCols > 0;
}

function parseTableAlignments(sepLine: str): str[] {
    let parts = sepLine.trim().split("|");
    let aligns: str[] = [];
    for (let p of parts) {
        let col = p.trim();
        if (col.length === 0) continue;
        let left = col.startsWith(":");
        let right = col.endsWith(":");
        if (left && right) {
            aligns.push("center");
        } else if (right) {
            aligns.push("right");
        } else if (left) {
            aligns.push("left");
        } else {
            aligns.push("none");
        }
    }
    return aligns;
}

function splitTableRow(rowLine: str): str[] {
    let trimmed = rowLine.trim();
    if (trimmed.startsWith("|")) trimmed = trimmed.slice(1);
    if (trimmed.endsWith("|")) trimmed = trimmed.slice(0, trimmed.length - 1);
    let cells = trimmed.split("|");
    let res: str[] = [];
    for (let c of cells) {
        res.push(c.trim());
    }
    return res;
}

function parseInlineTokens(text: str, escapeHtml: bool): MarkdownNode[] {
    let nodes: MarkdownNode[] = [];
    let i = 0;
    let buf = "";

    function flushBuf(): void {
        if (buf.length > 0) {
            nodes.push(new MarkdownNode("text", buf));
            buf = "";
        }
    }

    while (i < text.length) {
        // 1. Escaped character
        if (text[i] === "\\" && i + 1 < text.length) {
            let next = text[i + 1];
            if (next === "\\" || next === "`" || next === "*" || next === "_" || next === "[" || next === "]" || next === "(" || next === ")" || next === "#" || next === "+" || next === "-" || next === "." || next === "!" || next === "~" || next === "|") {
                buf = buf + next;
                i = i + 2;
                continue;
            }
        }

        // 2. Inline Code: `code`
        if (text[i] === "`") {
            let endIdx = findFrom(text, "`", i + 1);
            if (endIdx !== -1) {
                flushBuf();
                let codeContent = text.slice(i + 1, endIdx);
                nodes.push(new MarkdownNode("inline_code", codeContent));
                i = endIdx + 1;
                continue;
            }
        }

        // 3. Image: ![alt](url "title")
        if (text[i] === "!" && i + 1 < text.length && text[i + 1] === "[") {
            let closeBracket = findFrom(text, "]", i + 2);
            if (closeBracket !== -1 && closeBracket + 1 < text.length && text[closeBracket + 1] === "(") {
                let closeParen = findFrom(text, ")", closeBracket + 2);
                if (closeParen !== -1) {
                    flushBuf();
                    let alt = text.slice(i + 2, closeBracket);
                    let target = text.slice(closeBracket + 2, closeParen).trim();
                    let url = target;
                    let title = "";
                    if (target.includes(" \"")) {
                        let parts = target.split(" \"");
                        url = parts[0].trim();
                        title = parts[1].replace("\"", "").trim();
                    }
                    let imgNode = new MarkdownNode("image", alt);
                    imgNode.url = url;
                    imgNode.title = title;
                    nodes.push(imgNode);
                    i = closeParen + 1;
                    continue;
                }
            }
        }

        // 4. Link: [text](url "title")
        if (text[i] === "[") {
            let closeBracket = findFrom(text, "]", i + 1);
            if (closeBracket !== -1 && closeBracket + 1 < text.length && text[closeBracket + 1] === "(") {
                let closeParen = findFrom(text, ")", closeBracket + 2);
                if (closeParen !== -1) {
                    flushBuf();
                    let linkText = text.slice(i + 1, closeBracket);
                    let target = text.slice(closeBracket + 2, closeParen).trim();
                    let url = target;
                    let title = "";
                    if (target.includes(" \"")) {
                        let parts = target.split(" \"");
                        url = parts[0].trim();
                        title = parts[1].replace("\"", "").trim();
                    }
                    let linkNode = new MarkdownNode("link", linkText);
                    linkNode.url = url;
                    linkNode.title = title;
                    let childInlines = parseInlineTokens(linkText, escapeHtml);
                    for (let c of childInlines) {
                        linkNode.addChild(c);
                    }
                    nodes.push(linkNode);
                    i = closeParen + 1;
                    continue;
                }
            }
        }

        // 5. Autolink: <https://...> or <mailto:...>
        if (text[i] === "<") {
            let closeAngle = findFrom(text, ">", i + 1);
            if (closeAngle !== -1) {
                let linkContent = text.slice(i + 1, closeAngle).trim();
                if (linkContent.startsWith("http://") || linkContent.startsWith("https://") || linkContent.startsWith("mailto:")) {
                    flushBuf();
                    let autoLinkNode = new MarkdownNode("link", linkContent);
                    autoLinkNode.url = linkContent;
                    autoLinkNode.addChild(new MarkdownNode("text", linkContent));
                    nodes.push(autoLinkNode);
                    i = closeAngle + 1;
                    continue;
                }
            }
        }

        // 6. Bold + Italic: ***text*** or ___text___
        if ((startsWithAt(text, "***", i) || startsWithAt(text, "___", i)) && i + 3 < text.length) {
            let marker = text.slice(i, i + 3);
            let endIdx = findFrom(text, marker, i + 3);
            if (endIdx !== -1) {
                flushBuf();
                let inner = text.slice(i + 3, endIdx);
                let strongNode = new MarkdownNode("bold", inner);
                let emNode = new MarkdownNode("italic", inner);
                let children = parseInlineTokens(inner, escapeHtml);
                for (let c of children) {
                    emNode.addChild(c);
                }
                strongNode.addChild(emNode);
                nodes.push(strongNode);
                i = endIdx + 3;
                continue;
            }
        }

        // 7. Bold: **text** or __text__
        if ((startsWithAt(text, "**", i) || startsWithAt(text, "__", i)) && i + 2 < text.length) {
            let marker = text.slice(i, i + 2);
            let endIdx = findFrom(text, marker, i + 2);
            if (endIdx !== -1) {
                flushBuf();
                let inner = text.slice(i + 2, endIdx);
                let boldNode = new MarkdownNode("bold", inner);
                let children = parseInlineTokens(inner, escapeHtml);
                for (let c of children) {
                    boldNode.addChild(c);
                }
                nodes.push(boldNode);
                i = endIdx + 2;
                continue;
            }
        }

        // 8. Strikethrough: ~~text~~
        if (startsWithAt(text, "~~", i) && i + 2 < text.length) {
            let endIdx = findFrom(text, "~~", i + 2);
            if (endIdx !== -1) {
                flushBuf();
                let inner = text.slice(i + 2, endIdx);
                let strikeNode = new MarkdownNode("strikethrough", inner);
                let children = parseInlineTokens(inner, escapeHtml);
                for (let c of children) {
                    strikeNode.addChild(c);
                }
                nodes.push(strikeNode);
                i = endIdx + 2;
                continue;
            }
        }

        // 9. Italic: *text* or _text_
        if ((text[i] === "*" || text[i] === "_") && i + 1 < text.length) {
            let marker = text[i];
            let endIdx = findFrom(text, marker, i + 1);
            if (endIdx !== -1 && endIdx > i + 1) {
                flushBuf();
                let inner = text.slice(i + 1, endIdx);
                let emNode = new MarkdownNode("italic", inner);
                let children = parseInlineTokens(inner, escapeHtml);
                for (let c of children) {
                    emNode.addChild(c);
                }
                nodes.push(emNode);
                i = endIdx + 1;
                continue;
            }
        }

        // Normal character accumulation
        buf = buf + text[i];
        i = i + 1;
    }

    flushBuf();
    return nodes;
}

export namespace Markdown {
    export function slugify(text: str): str {
        let s = text.trim().toLowerCase();
        let out = "";
        for (let i = 0; i < s.length; i = i + 1) {
            let code = s.charCodeAt(i);
            let isAlphaNum = (code >= 97 && code <= 122) || (code >= 48 && code <= 57);
            if (isAlphaNum) {
                out = out + s[i];
            } else if (code === 32 || code === 45 || code === 95) {
                if (!out.endsWith("-") && out.length > 0) {
                    out = out + "-";
                }
            }
        }
        if (out.endsWith("-")) {
            out = out.slice(0, out.length - 1);
        }
        return out;
    }

    export function parse(source: str, options?: MarkdownOptions): MarkdownNode {
        let optGfm = options?.gfm ?? true;
        let optEscape = options?.escapeHtml ?? true;

        let root = new MarkdownNode("root");
        let rawLines = source.split("\n");
        let lines: str[] = [];
        for (let l of rawLines) {
            if (l.endsWith("\r")) {
                lines.push(l.slice(0, l.length - 1));
            } else {
                lines.push(l);
            }
        }

        let idx = 0;
        let total = lines.length;

        while (idx < total) {
            let line = lines[idx];
            let trimmed = line.trim();

            // 1. Blank line
            if (trimmed.length === 0) {
                idx = idx + 1;
                continue;
            }

            // 2. Fenced Code Block: ``` or ~~~
            if (trimmed.startsWith("```") || trimmed.startsWith("~~~")) {
                let fenceChar = trimmed.slice(0, 3);
                let lang = trimmed.slice(3).trim();
                idx = idx + 1;
                let codeLines: str[] = [];
                while (idx < total) {
                    let curLine = lines[idx];
                    if (curLine.trim().startsWith(fenceChar)) {
                        idx = idx + 1;
                        break;
                    }
                    codeLines.push(curLine);
                    idx = idx + 1;
                }
                let codeNode = new MarkdownNode("code_block", codeLines.join("\n"));
                codeNode.lang = lang;
                root.addChild(codeNode);
                continue;
            }

            // 3. Indented Code Block: 4 spaces or 1 tab
            if (line.startsWith("    ") || line.startsWith("\t")) {
                let codeLines: str[] = [];
                while (idx < total) {
                    let curLine = lines[idx];
                    if (curLine.startsWith("    ")) {
                        codeLines.push(curLine.slice(4));
                    } else if (curLine.startsWith("\t")) {
                        codeLines.push(curLine.slice(1));
                    } else if (curLine.trim().length === 0) {
                        codeLines.push("");
                    } else {
                        break;
                    }
                    idx = idx + 1;
                }
                let codeNode = new MarkdownNode("code_block", codeLines.join("\n"));
                root.addChild(codeNode);
                continue;
            }

            // 4. Thematic Break / Horizontal Rule: ---, ***, ___
            if (isThematicBreak(line)) {
                root.addChild(new MarkdownNode("thematic_break"));
                idx = idx + 1;
                continue;
            }

            // 5. ATX Heading: # H1 to ###### H6
            let hLevel = isHeadingLine(line);
            if (hLevel > 0) {
                let content = line.trimStart().slice(hLevel).trim();
                while (content.endsWith("#")) {
                    content = content.slice(0, content.length - 1).trimEnd();
                }
                let hNode = new MarkdownNode("heading", content);
                hNode.level = hLevel;
                let inlines = parseInlineTokens(content, optEscape);
                for (let c of inlines) {
                    hNode.addChild(c);
                }
                root.addChild(hNode);
                idx = idx + 1;
                continue;
            }

            // 6. Blockquote: > quote
            if (trimmed.startsWith(">")) {
                let quoteLines: str[] = [];
                while (idx < total) {
                    let cur = lines[idx].trim();
                    if (cur.startsWith(">")) {
                        let stripped = cur.slice(1);
                        if (stripped.startsWith(" ")) stripped = stripped.slice(1);
                        quoteLines.push(stripped);
                        idx = idx + 1;
                    } else if (cur.length === 0) {
                        break;
                    } else {
                        quoteLines.push(cur);
                        idx = idx + 1;
                    }
                }
                let innerDoc = Markdown.parse(quoteLines.join("\n"), options);
                let bqNode = new MarkdownNode("blockquote");
                for (let child of innerDoc.children) {
                    bqNode.addChild(child);
                }
                root.addChild(bqNode);
                continue;
            }

            // 7. GFM Table: | Col 1 | Col 2 |
            if (optGfm && line.includes("|") && idx + 1 < total && isTableSeparator(lines[idx + 1])) {
                let headerLine = line;
                let sepLine = lines[idx + 1];
                let aligns = parseTableAlignments(sepLine);
                let headers = splitTableRow(headerLine);

                let tableNode = new MarkdownNode("table");
                tableNode.align = aligns;

                let headerRow = new MarkdownNode("table_row");
                for (let i = 0; i < headers.length; i = i + 1) {
                    let cellNode = new MarkdownNode("table_cell", headers[i]);
                    let inlines = parseInlineTokens(headers[i], optEscape);
                    for (let c of inlines) cellNode.addChild(c);
                    headerRow.addChild(cellNode);
                }
                tableNode.addChild(headerRow);

                idx = idx + 2;
                while (idx < total) {
                    let cur = lines[idx];
                    if (cur.trim().length === 0 || !cur.includes("|")) {
                        break;
                    }
                    let rowCells = splitTableRow(cur);
                    let bodyRow = new MarkdownNode("table_row");
                    for (let c of rowCells) {
                        let cellNode = new MarkdownNode("table_cell", c);
                        let inlines = parseInlineTokens(c, optEscape);
                        for (let inNode of inlines) cellNode.addChild(inNode);
                        bodyRow.addChild(cellNode);
                    }
                    tableNode.addChild(bodyRow);
                    idx = idx + 1;
                }
                root.addChild(tableNode);
                continue;
            }

            // 8. Lists (Unordered & Ordered & Task Lists)
            if (isListItemLine(line)) {
                let isOrdered = false;
                let listStart = 1;
                let firstTrimmed = line.trimStart();
                let code0 = firstTrimmed.charCodeAt(0);
                if (code0 >= 48 && code0 <= 57) {
                    isOrdered = true;
                    let dotIdx = firstTrimmed.indexOf(".");
                    if (dotIdx === -1) dotIdx = firstTrimmed.indexOf(")");
                    if (dotIdx > 0) {
                        listStart = firstTrimmed.slice(0, dotIdx).toInt();
                    }
                }

                let listNode = new MarkdownNode("list");
                listNode.ordered = isOrdered;
                listNode.start = listStart;

                while (idx < total) {
                    let cur = lines[idx];
                    if (cur.trim().length === 0) {
                        idx = idx + 1;
                        if (idx < total && isListItemLine(lines[idx])) {
                            continue;
                        }
                        break;
                    }
                    if (!isListItemLine(cur)) {
                        break;
                    }

                    let curTrimmed = cur.trimStart();
                    let content = "";
                    if (curTrimmed.startsWith("- ") || curTrimmed.startsWith("* ") || curTrimmed.startsWith("+ ")) {
                        content = curTrimmed.slice(2);
                    } else {
                        let spaceIdx = curTrimmed.indexOf(" ");
                        if (spaceIdx > 0) {
                            content = curTrimmed.slice(spaceIdx + 1);
                        } else {
                            content = curTrimmed;
                        }
                    }

                    let itemNode = new MarkdownNode("list_item");
                    if (optGfm && (content.startsWith("[ ] ") || content.startsWith("[x] ") || content.startsWith("[X] "))) {
                        let isChecked = content.startsWith("[x] ") || content.startsWith("[X] ");
                        itemNode.checked = isChecked;
                        content = content.slice(4);
                    }

                    itemNode.text = content;
                    let inlines = parseInlineTokens(content, optEscape);
                    for (let c of inlines) {
                        itemNode.addChild(c);
                    }
                    listNode.addChild(itemNode);
                    idx = idx + 1;
                }

                root.addChild(listNode);
                continue;
            }

            // 9. Paragraph
            let pLines: str[] = [];
            while (idx < total) {
                let cur = lines[idx];
                let curTrimmed = cur.trim();
                if (curTrimmed.length === 0) {
                    break;
                }
                if (isHeadingLine(cur) > 0 || isThematicBreak(cur) || isListItemLine(cur) || curTrimmed.startsWith(">") || curTrimmed.startsWith("```") || curTrimmed.startsWith("~~~")) {
                    break;
                }
                pLines.push(cur);
                idx = idx + 1;
            }

            let pText = pLines.join("\n");
            let pNode = new MarkdownNode("paragraph", pText);
            let inlines = parseInlineTokens(pText, optEscape);
            for (let c of inlines) {
                pNode.addChild(c);
            }
            root.addChild(pNode);
        }

        return root;
    }

    export function renderAst(node: MarkdownNode, options?: MarkdownOptions): str {
        let optXhtml = options?.xhtml ?? false;
        let optEscape = options?.escapeHtml ?? true;
        let optBreaks = options?.breaks ?? false;

        let brTag = optXhtml ? "<br />" : "<br>";
        let hrTag = optXhtml ? "<hr />\n" : "<hr>\n";

        if (node.type === "root") {
            let out = "";
            for (let child of node.children) {
                out = out + renderAst(child, options);
            }
            return out;
        }

        if (node.type === "heading") {
            let tag = "h" + node.level;
            let inner = "";
            for (let c of node.children) {
                inner = inner + renderAst(c, options);
            }
            return "<" + tag + ">" + inner + "</" + tag + ">\n";
        }

        if (node.type === "paragraph") {
            let inner = "";
            for (let c of node.children) {
                inner = inner + renderAst(c, options);
            }
            if (optBreaks) {
                inner = inner.replaceAll("\n", brTag + "\n");
            }
            return "<p>" + inner + "</p>\n";
        }

        if (node.type === "code_block") {
            let code = optEscape ? escapeHtmlStr(node.text) : node.text;
            if (node.lang.length > 0) {
                return "<pre><code class=\"language-" + escapeHtmlStr(node.lang) + "\">" + code + "\n</code></pre>\n";
            }
            return "<pre><code>" + code + "\n</code></pre>\n";
        }

        if (node.type === "blockquote") {
            let inner = "";
            for (let c of node.children) {
                inner = inner + renderAst(c, options);
            }
            return "<blockquote>\n" + inner + "</blockquote>\n";
        }

        if (node.type === "list") {
            let tag = node.ordered ? "ol" : "ul";
            let startAttr = (node.ordered && node.start !== 1) ? (" start=\"" + node.start + "\"") : "";
            let inner = "";
            for (let c of node.children) {
                inner = inner + renderAst(c, options);
            }
            return "<" + tag + startAttr + ">\n" + inner + "</" + tag + ">\n";
        }

        if (node.type === "list_item") {
            let inner = "";
            if (node.checked != null) {
                let chk = node.checked ? " checked=\"\"" : "";
                let inputTag = optXhtml ? ("<input type=\"checkbox\"" + chk + " disabled=\"\" /> ") : ("<input type=\"checkbox\"" + chk + " disabled> ");
                inner = inputTag;
            }
            for (let c of node.children) {
                inner = inner + renderAst(c, options);
            }
            return "<li>" + inner + "</li>\n";
        }

        if (node.type === "table") {
            let headRow = node.children.length > 0 ? node.children[0] : null;
            let thead = "";
            if (headRow != null) {
                let ths = "";
                for (let i = 0; i < headRow.children.length; i = i + 1) {
                    let cell = headRow.children[i];
                    let alignAttr = "";
                    if (i < node.align.length && node.align[i] !== "none") {
                        alignAttr = " align=\"" + node.align[i] + "\"";
                    }
                    let cellContent = "";
                    for (let c of cell.children) cellContent = cellContent + renderAst(c, options);
                    ths = ths + "<th" + alignAttr + ">" + cellContent + "</th>";
                }
                thead = "<thead>\n<tr>" + ths + "</tr>\n</thead>\n";
            }

            let tbodyRows = "";
            for (let r = 1; r < node.children.length; r = r + 1) {
                let row = node.children[r];
                let tds = "";
                for (let i = 0; i < row.children.length; i = i + 1) {
                    let cell = row.children[i];
                    let alignAttr = "";
                    if (i < node.align.length && node.align[i] !== "none") {
                        alignAttr = " align=\"" + node.align[i] + "\"";
                    }
                    let cellContent = "";
                    for (let c of cell.children) cellContent = cellContent + renderAst(c, options);
                    tds = tds + "<td" + alignAttr + ">" + cellContent + "</td>";
                }
                tbodyRows = tbodyRows + "<tr>" + tds + "</tr>\n";
            }
            let tbody = tbodyRows.length > 0 ? ("<tbody>\n" + tbodyRows + "</tbody>\n") : "";

            return "<table>\n" + thead + tbody + "</table>\n";
        }

        if (node.type === "thematic_break") {
            return hrTag;
        }

        if (node.type === "text") {
            return optEscape ? escapeHtmlStr(node.text) : node.text;
        }

        if (node.type === "inline_code") {
            let code = optEscape ? escapeHtmlStr(node.text) : node.text;
            return "<code>" + code + "</code>";
        }

        if (node.type === "bold") {
            let inner = "";
            for (let c of node.children) inner = inner + renderAst(c, options);
            return "<strong>" + inner + "</strong>";
        }

        if (node.type === "italic") {
            let inner = "";
            for (let c of node.children) inner = inner + renderAst(c, options);
            return "<em>" + inner + "</em>";
        }

        if (node.type === "strikethrough") {
            let inner = "";
            for (let c of node.children) inner = inner + renderAst(c, options);
            return "<del>" + inner + "</del>";
        }

        if (node.type === "link") {
            let inner = "";
            for (let c of node.children) inner = inner + renderAst(c, options);
            let titleAttr = node.title.length > 0 ? (" title=\"" + escapeHtmlStr(node.title) + "\"") : "";
            return "<a href=\"" + escapeHtmlStr(node.url) + "\"" + titleAttr + ">" + inner + "</a>";
        }

        if (node.type === "image") {
            let titleAttr = node.title.length > 0 ? (" title=\"" + escapeHtmlStr(node.title) + "\"") : "";
            let altAttr = " alt=\"" + escapeHtmlStr(node.text) + "\"";
            let srcAttr = " src=\"" + escapeHtmlStr(node.url) + "\"";
            if (optXhtml) {
                return "<img" + srcAttr + altAttr + titleAttr + " />";
            }
            return "<img" + srcAttr + altAttr + titleAttr + ">";
        }

        return "";
    }

    export function render(source: str, options?: MarkdownOptions): str {
        let ast = parse(source, options);
        return renderAst(ast, options);
    }

    export function toPlainText(source: str): str {
        let ast = parse(source, { escapeHtml: false });
        let out: str[] = [];

        function walk(n: MarkdownNode): void {
            if (n.type === "text" || n.type === "inline_code") {
                out.push(n.text);
            } else if (n.type === "code_block") {
                out.push(n.text + "\n");
            } else {
                for (let c of n.children) {
                    walk(c);
                }
                if (n.type === "paragraph" || n.type === "heading" || n.type === "list_item" || n.type === "thematic_break") {
                    out.push("\n");
                }
            }
        }

        walk(ast);
        return out.join("").trim();
    }

    export function extractHeadings(source: str): MarkdownHeading[] {
        let ast = parse(source);
        let list: MarkdownHeading[] = [];

        function walk(n: MarkdownNode): void {
            if (n.type === "heading") {
                list.push({
                    level: n.level,
                    text: n.text,
                    id: slugify(n.text)
                });
            }
            for (let c of n.children) {
                walk(c);
            }
        }

        walk(ast);
        return list;
    }

    export function extractLinks(source: str): MarkdownLink[] {
        let ast = parse(source);
        let links: MarkdownLink[] = [];

        function walk(n: MarkdownNode): void {
            if (n.type === "link") {
                links.push({
                    text: n.text,
                    url: n.url,
                    title: n.title,
                    isImage: false
                });
            } else if (n.type === "image") {
                links.push({
                    text: n.text,
                    url: n.url,
                    title: n.title,
                    isImage: true
                });
            }
            for (let c of n.children) {
                walk(c);
            }
        }

        walk(ast);
        return links;
    }
}
