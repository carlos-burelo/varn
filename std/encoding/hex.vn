import { ParseError } from "std:error";

function hexCharToNibble(character: str): int {
    let code = character.charCodeAt(0);
    if (code >= 48 && code <= 57) {
        return code - 48;
    }
    if (code >= 97 && code <= 102) {
        return code - 97 + 10;
    }
    if (code >= 65 && code <= 70) {
        return code - 65 + 10;
    }
    throw new ParseError("invalid hex character: " + character);
}

export namespace Hex {
    export function encode(data: str): str {
        return Bytes.fromString(data).toHex();
    }

    export function encodeBytes(data: Bytes): str {
        return data.toHex();
    }

    export function decodeBytes(hexString: str): Bytes {
        if (hexString.length % 2 !== 0) {
            throw new ParseError("invalid hex string length");
        }
        let bytes: int[] = [];
        let length: int = hexString.length;
        for (let index = 0; index < length; index = index + 2) {
            let high = hexCharToNibble(hexString[index]);
            let low = hexCharToNibble(hexString[index + 1]);
            bytes.push(high * 16 + low);
        }
        return Bytes.fromBytes(bytes);
    }

    export function decode(hexString: str): str {
        return decodeBytes(hexString).toString();
    }
}
