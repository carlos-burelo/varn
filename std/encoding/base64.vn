import { base64Enc$, base64Dec$, base64EncBytes$, base64DecBytes$ } from "runtime:crypto";

function toUrlSafe(s: str): str {
    return s.replaceAll("+", "-").replaceAll("/", "_").replaceAll("=", "");
}

function fromUrlSafe(s: str): str {
    let out = s.replaceAll("-", "+").replaceAll("_", "/");
    let rem = out.length % 4;
    if (rem === 2) {
        out = out + "==";
    } else if (rem === 3) {
        out = out + "=";
    }
    return out;
}

export namespace Base64 {
    export function encode(data: str): str {
        return base64Enc$(data);
    }

    export function decode(data: str): str {
        return base64Dec$(data);
    }

    export function encodeUrl(data: str): str {
        return toUrlSafe(base64Enc$(data));
    }

    export function decodeUrl(data: str): str {
        return base64Dec$(fromUrlSafe(data));
    }

    export function encodeBytes(data: Bytes): str {
        return base64EncBytes$(data);
    }

    export function decodeBytes(data: str): Bytes {
        return base64DecBytes$(data);
    }

    export function encodeUrlBytes(data: Bytes): str {
        return toUrlSafe(base64EncBytes$(data));
    }

    export function decodeUrlBytes(data: str): Bytes {
        return base64DecBytes$(fromUrlSafe(data));
    }
}
