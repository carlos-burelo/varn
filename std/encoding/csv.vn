import { parse$, stringify$ } from "runtime:csv";

export interface CsvOptions {
    delimiter?: str;
    hasHeader?: bool;
    trim?: bool;
}

export namespace CSV {
    export function parse<T = dynamic>(text: str, options?: CsvOptions): T[] {
        let delim = ",";
        let hasHeader = true;
        let trim = true;

        if (options != null) {
            // Los miembros de CsvOptions son opcionales (`T?`): su lectura
            // da null cuando el campo no vino. `??` aplica el default.
            delim = options.delimiter ?? delim;
            hasHeader = options.hasHeader ?? hasHeader;
            trim = options.trim ?? trim;
        }

        return parse$(text, delim, hasHeader, trim) as T[];
    }

    export function stringify(rows: dynamic[], options?: CsvOptions): str {
        let delim = ",";

        if (options != null) {
            delim = options.delimiter ?? delim;
        }

        return stringify$(rows, delim);
    }
}
