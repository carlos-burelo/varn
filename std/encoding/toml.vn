function trimWhitespace(text: str): str {
    let start = 0;
    let end = text.length;
    while (start < end && (text[start] == " " || text[start] == "\t" || text[start] == "\r")) {
        start = start + 1;
    }
    while (end > start && (text[end - 1] == " " || text[end - 1] == "\t" || text[end - 1] == "\r")) {
        end = end - 1;
    }
    return text.slice(start, end);
}

function parseInteger(digits: str): int {
    let result = 0;
    let sign = 1;
    let start = 0;
    if (digits.startsWith("-")) {
        sign = -1;
        start = 1;
    } else if (digits.startsWith("+")) {
        start = 1;
    }
    for (let index = start; index < digits.length; index = index + 1) {
        let char = digits[index];
        let code = char.charCodeAt(0);
        if (code >= 48 && code <= 57) {
            result = result * 10 + (code - 48);
        }
    }
    return result * sign;
}

function parseFloating(text: str): float {
    let dotIndex = text.indexOf(".");
    if (dotIndex == null) {
        return parseInteger(text) as float;
    }
    let wholePart = text.slice(0, dotIndex);
    let fractionalPart = text.slice(dotIndex + 1);
    let wholeVal = parseInteger(wholePart) as float;
    let fractionVal = parseInteger(fractionalPart) as float;
    let divisor = 1.0;
    for (let index = 0; index < fractionalPart.length; index = index + 1) {
        divisor = divisor * 10.0;
    }
    if (text.startsWith("-")) {
        return wholeVal - (fractionVal / divisor);
    }
    return wholeVal + (fractionVal / divisor);
}

export type TomlValue = bool | int | float | str | TomlValue[] | Map<str, TomlValue>;

function parseTomlValue(valueText: str): TomlValue {
    let raw = trimWhitespace(valueText);
    if (raw == "true") {
        return true;
    }
    if (raw == "false") {
        return false;
    }
    if (raw.startsWith("\"") && raw.endsWith("\"") && raw.length >= 2) {
        return raw.slice(1, raw.length - 1);
    }
    if (raw.startsWith("'") && raw.endsWith("'") && raw.length >= 2) {
        return raw.slice(1, raw.length - 1);
    }
    if (raw.startsWith("[") && raw.endsWith("]")) {
        let inner = raw.slice(1, raw.length - 1);
        let items: TomlValue[] = [];
        if (trimWhitespace(inner).length == 0) {
            return items;
        }
        let parts = inner.split(",");
        for (let index = 0; index < parts.length; index = index + 1) {
            items.push(parseTomlValue(parts[index]));
        }
        return items;
    }
    if (raw.includes(".")) {
        return parseFloating(raw);
    }
    return parseInteger(raw);
}

function formatTomlValue(val: TomlValue): str {
    if (val is str) {
        return "\"" + val + "\"";
    }
    if (val is bool) {
        return val ? "true" : "false";
    }
    if (val is int) {
        return val.toString();
    }
    if (val is float) {
        return val.toString();
    }
    if (val is TomlValue[]) {
        let items: str[] = [];
        for (let i = 0; i < val.length; i = i + 1) {
            items.push(formatTomlValue(val[i]));
        }
        return "[" + items.join(", ") + "]";
    }
    return "\"\"";
}

export namespace Toml {
    export function parse(content: str): Map<str, TomlValue> {
        const root = new Map<str, TomlValue>();
        let currentSection = root;
        let lines = content.split("\n");

        for (let lineIndex = 0; lineIndex < lines.length; lineIndex = lineIndex + 1) {
            let line = trimWhitespace(lines[lineIndex]);
            if (line.length == 0 || line.startsWith("#")) {
                continue;
            }
            if (line.startsWith("[") && line.endsWith("]")) {
                let sectionName = line.slice(1, line.length - 1);
                const sectionObj = new Map<str, TomlValue>();
                root.set(sectionName, sectionObj);
                currentSection = sectionObj;
                continue;
            }
            let equalsIndex = line.indexOf("=");
            if (equalsIndex != null && equalsIndex > 0) {
                let key = trimWhitespace(line.slice(0, equalsIndex));
                let rawVal = line.slice(equalsIndex + 1);
                let parsedVal = parseTomlValue(rawVal);
                currentSection.set(key, parsedVal);
            }
        }
        return root;
    }

    export function tryParse(content: str): Map<str, TomlValue>? {
        try {
            return parse(content);
        } catch {
            return null;
        }
    }

    export function stringify(value: Map<str, TomlValue>): str {
        let lines: str[] = [];
        let sectionKeys: str[] = [];

        for (const (key, val) of value) {
            if (val::type == "Map") {
                sectionKeys.push(key);
            } else {
                lines.push(key + " = " + formatTomlValue(val));
            }
        }

        for (let s = 0; s < sectionKeys.length; s = s + 1) {
            let sectionName = sectionKeys[s];
            if (lines.length > 0) {
                lines.push("");
            }
            lines.push("[" + sectionName + "]");
            const sectionObj = value.get(sectionName) as Map<str, TomlValue>;
            for (const (subKey, subVal) of sectionObj) {
                lines.push(subKey + " = " + formatTomlValue(subVal));
            }
        }

        return lines.join("\n");
    }
}
