import { parse$, stringify$ } from "runtime:json";

export type JsonValue = int | float | str | bool | null | JsonValue[] | { [key: str]: JsonValue };

export namespace Json {
    export function parse<T = JsonValue>(text: str): T {
        return parse$(text) as T;
    }

    export function tryParse<T = JsonValue>(text: str): T? {
        try {
            return parse$(text) as T;
        } catch {
            return null;
        }
    }

    export function stringify(value: dynamic, space?: int): str {
        return stringify$(value);
    }
}
