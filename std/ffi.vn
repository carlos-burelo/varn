import {
    dlopen$,
    dlsym$,
    callI64$,
    callF64$
} from "runtime:ffi";

class DynamicLibrary {
    let _handle: dynamic;

    constructor(handle: dynamic) {
        this._handle = handle;
    }

    symbol(name: str): dynamic {
        return dlsym$(this._handle, name);
    }
}

class FFI {
    static open(path: str): DynamicLibrary {
        let handle = dlopen$(path);
        return new DynamicLibrary(handle);
    }

    static callInt(fnPtr: dynamic, a1: int, a2: int): int {
        return callI64$(fnPtr, a1, a2);
    }

    static callFloat(fnPtr: dynamic, a1: float, a2: float): float {
        return callF64$(fnPtr, a1, a2);
    }
}

export { FFI, DynamicLibrary };
