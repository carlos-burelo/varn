import { spawn$, sleep$, parallel$, cancelTask$, yieldTask$, channel$, Channel } from "runtime:task";

export type TaskSettledResult<T> = {
    status: str,
    value?: T,
    reason?: str
};

export function parallel<T>(tasks: Array<Task<T>>): Task<Array<T>> {
    return parallel$(tasks);
}

export function spawn<T>(target: Task<T>): TaskHandle<T> {
    return spawn$(target);
}

export function sleep(ms: int): TaskHandle<void> {
    return sleep$(ms);
}

export function cancel<T>(handle: TaskHandle<T>): void {
    cancelTask$(handle);
}

async function wrapSettledOne<T>(task: Task<T>): Task<TaskSettledResult<T>> {
    try {
        let val = await task;
        return { status: "fulfilled", value: val };
    } catch (err) {
        return { status: "rejected", reason: err.message ?? ("" + err) };
    }
}

async function raceOneHandle<T>(handle: TaskHandle<T>, ch: Channel<TaskSettledResult<T>>): Task<void> {
    try {
        let res = await handle;
        await ch.tx.send({ status: "fulfilled", value: res });
    } catch (err) {
        await ch.tx.send({ status: "rejected", reason: err.message ?? ("" + err) });
    }
}

export namespace Task {
    export async function yield(): Task<void> {
        await yieldTask$();
    }

    export async function all<T>(tasks: Array<Task<T>>): Task<Array<T>> {
        return await parallel$(tasks);
    }

    export async function allSettled<T>(tasks: Array<Task<T>>): Task<Array<TaskSettledResult<T>>> {
        let wrappedTasks: Array<Task<TaskSettledResult<T>>> = [];
        for (let i = 0; i < tasks.length; i = i + 1) {
            wrappedTasks.push(wrapSettledOne(tasks[i]));
        }
        return await parallel$(wrappedTasks);
    }

    export async function race<T>(tasks: Array<Task<T>>): Task<T> {
        if (tasks.length === 0) {
            throw new Error("Task.race requires at least one task");
        }
        let ch = channel$<TaskSettledResult<T>>(tasks.length);
        let handles: Array<TaskHandle<T>> = [];
        for (let i = 0; i < tasks.length; i = i + 1) {
            handles.push(spawn(tasks[i]));
        }
        for (let i = 0; i < handles.length; i = i + 1) {
            spawn(raceOneHandle(handles[i], ch));
        }
        let first = await ch.rx.receive();
        for (let i = 0; i < handles.length; i = i + 1) {
            cancel(handles[i]);
        }
        if (first.status === "rejected") {
            throw new Error(first.reason ?? "Task.race rejected");
        }
        return first.value as T;
    }
}

export async function delay(ms: int): Task<void> {
    await sleep$(ms);
}

export function setTimeout(callback: () => void, ms: int): TaskHandle<void> {
    async function timerRunner(): Task<void> {
        await sleep(ms);
        callback();
    }
    return spawn(timerRunner);
}

export function clearTimeout(handle: TaskHandle<void>): void {
    if (handle !== null) {
        cancel(handle);
    }
}
