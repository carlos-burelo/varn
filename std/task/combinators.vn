import { spawn$, sleep$, parallel$, cancelTask$, yieldTask$, channel$, Channel } from "runtime:task";
import { TimeoutError } from "std:error";

export function parallel<T>(tasks: Array<Task<T>>): TaskHandle<Array<T>> {
    return parallel$(tasks);
}

export function spawn<T>(target: Task<T>): TaskHandle<T> {
    return spawn$(target);
}

export function sleep(ms: int): TaskHandle<void> {
    return sleep$(ms);
}

export function cancel<T>(handle: TaskHandle<T>): void {
    cancelTask$(handle);
}

async function wrapSettledOne<T>(task: Task<T>): Task<Result<T, Error>> {
    try {
        return Result.Ok(await task);
    } catch (err) {
        return Result.Err(err as Error);
    }
}

async function raceOneHandle<T>(handle: TaskHandle<T>, ch: Channel<Result<T, Error>>): Task<void> {
    try {
        await ch.tx.send(Result.Ok(await handle));
    } catch (err) {
        await ch.tx.send(Result.Err(err as Error));
    }
}

class Deadline {
    expired: bool = false;
}

async function expire<T>(deadline: Deadline, target: TaskHandle<T>, ms: int): Task<void> {
    await sleep$(ms);
    deadline.expired = true;
    cancelTask$(target);
}

export namespace Task {
    export async function yield(): Task<void> {
        await yieldTask$();
    }

    export async function all<T>(tasks: Array<Task<T>>): Task<Array<T>> {
        return await parallel$(tasks);
    }

    export async function allSettled<T>(tasks: Array<Task<T>>): Task<Array<Result<T, Error>>> {
        let wrappedTasks: Array<Task<Result<T, Error>>> = [];
        for (let i = 0; i < tasks.length; i = i + 1) {
            wrappedTasks.push(wrapSettledOne(tasks[i]));
        }
        return await parallel$(wrappedTasks);
    }

    export async function timeout<T>(task: Task<T>, ms: int): Task<T> {
        const deadline = new Deadline();
        const target = spawn$(task);
        const timer = spawn$(expire(deadline, target, ms));
        try {
            return await target;
        } catch (err) {
            if (deadline.expired) {
                throw new TimeoutError(`timed out after ${ms}ms`);
            }
            throw err;
        } finally {
            cancelTask$(timer);
        }
    }

    export async function race<T>(tasks: Array<Task<T>>): Task<T> {
        if (tasks.length === 0) {
            throw new RangeError("Task.race requires at least one task");
        }
        let ch = channel$<Result<T, Error>>(tasks.length);
        let handles: Array<TaskHandle<T>> = [];
        for (let i = 0; i < tasks.length; i = i + 1) {
            handles.push(spawn(tasks[i]));
        }
        for (let i = 0; i < handles.length; i = i + 1) {
            spawn(raceOneHandle(handles[i], ch));
        }
        let first = await ch.rx.receive();
        for (let i = 0; i < handles.length; i = i + 1) {
            cancel(handles[i]);
        }
        return match (first) {
            Ok(value) => value,
            Err(error) => {
                throw error;
            }
        };
    }
}

export async function delay(ms: int): Task<void> {
    await sleep$(ms);
}

export function setTimeout(callback: () => void, ms: int): TaskHandle<void> {
    async function timerRunner(): Task<void> {
        await sleep(ms);
        callback();
    }
    return spawn(timerRunner);
}

export function clearTimeout(handle: TaskHandle<void>): void {
    if (handle !== null) {
        cancel(handle);
    }
}
