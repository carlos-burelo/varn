import { sleep } from "std:task/combinators";
import { now, toParts, fromParts, TimeParts } from "std:time";

export type CronSpec = {
    minutes: bool[],
    hours: bool[],
    days: bool[],
    months: bool[],
    weekdays: bool[]
};

function parseField(text: str, lo: int, hi: int): bool[] {
    let size = hi - lo + 1;
    let out: bool[] = [];
    for (let i = 0; i < size; i = i + 1) {
        out.push(false);
    }
    let groups = text.split(",");
    for (let g of groups) {
        let step = 1;
        let range = g;
        let slash = g.indexOf("/");
        if (slash >= 0) {
            range = g.slice(0, slash);
            step = int.parse(g.slice(slash + 1));
            if (step <= 0) {
                step = 1;
            }
        }
        let from = lo;
        let to = hi;
        if (range !== "" && range !== "*") {
            let dash = range.indexOf("-");
            if (dash >= 0) {
                from = int.parse(range.slice(0, dash));
                to = int.parse(range.slice(dash + 1));
            } else {
                from = int.parse(range);
                to = from;
            }
        }
        if (from < lo) {
            from = lo;
        }
        if (to > hi) {
            to = hi;
        }
        let v = from;
        while (v <= to) {
            out[v - lo] = true;
            v = v + step;
        }
    }
    return out;
}

function daysInMonth(year: int, month: int): int {
    if (month === 2) {
        if ((year % 4 === 0 && year % 100 !== 0) || year % 400 === 0) {
            return 29;
        }
        return 28;
    }
    if (month === 4 || month === 6 || month === 9 || month === 11) {
        return 30;
    }
    return 31;
}

function allSet(flags: bool[]): bool {
    for (let f of flags) {
        if (!f) {
            return false;
        }
    }
    return true;
}

function dowOf(ms: int): int {
    let days = ms / 86400000;
    if (ms < 0 && ms % 86400000 !== 0) {
        days = days - 1;
    }
    let d = (days + 4) % 7;
    if (d < 0) {
        d = d + 7;
    }
    return d;
}

export namespace Cron {
    export function parse(expr: str): CronSpec {
        let fields = expr.split(" ");
        let clean: str[] = [];
        for (let f of fields) {
            if (f.length > 0) {
                clean.push(f);
            }
        }
        if (clean.length !== 5) {
            throw new Error("Cron: expected 5 fields, got " + clean.length.toString());
        }
        let wd8 = parseField(clean[4], 0, 7);
        let wd = wd8.slice(0, 7);
        wd[0] = wd[0] || wd8[7];
        return #{
            minutes: parseField(clean[0], 0, 59),
            hours: parseField(clean[1], 0, 23),
            days: parseField(clean[2], 1, 31),
            months: parseField(clean[3], 1, 12),
            weekdays: wd
        };
    }

    export function next(spec: CronSpec, fromMs?: int): int {
        let base = fromMs ?? now();
        let t = base - (base % 60000) + 60000;
        let domOpen = allSet(spec.days);
        let dowOpen = allSet(spec.weekdays);
        for (let i = 0; i < 525600; i = i + 1) {
            let parts = toParts(t);
            if (parts.day > daysInMonth(parts.year, parts.month)) {
                t = t + 60000;
                continue;
            }
            let dow = dowOf(t);
            let dayOk = false;
            if (domOpen && dowOpen) {
                dayOk = true;
            } else if (!domOpen && !dowOpen) {
                dayOk = spec.days[parts.day - 1] || spec.weekdays[dow];
            } else if (!domOpen) {
                dayOk = spec.days[parts.day - 1];
            } else {
                dayOk = spec.weekdays[dow];
            }
            if (dayOk && spec.months[parts.month - 1] && spec.hours[parts.hour] && spec.minutes[parts.minute]) {
                return t;
            }
            t = t + 60000;
        }
        throw new Error("Cron: no fire time within a year");
    }

    export async function schedule(spec: CronSpec, action: () => void): Task<void> {
        while (true) {
            let at = next(spec);
            let wait = at - now();
            if (wait > 0) {
                await sleep(wait);
            }
            action();
        }
    }
}
