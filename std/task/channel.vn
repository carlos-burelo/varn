import {
    channel$,
    Sender,
    Receiver,
    Channel,
    ChannelClosed,
    IsolateHandle,
    spawnIsolate$
} from "runtime:task";

export { Sender, Receiver, Channel, ChannelClosed, IsolateHandle };

export function channel<T>(capacity: int): Channel<T> {
    return channel$<T>(capacity);
}

export function spawnIsolate<A, R>(
    fn: (...args: A) => R,
    args: A
): TaskHandle<IsolateHandle> {
    return spawnIsolate$(fn, args);
}
