// std:path — Pure Varn facade over runtime path host operations.

import {
    normalize as nativeNormalize,
    dirname as nativeDirname,
    basename as nativeBasename
} from "runtime:path";

export const sep = "/";
export const delimiter = ":";

export function normalize(p: str): str {
    return nativeNormalize(p);
}

export function dirname(p: str): str {
    return nativeDirname(p);
}

export function basename(p: str, ext?: str): str {
    let base = nativeBasename(p);
    if (ext !== null && ext !== undefined && base.endsWith(ext)) {
        return base.slice(0, base.length - ext.length);
    }
    return base;
}

export function extname(p: str): str {
    let base = nativeBasename(p);
    let idx = base.lastIndexOf(".");
    if (idx >= 0) {
        return base.slice(idx);
    }
    return "";
}

export function isAbsolute(p: str): bool {
    return p.startsWith("/") || p.startsWith("\\") || (p.length >= 2 && p[1] === ":");
}

export function join(...segments: str[]): str {
    let out = "";
    for (let segment of segments) {
        if (segment.length > 0) {
            if (out.length > 0 && !out.endsWith("/") && !segment.startsWith("/")) {
                out = out + "/" + segment;
            } else {
                out = out + segment;
            }
        }
    }
    return nativeNormalize(out);
}
