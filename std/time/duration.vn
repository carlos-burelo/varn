import { parseIsoDuration$ } from "runtime:time";
import { DurationParts } from "std:time/core";

export type DurationLike = Duration | str | int | DurationParts;

export class Duration {
    totalMilliseconds: int;
    hours: int;
    minutes: int;
    seconds: int;
    days: int;
    milliseconds: int;

    constructor(ms: int) {
        const totalSeconds = ms / 1000;
        const totalMinutes = totalSeconds / 60;
        const totalHours = totalMinutes / 60;
        this.totalMilliseconds = ms;
        this.milliseconds = ms % 1000;
        this.seconds = totalSeconds % 60;
        this.minutes = totalMinutes % 60;
        this.hours = totalHours % 24;
        this.days = totalHours / 24;
    }

    static from(input: DurationLike): Duration {
        if (input instanceof Duration) {
            return input as Duration;
        } else if (input instanceof str) {
            let ms = parseIsoDuration$(input as str);
            return new Duration(ms);
        } else if (input instanceof int) {
            return new Duration(input as int);
        } else {
            let parts = input as DurationParts;
            if (parts.years !== null || parts.months !== null) {
                throw new RangeError("a Duration is a fixed span of time and cannot hold years or months");
            }
            let ms = 0;
            // Los miembros de DurationParts son opcionales: el checker los
            // expone como `T?` y la lectura de un campo ausente da null.
            // `?? 0` es equivalente a la guardia `!== null` para esta suma.
            ms = ms + (parts.milliseconds ?? 0);
            ms = ms + (parts.seconds ?? 0) * 1000;
            ms = ms + (parts.minutes ?? 0) * 60000;
            ms = ms + (parts.hours ?? 0) * 3600000;
            ms = ms + (parts.days ?? 0) * 86400000;
            const sign = parts.sign ?? 1;
            if (sign !== 1 && sign !== -1) {
                throw new RangeError(`a Duration sign must be 1 or -1, got ${sign}`);
            }
            return new Duration(ms * sign);
        }
    }

    abs(): Duration {
        let ms = this.totalMilliseconds;
        if (ms < 0) ms = -ms;
        return new Duration(ms);
    }

    negated(): Duration {
        return new Duration(-this.totalMilliseconds);
    }

    add(other: DurationLike): Duration {
        let od = Duration.from(other);
        return new Duration(this.totalMilliseconds + od.totalMilliseconds);
    }

    subtract(other: DurationLike): Duration {
        let od = Duration.from(other);
        return new Duration(this.totalMilliseconds - od.totalMilliseconds);
    }

    compare(other: DurationLike): int {
        let od = Duration.from(other);
        if (this.totalMilliseconds < od.totalMilliseconds) return -1;
        if (this.totalMilliseconds > od.totalMilliseconds) return 1;
        return 0;
    }

    equals(other: DurationLike): bool {
        let od = Duration.from(other);
        return this.totalMilliseconds === od.totalMilliseconds;
    }

    toString(): str {
        return `Duration(${this.totalMilliseconds}ms)`;
    }

    toJSON(): str {
        return this.toString();
    }
}
