# Copia este archivo a `.env` (o `.env.local` para overrides personales, no
# versionado) en la raíz del proyecto. `vn` lo lee al arrancar — ver
# `crates/varn-cli/src/env_file.rs` — y fija estas claves en el proceso
# ANTES de correr nada, sin pisar lo que el shell ya haya exportado.
#
# Ambos `.env` y `.env.*` están en .gitignore: esto vive local, no se
# commitea. Cada quien mantiene el suyo.

# Backtrace completo de Rust en cualquier panic (no en los errores propios
# de Varn, que ya llevan su propio mensaje — esto es para cuando algo revienta
# a nivel Rust: un unwrap/expect dentro del VM o el compilador).
RUST_BACKTRACE=1
# RUST_BACKTRACE=full

# ── Depuración propia de Varn ────────────────────────────────────────────
# VARN_DEBUG_OPS=1        # vuelca el registro de operaciones nativas al iniciar
# VARN_GC_TRACE=1         # una línea por minor GC, según ocurre
# VARN_NO_JIT=1           # fuerza intérprete puro, sin tiering
# VARN_NO_CLIF=1          # como VARN_NO_JIT, para pruebas de paridad de tiers
# VARN_JIT_TIER=999999    # umbral de backedges para entrar a Cranelift
# VARN_JIT_OSR=1          # habilita on-stack-replacement
# VARN_CLIF_TRACE=1       # traza del lowering Cranelift
# VARN_CLIF_PRINT_IR=1    # vuelca el IR de Cranelift generado
# VARN_CLIF_VERIFY=1      # verifica el IR de Cranelift antes de compilar
# VARN_ALLOC_PROFILE=1    # perfil de asignaciones del heap
